+++ b/BetterGenshinImpact/GameTask/CharacterDevelopment/TalentEntryObservationEvidence.cs
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Copyright (C) 2026 bianwuqiong. BetterGI upstream authors retain their copyrights.
+// Modified 2026-10-12: bounded read-only talent entry observations and click binding.
+using System;
+using System.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+public sealed record UpgradePreviewTalentEntries(long ObservedAt,int Width,int Height,bool Focused,bool Overview,
+    bool PromptVisible,bool ReviveVisible,UpgradePreviewCharacter Character,Rect Region,
+    UpgradePreviewRow[] Rows,UpgradePreviewRow[] Candidates)
+{
+    public string Phase{get;init;}="talent_entry_observation";
+    public string FailureReason{get;init;}="unverified";
+    public InspectionPrivateCapture? PrivateCapture{get;init;}
+}
+
+/// <summary>Read-only observations after one navigation. Never retries an input or relaxes identity.</summary>
+public static class TalentEntryObservationEvidence
+{
+    public const int ObservationLimitMs=12000;
+    public const int ObservationIntervalMs=300;
+    public static readonly Rect ReferenceRegion=new(1536,0,384,900);
+    public static UpgradePreviewRow[] Candidates(UpgradePreviewRow[] rows)=>rows
+        .Where(r=>CharacterDevelopmentStateMachineTask.TryParseTalentLevel(r.Text,out _))
+        .OrderBy(r=>r.Bounds.Y).ToArray();
+    public static bool KnownPage(UpgradePreviewTalentEntries frame,string official)=>
+        frame.Focused&&frame.Overview&&!frame.PromptVisible&&!frame.ReviveVisible&&
+        frame.Character.ObservedAt==frame.ObservedAt&&frame.Character.Width==frame.Width&&frame.Character.Height==frame.Height&&
+        TalentUpgradePreviewEvidence.CharacterFrame(frame.Character,official)&&
+        frame.Region==TalentUpgradePreviewReader.Scale(ReferenceRegion,frame.Width);
+    public static string FrameFailure(UpgradePreviewTalentEntries frame,string official)
+    {
+        if(!KnownPage(frame,official))return "talent_list_page_unverified";
+        if(frame.Candidates.Length!=3)return "wrong_candidate_count";
+        if(!frame.Candidates.SequenceEqual(Candidates(frame.Rows)))return "candidate_rows_unbound";
+        double margin=2*frame.Width/1920d;
+        foreach(var row in frame.Candidates)
+        {
+            var box=row.Bounds;var crop=frame.Region;
+            if(box.Width<=0||box.Height<=0||box.Left-crop.Left<margin||crop.Right-box.Right<margin||
+                box.Top-crop.Top<margin||crop.Bottom-box.Bottom<margin)return "candidate_box_incomplete";
+        }
+        if(frame.Candidates.Zip(frame.Candidates.Skip(1)).Any(p=>p.First.Bounds.Bottom>=p.Second.Bounds.Top))
+            return "candidate_geometry_unverified";
+        return "verified_entries";
+    }
+    public static string PairFailure(UpgradePreviewTalentEntries first,UpgradePreviewTalentEntries second,string official,long now)
+    {
+        var a=FrameFailure(first,official);if(a!="verified_entries")return a;
+        var b=FrameFailure(second,official);if(b!="verified_entries")return b;
+        if(first.Width!=second.Width||first.Height!=second.Height||!TalentUpgradePreviewEvidence.Fresh(first.ObservedAt,second.ObservedAt,now))
+            return "entry_pair_freshness_unverified";
+        if(first.Candidates.Zip(second.Candidates).Any(p=>
+            Math.Abs((p.First.Bounds.Y+p.First.Bounds.Height/2)-(p.Second.Bounds.Y+p.Second.Bounds.Height/2))>6||
+            TalentUpgradePreviewEvidence.Normalize(p.First.Text)!=TalentUpgradePreviewEvidence.Normalize(p.Second.Text)))
+            return "unstable_candidate_geometry";
+        return "verified_entry_pair";
+    }
+    public static bool ClickBound(UpgradePreviewTalentEntries second,UpgradePreviewTalentEntries click,string official,long now)=>
+        PairFailure(second,click,official,now)=="verified_entry_pair"&&second.Candidates.Zip(click.Candidates).All(p=>
+            Math.Abs((p.First.Bounds.X+p.First.Bounds.Width/2)-(p.Second.Bounds.X+p.Second.Bounds.Width/2))<=6);
+}
