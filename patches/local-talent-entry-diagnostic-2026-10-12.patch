+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentEntryObservationEvidenceTests
+{
+    private const string Official="目标角色";
+    private static UpgradePreviewTalentEntries Frame(long at=100,int count=3,int yShift=0,int xShift=0)
+    {
+        var name=new UpgradePreviewCharacter(at,true,Official){Width=1920,Height=1080,
+            NameRegion=TalentUpgradePreviewEvidence.InspectionNameReference,
+            NameRows=[new(Official,new(1460,124,120,32))]};
+        var rows=Enumerable.Range(0,count).Select(i=>new UpgradePreviewRow("Lv.1",new(1800+xShift,250+i*100+yShift,80,25))).ToArray();
+        return new(at,1920,1080,true,true,false,false,name,TalentEntryObservationEvidence.ReferenceRegion,rows,
+            TalentEntryObservationEvidence.Candidates(rows));
+    }
+    [Fact] public void TwoCompleteDistinctFramesAndFreshClickAreBound()
+    {
+        var a=Frame();var b=Frame(400,yShift:2);var click=Frame(700,yShift:3,xShift:2);
+        Assert.Equal("verified_entry_pair",TalentEntryObservationEvidence.PairFailure(a,b,Official,450));
+        Assert.True(TalentEntryObservationEvidence.ClickBound(b,click,Official,750));
+    }
+    [Theory] [InlineData(0)] [InlineData(1)] [InlineData(2)] [InlineData(4)]
+    public void IncompleteOrAdditionalCandidateCountCannotPass(int count)=>
+        Assert.Equal("wrong_candidate_count",TalentEntryObservationEvidence.PairFailure(Frame(count:count),Frame(400),Official,450));
+    [Fact] public void TransitionGeometryIsDistinctFromWrongCount()=>
+        Assert.Equal("unstable_candidate_geometry",TalentEntryObservationEvidence.PairFailure(Frame(),Frame(400,yShift:7),Official,450));
+    [Fact] public void IdenticalTimestampOrExpiredPairRejects()
+    {
+        Assert.Equal("entry_pair_freshness_unverified",TalentEntryObservationEvidence.PairFailure(Frame(),Frame(),Official,100));
+        Assert.False(TalentEntryObservationEvidence.ClickBound(Frame(),Frame(400),Official,2000));
+    }
+    [Theory] [InlineData("prompt")] [InlineData("revive")] [InlineData("focus")] [InlineData("overview")] [InlineData("name")]
+    public void UnknownPageOrDifferentCharacterCannotClick(string failure)
+    {
+        var frame=Frame(400);frame=failure switch{
+            "prompt"=>frame with{PromptVisible=true},"revive"=>frame with{ReviveVisible=true},
+            "focus"=>frame with{Focused=false},"overview"=>frame with{Overview=false},
+            _=>frame with{Character=frame.Character with{Name="另一角色"}}};
+        Assert.False(TalentEntryObservationEvidence.ClickBound(Frame(),frame,Official,450));
+    }
+    [Fact] public void ClickUsesNewListPositionAndRejectsHorizontalDrift()=>
+        Assert.False(TalentEntryObservationEvidence.ClickBound(Frame(),Frame(400,xShift:7),Official,450));
+    [Fact] public void CandidateListMustBeDerivedFromFullRawRows()
+    {
+        var b=Frame(400) with{Rows=[]};
+        Assert.Equal("candidate_rows_unbound",TalentEntryObservationEvidence.PairFailure(Frame(),b,Official,450));
+    }
+    [Fact] public void TwoPixelEdgeRuleAndOrderedNonoverlapRemainRequired()
+    {
+        var bad=new UpgradePreviewRow("Lv.1",new(1537,250,80,25));
+        var frame=Frame(400);var rows=frame.Rows.ToArray();rows[0]=bad;
+        frame=frame with{Rows=rows,Candidates=TalentEntryObservationEvidence.Candidates(rows)};
+        Assert.Equal("candidate_box_incomplete",TalentEntryObservationEvidence.FrameFailure(frame,Official));
+        var overlap=Frame(400);var duplicate=overlap.Rows.ToArray();duplicate[1]=duplicate[0];
+        overlap=overlap with{Rows=duplicate,Candidates=TalentEntryObservationEvidence.Candidates(duplicate)};
+        Assert.Equal("candidate_geometry_unverified",TalentEntryObservationEvidence.FrameFailure(overlap,Official));
+    }
+    [Fact] public void ObservationBudgetMatchesExistingReadOnlyFinder()
+    {Assert.Equal(12000,TalentEntryObservationEvidence.ObservationLimitMs);Assert.Equal(300,TalentEntryObservationEvidence.ObservationIntervalMs);}
+}
