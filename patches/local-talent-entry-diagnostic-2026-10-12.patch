+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class Native19WeeklyDiagnosticTests
+{
+    private static WeeklyInventoryFrameEvidence Frame(long at,bool selected=true)
+    {
+        var rect=new BackpackRect(110,300,125,150);var names=BackpackRect.From(BackpackInventoryEvidenceSafety.NameRect(1920));
+        var count=BackpackRect.From(BackpackInventoryEvidenceSafety.RawCountRect(rect.ToRect()));
+        var border=new BackpackBorderEvidence(true,"four_side_neutral_outline",225,35,.9,[]);
+        var stack=new BackpackFrameEvidence{ObservedAt=at,NameRegion=names,
+            NameRows=[new("残火灯烛",names.X,names.Y+5,150,25)],CountRegion=count,CountRows=[],RawCountText="~7~",
+            SelectedItemVerified=selected,SelectedItemRect=rect,SelectionEvidence=border};
+        return new(stack,1920,1080,"characterDevelopmentItems",true,false,true,
+            WeeklyConversionInventoryEvidence.HeaderRect(1920),[new("养成道具",120,30,200,25)],"残火灯烛",.9,new(110,300,125,123));
+    }
+    [Fact] public void RejectedNumericAndTitleEdgesCanBeRetainedOnlyAsPrivateDiagnostics()
+    {
+        var first=Frame(400);var second=Frame(700);
+        Assert.True(WeeklyConversionInventoryEvidence.CanRetainDiagnostic(first));
+        var pair=new WeeklyInventoryObservation(new(new(110,300,125,150),172,365,100),first,second);
+        Assert.Null(WeeklyConversionInventoryEvidence.Count(pair,WeeklyInventoryCatalog.Materials[0]));
+    }
+    [Theory] [InlineData("focus")] [InlineData("prompt")] [InlineData("tab")] [InlineData("header")]
+    [InlineData("model")] [InlineData("category")] [InlineData("selection")]
+    public void UnknownSceneCannotRetainImages(string fault)
+    {
+        var read=Frame(400);read=fault switch{
+            "focus"=>read with{GameActive=false},"prompt"=>read with{PromptVisible=true},"tab"=>read with{TabVerified=false},
+            "header"=>read with{HeaderRows=[new("养成",120,30,200,25)]},"model"=>read with{IconScore=.74},
+            "category"=>read with{Category="unknown"},_=>Frame(400,false)};
+        Assert.False(WeeklyConversionInventoryEvidence.CanRetainDiagnostic(read));
+    }
+}
