     internal void ResetPair()=>previous=null;
+    internal static bool TryGetMatchedInputPoint(StartupEnterGameFrame frame,out Point2d point)
+    {
+        point=default;
+        if(!frame.EnterGame.Matched||frame.EnterGame.MatchBounds is not Rect bounds
+            ||bounds.Width<=0||bounds.Height<=0||bounds.X<0||bounds.Y<0
+            ||bounds.X+bounds.Width>frame.Width||bounds.Y+bounds.Height>frame.Height)return false;
+        var roi=frame.EnterGame.Region;
+        if(bounds.X<roi.X||bounds.Y<roi.Y||bounds.X+bounds.Width>roi.X+roi.Width
+            ||bounds.Y+bounds.Height>roi.Y+roi.Height)return false;
+        point=new(bounds.X+bounds.Width/2d,bounds.Y+bounds.Height/2d);
+        return true;
+    }
