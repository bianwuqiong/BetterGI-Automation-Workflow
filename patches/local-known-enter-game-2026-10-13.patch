diff --git a/BetterGenshinImpact/Service/StartupKnownEnterGameGate.cs b/BetterGenshinImpact/Service/StartupKnownEnterGameGate.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/Service/StartupKnownEnterGameGate.cs
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-13: one normal upstream EnterGame input; no login, account selection or unknown-page input.
+using System;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service;
+
+internal sealed record StartupEnterGameFrame(int Ordinal,long GameWindow,TimeSpan CapturedAt,int Width,int Height,
+    bool Foreground,bool ConflictingUi,StartupTemplateObservation EnterGame,bool AccountChoice=false);
+
+internal sealed class StartupKnownEnterGameGate
+{
+    internal static readonly TimeSpan MaximumPairGap=TimeSpan.FromMilliseconds(1000);
+    internal static readonly TimeSpan MaximumFrameAge=TimeSpan.FromMilliseconds(500);
+    private StartupEnterGameFrame? previous;
+    internal int Attempts { get; private set; }
+
+    internal bool TryEnter(StartupEnterGameFrame current,TimeSpan now,Action assertActualOwnerAndWindow,Action click)
+    {
+        var prior=previous;previous=null;
+        bool eligible=Attempts==0&&current.Foreground&&!current.ConflictingUi&&!current.AccountChoice&&current.GameWindow!=0
+            &&current.Width>0&&current.Height>0&&current.EnterGame.Matched
+            &&current.EnterGame.MatchBounds is {Width:>0,Height:>0}
+            &&current.CapturedAt<=now&&now-current.CapturedAt<=MaximumFrameAge;
+        if(!eligible)return false;
+        previous=current;
+        if(prior is null||current.Ordinal!=prior.Ordinal+1||current.GameWindow!=prior.GameWindow
+            ||current.Width!=prior.Width||current.Height!=prior.Height
+            ||current.CapturedAt<=prior.CapturedAt||current.CapturedAt-prior.CapturedAt>MaximumPairGap
+            ||current.EnterGame.MatchBounds!=prior.EnterGame.MatchBounds)return false;
+        assertActualOwnerAndWindow();
+        // Mark before invoking input: an exception or uncertain effect must never permit a second attempt.
+        Attempts=1;previous=null;click();return true;
+    }
+
+    internal void ResetPair()=>previous=null;
+    internal static bool CanAcceptReady(StartupSceneDecision decision,StartupEnterGameFrame frame)
+        =>decision.Ready&&!frame.EnterGame.Matched&&!frame.AccountChoice;
+
+    internal static StartupEnterGameFrame Read(ImageRegion frame,StartupSceneObservation scene,int ordinal,
+        long gameWindow,TimeSpan capturedAt,bool foreground)
+    {
+        var definition=RecognitionAssets.Get("GameLoading","EnterGame",frame);
+        using var match=frame.Find(definition);
+        bool found=match.IsExist();
+        var entry=new StartupTemplateObservation("GameLoading","EnterGame",definition.RegionOfInterest,
+            definition.Threshold,found,found?match.MatchScore:null,
+            found?new Rect(match.X,match.Y,match.Width,match.Height):null);
+        bool accountChoice=Has(frame,"GameLoading","ChooseEnterGame");
+        bool conflict=accountChoice||scene.MainUi||scene.ClosableUi||scene.Domain||scene.DialogueVisible||scene.ChoiceVisible;
+        if(found)
+        {
+            // These existing templates are refusal predicates only. Never execute their actions or OCR login/story text.
+            conflict|=Has(frame,"GameLoading","GirlMoon")
+                ||Has(frame,"GameLoading","WelkinMoon")||Has(frame,@"Common\Element","BtnWhiteConfirm")
+                ||Has(frame,@"Common\Element","BtnWhiteCancel")||Has(frame,@"Common\Element","Primogem");
+        }
+        return new(ordinal,gameWindow,capturedAt,frame.Width,frame.Height,foreground,conflict,entry,accountChoice);
+    }
+    private static bool Has(ImageRegion frame,string task,string name)
+    {
+        using var result=frame.Find(RecognitionAssets.Get(task,name,frame));return result.IsExist();
+    }
+}
diff --git a/Test/BetterGenshinImpact.UnitTest/ServiceTests/StartupKnownEnterGameGateTests.cs b/Test/BetterGenshinImpact.UnitTest/ServiceTests/StartupKnownEnterGameGateTests.cs
new file mode 100644
--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/ServiceTests/StartupKnownEnterGameGateTests.cs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-13: anonymous normal-entry pairs; no desktop, game or authentication interaction.
+using BetterGenshinImpact.Service;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.ServiceTests;
+
+public sealed class StartupKnownEnterGameGateTests
+{
+    private static StartupEnterGameFrame Frame(int n,int ms,bool matched=true,bool conflict=false,bool foreground=true,
+        long hwnd=42,int width=1920,int x=915)=>new(n,hwnd,TimeSpan.FromMilliseconds(ms),width,1080,foreground,conflict,
+            new("GameLoading","EnterGame",new(640,540,640,540),0.8,matched,matched?0.95:null,
+                matched?new Rect(x,760,104,28):null));
+    [Fact] public void TwoAdjacentCurrentFramesSendOnceAndNeverClaimReady()
+    {
+        var gate=new StartupKnownEnterGameGate();int checks=0,clicks=0;
+        Assert.False(gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(120),()=>checks++,()=>clicks++));
+        Assert.True(gate.TryEnter(Frame(2,620),TimeSpan.FromMilliseconds(650),()=>checks++,()=>clicks++));
+        Assert.False(gate.TryEnter(Frame(3,1140),TimeSpan.FromMilliseconds(1150),()=>checks++,()=>clicks++));
+        Assert.Equal(1,checks);Assert.Equal(1,clicks);Assert.Equal(1,gate.Attempts);
+        Assert.False(StartupSceneReadinessPolicy.Decide(1920,1080,true,false,false,false,false,false).Ready);
+    }
+    [Theory]
+    [InlineData("unknown")][InlineData("conflict")][InlineData("foreground")][InlineData("window")]
+    [InlineData("size")][InlineData("bounds")][InlineData("skipped")][InlineData("duplicate")]
+    [InlineData("oldpair")][InlineData("oldframe")][InlineData("future")]
+    public void MissingConflictingStaleOrUnboundEvidenceCannotSend(string fault)
+    {
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);
+        var current=Frame(2,620);
+        current=fault switch {
+            "unknown"=>Frame(2,620,matched:false),"conflict"=>Frame(2,620,conflict:true),
+            "foreground"=>Frame(2,620,foreground:false),"window"=>Frame(2,620,hwnd:43),
+            "size"=>Frame(2,620,width:1600),"bounds"=>Frame(2,620,x:916),
+            "skipped"=>Frame(3,620),"duplicate"=>Frame(1,620),
+            "oldpair"=>Frame(2,1200),"future"=>Frame(2,700),_=>current};
+        var now=TimeSpan.FromMilliseconds(fault=="oldpair"?1210:fault=="oldframe"?1200:650);
+        Assert.False(gate.TryEnter(current,now,()=>{},()=>clicks++));Assert.Equal(0,clicks);Assert.Equal(0,gate.Attempts);
+    }
+    [Fact] public void AnInterveningUnknownFrameInvalidatesTheOldPair()
+    {
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);
+        gate.TryEnter(Frame(2,620,matched:false),TimeSpan.FromMilliseconds(630),()=>{},()=>clicks++);
+        Assert.False(gate.TryEnter(Frame(3,1140),TimeSpan.FromMilliseconds(1150),()=>{},()=>clicks++));
+        Assert.Equal(0,clicks);
+    }
+    [Fact] public void CaptureFailureOrUninitializedContextResetsPair()
+    {
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);gate.ResetPair();
+        Assert.False(gate.TryEnter(Frame(2,620),TimeSpan.FromMilliseconds(630),()=>{},()=>clicks++));Assert.Equal(0,clicks);
+    }
+    [Theory][InlineData("owner")][InlineData("cancel")][InlineData("focus")][InlineData("deadline")]
+    public void ActualInputGuardFailureNeverCallsClick(string fault)
+    {
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);
+        Assert.Throws<InvalidOperationException>(()=>gate.TryEnter(Frame(2,620),TimeSpan.FromMilliseconds(630),
+            ()=>throw new InvalidOperationException(fault),()=>clicks++));Assert.Equal(0,clicks);
+    }
+    [Fact] public void ThrowingInputIsAnAttemptAndCannotBeReplayed()
+    {
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(Frame(1,100),TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);
+        Assert.Throws<InvalidOperationException>(()=>gate.TryEnter(Frame(2,620),TimeSpan.FromMilliseconds(630),
+            ()=>{},()=>{clicks++;throw new InvalidOperationException("unknown input effect");}));
+        Assert.False(gate.TryEnter(Frame(3,1140),TimeSpan.FromMilliseconds(1150),()=>{},()=>clicks++));
+        Assert.Equal(1,clicks);Assert.Equal(1,gate.Attempts);
+    }
+    [Theory][InlineData(false)][InlineData(true)]
+    public void EntryOrAccountPageCannotUseCoincidentGenericClosableReady(bool account)
+    {
+        var ready=StartupSceneReadinessPolicy.Decide(1920,1080,true,false,true,false,false,false);
+        var frame=account?Frame(1,100,matched:false) with {AccountChoice=true}:Frame(1,100,conflict:true);
+        Assert.False(StartupKnownEnterGameGate.CanAcceptReady(ready,frame));
+        var gate=new StartupKnownEnterGameGate();int clicks=0;
+        gate.TryEnter(frame,TimeSpan.FromMilliseconds(110),()=>{},()=>clicks++);
+        Assert.False(gate.TryEnter(frame with {Ordinal=2,CapturedAt=TimeSpan.FromMilliseconds(620)},
+            TimeSpan.FromMilliseconds(630),()=>{},()=>clicks++));Assert.Equal(0,clicks);
+    }
+    [Fact] public void ExistingFreshWorldReadyRemainsRequiredAfterEntry()
+    {
+        var ready=StartupSceneReadinessPolicy.Decide(1920,1080,true,true,false,false,false,false);
+        Assert.True(StartupKnownEnterGameGate.CanAcceptReady(ready,Frame(3,1140,matched:false)));
+    }
+}
