+        var tick=Task.Run(()=>{lock(TickLocker){entered.SetResult();release.Wait();}});
+        await entered.Task.WaitAsync(TimeSpan.FromSeconds(2));var oldEpoch=TaskTriggerDispatcher.StartupTriggerEpoch;var observations=0;
+        try
+        {
+            var failure=await Assert.ThrowsAsync<StartupLocalUserRequiredException>(async()=>{
