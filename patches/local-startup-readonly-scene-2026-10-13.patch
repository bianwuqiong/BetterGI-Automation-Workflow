+    }
+    [Fact] public async Task CanceledAwaitStillRequiresTheUncanceledRealDrainBeforeRestoration()
+    {
+        using var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None);
+        using var release=new ManualResetEventSlim();var entered=new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var tick=Task.Run(()=>{lock(TickLocker){entered.SetResult();release.Wait();}});
+        await entered.Task.WaitAsync(TimeSpan.FromSeconds(2));using var canceled=new CancellationTokenSource();
+        try
+        {
+            var pending=TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromSeconds(2),canceled.Token);
+            canceled.Cancel();await Assert.ThrowsAnyAsync<OperationCanceledException>(()=>pending);
+            owner.Dispose();Assert.False(owner.HasOwnership);Assert.True(TaskTriggerDispatcher.StartupTriggersSuppressed);
+            Assert.Equal(0,TaskControl.TaskSemaphore.CurrentCount);Assert.False(await TaskControl.TaskSemaphore.WaitAsync(0));
+        }
+        finally{release.Set();await tick.WaitAsync(TimeSpan.FromSeconds(2));}
+        await WaitForRestoration();
+    }
+    [Fact] public async Task ClosedInheritedRealScopeCannotBeRevivedAsFreshStartupOwnership()
+    {
+        var ambient=RunnerAmbient;var prior=ambient.Value;var runner=await TaskRunner.OwnedScope.AcquireAsync();Assert.NotNull(runner);
+        ambient.Value=runner;
+        try
+        {
+            runner!.RequestSemaphoreRelease();Assert.False(TaskRunner.HasOwnedSemaphore);Assert.Equal(1,TaskControl.TaskSemaphore.CurrentCount);
+            var failure=await Assert.ThrowsAsync<StartupLocalUserRequiredException>(()=>StartupReadinessOwner.AcquireAsync(CancellationToken.None));
+            Assert.Equal("startup_requires_local_user_startup_owner_lost",failure.Reason);
+            Assert.Equal(1,TaskControl.TaskSemaphore.CurrentCount);Assert.False(TaskTriggerDispatcher.StartupTriggersSuppressed);
