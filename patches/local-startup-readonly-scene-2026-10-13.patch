+[Collection("StartupReadiness32Lease")]
+public sealed class StartupReadinessLeaseTests
+{
+    private static object TickLocker=>typeof(TaskTriggerDispatcher).GetField("_locker",BindingFlags.Static|BindingFlags.NonPublic)!.GetValue(null)!;
