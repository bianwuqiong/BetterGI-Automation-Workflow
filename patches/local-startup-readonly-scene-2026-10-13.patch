+        using var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None);
+        using var suppression=await TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromSeconds(2),CancellationToken.None);
+        var suppressedEpoch=TaskTriggerDispatcher.StartupTriggerEpoch;
+        Assert.False(TaskTriggerDispatcher.StartupTickAllowed(oldEpoch));Assert.False(TaskTriggerDispatcher.StartupTickAllowed(suppressedEpoch));
+        suppression.Dispose();var restoredEpoch=TaskTriggerDispatcher.StartupTriggerEpoch;
+        Assert.False(TaskTriggerDispatcher.StartupTickAllowed(oldEpoch));Assert.False(TaskTriggerDispatcher.StartupTickAllowed(suppressedEpoch));
+        Assert.True(TaskTriggerDispatcher.StartupTickAllowed(restoredEpoch));
+        suppression.Dispose();Assert.Equal(restoredEpoch,TaskTriggerDispatcher.StartupTriggerEpoch);
+    }
+    [Fact] public async Task SuspensionDoesNotReturnUntilTheWholeExistingSynchronousTriggerCallFinishes()
+    {
+        using var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None);
+        using var release=new ManualResetEventSlim();var entered=new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var finished=0;var trigger=new FakeTrigger(()=>{entered.SetResult();release.Wait();Interlocked.Exchange(ref finished,1);});
+        var tick=Task.Run(()=>{lock(TickLocker){trigger.OnCapture(null!);}});
+        await entered.Task.WaitAsync(TimeSpan.FromSeconds(2));
+        IDisposable? suspension=null;
+        Task<IDisposable>? pending=null;
+        try
+        {
+            pending=TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromSeconds(2),CancellationToken.None);
