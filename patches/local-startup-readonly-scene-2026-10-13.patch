+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-13: anonymous startup scenes; no game, story input or OCR model is invoked.
+using BetterGenshinImpact.Service;
+
+namespace BetterGenshinImpact.UnitTest.ServiceTests;
+
+public sealed class StartupSceneReadinessPolicyTests
+{
+    [Theory]
+    [InlineData(true,false,false,"main_ui")]
+    [InlineData(false,true,false,"closable_ui")]
+    [InlineData(false,false,true,"domain")]
+    public void ExistingVerifiedUiIsReadyWithoutWakeInput(bool main,bool close,bool domain,string scene)
+    {
+        var decision=StartupSceneReadinessPolicy.Decide(1920,1080,true,main,close,domain,false,false);
+        Assert.True(decision.Ready);Assert.False(decision.RequiresLocalUser);Assert.False(decision.WakeInputAllowed);
+        Assert.Equal(scene,decision.Scene);
+    }
+    [Theory]
+    [InlineData(false,false,false)]
+    [InlineData(true,false,false)]
+    [InlineData(false,true,false)]
+    [InlineData(false,false,true)]
+    [InlineData(true,true,true)]
+    public void DialogueOverridesEveryPositiveGenericReadyMatch(bool main,bool close,bool domain)
+    {
+        var decision=StartupSceneReadinessPolicy.Decide(1920,1080,true,main,close,domain,true,false);
+        Assert.False(decision.Ready);Assert.True(decision.RequiresLocalUser);Assert.False(decision.WakeInputAllowed);
+        Assert.Equal("startup_requires_local_user_dialogue",decision.Reason);
+    }
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void ChoiceBlocksWithoutRequiringTheOtherDialogueIcon(bool dialogue)
+    {
+        var decision=StartupSceneReadinessPolicy.Decide(1920,1080,true,true,true,true,dialogue,true);
+        Assert.False(decision.Ready);Assert.True(decision.RequiresLocalUser);Assert.False(decision.WakeInputAllowed);
+        Assert.Equal("startup_requires_local_user_dialogue_choice",decision.Reason);
+    }
+    [Fact] public void UnknownOnlyWaitsReadOnlyThenRequiresLocalUserAtDeadline()
+    {
+        var pending=StartupSceneReadinessPolicy.Decide(1920,1080,true,false,false,false,false,false);
+        Assert.False(pending.Ready);Assert.False(pending.RequiresLocalUser);Assert.False(pending.WakeInputAllowed);
+        var expired=StartupSceneReadinessPolicy.Decide(1920,1080,true,false,false,false,false,false,true);
+        Assert.False(expired.Ready);Assert.True(expired.RequiresLocalUser);Assert.False(expired.WakeInputAllowed);
+        Assert.Equal("startup_requires_local_user_unknown_scene",expired.Reason);
+    }
+    [Theory]
+    [InlineData(0,1080,true)]
+    [InlineData(1920,0,true)]
+    [InlineData(1920,1080,false)]
+    public void IncompleteObservationCannotUseAPositiveReadyClaim(int width,int height,bool complete)
+    {
+        var decision=StartupSceneReadinessPolicy.Decide(width,height,complete,true,true,true,false,false);
+        Assert.False(decision.Ready);Assert.True(decision.RequiresLocalUser);Assert.False(decision.WakeInputAllowed);
+        Assert.Equal("startup_requires_local_user_scene_observation_failed",decision.Reason);
+    }
+    [Fact] public void ExpiredEvaluationCannotAcceptALateReadyMatch()
+    {
+        var decision=StartupSceneReadinessPolicy.Decide(1920,1080,true,true,true,true,false,false,true);
+        Assert.False(decision.Ready);Assert.True(decision.RequiresLocalUser);Assert.False(decision.WakeInputAllowed);
+    }
+}
