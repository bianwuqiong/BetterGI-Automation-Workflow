+        await Assert.ThrowsAnyAsync<OperationCanceledException>(()=>StartupReadinessOwner.AcquireAsync(canceled.Token));
+        Assert.Equal(1,TaskControl.TaskSemaphore.CurrentCount);Assert.False(TaskTriggerDispatcher.StartupTriggersSuppressed);
+        Assert.Equal(epoch,TaskTriggerDispatcher.StartupTriggerEpoch);
+    }
+    [Fact] public async Task OldAndSuppressedTickEpochsNeverBecomeAllowedAfterRestoration()
+    {
