+        try
+        {
+            await Assert.ThrowsAsync<StartupLocalUserRequiredException>(()=>
+                TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromMilliseconds(10),CancellationToken.None));
+            runner!.Invalidate();ambient.Value=null;runner.RequestSemaphoreRelease();owner.Dispose();
+            Assert.False(runner.IsActive);Assert.False(TaskRunner.HasOwnedSemaphore);Assert.False(owner.HasOwnership);
+            Assert.True(TaskTriggerDispatcher.StartupTriggersSuppressed);Assert.Equal(0,TaskControl.TaskSemaphore.CurrentCount);
+            Assert.False(await TaskControl.TaskSemaphore.WaitAsync(0));
+        }
+        finally
+        {
+            runner!.Invalidate();runner.RequestSemaphoreRelease();owner.Dispose();ambient.Value=prior;
+            release.Set();await tick.WaitAsync(TimeSpan.FromSeconds(2));
