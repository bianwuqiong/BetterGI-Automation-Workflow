+    [Fact] public async Task NestedRealRetentionsAndRepeatedCloseReleaseExactlyOnceWithoutRevivingActiveContext()
+    {
+        var runner=await TaskRunner.OwnedScope.AcquireAsync();Assert.NotNull(runner);
+        var first=runner!.RetainSemaphore();var second=runner.RetainSemaphore();
+        try
+        {
+            runner.Invalidate();runner.RequestSemaphoreRelease();runner.RequestSemaphoreRelease();
+            Assert.False(runner.IsActive);Assert.Equal(0,TaskControl.TaskSemaphore.CurrentCount);
+            Assert.Throws<StartupLocalUserRequiredException>(()=>runner.RetainSemaphore());
