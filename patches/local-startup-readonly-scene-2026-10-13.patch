+    }
+    [Fact] public async Task ClosingAReusedActualRunnerContextDoesNotReleaseItsSemaphoreOverAPendingDrain()
+    {
+        var ambient=RunnerAmbient;var prior=ambient.Value;
+        // Use the production real WaitAsync(0) factory, never an inert scope or caller-owned boolean.
+        var runner=await TaskRunner.OwnedScope.AcquireAsync();Assert.NotNull(runner);ambient.Value=runner;
+        using var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None);
+        Assert.Equal("existing_TaskRunner_owned_TaskSemaphore",owner.Source);
+        using var release=new ManualResetEventSlim();var entered=new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+        var tick=Task.Run(()=>{lock(TickLocker){entered.SetResult();release.Wait();}});
