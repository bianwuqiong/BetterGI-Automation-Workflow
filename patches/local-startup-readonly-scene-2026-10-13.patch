+    internal string Source=>source;
+    internal bool HasOwnership=>Volatile.Read(ref active)==1&&TaskControl.TaskSemaphore.CurrentCount==0&&
+        (acquiredSemaphore is not null||inheritedRetention?.Scope is {IsActive:true,HasNativeSemaphore:true});
+    internal static async Task<StartupReadinessOwner> AcquireAsync(CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        if(TaskRunner.HasInheritedSemaphoreScope)return new(TaskRunner.RetainCurrentOwnedSemaphore());
+        if(!await TaskControl.TaskSemaphore.WaitAsync(0,token))
+            throw new StartupLocalUserRequiredException("startup_requires_local_user_concurrent_task");
+        return new(TaskControl.TaskSemaphore);
+    }
+    internal void AssertOwnership()
+    {
+        if(!HasOwnership)throw new StartupLocalUserRequiredException("startup_requires_local_user_startup_owner_lost");
+    }
+    public void Dispose()
+    {
+        Interlocked.Exchange(ref active,0);
+        lock(closeGate){ReleaseNativeIfClosed();}
+    }
+    internal IDisposable RetainUntilActualDrain()
+    {
+        lock(closeGate)
+        {
+            AssertOwnership();deferredDrains++;
+            return new DeferredDrainHold(this);
+        }
+    }
+    internal void MarkStartupOperationQuiescent()=>inheritedRetention?.MarkOperationQuiescent();
+    internal Task RestoreAfterInheritedRunnerCleanupAsync(Action restore)
+    {
+        var inherited=inheritedRetention;
+        if(inherited is not null)return inherited.Scope.RestoreStartupAfterCleanupAsync(restore);
+        restore();return Task.CompletedTask;
+    }
+    private void ReleaseNativeIfClosed()
+    {
+        if(Volatile.Read(ref active)!=0||deferredDrains!=0)return;
+        if(acquiredSemaphore is {} actual){acquiredSemaphore=null;actual.Release();}
+        inheritedRetention?.Dispose();inheritedRetention=null;
+    }
+    private void EndDeferredDrain()
+    {
+        lock(closeGate)
+        {
+            if(deferredDrains<=0)throw new InvalidOperationException("native_startup_drain_retention_underflow");
+            deferredDrains--;ReleaseNativeIfClosed();
+        }
+    }
+    private sealed class DeferredDrainHold(StartupReadinessOwner owner):IDisposable
+    {
+        private int active=1;
+        public void Dispose(){if(Interlocked.Exchange(ref active,0)==1)owner.EndDeferredDrain();}
+    }
+}
+
+public sealed class StartupLocalUserRequiredException : InvalidOperationException
+{
+    public string Reason{get;}
+    public StartupLocalUserRequiredException(string reason,Exception? inner=null)
+        :base(reason+": 启动页面未核验；请在本机手动返回可交互世界后再运行。未发送唤醒点击或执行任务节点。",inner)=>Reason=reason;
+}
