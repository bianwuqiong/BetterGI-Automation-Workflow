+        (AsyncLocal<TaskRunner.OwnedScope?>)typeof(TaskRunner).GetField("OwnedSemaphoreScope",BindingFlags.Static|BindingFlags.NonPublic)!.GetValue(null)!;
+    private static async Task WaitForRestoration()
+    {
+        var limit=System.Diagnostics.Stopwatch.StartNew();
+        while(TaskTriggerDispatcher.StartupTriggersSuppressed&&limit.Elapsed<TimeSpan.FromSeconds(2))await Task.Delay(5);
+        Assert.False(TaskTriggerDispatcher.StartupTriggersSuppressed);
+        while(TaskControl.TaskSemaphore.CurrentCount!=1&&limit.Elapsed<TimeSpan.FromSeconds(2))await Task.Delay(5);
+        Assert.Equal(1,TaskControl.TaskSemaphore.CurrentCount);
+    }
+    [Fact] public async Task ActualOwnerAndSuspensionPreservePriorTriggerIdentityAndEnabledState()
+    {
+        var prior=GameTaskManager.TriggerDictionary;
+        var trigger=new FakeTrigger();var dictionary=new ConcurrentDictionary<string,ITaskTrigger>();dictionary["anonymous"]=trigger;
+        GameTaskManager.TriggerDictionary=dictionary;
+        try
+        {
+            using(var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None))
+            {
+                Assert.True(owner.HasOwnership);Assert.Equal(0,TaskControl.TaskSemaphore.CurrentCount);
+                using(var suppression=await TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromSeconds(2),CancellationToken.None))
+                {
+                    Assert.True(TaskTriggerDispatcher.StartupTriggersSuppressed);
+                    Assert.Same(dictionary,GameTaskManager.TriggerDictionary);Assert.Same(trigger,dictionary["anonymous"]);
+                    Assert.True(trigger.IsEnabled);Assert.Equal(0,trigger.Initializations);Assert.Equal(0,trigger.Calls);
+                }
+                Assert.False(TaskTriggerDispatcher.StartupTriggersSuppressed);
+                Assert.Same(dictionary,GameTaskManager.TriggerDictionary);Assert.True(trigger.IsEnabled);
+            }
+            Assert.Equal(1,TaskControl.TaskSemaphore.CurrentCount);
+        }
+        finally{GameTaskManager.TriggerDictionary=prior;}
+    }
+    [Fact] public async Task AForeignBusySemaphoreCannotBecomeStartupOwnership()
+    {
+        await TaskControl.TaskSemaphore.WaitAsync();var epoch=TaskTriggerDispatcher.StartupTriggerEpoch;
+        try
+        {
+            var failure=await Assert.ThrowsAsync<StartupLocalUserRequiredException>(()=>StartupReadinessOwner.AcquireAsync(CancellationToken.None));
+            Assert.Equal("startup_requires_local_user_concurrent_task",failure.Reason);
