@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-13: read-only startup scene policy; unknown pages never authorize wake input.
+namespace BetterGenshinImpact.Service;
+
+public sealed record StartupSceneDecision(string Scene,bool Ready,bool RequiresLocalUser,string Reason)
+{
+    public bool WakeInputAllowed => false;
+}
+
+public static class StartupSceneReadinessPolicy
+{
+    public static StartupSceneDecision Decide(int width,int height,bool observationComplete,
+        bool mainUi,bool closableUi,bool domain,bool dialogueVisible,bool choiceVisible,bool deadlineExpired=false)
+    {
+        if(!observationComplete||width<=0||height<=0)
+            return new("observation_failed",false,true,"startup_requires_local_user_scene_observation_failed");
+        // Dialogue/choice wins over a coincident generic X, domain or main-UI match.
+        if(choiceVisible)return new("dialogue_choice",false,true,"startup_requires_local_user_dialogue_choice");
+        if(dialogueVisible)return new("dialogue",false,true,"startup_requires_local_user_dialogue");
+        if(deadlineExpired)return new("unknown",false,true,"startup_requires_local_user_unknown_scene");
+        if(mainUi)return new("main_ui",true,false,"verified_existing_main_ui");
+        if(closableUi)return new("closable_ui",true,false,"verified_existing_closable_ui");
+        if(domain)return new("domain",true,false,"verified_existing_domain");
+        return new("unknown",false,false,"startup_unknown_scene_waiting_readonly");
+    }
+}
