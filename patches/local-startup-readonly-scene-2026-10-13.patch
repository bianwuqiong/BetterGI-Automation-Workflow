+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-13: observe existing upstream dialogue templates without AutoSkip actions.
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.Service;
+
+public sealed record StartupTemplateObservation(string Task,string Object,Rect Region,double Threshold,
+    bool Matched,double? MatchScore,Rect? MatchBounds);
+public sealed record StartupSceneObservation(long ObservedAt,int Width,int Height,bool MainUi,bool ClosableUi,bool Domain,
+    bool DialogueVisible,bool ChoiceVisible,StartupTemplateObservation[] Templates)
+{
+    public string Method=>"existing_upstream_dialogue_and_choice_templates_readonly_v1";
+    public bool InputSent=>false;
+    public bool NativePngRetained=>false;
+}
+
+internal static class StartupSceneReadOnlyObserver
+{
+    private static StartupTemplateObservation Match(ImageRegion frame,string name)
+    {
+        var definition=RecognitionAssets.Get("AutoSkip",name,frame.Width,frame.Height);
+        using var found=frame.Find(definition);
+        bool matched=found.IsExist();
+        return new("AutoSkip",name,definition.RegionOfInterest,definition.Threshold,matched,
+            matched?found.MatchScore:null,matched?new Rect(found.X,found.Y,found.Width,found.Height):null);
+    }
+    internal static StartupSceneObservation Read(ImageRegion frame,long at)
+    {
+        // Same DisabledUiButton predicate used by Bv.IsInTalkUi; same OptionIcon lookup as AutoSkip.HasDialogueOption.
+        // Deliberately never instantiate a trigger, choose an option, OCR story text or invoke AutoSkip.Start.
+        var dialogue=Match(frame,"DisabledUiButton");var choice=Match(frame,"OptionIcon");
+        return new(at,frame.Width,frame.Height,Bv.IsInMainUi(frame),Bv.IsInAnyClosableUi(frame),Bv.IsInDomain(frame),
+            dialogue.Matched,choice.Matched,[dialogue,choice]);
+    }
+}
