+        using var owner=await StartupReadinessOwner.AcquireAsync(CancellationToken.None);
+        using var suppression=await TaskTriggerDispatcher.SuspendAutomaticTriggersForStartupAsync(owner,TimeSpan.FromSeconds(2),CancellationToken.None);
+        using var hold=owner.RetainUntilActualDrain();
+        var barrier=kind==1?Task.FromCanceled<bool>(new CancellationToken(true)):kind==2?Task.FromResult(false):
+            Task.FromException<bool>(new InvalidOperationException("anonymous_barrier_failure"));
+        var complete=typeof(TaskTriggerDispatcher).GetMethod("CompleteStartupDrainAfterAbort",BindingFlags.Static|BindingFlags.NonPublic)!;
+        await (Task)complete.Invoke(null,[barrier,suppression,owner,hold])!;
+        owner.Dispose();Assert.False(owner.HasOwnership);
+        Assert.True(TaskTriggerDispatcher.StartupTriggersSuppressed);Assert.Equal(0,TaskControl.TaskSemaphore.CurrentCount);
+        // Test cleanup only: no actual failed barrier is converted into a positive production drain proof.
+        suppression.Dispose();hold.Dispose();await WaitForRestoration();
+    }
+    [Fact] public async Task OrdinaryCleanupRunsSynchronouslyAndReleasesExactlyOnceEvenWhenItThrows()
+    {
+        var runner=await TaskRunner.OwnedScope.AcquireAsync();Assert.NotNull(runner);var calls=0;
+        var failure=Assert.Throws<InvalidOperationException>(()=>runner!.CloseWithCleanup(()=>{
+            calls++;Assert.False(runner.IsActive);Assert.False(TaskTriggerDispatcher.StartupTriggersSuppressed);
+            throw new InvalidOperationException("anonymous_ordinary_cleanup_failure");
+        }));
+        Assert.Equal("anonymous_ordinary_cleanup_failure",failure.Message);Assert.Equal(1,calls);
