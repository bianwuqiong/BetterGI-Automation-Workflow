diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native18ExactEvidenceTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native18ExactEvidenceTests.cs
new file mode 100644
--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native18ExactEvidenceTests.cs
@@ -0,0 +1,56 @@
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class Native18ExactEvidenceTests
+{
+    [Theory] [InlineData("角色培养道具",true)] [InlineData("养成道具",true)] [InlineData("养成",false)]
+    [InlineData("养成道具材料",false)] [InlineData("贵重道具",false)]
+    public void ReviewedHeaderAliasesAreExactCompleteAndUnique(string text,bool verified)
+    {
+        var box=WeeklyConversionInventoryEvidence.HeaderRect(1920);
+        Assert.Equal(verified,WeeklyConversionInventoryEvidence.HeaderVerified([new(text,120,30,200,25)],box,"characterDevelopmentItems"));
+    }
+    [Fact] public void BothAliasLabelsOrRepeatedHeaderNeverPass()
+    {
+        var box=WeeklyConversionInventoryEvidence.HeaderRect(1920);
+        Assert.False(WeeklyConversionInventoryEvidence.HeaderVerified([new("角色培养道具",120,30,200,25),new("养成道具",120,60,200,25)],box,"characterDevelopmentItems"));
+        Assert.False(WeeklyConversionInventoryEvidence.HeaderVerified([new("养成道具",120,30,200,25),new("养成道具",120,60,200,25)],box,"characterDevelopmentItems"));
+        Assert.False(WeeklyConversionInventoryEvidence.HeaderVerified([new("养成道具",101,30,200,25)],box,"characterDevelopmentItems"));
+    }
+    [Fact] public void ActualSlashControlsOnlyNumericVerticalBandAndNeverRepairsTheWholeMisread()
+    {
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.White);
+        var box=new Rect(200,200,120,50);
+        Cv2.Line(image,new Point(270,216),new Point(263,234),Scalar.Black,2);
+        using var frame=new ImageRegion(image.Clone(),0,0);
+        var r=TalentUpgradePreviewReader.ReadRatio(frame,box,new NumericOcr(false),100);
+        Assert.True(r.Complete);Assert.True(r.SlashPixelVerified);Assert.Equal("7316",r.Raw);
+        Assert.Equal(73,r.Owned);Assert.Equal(6,r.Required);Assert.Equal("slash_vertical_band",r.SplitRegionMethod);
+        Assert.Equal(6,r.SplitVerticalPaddingReference);
+        Assert.True(r.NumeratorRegion!.Value.Top>box.Top&&r.NumeratorRegion.Value.Bottom<box.Bottom);
+    }
+    [Fact] public void FailedIntegerKeepsSlashEvidenceAndEveryFailedRawField()
+    {
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.White);var box=new Rect(200,200,120,50);
+        Cv2.Line(image,new Point(270,216),new Point(263,234),Scalar.Black,2);using var frame=new ImageRegion(image.Clone(),0,0);
+        var r=TalentUpgradePreviewReader.ReadRatio(frame,box,new NumericOcr(true),100);
+        Assert.False(r.Complete);Assert.True(r.SlashPixelVerified);Assert.Null(r.Owned);Assert.Null(r.Required);
+        Assert.Equal("7316",r.Raw);Assert.Equal("6x",r.DenominatorRaw);Assert.NotNull(r.SlashBounds);Assert.NotEmpty(r.DenominatorRows);
+    }
+    private sealed class NumericOcr(bool bad) : IOcrService
+    {
+        private string Text(Mat m)=>m.Width==120?"73/6":m.Width>230?"73":bad?"6x":"6";
+        public string Ocr(Mat m)=>Text(m);
+        public string OcrWithoutDetector(Mat m)=>m.Width==120?"7316":Text(m);
+        public OcrResult OcrResult(Mat m)
+        {
+            var b=m.Width==120?new Rect(10,10,70,25):new Rect(12,12,Math.Min(80,m.Width-24),Math.Min(50,m.Height-24));
+            return new([new(new RotatedRect(new Point2f(b.X+b.Width/2f,b.Y+b.Height/2f),new Size2f(b.Width,b.Height),0),Text(m),.99f)]);
+        }
+    }
+}
