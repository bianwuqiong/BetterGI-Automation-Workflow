@@ -0,0 +1,35 @@
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using BetterGenshinImpact.UnitTest.CoreTests.RecognitionTests.OCRTests;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class Native18PrivateQuantityTests
+{
+    [Fact] [Trait("Fixture","PrivateNative18Quantity")]
+    public void RetainedActualPngQuantityIsParsedByTheSameCandidateWithoutPretendingLiveFreshness()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_NATIVE18_QUANTITY_MANIFEST");
+        Assert.False(string.IsNullOrWhiteSpace(path));
+        var f=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        var result=new List<object>();
+        var models=new PaddleFixture();
+        foreach(var file in f.Images)
+        {
+            using var image=Cv2.ImRead(file);using var frame=new ImageRegion(image.Clone(),0,0);
+            var b=f.QuantityBox;
+            foreach(var version in new[]{"V4","V5"})
+            {
+            var reading=TalentUpgradePreviewReader.ReadRatio(frame,new(b[0],b[1],b[2],b[3]),models.Get(version:version),0,requirePixelSplit:true);
+            result.Add(new{version,reading});
+            File.WriteAllText(f.DiagnosticPath,Newtonsoft.Json.JsonConvert.SerializeObject(new{source="actual_png_offline_candidate_not_live",frames=result}));
+            Assert.True(reading.SlashPixelVerified,"Actual slash geometry must be independently retained even if numeric methods fail.");
+            Assert.True(reading.Complete,$"Numerator={reading.NumeratorRaw}, Denominator={reading.DenominatorRaw}");
+            Assert.Equal(f.Owned,reading.Owned);Assert.Equal(f.Required,reading.Required);
+            }
+        }
+    }
+    private sealed class Fixture{public string[] Images{get;set;}=[];public int[] QuantityBox{get;set;}=[];public int? Owned{get;set;}public int? Required{get;set;}public string DiagnosticPath{get;set;}="";}
+}
