+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class Native18PrivateHeaderTests
+{
+    [Fact] [Trait("Fixture","PrivateNative18Header")]
+    public void ActualNewBagHeaderUsesOnlyAnExactReviewedAlias()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_NATIVE18_HEADER_MANIFEST");Assert.False(string.IsNullOrWhiteSpace(path));
+        var f=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        using var image=Cv2.ImRead(f.File);var r=f.ClientRect;using var client=new Mat(image,new Rect(r[0],r[1],r[2],r[3]));
+        foreach(int width in new[]{1536,1920})
+        {
+            using var resized=new Mat();Cv2.Resize(client,resized,new Size(width,width*9/16));using var frame=new ImageRegion(resized.Clone(),0,0);
+            var region=WeeklyConversionInventoryEvidence.HeaderRect(width);using var crop=frame.DeriveCrop(region.ToRect());
+            var rows=OcrFactory.Paddle.OcrResult(crop.SrcMat).Regions.Select(row=>{var b=row.Rect.BoundingRect();return new BackpackOcrRow(row.Text,region.X+b.X,region.Y+b.Y,b.Width,b.Height);}).ToArray();
+            Assert.True(WeeklyConversionInventoryEvidence.HeaderVerified(rows,region,"characterDevelopmentItems"));
+            Assert.Equal("养成道具",BackpackInventoryEvidenceSafety.Normalize(Assert.Single(rows).Text));
+        }
+    }
+    private sealed class Fixture{public string File{get;set;}="";public int[] ClientRect{get;set;}=[];}
+}
