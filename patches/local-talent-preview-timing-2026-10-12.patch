diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentPreviewReadTimingTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentPreviewReadTimingTests.cs
new file mode 100644
--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentPreviewReadTimingTests.cs
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: the original capture clock is retained through OCR and later PNG diagnostics.
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentPreviewReadTimingTests
+{
+    private static UpgradePreviewFrame Frame(long at)=>new(at,true,1,2,
+        [new("材料甲",.9,new Rect(838,627,116,146),new(at,"4/1",new Rect(844,737,104,33),4,1,true))],
+        new(at,"200/10",new Rect(900,800,275,55),200,10,true),"摩拉",.9,[])
+    {
+        Width=1920,Height=1080,
+        PrivateCapture=new(at,1920,1080,"CV_8UC3","private-fixture-only",new string('A',64),new string('B',64),
+            "diagnostic_only_lossless_native_srcmat_no_resize")
+    };
+    private static (UpgradePreviewFrame First,UpgradePreviewFrame Second) Pair()
+    {
+        var first=Frame(100) with{ReadTiming=new(90,100,101,150,null,600,null)};
+        var second=Frame(400) with{ReadTiming=new(390,400,401,450,500,650,true)};
+        return(first,second);
+    }
+    [Fact] public void EvaluationClockPrecedesPngYetUsesOriginalCaptureTime()
+    {
+        var (first,second)=Pair();
+        Assert.True(TalentUpgradePreviewEvidence.TimedPreviewPair(first,second,1));
+        Assert.Equal(first.ObservedAt,first.ReadTiming!.CaptureReturnedAt);
+        Assert.Equal(second.ObservedAt,second.ReadTiming!.CaptureReturnedAt);
+    }
+    [Fact] public void PngCompletionCannotRefreshAnExpiredSecondFrame()
+    {
+        var (first,second)=Pair();
+        first=first with{ReadTiming=first.ReadTiming! with{DiagnosticPngCompletedAt=2000}};
+        second=second with{ReadTiming=second.ReadTiming! with{PairEvaluatedAt=1901,DiagnosticPngCompletedAt=2100}};
+        Assert.False(TalentUpgradePreviewEvidence.TimedPreviewPair(first,second,1));
+    }
+    [Fact] public void ExactEvaluationDeadlineRemainsAcceptedBeforeLaterPng()
+    {
+        var (first,second)=Pair();
+        first=first with{ReadTiming=first.ReadTiming! with{DiagnosticPngCompletedAt=2000}};
+        second=second with{ReadTiming=second.ReadTiming! with{PairEvaluatedAt=1900,DiagnosticPngCompletedAt=2100}};
+        Assert.True(TalentUpgradePreviewEvidence.TimedPreviewPair(first,second,1));
+    }
+    [Theory]
+    [InlineData("missing")][InlineData("wrongCapture")][InlineData("firstEval")][InlineData("readerAfterEval")]
+    [InlineData("pngBeforeEval")][InlineData("missingPng")][InlineData("secondFalse")]
+    [InlineData("wrongPixels")][InlineData("wrongSource")][InlineData("shortHash")][InlineData("overlap")]
+    public void PartialReorderedOrUnretainedTimingCannotClaimSuccess(string fault)
+    {
+        var (first,second)=Pair();
+        switch(fault)
+        {
+            case "missing":second=second with{ReadTiming=null};break;
+            case "wrongCapture":second=second with{ReadTiming=second.ReadTiming! with{CaptureReturnedAt=401}};break;
+            case "firstEval":first=first with{ReadTiming=first.ReadTiming! with{PairEvaluatedAt=200}};break;
+            case "readerAfterEval":second=second with{ReadTiming=second.ReadTiming! with{ReaderCompletedAt=501}};break;
+            case "pngBeforeEval":first=first with{ReadTiming=first.ReadTiming! with{DiagnosticPngCompletedAt=499}};break;
+            case "missingPng":second=second with{PrivateCapture=null};break;
+            case "secondFalse":second=second with{ReadTiming=second.ReadTiming! with{PairAccepted=false}};break;
+            case "wrongPixels":second=second with{PrivateCapture=second.PrivateCapture! with{PixelType="CV_8UC4"}};break;
+            case "wrongSource":second=second with{PrivateCapture=second.PrivateCapture! with{Source="synthetic"}};break;
+            case "shortHash":second=second with{PrivateCapture=second.PrivateCapture! with{PngSha256="AA"}};break;
+            case "overlap":second=second with{ReadTiming=second.ReadTiming! with{CaptureCallStartedAt=150}};break;
+        }
+        Assert.False(TalentUpgradePreviewEvidence.TimedPreviewPair(first,second,1));
+    }
+}
