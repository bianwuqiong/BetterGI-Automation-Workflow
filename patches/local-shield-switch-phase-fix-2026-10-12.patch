@@ -0,0 +1,20 @@
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+/// <summary>Invocation-owned monotonic phase/latch evidence. Never proves actual account balances.</summary>
+public sealed class ProtectedDomainResourcePhase
+{
+    public bool ExactSingleContract {get;private set;}
+    public int ActiveRound {get;private set;}=-1;
+    public bool RewardInteractionEntered {get;private set;}
+    public bool SubmissionRequested {get;private set;}
+    public int SubmissionRequests {get;private set;}
+    public int CompletedClaimCount {get;private set;}
+    public string Stage {get;private set;}="entry";
+    public void Reset(bool exactSingle) {ExactSingleContract=exactSingle;ActiveRound=-1;RewardInteractionEntered=false;SubmissionRequested=false;SubmissionRequests=0;CompletedClaimCount=0;Stage="entry";}
+    public void EnterRound(int round) {ActiveRound=round;Stage="challenge_activation";}
+    public void SetStage(string stage)=>Stage=stage;
+    public void EnterRewardInteraction(){RewardInteractionEntered=true;Stage="reward_interaction";}
+    public void MarkSubmissionRequested(){SubmissionRequested=true;SubmissionRequests++;Stage="submission_requested";}
+    public void MarkClaimFlowCompleted(){CompletedClaimCount++;Stage="claim_flow_completed";}
+    public bool CanAssertBeforeRewardAbort=>ExactSingleContract && ActiveRound==0 && CompletedClaimCount==0 && !RewardInteractionEntered && !SubmissionRequested && SubmissionRequests==0;
+}
