+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.AutoDomain;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ProtectedShieldSchedulingTests
+{
+    [Fact]
+    public void PendingFirstIdentityFrameNeverTriggersAnotherTargetKey()
+    {
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(true,-2,4,1200,0));
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(true,-1,4,900,0));
+        Assert.True(MaterialSwitchTimingPolicy.ShouldRetryTarget(true,-1,4,1000,0));
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(false,-1,4,1200,0));
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(true,-1,4,5000,0));
+    }
+    [Fact]
+    public void GeometryRefreshOrTargetKeyMustRestartTheTwoFrameIdentitySequence()
+    {
+        var context=new AvatarActiveCheckContext {StrictIdentity=true};
+        Assert.Equal(-2,context.ObserveStrictCandidate(4));context.ResetStrictCandidate();
+        Assert.Equal(-2,context.ObserveStrictCandidate(4));Assert.Equal(4,context.ObserveStrictCandidate(4));
+    }
+    [Fact]
+    public void InvocationOwnedBeforeRewardProofRequiresTheExactFirstSingleRound()
+    {
+        var phase=new ProtectedDomainResourcePhase();phase.Reset(true);
+        Assert.False(phase.CanAssertBeforeRewardAbort);
+        phase.EnterRound(0);phase.SetStage("battle");Assert.True(phase.CanAssertBeforeRewardAbort);
+        phase.EnterRewardInteraction();Assert.False(phase.CanAssertBeforeRewardAbort);
+        phase.SetStage("battle");Assert.False(phase.CanAssertBeforeRewardAbort);
+        phase.Reset(true);phase.EnterRound(1);Assert.False(phase.CanAssertBeforeRewardAbort);
+        phase.Reset(false);phase.EnterRound(0);Assert.False(phase.CanAssertBeforeRewardAbort);
+    }
+    [Fact]
+    public void OnceSubmissionRequestedNoLaterFailureCanClaimNoSubmission()
+    {
+        var phase=new ProtectedDomainResourcePhase();phase.Reset(true);phase.EnterRound(0);
+        phase.MarkSubmissionRequested();Assert.False(phase.CanAssertBeforeRewardAbort);
+        phase.EnterRound(0);phase.SetStage("battle");Assert.False(phase.CanAssertBeforeRewardAbort);
+        Assert.True(phase.SubmissionRequested);Assert.Equal(1,phase.SubmissionRequests);
+        phase.MarkClaimFlowCompleted();Assert.Equal(1,phase.CompletedClaimCount);
+        Assert.False(phase.CanAssertBeforeRewardAbort);
+    }
+}
