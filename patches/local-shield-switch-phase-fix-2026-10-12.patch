@@ -0,0 +1,22 @@
+using System;
+using System.Linq;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.AutoFight.Model;
+
+public sealed record StrictSlotPixels(int Slot,Rect Bounds,double WhiteFraction,double WhiteEdgeFraction,int ExactDarkDigitPixels);
+public sealed record StrictSwitchFrame(long ObservedAt,long ElapsedMs,int Target,int Active,int ColorCandidate,
+    int ArrowCandidate,bool UiReady,bool GeometryChanged,int Presses,StrictSlotPixels[] Slots);
+
+/// <summary>Scalar diagnostics only; identity rules are still the existing strict helper.</summary>
+public static class ProtectedSwitchDiagnostics
+{
+    public static StrictSlotPixels[] Pixels(ImageRegion frame,Rect[] rects)=>rects.Select((rect,i)=>{
+        using var mat=new Mat(frame.CacheGreyMat,rect);int white=0,dark=0;
+        for(int y=0;y<mat.Rows;y++)for(int x=0;x<mat.Cols;x++) {
+            var v=mat.At<byte>(y,x);if(v>=251)white++;if(v==50)dark++;
+        }
+        return new StrictSlotPixels(i+1,rect,white/(double)(mat.Rows*mat.Cols),PartyAvatarSideIndexHelper.CalculateWhiteEdgePixelsRatio(mat),dark);
+    }).ToArray();
+}
