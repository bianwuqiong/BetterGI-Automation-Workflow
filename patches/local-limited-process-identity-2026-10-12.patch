+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: actual process identity with fixed query-only limited rights.
+using System;
+using System.ComponentModel;
+using System.Globalization;
+using System.IO;
+using System.Runtime.InteropServices;
+using System.Text;
+using Microsoft.Win32.SafeHandles;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+internal sealed record InventoryProcessIdentity(int ProcessId, string ExecutablePath, string ProcessStartedUtcTicks);
+
+/// <summary>Queries one real process handle; never requests module/VM read or input rights.</summary>
+internal static class LimitedInventoryProcessIdentity
+{
+    internal const uint QueryLimitedInformation = 0x1000;
+    private const uint StillActive = 259;
+    private const long FileTimeEpochTicks = 504911232000000000;
+    [StructLayout(LayoutKind.Sequential)]
+    private struct NativeFileTime
+    {
+        public uint Low, High;
+        public readonly ulong Value => ((ulong)High << 32) | Low;
+    }
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern SafeProcessHandle OpenProcess(uint access, [MarshalAs(UnmanagedType.Bool)] bool inherit, uint pid);
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool QueryFullProcessImageNameW(SafeProcessHandle handle, uint flags, StringBuilder name, ref uint size);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetProcessTimes(SafeProcessHandle handle, out NativeFileTime creation, out NativeFileTime exit,
+        out NativeFileTime kernel, out NativeFileTime user);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    [return: MarshalAs(UnmanagedType.Bool)]
+    private static extern bool GetExitCodeProcess(SafeProcessHandle handle, out uint code);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern uint GetProcessId(SafeProcessHandle handle);
+    [DllImport("user32.dll", SetLastError = true)]
+    private static extern uint GetWindowThreadProcessId(nint window, out uint pid);
+    [DllImport("user32.dll")]
+    private static extern nint GetForegroundWindow();
+
+    private static Win32Exception Failure(string phase, string operation)
+    {
+        int code = Marshal.GetLastWin32Error();
+        var error = new Win32Exception(code, phase + ":limited_process_identity:" + operation + ":win32=" + code + ":" + new Win32Exception(code).Message);
+        error.Data["nativeSource"] = "limited_process_identity";
+        error.Data["nativePhase"] = phase;
+        error.Data["nativeOperation"] = operation;
+        return error;
+    }
+    private static uint WindowOwner(nint window, string phase)
+    {
+        if (GetWindowThreadProcessId(window, out uint owner) == 0) throw Failure(phase, "GetWindowThreadProcessId");
+        return owner;
+    }
+    internal static string StartedUtcTicks(ulong creation)
+    {
+        if (creation == 0 || creation > (ulong)(DateTime.MaxValue.Ticks - FileTimeEpochTicks))
+            throw new InvalidOperationException("actual_process_creation_time_invalid");
+        return checked((long)creation + FileTimeEpochTicks).ToString(CultureInfo.InvariantCulture);
+    }
+    internal static void RequireStableLiveWindow(int expectedPid, nint window, uint ownerBefore, uint ownerAfter,
+        nint foregroundBefore, nint foregroundAfter, uint processId, uint codeBefore, uint codeAfter, ulong exitTime)
+    {
+        if (expectedPid <= 0 || window == 0 || ownerBefore != (uint)expectedPid || ownerAfter != (uint)expectedPid
+            || processId != (uint)expectedPid || foregroundBefore != window || foregroundAfter != window
+            || codeBefore != StillActive || codeAfter != StillActive || exitTime != 0)
+            throw new InvalidOperationException("actual_game_PID_HWND_liveness_or_focus_changed_during_limited_query");
+    }
+    internal static InventoryProcessIdentity Query(nint window, int expectedPid, string phase)
+    {
+        if (expectedPid <= 0 || window == 0) throw new InvalidOperationException("actual_game_window_and_PID_required");
+        uint ownerBefore = WindowOwner(window, phase); nint foregroundBefore = GetForegroundWindow();
+        if (ownerBefore != (uint)expectedPid || foregroundBefore != window)
+            throw new InvalidOperationException("actual_game_window_owner_or_focus_changed_before_limited_query");
+        using var handle = OpenProcess(QueryLimitedInformation, false, (uint)expectedPid);
+        if (handle.IsInvalid) throw Failure(phase, "OpenProcess_QUERY_LIMITED_INFORMATION");
+        uint processId = GetProcessId(handle);
+        if (processId == 0) throw Failure(phase, "GetProcessId");
+        if (!GetExitCodeProcess(handle, out uint codeBefore)) throw Failure(phase, "GetExitCodeProcess_before");
+        uint size = 32768; var path = new StringBuilder((int)size);
+        if (!QueryFullProcessImageNameW(handle, 0, path, ref size)) throw Failure(phase, "QueryFullProcessImageNameW");
+        if (!GetProcessTimes(handle, out var creation, out var exit, out _, out _)) throw Failure(phase, "GetProcessTimes");
+        if (!GetExitCodeProcess(handle, out uint codeAfter)) throw Failure(phase, "GetExitCodeProcess_after");
+        uint ownerAfter = WindowOwner(window, phase); nint foregroundAfter = GetForegroundWindow();
+        RequireStableLiveWindow(expectedPid, window, ownerBefore, ownerAfter, foregroundBefore, foregroundAfter,
+            processId, codeBefore, codeAfter, exit.Value);
+        if (size == 0 || path.Length == 0 || !Path.IsPathFullyQualified(path.ToString()))
+            throw new InvalidOperationException("actual_process_executable_path_missing_or_not_absolute");
+        return new(expectedPid, Path.GetFullPath(path.ToString()), StartedUtcTicks(creation.Value));
+    }
+}
