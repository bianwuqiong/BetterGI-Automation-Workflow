+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: anonymous limited-query identity guards; no process launch, capture or input.
+using System;
+using BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+using Xunit;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+public sealed class LimitedInventoryProcessIdentityTests
+{
+    [Fact] public void ActualFileTimeConvertsToExactDecimalUtcTicksWithoutFloatingPoint()
+    {
+        Assert.Equal("638950080000000001", LimitedInventoryProcessIdentity.StartedUtcTicks(134038848000000001));
+        Assert.Throws<InvalidOperationException>(()=>LimitedInventoryProcessIdentity.StartedUtcTicks(0));
+        Assert.Throws<InvalidOperationException>(()=>LimitedInventoryProcessIdentity.StartedUtcTicks(ulong.MaxValue));
+        Assert.Equal(0x1000u,LimitedInventoryProcessIdentity.QueryLimitedInformation);
+    }
+    [Fact] public void BothActualOwnersForegroundAndHandlePidMustRemainBound()
+    {
+        void Check(uint first=17,uint last=17,nint before=29,nint after=29,uint pid=17,uint codeBefore=259,uint codeAfter=259,ulong exit=0)
+            =>LimitedInventoryProcessIdentity.RequireStableLiveWindow(17,29,first,last,before,after,pid,codeBefore,codeAfter,exit);
+        Check();
+        Assert.Throws<InvalidOperationException>(()=>Check(first:18));
+        Assert.Throws<InvalidOperationException>(()=>Check(last:18));
+        Assert.Throws<InvalidOperationException>(()=>Check(before:30));
+        Assert.Throws<InvalidOperationException>(()=>Check(after:30));
+        Assert.Throws<InvalidOperationException>(()=>Check(pid:18));
+        Assert.Throws<InvalidOperationException>(()=>Check(codeBefore:0));
+        Assert.Throws<InvalidOperationException>(()=>Check(codeAfter:1));
+        // A process deliberately exiting with STILL_ACTIVE is still rejected by actual exit time.
+        Assert.Throws<InvalidOperationException>(()=>Check(exit:1));
+    }
+}
