+using BetterGenshinImpact.GameTask.AutoDomain;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CondensedClaimRowFixTests
+{
+    [Theory]
+    [InlineData("使用1个浓缩树脂，获取3次产出",true)]
+    [InlineData("使用1个浓缩树脂,获取3次产出",true)]
+    [InlineData("使用1个浓缩树脂",true)]
+    [InlineData("使用50原石，获取3次产出",false)]
+    [InlineData("使用2个浓缩树脂，获取3次产出",false)]
+    [InlineData("使用1个浓缩树脂，获取3次产出使用原石",false)]
+    public void FullKnownResourceLabelIsRequired(string text,bool expected)=>Assert.Equal(expected,SingleCondensedClaimSafety.FullLabel(text));
+    [Fact]
+    public void OnlySecondCondensedRowButtonCanBeSubmittedOnce()
+    {
+        ClaimTextBox[] header=[new("石化古树",new()),new("请选择激活方式",new())];
+        ClaimTextBox[] rows=[new("使用20个原粹树脂",new(675,475,250,28)),new("使用",new(1230,475,50,28)),
+            new("使用1个浓缩树脂，获取3次产出",new(675,620,350,28)),new("使用",new(1230,620,50,28)),
+            new("使用50原石，获取3次产出",new(675,745,350,28)),new("使用",new(1230,745,50,28))];
+        var a=SingleCondensedClaimSafety.Select(header,rows,1920,1080,1000);
+        var b=SingleCondensedClaimSafety.Select(header,rows,1920,1080,1300);
+        Assert.NotNull(a);Assert.Equal(620,a.Button.Y);
+        var latch=new SingleOriginal20Submission();int clicks=0;
+        Assert.True(latch.Submit(a,b,1400,_=>clicks++));Assert.False(latch.Submit(a,b,1400,_=>clicks++));Assert.Equal(1,clicks);
+        Assert.Null(SingleCondensedClaimSafety.Select(header,[..rows,rows[3]],1920,1080,1300));
+        Assert.Null(SingleCondensedClaimSafety.Select(header,[..rows,rows[2]],1920,1080,1300));
+    }
+}
