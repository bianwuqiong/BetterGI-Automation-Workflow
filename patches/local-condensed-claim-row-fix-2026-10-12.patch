@@ -0,0 +1,63 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+public sealed record CondensedPromptFrame(long ObservedAt,int Width,int Height,SingleOriginal20Proof? ClaimProof,
+    int? OriginalResin,int? CondensedResin,string OriginalRaw,string CondensedRaw,Rect? OriginalIconRect,Rect? CondensedIconRect);
+public sealed record CondensedPromptSnapshot(string Scene,bool ReadOnly,bool Verified,bool MainUiRestored,
+    int? OriginalResin,int? CondensedResin,bool OriginalVerified,bool CondensedVerified,string? ObservedAt,
+    bool TreePromptVerified,bool CondensedRowVerified,string Reason,CondensedPromptFrame? First,CondensedPromptFrame? Second);
+
+public sealed class CondensedRewardPromptSnapshotTask
+{
+    public static string Serialize(CondensedPromptSnapshot result)=>JsonConvert.SerializeObject(result,
+        new JsonSerializerSettings {ContractResolver=new CamelCasePropertyNamesContractResolver()});
+    public async Task<CondensedPromptSnapshot> Start(CancellationToken ct)
+    {
+        CondensedPromptFrame? first=null,second=null;
+        using var timeout=CancellationTokenSource.CreateLinkedTokenSource(ct);timeout.CancelAfter(TimeSpan.FromSeconds(8));
+        try
+        {
+            for(int i=0;i<4;i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var frame=Common.TaskControl.CaptureToRectArea(forceNew:true);
+                if(!SystemControl.IsGenshinImpactActiveByProcess())break;
+                second=ReadFrame(frame,OcrFactory.Paddle,DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
+                timeout.Token.ThrowIfCancellationRequested();
+                if(Pair(first,second,DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()))return Result(true,"complete_condensed_row_and_header_balance_pair");
+                first=second;await Task.Delay(250,timeout.Token);
+            }
+            return Result(false,"complete_reward_prompt_or_balances_unverified");
+        }
+        catch(OperationCanceledException) when(!ct.IsCancellationRequested){return Result(false,"observation_timeout");}
+        catch(OperationCanceledException){throw;}
+        catch(Exception ex){return Result(false,"observation_failed:"+ex.GetType().Name);}
+        CondensedPromptSnapshot Result(bool verified,string reason)=>new("reward-prompt",true,verified,false,
+            verified?second!.OriginalResin:null,verified?second!.CondensedResin:null,verified,verified,
+            verified?DateTimeOffset.FromUnixTimeMilliseconds(second!.ObservedAt).ToString("O"):null,
+            verified,verified,reason,first,second);
+    }
+    public static bool Pair(CondensedPromptFrame? first,CondensedPromptFrame? second,long now)=>
+        first is not null && second is not null && SingleOriginal20ClaimSafety.Matching(first.ClaimProof,second.ClaimProof,now) &&
+        first.OriginalResin is >=0 and <=200 && first.OriginalResin==second.OriginalResin &&
+        first.CondensedResin is >=1 and <=5 && first.CondensedResin==second.CondensedResin;
+    internal static CondensedPromptFrame ReadFrame(ImageRegion frame,IOcrService ocr,long at)
+    {
+        var proof=AutoDomainTask.ReadSingleCondensedProof(frame,at,ocr);
+        Rect Search(double left,double right)=>new((int)(frame.Width*left),0,(int)(frame.Width*(right-left)),frame.Height/8);
+        // The reward header also contains fragile resin and primogems. Their columns are excluded.
+        var original=ReadResinSnapshotTask.ReadCount(frame,"original_resin.png",true,ocr,Search(.70,.82));
+        var condensed=ReadResinSnapshotTask.ReadCount(frame,"condensed_resin.png",false,ocr,Search(.61,.70));
+        return new(at,frame.Width,frame.Height,proof,original.Value,condensed.Value,original.Raw,condensed.Raw,
+            original.IconRect,condensed.IconRect);
+    }
+}
