diff --git a/BetterGenshinImpact/GameTask/AutoDomain/CondensedRewardPromptSnapshotTask.cs b/BetterGenshinImpact/GameTask/AutoDomain/CondensedRewardPromptSnapshotTask.cs
new file mode 100644
--- /dev/null
