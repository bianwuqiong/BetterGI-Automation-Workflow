+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CondensedClaimPrivateImageTests(ITestOutputHelper output)
+{
+    [Theory]
+    [Trait("Fixture","PrivateCondensedReward")]
+    [InlineData(0)]
+    [InlineData(1)]
+    public void RetainedSceneUsesProductionCondensedRowAndRestrictedHeaderReader(int index)
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_CONDENSED_REWARD_MANIFEST");
+        Assert.False(string.IsNullOrWhiteSpace(path),"Private manifest required; missing fixtures cannot pass.");
+        var fixtures=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture[]>(File.ReadAllText(path!))!;
+        Assert.Equal(2,fixtures.Length);var f=fixtures[index];
+        Assert.True(f.Original.HasValue);Assert.True(f.Condensed.HasValue);Assert.Equal(4,f.ClientRect.Length);
+        using var image=Cv2.ImRead(f.File);using var client=new Mat(image,new Rect(f.ClientRect[0],f.ClientRect[1],f.ClientRect[2],f.ClientRect[3]));
+        using var ocr=new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),PaddleOcrService.PaddleOcrModelType.V6);
+        foreach(var width in new[]{1536,1920})
+        {
+            using var full=new Mat();Cv2.Resize(client,full,new Size(width,width*9/16));using var capture=new ImageRegion(full.Clone(),0,0);
+            var frame=CondensedRewardPromptSnapshotTask.ReadFrame(capture,ocr,1000);
+            output.WriteLine(Newtonsoft.Json.JsonConvert.SerializeObject(frame));
+            Assert.NotNull(frame.ClaimProof);Assert.Equal(f.Original,frame.OriginalResin);Assert.Equal(f.Condensed,frame.CondensedResin);
+            Assert.True(CondensedRewardPromptSnapshotTask.Pair(frame,frame with {ObservedAt=1300,ClaimProof=frame.ClaimProof! with {ObservedAt=1300}},1400));
+        }
+    }
+    private sealed class Fixture {public string File {get;set;}="";public int[] ClientRect {get;set;}=[];public int? Original {get;set;}public int? Condensed {get;set;}}
+}
