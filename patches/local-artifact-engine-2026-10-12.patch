+using System;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+public static class ArtifactClaimObservation
+{
+    public static void ValidateCorrelation(string runId, string stepId)
+    {
+        static bool Valid(string value) => value.Length is >= 1 and <= 128 &&
+            System.Text.RegularExpressions.Regex.IsMatch(value, @"\A[A-Za-z0-9_.:-]+\z");
+        if (string.IsNullOrEmpty(runId) && string.IsNullOrEmpty(stepId)) return;
+        if (runId is null || stepId is null || !Valid(runId) || !Valid(stepId))
+            throw new ArgumentException("Artifact run and step correlation must both be bounded safe identifiers.");
+    }
+}
