@@ -0,0 +1,45 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+/// <summary>One condensed claim; shares the existing one-click latch and protected exit protocol.</summary>
+public static class SingleCondensedClaimSafety
+{
+    public static bool Applies(SingleOriginal20Contract c) => c.RequireShield && !c.CombatOnly &&
+        c.Rounds == 1 && c.Specify && c.Original20 == 0 && c.LegacyOriginal == 0 &&
+        c.Original40 == 0 && c.Condensed == 1 && c.Transient == 0 && c.Fragile == 0 &&
+        c.Priority is { Length: 1 } && c.Priority[0] == "浓缩树脂";
+
+    public static Rect RowsRect(int width, int height) =>
+        new((int)(width * .25), (int)(height * .39), (int)(width * .5), (int)(height * .34));
+
+    public static SingleOriginal20Proof? Select(IEnumerable<ClaimTextBox> header,
+        IEnumerable<ClaimTextBox> rows, int width, int height, long observedAt)
+    {
+        if (width < 800 || width * 9 != height * 16 || observedAt < 0 ||
+            !SingleOriginal20ClaimSafety.PromptHeader(header)) return null;
+        var all = rows.ToArray();
+        var labels = all.Where(t => SingleOriginal20ClaimSafety.Normalize(t.Text) == "使用1个浓缩树脂").ToArray();
+        if (labels.Length != 1) return null;
+        var label = labels[0].Bounds;
+        var scale = width / 1920d;
+        var buttons = all.Where(t => SingleOriginal20ClaimSafety.Normalize(t.Text) == "使用" &&
+            Math.Abs(t.Bounds.Y + t.Bounds.Height / 2d - label.Y - label.Height / 2d) <= 20 * scale).ToArray();
+        if (buttons.Length != 1) return null;
+        var button = buttons[0].Bounds;
+        var band = RowsRect(width, height);
+        static bool Inside(Rect r, Rect b) => r.Width > 0 && r.Height > 0 &&
+            r.Left >= b.Left && r.Top >= b.Top && r.Right <= b.Right && r.Bottom <= b.Bottom;
+        if (!Inside(label, band) || !Inside(button, band) || label.Right > 1100 * scale ||
+            label.Width > 500 * scale || label.Height > 60 * scale || button.Left < 1150 * scale ||
+            button.Right > 1370 * scale || button.Width > 150 * scale || button.Height > 60 * scale) return null;
+        // A merged or conflicting resource line cannot authorize the selected row.
+        if (all.Any(t => t != labels[0] && Math.Abs(t.Bounds.Y + t.Bounds.Height / 2d - label.Y - label.Height / 2d) <= 20 * scale &&
+            new[] { "树脂", "原石", "脆弱", "须臾" }.Any(s => SingleOriginal20ClaimSafety.Normalize(t.Text).Contains(s, StringComparison.Ordinal))))
+            return null;
+        return new SingleOriginal20Proof(label, button, width, observedAt);
+    }
+}
