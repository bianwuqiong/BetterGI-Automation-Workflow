+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoDomainTests;
+
+public class SingleCondensedClaimSafetyTests
+{
+    private static readonly ClaimTextBox[] Header = [new("石化古树", new()), new("请选择激活方式", new())];
+    private static readonly ClaimTextBox[] Rows = [new("使用20个原粹树脂", new(680, 470, 300, 35)), new("使用", new(1220, 470, 50, 35)),
+        new("使用1个浓缩树脂", new(680, 590, 300, 35)), new("使用", new(1220, 590, 50, 35))];
+    private static SingleOriginal20Contract Contract() => new(true, false, 1, true, 0, 0, 0, 1, 0, 0, ["浓缩树脂"]);
+
+    [Fact]
+    public void ExactOneCondensedContractDoesNotUseOriginalContract()
+    {
+        Assert.True(SingleCondensedClaimSafety.Applies(Contract()));
+        Assert.False(SingleOriginal20ClaimSafety.Applies(Contract()));
+        foreach (var other in new[] { Contract() with { RequireShield = false }, Contract() with { CombatOnly = true },
+            Contract() with { Rounds = 2 }, Contract() with { Specify = false }, Contract() with { Original20 = 1 },
+            Contract() with { LegacyOriginal = 1 }, Contract() with { Original40 = 1 }, Contract() with { Condensed = 2 },
+            Contract() with { Transient = 1 }, Contract() with { Fragile = 1 }, Contract() with { Priority = ["浓缩树脂", "原粹树脂"] } })
+            Assert.False(SingleCondensedClaimSafety.Applies(other));
+    }
+
+    [Fact]
+    public void SelectsOnlyTheCondensedRowThenSharesOneSubmissionLatch()
+    {
+        var first = SingleCondensedClaimSafety.Select(Header, Rows, 1920, 1080, 1000);
+        var second = SingleCondensedClaimSafety.Select(Header, Rows, 1920, 1080, 1300);
+        Assert.NotNull(first);
+        Assert.Equal(590, first.Button.Y);
+        var latch = new SingleOriginal20Submission();
+        var clicks = new List<Rect>();
+        Assert.True(latch.Submit(first, second, 1400, clicks.Add));
+        Assert.False(latch.Submit(first, second, 1400, clicks.Add));
+        Assert.Single(clicks);
+    }
+
+    [Theory]
+    [InlineData("使用浓缩树脂")]
+    [InlineData("使用2个浓缩树脂")]
+    [InlineData("使用1个浓缩树脂原石")]
+    [InlineData("使用1个浓缩树脂使用")]
+    public void IncompleteOrMergedLabelsNeverAuthorize(string text)
+    {
+        var rows = Rows.ToArray(); rows[2] = rows[2] with { Text = text };
+        Assert.Null(SingleCondensedClaimSafety.Select(Header, rows, 1920, 1080, 1000));
+    }
+
+    [Fact]
+    public void ConflictingOrDuplicateButtonsAndMissingHeaderNeverAuthorize()
+    {
+        Assert.Null(SingleCondensedClaimSafety.Select([], Rows, 1920, 1080, 1000));
+        Assert.Null(SingleCondensedClaimSafety.Select(Header, [.. Rows, Rows[3]], 1920, 1080, 1000));
+        Assert.Null(SingleCondensedClaimSafety.Select(Header, [.. Rows, new("原石", new(1000, 590, 50, 35))], 1920, 1080, 1000));
+        var shifted = Rows.ToArray(); shifted[3] = shifted[3] with { Bounds = new(1220, 655, 50, 35) };
+        Assert.Null(SingleCondensedClaimSafety.Select(Header, shifted, 1920, 1080, 1000));
+    }
+}
