+using System;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+public sealed record CondensedCraftResult(string Status, int OriginalResinBefore, int OriginalResinAfter,
+    int CondensedResinBefore, int CondensedResinAfter, int CondensedResinCreated, int OriginalResinSpent,
+    bool MainUiRestored, int RecipeOriginalResinCost = 60, bool RecipeCostVerified = false,
+    int SafeCondensedCapacity = 5, bool CondensedCapacityObserved = false);
+
+public static class CondensedCraftPolicy
+{
+    public static bool HasExactRecipeCost60(string raw) =>
+        System.Text.RegularExpressions.Regex.IsMatch(
+            BetterGenshinImpact.Helpers.StringUtils.ConvertFullWidthNumToHalfWidth(raw).Replace('／', '/'),
+            @"\A\s*\d{1,3}\s*/\s*60\s*\z");
+
+    public static void Validate(string country, int maxCrafts, int originalResinBudget, int minResinToKeep)
+    {
+        if (country is not ("蒙德" or "璃月")) throw new ArgumentException("合成台仅支持蒙德或璃月。", nameof(country));
+        if (maxCrafts is < 1 or > 5) throw new ArgumentOutOfRangeException(nameof(maxCrafts));
+        if (originalResinBudget is < 0 or > 200) throw new ArgumentOutOfRangeException(nameof(originalResinBudget));
+        if (minResinToKeep is < 0 or > 200) throw new ArgumentOutOfRangeException(nameof(minResinToKeep));
+    }
+}
