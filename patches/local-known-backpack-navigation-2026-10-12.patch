+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: exact known backpack pages for navigation/cleanup only; no inventory reader routes.
+using System;
+using System.Linq;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed record InventoryBackpackTabMatch(string ObjectName, double Threshold, BackpackRect Match);
+public sealed record InventoryKnownBackpackProof(long ObservedAt, int Width, int Height, string TabObjectName,
+    BackpackRect HeaderRegion, BackpackOcrRow[] HeaderRows, InventoryBackpackTabMatch[] SelectedTabMatches,
+    bool Focused, bool PromptVisible, bool NegativeSceneAnchorsAbsent);
+
+internal static class KnownBackpackNavigation
+{
+    // Exact upstream GridScreenName descriptions and existing Recognition.json Checked objects.
+    // The development page retains the two already reviewed complete-title variants.
+    private static readonly (string Tab, string[] Headers)[] Pages = [
+        ("BagWeaponChecked", ["武器"]), ("BagArtifactChecked", ["圣遗物"]),
+        ("BagCharacterDevelopmentItemChecked", ["角色培养道具", "养成道具"]),
+        ("BagFoodChecked", ["食物"]), ("BagMaterialChecked", ["材料"]),
+        ("BagGadgetChecked", ["小道具"]), ("BagQuestChecked", ["任务"]),
+        ("BagPreciousItemChecked", ["贵重道具"]), ("BagFurnishingChecked", ["摆设"])
+    ];
+    internal static bool Prompt(ImageRegion image)
+    {
+        using var confirm = image.Find(ElementRecognition.Get("BtnBlackConfirm", image));
+        return Bv.IsInPromptDialog(image) || Bv.IsInRevivePrompt(image) || confirm.IsExist();
+    }
+    internal static bool HeaderVerified(BackpackOcrRow[] rows, BackpackRect region, string tab)
+    {
+        var page = Pages.SingleOrDefault(p => p.Tab == tab);
+        if (page.Headers is null || rows.Length == 0) return false;
+        var exact = rows.Where(r => page.Headers.Contains(BackpackInventoryEvidenceSafety.Normalize(r.Text), StringComparer.Ordinal)).ToArray();
+        int allKnownHeaders = rows.Count(r => Pages.Any(p => p.Headers.Contains(BackpackInventoryEvidenceSafety.Normalize(r.Text), StringComparer.Ordinal)));
+        double margin = 2 * region.Width / 350d;
+        return rows.All(r => BackpackInventoryEvidenceSafety.Inside(new(r.X, r.Y, r.Width, r.Height), region))
+            && exact.Length == 1 && allKnownHeaders == 1 && exact[0].Width > 0 && exact[0].Height > 0
+            && exact[0].X - region.X >= margin && exact[0].Y - region.Y >= margin
+            && region.X + region.Width - exact[0].X - exact[0].Width >= margin
+            && region.Y + region.Height - exact[0].Y - exact[0].Height >= margin;
+    }
+    internal static bool Verified(InventoryKnownBackpackProof? proof)
+    {
+        if (proof is null || proof.ObservedAt < 0 || proof.Width != 1920 || proof.Height != 1080
+            || !proof.Focused || proof.PromptVisible || !proof.NegativeSceneAnchorsAbsent
+            || proof.HeaderRegion != WeeklyConversionInventoryEvidence.HeaderRect(proof.Width)
+            || proof.SelectedTabMatches.Length != Pages.Length) return false;
+        for (int i = 0; i < Pages.Length; i++)
+        {
+            var match = proof.SelectedTabMatches[i];
+            if (match.ObjectName != Pages[i].Tab || match.Threshold != .8
+                || (match.Match != new BackpackRect(0, 0, 0, 0) && (match.Match.Width <= 0 || match.Match.Height <= 0
+                    || !BackpackInventoryEvidenceSafety.Inside(match.Match, new(0, 0, proof.Width, proof.Height))))) return false;
+        }
+        var selected = proof.SelectedTabMatches.Where(m => m.Match.Width > 0 && m.Match.Height > 0).ToArray();
+        return selected.Length == 1 && selected[0].ObjectName == proof.TabObjectName
+            && HeaderVerified(proof.HeaderRows, proof.HeaderRegion, proof.TabObjectName);
+    }
+    internal static bool CleanupPair(InventoryKnownBackpackProof? first, InventoryKnownBackpackProof? second) =>
+        !ReferenceEquals(first, second) && Verified(first) && Verified(second)
+        && first!.TabObjectName == second!.TabObjectName && second.ObservedAt > first.ObservedAt
+        && second.ObservedAt - first.ObservedAt <= 5000;
+    internal static InventoryKnownBackpackProof? Read(ImageRegion image, long observedAt, InventoryWorldProof world)
+    {
+        bool active = SystemControl.IsGenshinImpactActiveByProcess(), prompt = Prompt(image);
+        bool negativeAbsent = world.Width == image.Width && world.Height == image.Height && world.ObservedAt == observedAt
+            && world.Anchors.Length == 6 && world.Anchors.Skip(1).All(a => a.Match == new BackpackRect(0, 0, 0, 0));
+        if (!active || prompt || !negativeAbsent || image.Width != 1920 || image.Height != 1080) return null;
+        var matches = Pages.Select(page => {
+            var ro = ElementRecognition.Get(page.Tab, image); using var selected = image.Find(ro);
+            return new InventoryBackpackTabMatch(page.Tab, ro.Threshold,
+                selected.IsExist() ? new(selected.X, selected.Y, selected.Width, selected.Height) : new(0, 0, 0, 0));
+        }).ToArray();
+        var picked = matches.Where(m => m.Match.Width > 0 && m.Match.Height > 0).ToArray();
+        if (picked.Length != 1) return null;
+        var box = WeeklyConversionInventoryEvidence.HeaderRect(image.Width); using var crop = image.DeriveCrop(box.ToRect());
+        var rows = StrictInventoryOcrSession.Current.OcrResult(crop.SrcMat).Regions.Select(r => {
+            var b = r.Rect.BoundingRect(); return new BackpackOcrRow(r.Text, b.X + box.X, b.Y + box.Y, b.Width, b.Height);
+        }).ToArray();
+        var proof = new InventoryKnownBackpackProof(observedAt, image.Width, image.Height, picked[0].ObjectName,
+            box, rows, matches, active, prompt, negativeAbsent);
+        return Verified(proof) ? proof : null;
+    }
+    internal static InventoryKnownBackpackProof? For(InventoryCapturedImage shot) => shot.KnownBackpack;
+}
