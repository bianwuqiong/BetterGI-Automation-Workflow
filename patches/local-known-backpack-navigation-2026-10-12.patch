@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: exact known-page navigation/cleanup guards; anonymous pure cases only.
+using System;
+using System.Linq;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+using Xunit;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+public sealed class KnownBackpackNavigationTests
+{
+    private static readonly string[] Tabs=["BagWeaponChecked","BagArtifactChecked","BagCharacterDevelopmentItemChecked",
+        "BagFoodChecked","BagMaterialChecked","BagGadgetChecked","BagQuestChecked","BagPreciousItemChecked","BagFurnishingChecked"];
+    private static InventoryKnownBackpackProof Proof(string tab="BagWeaponChecked",string title="武器",long at=1000)=>new(at,1920,1080,tab,
+        WeeklyConversionInventoryEvidence.HeaderRect(1920),[new(title,120,30,160,25)],
+        Tabs.Select(t=>new InventoryBackpackTabMatch(t,.8,t==tab?new(600,20,40,40):new(0,0,0,0))).ToArray(),true,false,true);
+    [Theory]
+    [InlineData("BagWeaponChecked","武器")]
+    [InlineData("BagArtifactChecked","圣遗物")]
+    [InlineData("BagCharacterDevelopmentItemChecked","养成道具")]
+    [InlineData("BagCharacterDevelopmentItemChecked","角色培养道具")]
+    [InlineData("BagFoodChecked","食物")]
+    [InlineData("BagMaterialChecked","材料")]
+    [InlineData("BagGadgetChecked","小道具")]
+    [InlineData("BagQuestChecked","任务")]
+    [InlineData("BagPreciousItemChecked","贵重道具")]
+    [InlineData("BagFurnishingChecked","摆设")]
+    public void ExactSelectedPageCanBeKnownForNavigationOnly(string tab,string title)=>Assert.True(KnownBackpackNavigation.Verified(Proof(tab,title)));
+    [Fact] public void PartialMismatchedAmbiguousOrClippedHeaderNeverAuthorizesNavigation()
+    {
+        foreach(var title in new[]{"武","武器详情","任务道具","贵重道具","","登录"})
+            Assert.False(KnownBackpackNavigation.Verified(Proof(title:title)));
+        var p=Proof();var row=p.HeaderRows[0];
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row,row]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row,new("圣遗物",120,60,160,25)]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row with{X=p.HeaderRegion.X+1}]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row with{Y=p.HeaderRegion.Y+1}]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row with{X=p.HeaderRegion.X+p.HeaderRegion.Width-row.Width-1}]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRows=[row with{Y=p.HeaderRegion.Y+p.HeaderRegion.Height-row.Height-1}]}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{HeaderRegion=new(0,0,350,100)}));
+    }
+    [Fact] public void MissingOrMultipleSelectionFocusPromptAndNegativeSceneAreRejected()
+    {
+        var p=Proof();
+        Assert.False(KnownBackpackNavigation.Verified(p with{Focused=false}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{PromptVisible=true}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{NegativeSceneAnchorsAbsent=false}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{Width=1280,Height=720}));
+        Assert.False(KnownBackpackNavigation.Verified(p with{SelectedTabMatches=p.SelectedTabMatches[..8]}));
+        var two=p.SelectedTabMatches.ToArray();two[1]=two[1] with{Match=new(650,20,40,40)};
+        Assert.False(KnownBackpackNavigation.Verified(p with{SelectedTabMatches=two}));
+        var none=p.SelectedTabMatches.ToArray();none[0]=none[0] with{Match=new(0,0,0,0)};
+        Assert.False(KnownBackpackNavigation.Verified(p with{SelectedTabMatches=none}));
+        var threshold=p.SelectedTabMatches.ToArray();threshold[0]=threshold[0] with{Threshold=.79};
+        Assert.False(KnownBackpackNavigation.Verified(p with{SelectedTabMatches=threshold}));
+    }
+    [Fact] public void CleanupRequiresIndependentFreshSamePagePairAndOriginalOnceEscapeGate()
+    {
+        var a=Proof();var b=Proof(at:1200);
+        Assert.True(KnownBackpackNavigation.CleanupPair(a,b));
+        Assert.False(KnownBackpackNavigation.CleanupPair(a,a));
+        Assert.False(KnownBackpackNavigation.CleanupPair(a,Proof(at:1000)));
+        Assert.False(KnownBackpackNavigation.CleanupPair(a,Proof(at:6001)));
+        Assert.False(KnownBackpackNavigation.CleanupPair(a,Proof("BagPreciousItemChecked","贵重道具",1200)));
+        Assert.False(KnownBackpackNavigation.CleanupPair(a,b with{PromptVisible=true}));
+        Assert.True(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,true,false,false));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,true,false,true));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(false,true,false,false));
+        Assert.Throws<ArgumentException>(()=>WeeklyInventoryCatalog.Grid("weapons"));
+        Assert.Throws<ArgumentException>(()=>WeeklyInventoryCatalog.TabPrefix("food"));
+    }
+}
