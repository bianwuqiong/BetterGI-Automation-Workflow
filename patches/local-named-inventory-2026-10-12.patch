+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: fresh CPU sessions from actual pinned original OCR assets, no singleton/cache reuse.
+using System;
+using System.IO;
+using System.Security.Cryptography;
+using System.Threading;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed record StrictInventoryModelEvidence(string LoadMethod,string Provider,string RawModel,string DetectorModel,
+    NamedCountModelEvidence CountModels,NamedOcrModelAsset RawDetectorAsset);
+
+public static class StrictInventoryModelValidation
+{
+    public static bool Verified(StrictInventoryModelEvidence? e)=>e is not null&&
+        e.LoadMethod=="new_cpu_uncached_original_onnx_and_labels_under_read_pins"&&e.Provider=="Cpu"&&e.RawModel=="V6"&&e.DetectorModel=="V4"&&
+        NamedCountModelPin.Verified(e.CountModels)&&e.RawDetectorAsset.ModelName==BgiOnnxModel.PaddleOcrDetV6.Name&&
+        e.RawDetectorAsset.RelativePath==BgiOnnxModel.PaddleOcrDetV6.ModelRelativePath.Replace('\\','/')&&
+        e.RawDetectorAsset.Length>0&&e.RawDetectorAsset.Sha256.Length==64&&System.Linq.Enumerable.All(e.RawDetectorAsset.Sha256,Uri.IsHexDigit);
+}
+
+internal sealed class StrictInventoryOcrSession:IDisposable
+{
+    private static readonly AsyncLocal<StrictInventoryOcrSession?> Ambient=new();
+    internal static IOcrService Current=>Ambient.Value is {disposed:false} current?current.Raw:
+        throw new InvalidOperationException("actual_pinned_inventory_ocr_session_required");
+    internal NamedCountModelPin CountPin{get;}
+    internal PaddleOcrService Raw{get;}internal PaddleOcrService Detector{get;}
+    internal StrictInventoryModelEvidence Evidence{get;}
+    private readonly FileStream extra;private bool disposed;
+    internal StrictInventoryOcrSession()
+    {
+        if(Ambient.Value is {disposed:false})throw new InvalidOperationException("nested_strict_inventory_ocr_scope_not_allowed");
+        CountPin=new NamedCountModelPin();
+        FileStream? opened=null;PaddleOcrService? raw=null,detector=null;
+        try
+        {
+            var model=BgiOnnxModel.PaddleOcrDetV6;
+            opened=File.Open(model.ModalPath,FileMode.Open,FileAccess.Read,FileShare.Read);
+            var proof=new NamedOcrModelAsset(model.Name,model.ModelRelativePath.Replace('\\','/'),Convert.ToHexString(SHA256.HashData(opened)),opened.Length);opened.Position=0;
+            var factory=new BgiOnnxFactory(App.GetLogger<BgiOnnxFactory>(),true);
+            raw=new PaddleOcrService(factory,PaddleOcrService.PaddleOcrModelType.V6);
+            detector=new PaddleOcrService(factory,PaddleOcrService.PaddleOcrModelType.V4);
+            Raw=raw;Detector=detector;extra=opened;
+            Evidence=new("new_cpu_uncached_original_onnx_and_labels_under_read_pins","Cpu","V6","V4",CountPin.Evidence,proof);
+            Ambient.Value=this;
+        }
+        catch{try{detector?.Dispose();}finally{try{raw?.Dispose();}finally{try{opened?.Dispose();}finally{CountPin.Dispose();}}}throw;}
+    }
+    public void Dispose(){if(disposed)return;disposed=true;if(ReferenceEquals(Ambient.Value,this))Ambient.Value=null;
+        try{Raw.Dispose();}finally{try{Detector.Dispose();}finally{try{extra.Dispose();}finally{CountPin.Dispose();}}}}
+}
