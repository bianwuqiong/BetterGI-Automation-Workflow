+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: actual synchronous inventory capture contracts; no consumption dependencies.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+/// <summary>Borrowed actual frame. The provider owns actual acquisition and native lifecycle checks.</summary>
+internal sealed class InventoryCapturedImage(ImageRegion image, IDisposable owner, JObject actualCapture,
+    InspectionPrivateCapture originalPixels) : IDisposable
+{
+    public ImageRegion Image { get; } = image;
+    public JObject ActualCapture { get; } = (JObject)actualCapture.DeepClone();
+    public InspectionPrivateCapture OriginalPixels { get; } = originalPixels;
+    internal InventoryWorldProof? WorldEvidence { get; set; }
+    public long ObservedAt => ActualCapture.Value<long>("callReturnedAt");
+    public void Dispose() => owner.Dispose();
+}
+
+public sealed record InventoryBoundRawFrame(string Phase, long ObservedAt, JObject ActualCapture,
+    InspectionPrivateCapture PrivateCapture, JObject Recognized)
+{ public InventoryWorldProof? WorldEvidence { get; init; } }
+
+/// <summary>No default TaskControl/Now fallback. Passed only by trusted native construction.</summary>
+internal sealed class InventoryCaptureSource(Func<CancellationToken, InventoryCapturedImage> capture,
+    Action assertActualBinding, JObject actualBinding, string captureSession)
+{
+    public JObject Binding { get; } = (JObject)actualBinding.DeepClone();
+    public string CaptureSession { get; } = captureSession;
+    public void AssertCurrent() => assertActualBinding();
+    public void AssertFresh(long actualReturnedAt)
+    {
+        AssertCurrent();long now=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+        if(!InventoryCaptureEvidence.FreshForInput(actualReturnedAt,now))throw new InvalidOperationException("bound_inventory_page_capture_stale_before_input");
+    }
+    public InventoryCapturedImage Capture(CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested(); AssertCurrent(); var shot = capture(ct);
+        try
+        {
+            AssertCurrent(); ct.ThrowIfCancellationRequested();
+            if (shot.Image.Width != 1920 || shot.Image.Height != 1080 ||
+                !InventoryCaptureEvidence.Frame(shot.ActualCapture, shot.OriginalPixels, Binding, 0, long.MaxValue))
+                throw new InvalidOperationException("actual_synchronous_bound_inventory_capture_required");
+            return shot;
+        }
+        catch { shot.Dispose(); throw; }
+    }
+}
+
+public static class InventoryCaptureEvidence
+{
+    public static bool FreshForInput(long actualReturnedAt,long now)=>actualReturnedAt>=0&&now>=actualReturnedAt&&now-actualReturnedAt<=1500;
+    private static long? Integer(JToken? token) => token?.Type == JTokenType.Integer ? token.Value<long>() : null;
+    public static bool Frame(JObject proof, InspectionPrivateCapture pixels, JObject actualBinding, long start, long finish)
+    {
+        var began = Integer(proof["callStartedAt"]); var returned = Integer(proof["callReturnedAt"]);
+        var rectangle = actualBinding["captureRectangle"] as JObject;
+        return start >= 0 && finish >= start && began.HasValue && returned.HasValue && began >= start && returned >= began
+            && returned <= finish && returned - began <= 5000 && pixels.ObservedAt == returned
+            && Integer(proof["nativeWidth"]) == 1920 && Integer(proof["nativeHeight"]) == 1080
+            && pixels.Width == 1920 && pixels.Height == 1080 && pixels.PixelType == "CV_8UC3"
+            && proof.Value<string>("pixelType") == "CV_8UC3"
+            && proof.Value<string>("freshnessSource") == "BitBltSession.GetImage_executes_BitBlt_GdiFlush_new_buffer_each_call"
+            && actualBinding.Value<string>("captureMethod") == "actual_synchronous_BitBltCapture"
+            && Integer(actualBinding["processId"]) > 0 && Integer(actualBinding["windowHandle"]) > 0
+            && actualBinding["processStartedUtcTicks"]?.Type==JTokenType.String&&long.TryParse(actualBinding.Value<string>("processStartedUtcTicks"),out var startedTicks)&&startedTicks>0 && rectangle is not null
+            && actualBinding["backendGeneration"]?.Type==JTokenType.String&&long.TryParse(actualBinding.Value<string>("backendGeneration"),out var generation)&&generation>0
+            && Guid.TryParseExact(actualBinding.Value<string>("systemInfoGeneration"),"N",out _)
+            && Guid.TryParseExact(actualBinding.Value<string>("backendAssemblyMvid"),"N",out _)
+            && !string.IsNullOrWhiteSpace(actualBinding.Value<string>("executablePath"))
+            && Integer(rectangle["width"]) == 1920 && Integer(rectangle["height"]) == 1080
+            && JToken.DeepEquals(proof["binding"], actualBinding)
+            && JToken.DeepEquals(proof["returnedRectangle"], actualBinding["captureRectangle"])
+            && pixels.Source == "diagnostic_only_lossless_native_srcmat_no_resize"
+            && !string.IsNullOrWhiteSpace(pixels.Path)
+            && new[] { pixels.PngSha256, pixels.NativePixelsSha256 }.All(s => s.Length == 64 && s.All(Uri.IsHexDigit));
+    }
+    public static bool Timeline(IReadOnlyList<InventoryBoundRawFrame> frames, JObject binding, long start, long finish)
+    {
+        if (frames.Count is < 1 or > 2048) return false;
+        long previousReturn = -1;
+        foreach (var frame in frames)
+        {
+            if (!Frame(frame.ActualCapture, frame.PrivateCapture, binding, start, finish)
+                || frame.ObservedAt != Integer(frame.ActualCapture["callReturnedAt"])
+                || frame.ObservedAt <= previousReturn || Integer(frame.ActualCapture["callStartedAt"]) < previousReturn) return false;
+            previousReturn = frame.ObservedAt;
+        }
+        return true;
+    }
+}
