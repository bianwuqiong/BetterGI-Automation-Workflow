+            int end = vertical ? item.Y + (int)(item.Height * .75) : item.X + (int)(item.Width * .55), stride = Math.Max(1, (end - begin) / 12);
+            var pixels = Enumerable.Range(0, end - begin).Where(p => p % stride == 0).Select(p => new BackpackBorderPixel(vertical ? edge : begin + p, vertical ? begin + p : edge, 240, 240, 240)).ToArray();
+            sides.Add(new(vertical ? "x" : "y", edge, end - begin, end - begin, pixels));
