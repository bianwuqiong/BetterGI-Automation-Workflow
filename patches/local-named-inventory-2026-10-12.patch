+using BetterGenshinImpact.Core.Config;
+using Microsoft.VisualBasic.FileIO;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed record RuntimeCatalogAsset(string RelativePath, long ByteLength, string Sha256);
+public sealed record RuntimeCatalogVersion(RuntimeCatalogAsset Csv, RuntimeCatalogAsset Model,
+    string ParserVersion = "named-cultivation-catalog-1");
+public sealed record RuntimeMaterialRow(int CsvRowNumber, string VariantId, string ItemClassId,
+    string MaterialId, string FullName, string MaterialType, int QualityLevel, string RowSha256,
+    int EmbeddingByteLength);
+public sealed record ResolvedNamedMaterial(string MaterialId, string MaterialName, string Category,
+    string Purpose, RuntimeMaterialRow CsvRow, RuntimeCatalogVersion CatalogVersion);
+
+/// <summary>Actual CSV pairs admit names/IDs; prefixes alone never admit a request.</summary>
+public sealed class RuntimeCultivationCatalog
+{
+    private readonly RuntimeMaterialRow[] rows;
+    public RuntimeCatalogVersion Version { get; }
+    internal RuntimeCultivationCatalog(RuntimeMaterialRow[] rows, RuntimeCatalogVersion version)
+    { this.rows = rows; Version = version; }
+    internal RuntimeMaterialRow ResolveMora()
+    {
+        var matched=rows.Where(r=>r.ItemClassId=="material:202"&&r.FullName=="摩拉").ToArray();
+        if(matched.Length==0||rows.Any(r=>r.FullName=="摩拉"&&r.ItemClassId!="material:202")||
+            matched.Any(r=>r.EmbeddingByteLength<=0))throw new InvalidDataException("actual_runtime_mora_material202_identity_unverified");
+        return matched[0];
+    }
+
+    public ResolvedNamedMaterial Resolve(BackpackMaterial requested)
+    {
+        if (requested is null || !Regex.IsMatch(requested.MaterialId ?? "", @"\A(?:104|112|113|114)[0-9]{3}\z")
+            || string.IsNullOrWhiteSpace(requested.MaterialName) || requested.MaterialName != requested.MaterialName.Trim()
+            || requested.MaterialName.Length > 80 || requested.MaterialName.Any(char.IsControl))
+            throw new ArgumentException("bounded_exact_cultivation_ID_and_full_name_required");
+        var classId = "material:" + requested.MaterialId;
+        var matched = rows.Where(r => r.ItemClassId == classId).ToArray();
+        if (matched.Length == 0 || matched.Any(r => r.FullName != requested.MaterialName)
+            || matched.Select(r => (r.FullName, r.MaterialType, r.QualityLevel)).Distinct().Count() != 1)
+            throw new ArgumentException("runtime_CSV_material_ID_full_name_pair_missing_or_conflicting");
+        // ItemRecognizer currently groups by Name. Reject any global CSV cross-class/ID
+        // collision, so its name-only candidate cannot masquerade as the requested ID.
+        if (rows.Any(r => r.FullName == requested.MaterialName && r.ItemClassId != classId))
+            throw new ArgumentException("runtime_CSV_name_ambiguous_across_material_ID_or_item_class");
+        var row = matched[0];
+        if (row.EmbeddingByteLength <= 0 || row.QualityLevel is < 1 or > 5)
+            throw new ArgumentException("runtime_CSV_recognizer_material_prototype_missing");
+        string purpose = requested.MaterialId[..3] switch {
+            "104" when row.MaterialType == "角色天赋素材" => "talentBookOrCrown",
+            "112" when row.MaterialType is "角色与武器培养素材" or "" => "developmentMaterialNamespace",
+            "114" when row.MaterialType == "武器突破素材" => "weaponAscensionMaterial",
+            // Empty metadata is not a guessed weeklyBoss classification. Ordinary bag
+            // observation later proves the *actual* selected tab/header, or remains null.
+            "113" when row.MaterialId == "113021" => "fixedDreamSolventRoute",
+            "113" when row.MaterialType is "" or "角色突破素材" => "developmentMaterialNamespace",
+            _ => throw new ArgumentException("runtime_CSV_material_namespace_or_type_not_allowed")
+        };
+        string category = row.MaterialId == "113021" ? "preciousItems" : "characterDevelopmentItems";
+        return new(row.MaterialId, row.FullName, category, purpose, row, Version);
+    }
+
+    internal static RuntimeCultivationCatalog ParseRows(string[] headers, IEnumerable<string[]> source,
+        RuntimeCatalogVersion version)
+    {
+        int Column(string name)
+        {
+            var positions = headers.Select((v, i) => (Value: v.Trim().TrimStart('\uFEFF'), Index: i))
+                .Where(p => p.Value == name).ToArray();
+            return positions.Length == 1 ? positions[0].Index : throw new InvalidDataException("required_CSV_column_missing_or_duplicated:" + name);
+        }
+        int variant = Column("variant_id"), itemClass = Column("item_class_id"), itemName = Column("item_name"),
+            kind = Column("material_type"), quality = Column("quality_level"), embedding = Column("embedding");
+        var rows = new List<RuntimeMaterialRow>(); int number = 1;
+        foreach (var fields in source)
+        {
+            if (++number > 50001 || fields.Length != headers.Length)
+                throw new InvalidDataException("runtime_CSV_row_count_or_column_shape_invalid");
+            string classId = fields[itemClass].Trim(), name = fields[itemName].Trim();
+            if (classId.Length is < 1 or > 160 || name.Length is < 1 or > 160 || classId.Any(char.IsControl) || name.Any(char.IsControl))
+                throw new InvalidDataException("runtime_CSV_identity_text_invalid");
+            int level = int.TryParse(fields[quality], NumberStyles.None, CultureInfo.InvariantCulture, out var parsed) ? parsed : -1;
+            int bytes;
+            try { bytes = Convert.FromBase64String(fields[embedding]).Length; }
+            catch (FormatException ex) { throw new InvalidDataException("runtime_CSV_embedding_encoding_invalid", ex); }
+            if (bytes <= 0 || bytes % sizeof(float) != 0 || bytes > 65536)
+                throw new InvalidDataException("runtime_CSV_embedding_shape_invalid");
+            string id = Regex.Match(classId, @"\Amaterial:([1-9][0-9]{0,8})\z") is { Success: true } match ? match.Groups[1].Value : "";
+            // Hash full actual source fields, including embedding, but never retain/export vectors.
+            string rowHash = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(
+                Newtonsoft.Json.JsonConvert.SerializeObject(fields)))).ToLowerInvariant();
+            rows.Add(new(number, fields[variant].Trim(), classId, id, name, fields[kind].Trim(), level, rowHash, bytes));
+        }
+        if (rows.Count == 0) throw new InvalidDataException("runtime_CSV_empty");
+        return new(rows.ToArray(), version);
+    }
+}
+
+/// <summary>Pin the exact actual runtime CSV/model files against writes for the read session.</summary>
+public sealed class PinnedRuntimeCultivationCatalog : IDisposable
+{
+    private readonly List<FileStream> pins = [];
+    public RuntimeCultivationCatalog Catalog { get; private set; } = null!;
+    private PinnedRuntimeCultivationCatalog() { }
+    public static PinnedRuntimeCultivationCatalog Open()
+    {
+        var result = new PinnedRuntimeCultivationCatalog();
+        try
+        {
+            var csv = result.Pin(@"Assets\Model\ItemV2\item.csv", 20_000_000);
+            var model = result.Pin(@"Assets\Model\ItemV2\item.onnx", 100_000_000);
+            using var parser = new TextFieldParser(csv.Stream, new UTF8Encoding(false, true),
+                detectEncoding: true, leaveOpen: true) { TextFieldType = FieldType.Delimited,
+                HasFieldsEnclosedInQuotes = true, TrimWhiteSpace = false };
+            parser.SetDelimiters(",");
+            var headers = parser.ReadFields() ?? throw new InvalidDataException("runtime_CSV_header_missing");
+            IEnumerable<string[]> ReadRows()
+            {
+                while (!parser.EndOfData) yield return parser.ReadFields() ?? throw new InvalidDataException("runtime_CSV_row_missing");
+            }
+            result.Catalog = RuntimeCultivationCatalog.ParseRows(headers, ReadRows(),
+                new(csv.Asset, model.Asset));
+            return result;
+        }
+        catch { result.Dispose(); throw; }
+    }
+    private (FileStream Stream, RuntimeCatalogAsset Asset) Pin(string relative, long maximum)
+    {
+        string absolute = Path.GetFullPath(Global.Absolute(relative));
+        var stream = new FileStream(absolute, FileMode.Open, FileAccess.Read, FileShare.Read);
+        pins.Add(stream);
+        if (stream.Length is <= 0 || stream.Length > maximum) throw new InvalidDataException("runtime_asset_size_invalid");
+        string hash = Convert.ToHexString(SHA256.HashData(stream)).ToLowerInvariant(); stream.Position = 0;
+        return (stream, new(relative.Replace('\\', '/'), stream.Length, hash));
+    }
+    public void Dispose() { foreach (var pin in pins) pin.Dispose(); pins.Clear(); }
+}
