+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: exact named inventory and retained raw evidence contracts.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Newtonsoft.Json.Serialization;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed class NamedCultivationInventoryRequest
+{
+    public string RunId { get; set; } = "";
+    public string StepId { get; set; } = "";
+    public string Phase { get; set; } = "diagnostic";
+    public BackpackMaterial[] Materials { get; set; } = [];
+    public void ValidateShape()
+    {
+        if (!Regex.IsMatch(RunId ?? "", @"\A[A-Za-z0-9][A-Za-z0-9_-]{0,79}\z")
+            || string.IsNullOrWhiteSpace(StepId) || StepId.Length > 128 || StepId != StepId.Trim() || StepId.Any(char.IsControl)
+            || Phase is not ("before" or "after" or "diagnostic") || Materials is not { Length: > 0 and <= 8 }
+            || Materials.Any(m => m is null || !Regex.IsMatch(m.MaterialId ?? "", @"\A(?:104|112|113|114)[0-9]{3}\z")
+                || string.IsNullOrWhiteSpace(m.MaterialName) || m.MaterialName != m.MaterialName.Trim()
+                || m.MaterialName.Length > 80 || m.MaterialName.Any(char.IsControl))
+            || Materials.Select(m => m.MaterialId).Distinct(StringComparer.Ordinal).Count() != Materials.Length
+            || Materials.Select(m => m.MaterialName).Distinct(StringComparer.Ordinal).Count() != Materials.Length)
+            throw new ArgumentException("named_inventory_requires_one_to_eight_distinct_exact_cultivation_pairs_and_run_step_phase");
+    }
+    public NamedCultivationInventoryRequest Freeze() => new() { RunId = RunId, StepId = StepId, Phase = Phase,
+        Materials = Materials.Select(m => new BackpackMaterial { MaterialId = m.MaterialId, MaterialName = m.MaterialName }).ToArray() };
+}
+public sealed record NamedInventoryObservation(ResolvedNamedMaterial Material,
+    WeeklyInventoryObservation Pair, string Reason);
+public sealed class NamedCultivationInventoryResult
+{
+    public StrictInventoryModelEvidence? StrictModels{get;set;}
+    public int SchemaVersion { get; init; } = 1;
+    public string Source { get; init; } = "named_cultivation_backpack_selected_stack";
+    public bool ReadOnly { get; init; } = true;
+    public bool ConfirmationSubmitted { get; init; }
+    public bool TargetReached { get; init; }
+    public int CompletedUpgrades { get; init; }
+    public string RunId { get; init; } = "";
+    public string StepId { get; init; } = "";
+    public string Phase { get; init; } = "";
+    public string Status { get; set; } = "unknown";
+    public string PrimaryReason { get; set; } = "unverified";
+    public string CleanupReason { get; set; } = "not_started";
+    public long StartedAt { get; init; }
+    public long FinishedAt { get; set; }
+    public long? ObservedAt { get; set; }
+    public bool MainUiRestored { get; set; }
+    public bool CleanupCompleted { get; set; }
+    public RuntimeCatalogVersion? CatalogVersion { get; set; }
+    public ResolvedNamedMaterial[] RequestedMaterials { get; set; } = [];
