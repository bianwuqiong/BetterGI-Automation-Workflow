+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: native-only actual inventory capture factory, no consumption registration.
+using System;
+using System.IO;
+using System.Linq;
+using System.Threading;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Newtonsoft.Json.Serialization;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+internal static class InventoryCaptureFactory
+{
+    private static readonly JsonSerializer Camel=JsonSerializer.Create(new JsonSerializerSettings{ContractResolver=new CamelCasePropertyNamesContractResolver()});
+    internal static InventoryCaptureSource Create()
+    {
+        var bound=new BoundBitBltInventoryCapture();
+        void AssertOwner(){if(!TaskRunner.HasOwnedSemaphore)throw new InvalidOperationException("bound_inventory_solo_owner_scope_ended");bound.AssertCurrent();}
+        var directory=Path.Combine(Global.Absolute(@"log\named-inventory-native-frames"),Guid.NewGuid().ToString("N"));
+        InventoryCapturedImage Capture(CancellationToken ct)
+        {
+            AssertOwner();var shot=bound.Capture(ct);
+            try
+            {
+                AssertOwner();
+                var world=InventoryWorldEvidence.Read(shot.Image,shot.Proof.CallReturnedAt);
+                bool known=InventoryWorldEvidence.Verified(world);
+                if(!known&&world.Anchors.Skip(1).All(a=>a.Match==new BackpackRect(0,0,0,0)))
+                {
+                    var region=WeeklyConversionInventoryEvidence.HeaderRect(shot.Image.Width);
+                    using var crop=shot.Image.DeriveCrop(region.ToRect());
+                    var rows=StrictInventoryOcrSession.Current.OcrResult(crop.SrcMat).Regions.Select(r=>{
+                        var b=r.Rect.BoundingRect();return new BackpackOcrRow(r.Text,b.X+region.X,b.Y+region.Y,b.Width,b.Height);}).ToArray();
+                    known=new[]{"characterDevelopmentItems","preciousItems"}.Any(category=>{
+                        using var tab=shot.Image.Find(ElementRecognition.Get(WeeklyInventoryCatalog.TabPrefix(category)+"Checked",shot.Image));
+                        return tab.IsExist()&&WeeklyConversionInventoryEvidence.HeaderVerified(rows,region,category);});
+                }
+                // Unknown layers, authentication and external menus are never retained or used for input.
+                if(!known)throw new InvalidOperationException("bound_inventory_capture_unreviewed_page_no_private_png");
+                var encoded=InspectionNativeFrameEncoding.Encode(shot.Image.SrcMat);Directory.CreateDirectory(directory);
+                var path=Path.Combine(directory,Guid.NewGuid().ToString("N")+".png");
+                using(var stream=new FileStream(path,FileMode.CreateNew,FileAccess.Write,FileShare.None,4096,FileOptions.WriteThrough))
+                {stream.Write(encoded.Png);stream.Flush(flushToDisk:true);}
+                if(!File.ReadAllBytes(path).SequenceEqual(encoded.Png))throw new IOException("inventory_private_native_png_readback_failed");
+                var pixels=new InspectionPrivateCapture(shot.Proof.CallReturnedAt,shot.Image.Width,shot.Image.Height,shot.Image.SrcMat.Type().ToString(),
+                    path,encoded.PngSha256,encoded.NativePixelsSha256,"diagnostic_only_lossless_native_srcmat_no_resize");
+                return new(shot.Image,shot,JObject.FromObject(shot.Proof,Camel),pixels){WorldEvidence=world};
+            }
+            catch{shot.Dispose();throw;}
+        }
+        return new(Capture,AssertOwner,JObject.FromObject(bound.Binding,Camel),bound.CaptureSession);
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/NamedInventory/InventorySynchronousCapture.cs b/BetterGenshinImpact/GameTask/Common/Job/NamedInventory/InventorySynchronousCapture.cs
