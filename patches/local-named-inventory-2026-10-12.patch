+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: actual same-image world anchor descriptors for independent private PNG verification.
+using System;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed record InventoryWorldAnchor(string Task,string ObjectName,string RelativeTemplatePath,string FileSha256,
+    string RelativeDefinitionPath,string DefinitionSha256,BackpackRect SearchRegion,double Threshold,bool UseThreeChannels,
+    string MatchMode,bool UseMask,string TemplatePngBase64,string TemplatePngSha256,string TemplatePixelsSha256,BackpackRect Match);
+public sealed record InventoryWorldProof(long ObservedAt,int Width,int Height,InventoryWorldAnchor[] Anchors);
+
+public static class InventoryWorldEvidence
+{
+    private static readonly (string Task,string Name,string File)[] Definitions=[
+        (@"Common\Element","PaimonMenu","paimon_menu.png"),(@"Common\Element","InDomain","in_domain.png"),
+        (@"Common\Element","PromptDialogLeftBottomStar","prompt_dialog_left_bottom_star.png"),
+        (@"Common\Element","BtnBlackConfirm","btn_black_confirm.png"),(@"AutoFight","Confirm","confirm.png"),
+        (@"QuickTeleport","MapCloseButton","MapCloseButton.png")];
+    internal static InventoryWorldProof For(InventoryCapturedImage shot)=>shot.WorldEvidence??=Read(shot.Image,shot.ObservedAt);
+    public static bool Verified(InventoryWorldProof? proof)
+    {
+        if(proof is null||proof.Width!=1920||proof.Height!=1080||proof.ObservedAt<0||proof.Anchors.Length!=Definitions.Length)return false;
+        for(int i=0;i<Definitions.Length;i++)
+        {
+            var a=proof.Anchors[i];var d=Definitions[i];var task=d.Task.Replace('\\','/');
+            if(a.Task!=task||a.ObjectName!=d.Name||a.RelativeTemplatePath!=$"GameTask/{task}/Assets/1920x1080/{d.File}"||
+                a.RelativeDefinitionPath!=$"GameTask/{task}/Assets/Recognition.json"||a.UseMask||a.MatchMode!="CCoeffNormed"||
+                !double.IsFinite(a.Threshold)||a.Threshold is <.7 or >1||string.IsNullOrWhiteSpace(a.TemplatePngBase64)||
+                new[]{a.FileSha256,a.DefinitionSha256,a.TemplatePngSha256,a.TemplatePixelsSha256}.Any(s=>s.Length!=64||!s.All(Uri.IsHexDigit)))return false;
+            if(i==0? a.Match.Width<=0||a.Match.Height<=0 : a.Match!=new BackpackRect(0,0,0,0))return false;
+        }
+        return true;
+    }
+    internal static InventoryWorldProof Read(ImageRegion image,long at)
+    {
+        var anchors=Definitions.Select(d=>{
+            var relative=$"GameTask/{d.Task.Replace('\\','/')}/Assets/1920x1080/{d.File}";
+            var definition=$"GameTask/{d.Task.Replace('\\','/')}/Assets/Recognition.json";
+            var path=Global.Absolute(relative);var configPath=Global.Absolute(definition);
+            using var assetPin=File.Open(path,FileMode.Open,FileAccess.Read,FileShare.Read);
+            using var configPin=File.Open(configPath,FileMode.Open,FileAccess.Read,FileShare.Read);
+            var fileHash=Convert.ToHexString(SHA256.HashData(assetPin));assetPin.Position=0;
+            var definitionHash=Convert.ToHexString(SHA256.HashData(configPin));configPin.Position=0;
+            var ro=RecognitionObjectJsonLoader.LoadFromFile(configPath,d.Name,new(){CaptureWidth=image.Width,CaptureHeight=image.Height,
+                TemplateLoader=(name,mode)=>name==d.File?Mat.FromStream(assetPin,mode):throw new InvalidOperationException("unreviewed_world_template")});
+            try
+            {
+                var mat=ro.TemplateImageMat??throw new InvalidOperationException("actual_world_template_missing");
+                var encoded=InspectionNativeFrameEncoding.Encode(mat);using var match=image.Find(ro);
+                return new InventoryWorldAnchor(d.Task.Replace('\\','/'),d.Name,relative,fileHash,
+                    definition,definitionHash,BackpackRect.From(ro.RegionOfInterest),ro.Threshold,
+                    ro.Use3Channels,ro.TemplateMatchMode.ToString(),ro.UseMask,Convert.ToBase64String(encoded.Png),encoded.PngSha256,
+                    encoded.NativePixelsSha256,match.IsExist()?new(match.X,match.Y,match.Width,match.Height):new(0,0,0,0));
+            }
+            finally {ro.MaskMat?.Dispose();ro.TemplateImageGreyMat?.Dispose();ro.TemplateImageMat?.Dispose();}
+        }).ToArray();
+        return new(at,image.Width,image.Height,anchors);
+    }
+}
