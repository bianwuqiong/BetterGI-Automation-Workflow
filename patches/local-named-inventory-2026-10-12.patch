+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Fischless.GameCapture.BitBlt;
+using Microsoft.VisualBasic.FileIO;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.Common.Job.NamedInventory;
+
+public sealed record InventoryGameBindingProof(int ProcessId, long WindowHandle, string ProcessStartedUtcTicks,
+    string ExecutablePath, string SystemInfoGeneration, string BackendGeneration, string BackendAssemblyMvid,
+    Rect CaptureRectangle, string CaptureMethod = "actual_synchronous_BitBltCapture");
+public sealed record InventorySyncCaptureProof(long CallStartedAt, long CallReturnedAt, Rect ReturnedRectangle,
+    int NativeWidth, int NativeHeight, string PixelType, InventoryGameBindingProof Binding,
+    string FreshnessSource = "BitBltSession.GetImage_executes_BitBlt_GdiFlush_new_buffer_each_call");
+
+/// <summary>Strongly limited to the actually audited synchronous BitBlt backend.</summary>
+internal sealed class BoundBitBltInventoryCapture
+{
+    private sealed record Generation(string Value);
+    private static readonly ConditionalWeakTable<object, Generation> Generations = new();
+    private readonly object systemInfo;
+    private readonly BitBltCapture backend;
+    private readonly long actualBackendSessionGeneration;
+    public InventoryGameBindingProof Binding { get; }
+    public string CaptureSession { get; }
+    private static long Now() => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+    public BoundBitBltInventoryCapture()
+    {
+        var context = TaskContext.Instance();
+        if (!context.IsInitialized || context.GameHandle == 0 || context.SystemInfo.GameProcessId <= 0)
+            throw new InvalidOperationException("initialized_actual_game_context_required");
+        var capture = TaskTriggerDispatcher.GlobalGameCapture;
+        if (capture.GetType() != typeof(BitBltCapture) || !capture.IsCapturing)
+            throw new NotSupportedException("session_supports_only_audited_actual_synchronous_BitBlt_backend");
+        backend = (BitBltCapture)capture; systemInfo = context.SystemInfo;
+        actualBackendSessionGeneration=backend.SessionGeneration;
+        if(actualBackendSessionGeneration<=0)throw new InvalidOperationException("actual_BitBlt_session_generation_missing");
+        using var owner = SystemControl.GetProcessByHandle(context.GameHandle)
+            ?? throw new InvalidOperationException("actual_game_window_owner_unavailable");
+        var area = context.SystemInfo.CaptureAreaRect;
+        var rectangle = new Rect(area.Left, area.Top, area.Width, area.Height);
+        if (rectangle.Width != 1920 || rectangle.Height != 1080)
+            throw new InvalidOperationException("minimum_session_requires_current_native_1920x1080_capture_context");
+        Binding = new(owner.Id, context.GameHandle.ToInt64(), owner.StartTime.ToUniversalTime().Ticks.ToString(System.Globalization.CultureInfo.InvariantCulture),
+            Path.GetFullPath(owner.MainModule?.FileName ?? throw new InvalidOperationException("actual_game_exe_path_missing")),
+            Generations.GetValue(systemInfo, _ => new(Guid.NewGuid().ToString("N"))).Value,
+            actualBackendSessionGeneration.ToString(System.Globalization.CultureInfo.InvariantCulture),
+            backend.GetType().Assembly.ManifestModule.ModuleVersionId.ToString("N"), rectangle);
+        CaptureSession = "bitblt-inventory:" + Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(JsonConvert.SerializeObject(Binding)))).ToLowerInvariant();
+        AssertCurrent();
+    }
+    // Native authorization may obtain this same actual token before issuing its permit.
+    // The token is never accepted from an arbitrary request Boolean or synthetic frame.
+    public static string CurrentSessionToken() => new BoundBitBltInventoryCapture().CaptureSession;
+    public void AssertCurrent()
+    {
+        var context = TaskContext.Instance();
+        if (!context.IsInitialized || !ReferenceEquals(context.SystemInfo, systemInfo)
+            || !ReferenceEquals(TaskTriggerDispatcher.GlobalGameCapture, backend) || !backend.IsCapturing||backend.SessionGeneration!=actualBackendSessionGeneration
+            || context.GameHandle.ToInt64() != Binding.WindowHandle || context.SystemInfo.GameProcessId != Binding.ProcessId)
+            throw new InvalidOperationException("game_or_actual_capture_lifecycle_changed");
+        using var owner = SystemControl.GetProcessByHandle(context.GameHandle)
+            ?? throw new InvalidOperationException("game_window_owner_lost");
+        if (owner.HasExited || owner.Id != Binding.ProcessId || owner.StartTime.ToUniversalTime().Ticks.ToString(System.Globalization.CultureInfo.InvariantCulture) != Binding.ProcessStartedUtcTicks
+            || !string.Equals(Path.GetFullPath(owner.MainModule?.FileName ?? ""), Binding.ExecutablePath, StringComparison.OrdinalIgnoreCase)
+            || SystemControl.GetForegroundWindowHandle().ToInt64() != Binding.WindowHandle)
+            throw new InvalidOperationException("actual_game_PID_HWND_start_time_exe_or_focus_changed");
+        var area = context.SystemInfo.CaptureAreaRect;
+        if (new Rect(area.Left, area.Top, area.Width, area.Height) != Binding.CaptureRectangle)
+            throw new InvalidOperationException("actual_capture_coordinate_context_changed");
+        if (!User32.GetClientRect(context.GameHandle, out var client) || client.Width != 1920 || client.Height != 1080)
+            throw new InvalidOperationException("actual_current_game_client_rectangle_changed");
+        DwmApi.DwmGetWindowAttribute<RECT>(context.GameHandle, DwmApi.DWMWINDOWATTRIBUTE.DWMWA_EXTENDED_FRAME_BOUNDS, out var window);
+        if (new Rect(window.Left, window.Top + window.Height - client.Height, client.Width, client.Height) != Binding.CaptureRectangle)
+            throw new InvalidOperationException("actual_game_window_position_or_capture_origin_changed");
+    }
+    public CapturedInventoryNativeImage Capture(CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested(); AssertCurrent(); long started = Now();
+        using var native = backend.Capture() ?? throw new InvalidOperationException("synchronous_BitBlt_capture_failed");
+        long returned = Now(); AssertCurrent(); ct.ThrowIfCancellationRequested();
+        var rectangle = native.CaptureRect ?? throw new InvalidOperationException("actual_BitBlt_returned_capture_rectangle_missing");
+        var region = new Rect(rectangle.Left, rectangle.Top, rectangle.Width, rectangle.Height);
+        if (region != Binding.CaptureRectangle || native.Frame.Width != 1920 || native.Frame.Height != 1080
+            || region.Width != native.Frame.Width || region.Height != native.Frame.Height || native.Frame.Empty())
+            throw new InvalidOperationException("actual_BitBlt_frame_geometry_or_returned_rectangle_changed");
+        // Transfer a private Mat clone to CaptureContent; the original pooled frame is disposed.
+        var content = new CaptureContent(native.Frame.Clone(), 0, 0);
+        return new(content, new(started, returned, region, native.Frame.Width, native.Frame.Height,
+            native.Frame.Type().ToString(), Binding));
+    }
+}
+internal sealed class CapturedInventoryNativeImage(CaptureContent content, InventorySyncCaptureProof proof) : IDisposable
+{
+    public ImageRegion Image => content.CaptureRectArea;
+    public InventorySyncCaptureProof Proof { get; } = proof;
+    public InspectionPrivateCapture? RetainedPrivateCapture { get; internal set; }
+    public void Dispose() => content.Dispose();
+}
