+
+public static class BoundMoraRawEvidence
+{
+    private static bool Away(BackpackOcrRow row, BackpackRect box, double margin) => row.Width > 0 && row.Height > 0
+        && row.X - box.X >= margin && row.Y - box.Y >= margin && box.X + box.Width - row.X - row.Width >= margin
+        && box.Y + box.Height - row.Y - row.Height >= margin;
+    public static int? Pair(MoraFrameEvidence a, MoraFrameEvidence b, MoraSnapshotRequest request, long now)
+    {
+        var count = MoraSnapshotEvidence.Pair(a, b, now); if (!count.HasValue) return null;
+        foreach (var frame in new[] { a, b })
+        {
+            double margin = 2 * frame.Width / 1920d;
+            string raw=string.Concat(frame.RawBalanceText.Where(c=>!char.IsWhiteSpace(c)));
+            if(!Regex.IsMatch(raw,@"\A(?:0|[1-9][0-9]{0,9})\z")||frame.BalanceRows.Length!=1||
+                raw!=string.Concat(frame.BalanceRows[0].Text.Where(c=>!char.IsWhiteSpace(c))))return null;
+            if (frame.IconScore > 1 || frame.IconRegion != BackpackRect.From(MoraSnapshotRequest.Scale(request.IconRegion, frame.Width))
+                || frame.BalanceRegion != BackpackRect.From(MoraSnapshotRequest.Scale(request.BalanceRegion, frame.Width))
+                || frame.BalanceRows.Length != 1 || !Away(frame.BalanceRows[0], frame.BalanceRegion, margin)
+                || !WeeklyConversionInventoryEvidence.HeaderVerified(frame.HeaderRows, WeeklyConversionInventoryEvidence.HeaderRect(frame.Width), "preciousItems")) return null;
+        }
+        return count;
+    }
+}
