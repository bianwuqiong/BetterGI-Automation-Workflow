diff --git a/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionCleanupPolicy.cs b/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionCleanupPolicy.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionCleanupPolicy.cs
@@ -0,0 +1,57 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+public sealed record InspectionMenuFrame(long ObservedAt,int Width,int Height,UpgradePreviewRow[] Anchors);
+public static class InspectionPaimonMenuEvidence
+{
+    public static readonly Rect ReferenceRegion=new(110,345,655,590); // Excludes account header/UID/birthday.
+    private static readonly (string Name,int X,int Y)[] Anchors=[("队伍配置",350,455),("好友",508,455),("成就",665,455),
+        ("角色",508,596),("背包",195,737),("任务",350,737),("地图",508,737),("冒险之证",195,878)];
+    public static UpgradePreviewRow[] AccountFreeAnchors(IEnumerable<UpgradePreviewRow> rows)=>rows
+        .Where(r=>Anchors.Any(a=>a.Name==TalentUpgradePreviewEvidence.Normalize(r.Text))).ToArray();
+    public static bool Verified(InspectionMenuFrame frame)
+    {
+        if(frame.Width<800||frame.Width*9!=frame.Height*16||frame.ObservedAt<0)return false;
+        double s=frame.Width/1920d;
+        foreach(var anchor in Anchors)
+        {
+            var matches=frame.Anchors.Where(r=>TalentUpgradePreviewEvidence.Normalize(r.Text)==anchor.Name).ToArray();
+            if(matches.Length!=1)return false;
+            var box=matches[0].Bounds;
+            if(box.Width<10*s||box.Height<10*s||box.Height>55*s||
+                Math.Abs(box.X+box.Width/2d-anchor.X*s)>45*s||Math.Abs(box.Y+box.Height/2d-anchor.Y*s)>38*s)return false;
+        }
+        return true;
+    }
+}
+public enum InspectionCleanupAction { Wait,Escape,Restored,Blocked }
+/// <summary>At most one Escape per recognized layer; transition/unknown pages never trigger input.</summary>
+public sealed class InspectionCleanupPolicy
+{
+    private readonly HashSet<string> escaped=[];
+    private string candidate="";private long? candidateAt;private long? worldAt;private long? lastEscapeAt;
+    public InspectionCleanupAction Observe(string scene,long at,long elapsedMs,bool focused,bool blocked)
+    {
+        if(!focused||blocked||elapsedMs<0||elapsedMs>=10000)return InspectionCleanupAction.Blocked;
+        if(scene=="world")
+        {
+            candidate="";candidateAt=null;
+            if(worldAt.HasValue&&TalentUpgradePreviewEvidence.Fresh(worldAt.Value,at,at))return InspectionCleanupAction.Restored;
+            worldAt=at;return InspectionCleanupAction.Wait;
+        }
+        worldAt=null;
+        if(scene is not("overview" or "detail" or "preview" or "tooltip" or "paimon_menu"))
+        {candidate="";candidateAt=null;return InspectionCleanupAction.Wait;}
+        if(candidate!=scene||!candidateAt.HasValue)
+        {candidate=scene;candidateAt=at;return InspectionCleanupAction.Wait;}
+        if(!TalentUpgradePreviewEvidence.Fresh(candidateAt.Value,at,at))
+        {candidateAt=at;return InspectionCleanupAction.Wait;}
+        if(escaped.Contains(scene)||lastEscapeAt.HasValue&&elapsedMs-lastEscapeAt.Value<1000)return InspectionCleanupAction.Wait;
+        escaped.Add(scene);lastEscapeAt=elapsedMs;candidate="";candidateAt=null;
+        return InspectionCleanupAction.Escape;
+    }
+}
