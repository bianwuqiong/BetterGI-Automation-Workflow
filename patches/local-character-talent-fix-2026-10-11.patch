+        {
+            return TalentLevelGlyphColor.Unknown;
+        }
+        glyphRoi = result.Regions[0].Rect.BoundingRect().ClampTo(levelCrop.Width, levelCrop.Height);
+        if (glyphRoi.Width <= 0 || glyphRoi.Height <= 0 || levelCrop.Depth() != MatType.CV_8U ||
+            levelCrop.Channels() is not (3 or 4))
+        {
+            return TalentLevelGlyphColor.Unknown;
+        }
+        using var bgr = levelCrop.Channels() == 4 ? levelCrop.CvtColor(ColorConversionCodes.BGRA2BGR) : null;
+        var source = bgr ?? levelCrop;
+        List<int> backgroundBlue = [], backgroundGreen = [], backgroundRed = [];
+        for (var y = 0; y < source.Height; y++)
+        {
+            for (var x = 0; x < source.Width; x++)
+            {
+                if (glyphRoi.Contains(new Point(x, y))) continue;
+                var background = source.At<Vec3b>(y, x);
+                backgroundBlue.Add(background.Item0);
+                backgroundGreen.Add(background.Item1);
+                backgroundRed.Add(background.Item2);
+            }
+        }
+        if (backgroundBlue.Count < 8) return TalentLevelGlyphColor.Unknown;
+        backgroundBlue.Sort(); backgroundGreen.Sort(); backgroundRed.Sort();
+        var middle = backgroundBlue.Count / 2;
+        var localBackground = new Vec3b((byte)backgroundBlue[middle], (byte)backgroundGreen[middle], (byte)backgroundRed[middle]);
+        var backgroundMaximum = Math.Max(localBackground.Item0, Math.Max(localBackground.Item1, localBackground.Item2));
+        using var pixels = new Mat(source, glyphRoi);
