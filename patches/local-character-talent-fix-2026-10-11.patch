+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.View.Drawable;
+using Newtonsoft.Json;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CharacterTalentPrivateImageTests(ITestOutputHelper output)
+{
+    [Theory]
+    [Trait("Fixture", "PrivateCharacterTalent")]
+    [InlineData("low-normal")]
+    [InlineData("low-skill")]
+    [InlineData("low-burst")]
+    [InlineData("high-neutral-normal")]
+    [InlineData("high-neutral-skill")]
+    [InlineData("bonus-skill")]
+    [InlineData("bonus-burst")]
+    public void ConfirmedLocalTalentFramesUseTheProductionCoreAndThreeSampleRequirement(string caseId)
+    {
+        var fixtureDirectory = Environment.GetEnvironmentVariable("BETTERGI_PRIVATE_TALENT_FIXTURE_DIR");
+        Assert.False(string.IsNullOrWhiteSpace(fixtureDirectory), "必须显式提供私人游戏帧目录；缺少夹具不能记为通过");
+        var manifest = JsonConvert.DeserializeObject<Dictionary<string, PrivateFixture>>(
+            File.ReadAllText(Path.Combine(fixtureDirectory!, "character-talent-fixtures.json")))!;
+        Assert.True(manifest.TryGetValue(caseId, out var expected), "私人夹具缺失时必须明确失败");
+        using var screenshot = Cv2.ImRead(Path.Combine(fixtureDirectory!, expected!.Filename));
+        Assert.Equal(new Size(1538, 895), screenshot.Size());
+        // 此处是确认详情页后的 Sky 压缩帧；只在内存移除标题/边框，不保存图像。
+        Assert.Equal(4, expected.ClientRect.Length);
+        using var client = new Mat(screenshot, new Rect(expected.ClientRect[0], expected.ClientRect[1],
+            expected.ClientRect[2], expected.ClientRect[3]));
+        using var ocr = new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),
+            PaddleOcrService.PaddleOcrModelType.V6);
+        foreach (var width in new[] { 1536, 1920 })
+        {
+            using var frame = new Mat();
+            Cv2.Resize(client, frame, new Size(width, width * 9 / 16));
+            var scale = width / 1920d;
+            using var capture = new ImageRegion(frame.Clone(), 0, 0, drawContent: new DrawContent());
+            var stable = new StableValueAccumulator<(string Type, int Level, bool Bonus)>(3);
+            for (var attempt = 1; attempt <= 3; attempt++)
+            {
+                var parsed = CharacterDevelopmentStateMachineTask.TryReadTalentDetailFrame(capture, scale, ocr,
+                    out var type, out var level, out var bonus, out var diagnostics);
+                output.WriteLine("case={0}; width={1}; attempt={2}; {3}", caseId, width, attempt, diagnostics);
+                Assert.True(parsed, diagnostics);
+                Assert.Equal(expected.Type, type);
+                Assert.Equal(expected.DisplayLevel, level);
+                Assert.Equal(expected.HasBonus, bonus);
+                Assert.Equal(attempt == 3, stable.Add((type, level, bonus)));
+            }
+        }
+    }
+
+    private sealed class PrivateFixture
+    {
+        public string Filename { get; set; } = "";
+        public string Type { get; set; } = "";
+        public int DisplayLevel { get; set; }
+        public bool HasBonus { get; set; }
+        public int[] ClientRect { get; set; } = [];
+    }
+}
