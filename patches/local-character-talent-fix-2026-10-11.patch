+
+    [Fact]
+    public void ColoredBackgroundOutsideTheDetectedLevelBoxDoesNotChangeNeutralGlyphEvidence()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, new Scalar(230, 230, 20));
+        using (var glyph = new Mat(image, new Rect(10, 10, 40, 20))) glyph.SetTo(new Scalar(230, 230, 230));
+        Assert.Equal(GlyphColor.Neutral, ReadColor(image, LevelResult()));
+    }
+
+    [Theory]
+    [InlineData(120, 110, 15)]
+    [InlineData(80, 80, 0)]
+    [InlineData(3, 3, 0)]
+    [InlineData(150, 150, 110)]
+    public void DarkCyanGlyphsCannotBeDiscardedLeavingOnlyWhiteNoise(int blue, int green, int red)
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.Black);
+        using (var glyph = new Mat(image, new Rect(10, 10, 40, 20))) glyph.SetTo(new Scalar(blue, green, red));
+        for (var y = 10; y < 15; y++)
+            for (var x = 10; x < 30; x++) image.Set(y, x, new Vec3b(240, 240, 240));
+        Assert.NotEqual(GlyphColor.Neutral, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void ATooSmallGroupOfWhiteParticlesDoesNotEstablishAWhiteLevel()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.Black);
+        for (var x = 10; x < 30; x++) image.Set(10, x, new Vec3b(240, 240, 240));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void MixedNeutralAndCyanGlyphsAreUnknown()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.Black);
+        using (var half = new Mat(image, new Rect(10, 10, 20, 20))) half.SetTo(new Scalar(230, 230, 230));
+        using (var half = new Mat(image, new Rect(30, 10, 20, 20))) half.SetTo(new Scalar(230, 230, 30));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void TooDarkNeutralPixelsDoNotEstablishAWhiteLevel()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, new Scalar(70, 70, 70));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void DarkGrayTextOnABrightBackgroundCannotBeClassifiedAsWhite()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, new Scalar(150, 150, 150));
+        using (var glyph = new Mat(image, new Rect(10, 10, 40, 20))) glyph.SetTo(new Scalar(70, 70, 70));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void LowBrightnessTintedTextCannotBeClassifiedAsWhite()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.Black);
+        using (var glyph = new Mat(image, new Rect(10, 10, 40, 20))) glyph.SetTo(new Scalar(80, 80, 60));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult()));
+    }
+
+    [Fact]
+    public void MultipleDetectedLevelRegionsDoNotEstablishGlyphEvidence()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.White);
+        var first = LevelResult().Regions[0];
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, new OcrResult([first, first])));
+    }
+
+    [Fact]
+    public void MissingOrNonLevelTextDoesNotEstablishGlyphEvidence()
+    {
+        using var image = new Mat(50, 100, MatType.CV_8UC3, Scalar.White);
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, new OcrResult([])));
+        Assert.Equal(GlyphColor.Unknown, ReadColor(image, LevelResult("天赋等级+3")));
+    }
+
+    [Fact]
+    public void UnknownPageCannotReadOrExposeOtherOcrFields()
+    {
+        using var pixels = new Mat(1080, 1920, MatType.CV_8UC3, Scalar.Black);
+        using var capture = new ImageRegion(pixels.Clone(), 0, 0, drawContent: new DrawContent());
+        var ocr = new UnknownPageOcr();
+        Assert.False(CharacterDevelopmentStateMachineTask.TryReadTalentDetailFrame(capture, 1, ocr,
+            out _, out _, out _, out var diagnostics));
+        Assert.Equal(1, ocr.ReadCount);
+        Assert.DoesNotContain("untrusted-field", diagnostics);
+    }
+
+    [Fact]
+    public void ChangedBonusBreaksTheThreeConsecutiveSampleSequence()
+    {
+        var stable = new StableValueAccumulator<(string Type, int Level, bool Bonus)>(3);
+        Assert.False(stable.Add(("元素战技", 9, false)));
+        Assert.False(stable.Add(("元素战技", 9, false)));
+        Assert.False(stable.Add(("元素战技", 9, true)));
+        Assert.False(stable.Add(("元素战技", 9, true)));
+        Assert.True(stable.Add(("元素战技", 9, true)));
+    }
+
+    [Fact]
+    public void InvalidFrameBreaksTheThreeConsecutiveSampleSequence()
+    {
+        var stable = new StableValueAccumulator<(string Type, int Level, bool Bonus)>(3);
+        Assert.False(stable.Add(("普通攻击", 9, false)));
+        Assert.False(stable.Add(("普通攻击", 9, false)));
+        stable.Reset();
+        Assert.False(stable.Add(("普通攻击", 9, false)));
+        Assert.False(stable.Add(("普通攻击", 9, false)));
+        Assert.True(stable.Add(("普通攻击", 9, false)));
+    }
+
+    private static OcrResult LevelResult(string text = "Lv.9") => new([
+        new OcrResultRegion(new RotatedRect(new Point2f(30, 20), new Size2f(40, 20), 0), text, .99f)
+    ]);
+
+    private static GlyphColor ReadColor(Mat image, OcrResult result) =>
+        CharacterDevelopmentStateMachineTask.ReadTalentLevelGlyphColor(image, result, out _, out _, out _, out _, out _);
+
+    private sealed class UnknownPageOcr : IOcrService
+    {
+        public int ReadCount { get; private set; }
+        public string Ocr(Mat mat) => throw new InvalidOperationException("不允许绕过上下文核验");
+        public string OcrWithoutDetector(Mat mat) => throw new InvalidOperationException("不允许绕过上下文核验");
+        public OcrResult OcrResult(Mat mat)
+        {
+            if (++ReadCount > 1) throw new InvalidOperationException("untrusted-field");
+            return new OcrResult([new OcrResultRegion(new RotatedRect(), "未知页面", 1)]);
+        }
+    }
+}
