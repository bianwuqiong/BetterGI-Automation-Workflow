diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/MoraCropPairRegressionTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/MoraCropPairRegressionTests.cs
new file mode 100644
--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/MoraCropPairRegressionTests.cs
@@ -0,0 +1,54 @@
+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MoraCropPairRegressionTests
+{
+    private static MoraFrameEvidence Frame(long at,string raw="12345678") => new(at,1920,1080,true,false,
+        [new("贵重道具",143,30,105,30)],"摩拉",.9,new(354,1000,37,37),
+        new MoraSnapshotRequest().BalanceRegion,[new(raw,398,1004,135,31)],raw);
+    [Fact]
+    public void ExpandedCropPreservesBothDigitMarginsWithoutLoweringTheEdgeRule()
+    {
+        var frame=Frame(1000);
+        Assert.Equal(12345678,MoraSnapshotEvidence.Read(frame));
+        Assert.Equal("verified",MoraSnapshotEvidence.ReadWithReason(frame).Reason);
+        var old=frame with {BalanceRegion=new(397,1000,140,40)};
+        Assert.Null(MoraSnapshotEvidence.Read(old));
+        Assert.Equal("balance_digits_touch_crop_edge_or_outside",MoraSnapshotEvidence.ReadWithReason(old).Reason);
+        new MoraSnapshotRequest().Validate();
+    }
+    [Fact]
+    public void FinalFailedAttemptStillReturnsTheTwoDistinctActualCaptures()
+    {
+        var collector=new MoraFramePairCollector();
+        var a=Frame(1000,"unreadable");var b=Frame(1300,"unreadable");var c=Frame(1600,"unreadable");
+        Assert.Null(collector.Observe(a,1100));Assert.Null(collector.Observe(b,1400));Assert.Null(collector.Observe(c,1700));
+        Assert.Same(b,collector.First);Assert.Same(c,collector.Second);Assert.NotSame(collector.First,collector.Second);
+        Assert.Equal(1300,collector.First!.ObservedAt);Assert.Equal(1600,collector.Second!.ObservedAt);
+        Assert.Equal("balance_integer_unparsed",collector.Reason);
+    }
+    [Fact]
+    public void SameObjectOrSameTimestampCannotSupplyAnIndependentPair()
+    {
+        var a=Frame(1000);var collector=new MoraFramePairCollector();
+        Assert.Null(collector.Observe(a,1100));Assert.Null(collector.Observe(a,1100));
+        Assert.Equal("duplicate_capture_record",collector.Reason);
+        var b=Frame(1000);
+        Assert.Null(MoraSnapshotEvidence.Pair(a,b,1100));
+        Assert.Equal("independent_frame_timestamps_required",MoraSnapshotEvidence.PairReason(a,b,1100));
+    }
+    [Fact]
+    public void IndependentFreshPairSucceedsAndUncertainIdentityNeverGetsReused()
+    {
+        var collector=new MoraFramePairCollector();
+        Assert.Null(collector.Observe(Frame(1000),1100));
+        Assert.Equal(12345678,collector.Observe(Frame(1300),1400));
+        Assert.Equal("verified",collector.Reason);
+        Assert.Null(collector.Observe(Frame(1600) with {IconName="其他物品",IconScore=.99},1700));
+        Assert.Equal("mora_icon_unverified",collector.Reason);
+        Assert.Null(collector.Observe(Frame(1900),2000));
+        Assert.Equal("mora_icon_unverified",collector.Reason);
+        Assert.Equal(12345678,collector.Observe(Frame(2200),2300));
+    }
+}
