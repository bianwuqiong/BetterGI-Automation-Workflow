@@ -0,0 +1,47 @@
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.View.Drawable;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ResinSnapshotImageTests
+{
+    [Fact]
+    public void RealSecondReadHeadersKeep158AndExplicitZeroAtBothReplaySizes()
+    {
+        // Cropped map headers contain no UID. The retained frames come from the second map read
+        // in run <private-local-record>, video offsets 346-351s; compressed video is a replay
+        // fixture, not a byte-identical copy of the live 1920p DirectML input.
+        var fixtureDir = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, @"..\..\..\..\Fixtures\ResinSnapshot"));
+        using var ocr = new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),
+            PaddleOcrService.PaddleOcrModelType.V5);
+        foreach (var i in Enumerable.Range(1, 6))
+        {
+            using var header = Cv2.ImRead(Path.Combine(fixtureDir, $"map-header-{i:00}.png"));
+            Assert.False(header.Empty());
+            using var baseFrame = new Mat(720, 1280, MatType.CV_8UC3, Scalar.Black);
+            using (var headerTarget = new Mat(baseFrame, new Rect(640, 0, 640, 90))) header.CopyTo(headerTarget);
+            foreach (var width in new[] { 1280, 1920 })
+            {
+                using var resized = new Mat();
+                Cv2.Resize(baseFrame, resized, new Size(width, width * 9 / 16));
+                using var capture = new ImageRegion(resized.Clone(), 0, 0, drawContent: new DrawContent());
+                var original = ReadResinSnapshotTask.ReadCount(capture, "original_resin.png", true, ocr);
+                var condensed = ReadResinSnapshotTask.ReadCount(capture, "condensed_resin.png", false, ocr);
+                Assert.Equal(158, original.Value);
+                Assert.Equal(0, condensed.Value);
+                Assert.Equal("158/200", original.Raw.Trim());
+                Assert.Equal("0", condensed.Raw.Trim());
+                Assert.True(original.IconScore >= .8);
+                Assert.True(condensed.IconScore >= .8);
+                // The + button starts around x=922 in the 1280 recording; the original
+                // resin icon starts x=816. Neither control may enter an adjacent OCR crop.
+                Assert.True(original.CountRect!.Value.Right < 922 * width / 1280d);
+                Assert.True(condensed.CountRect!.Value.Right < original.IconRect!.Value.Left);
+            }
+        }
+    }
+}
