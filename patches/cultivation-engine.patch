+                        fresh.Derive(freshControls[0].Bounds).Click(); rewardExitClicked = true;
+                        completion.MarkExitClicked(timer.Elapsed);
+                        await Delay(120, _ct); continue;
+                    }
+                    previousRewardExit = button;
+                    await Delay(500, _ct); continue;
+                }
+            }
+            previousRewardExit = null;
+            var now = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+            ExactDomainExitProof? dialog = null;
+            if (blackConfirm.IsExist())
+            {
+                var rows = ReadClaimText(capture, new Rect((int)(capture.Width * .2), (int)(capture.Height * .15),
+                    (int)(capture.Width * .6), (int)(capture.Height * .65)));
+                dialog = ExactDomainExitSafety.Select(rows, capture.Width, capture.Height, now);
+            }
+            var exactDialog = ExactDomainExitSafety.Matching(previousDialog, dialog, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
+            previousDialog = dialog;
+            // A surviving resource selector or unfamiliar dialog blocks every exit input; no double-ESC fallback.
+            var header = ReadClaimText(capture, SingleOriginal20ClaimSafety.HeaderRect(capture.Width, capture.Height));
+            var resourcePrompt = SingleOriginal20ClaimSafety.PromptHeader(header);
+            var anyDialog = blackConfirm.IsExist() || legacyConfirm.IsExist() || resourcePrompt;
+            var countdown = ReadClaimText(capture,new Rect((int)(capture.Width*.35),(int)(capture.Height*.82),
+                (int)(capture.Width*.3),(int)(capture.Height*.1)))
+                .Any(t=>SingleOriginal20ClaimSafety.Normalize(t.Text).Contains("秒后自动退出",StringComparison.Ordinal));
+            if (!ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed)) break;
+            if(completion.Observe(mainUi,inDomain,exitDoor.IsExist(),countdown,resourcePrompt,anyDialog,bigMap,false,false,timer.Elapsed))
+            {
+                _ct.ThrowIfCancellationRequested();
+                return ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed);
+            }
+            var action = policy.Observe(mainUi, inDomain || countdown, exitDoor.IsExist() && !anyDialog, exactDialog,
+                timer.Elapsed, anyDialogVisible: anyDialog);
+            if (timer.ElapsedMilliseconds >= 30000) break;
+            switch (action)
+            {
+                case CombatOnlyExitAction.PressEscape:
+                    Logger.LogInformation("单次领奖安全退出：仅秘境HUD单次ESC，无领奖/再挑战输入");
+                    _ct.ThrowIfCancellationRequested();
+                    if (!ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed)) return false;
+                    Simulation.SendInput.Keyboard.KeyPress(VK.VK_ESCAPE); break;
+                case CombatOnlyExitAction.ClickExitDoor:
+                    Logger.LogInformation("单次领奖安全退出：已识别退出门，等待完整退出确认文本");
+                    _ct.ThrowIfCancellationRequested();
+                    if (!ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed)) return false;
+                    exitDoor.Click(); break;
+                case CombatOnlyExitAction.ConfirmExit:
+                    if (dialog is null || !exactDialog) return false;
+                    Logger.LogInformation("单次领奖安全退出：完整退出文本和唯一确认双帧已核验，点击退出确认");
+                    _ct.ThrowIfCancellationRequested();
+                    if (!ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed)) return false;
+                    capture.Derive(dialog.Button).Click(); completion.MarkExitClicked(timer.Elapsed); previousDialog = null;
+                    await Delay(120,_ct); continue;
+                case CombatOnlyExitAction.Complete:
+                    // Generic combat policy has no exit/loading-chain latch. Only completion above may return.
+                    break;
+            }
+            await Delay(completion.ExitRequested ? 120 : 500, _ct);
+        }
+        return false;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoDomain/DomainCombatSafety.cs b/BetterGenshinImpact/GameTask/AutoDomain/DomainCombatSafety.cs
new file mode 100644
index 00000000..4a8a656d
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoDomain/DomainCombatSafety.cs
@@ -0,0 +1,146 @@
+using System;
+using System.Globalization;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.RegularExpressions;
+using BetterGenshinImpact.GameTask.AutoFight.Script;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+/// <summary>
+/// 战斗诊断的资源隔离和钟离长 E 调度策略。不推断护盾生命值或材料收益。
+/// </summary>
+public static class DomainCombatSafety
+{
+    public static bool CanClaimRewards(bool combatOnly) => !combatOnly;
+
+    public static bool IsExitConfirmationText(string? text)
+    {
+        var compact = Regex.Replace(text ?? "", @"\s+", "");
+        // 实机退出确认：尚未领取当前秘境的奖励，是否退出？仅接受完整提示，不能泛化“是否退出”。
+        var punctuationNormalized = Regex.Replace(compact, @"[，,？?]", "");
+        return compact.Contains("退出秘境", StringComparison.Ordinal) ||
+               compact.Contains("离开秘境", StringComparison.Ordinal) ||
+               compact.Contains("離開秘境", StringComparison.Ordinal) ||
+               punctuationNormalized.Contains("尚未领取当前秘境的奖励是否退出", StringComparison.Ordinal) ||
+               Regex.IsMatch(compact, @"(?:leave|exit)(?:the)?domain", RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);
+    }
+
+    public static int RoundLimit(bool combatOnly, int configuredRounds) => combatOnly ? 1 : configuredRounds;
+
+    public static void ValidateStrategy(bool combatOnly, bool requireZhongli, string path)
+    {
+        if ((combatOnly || requireZhongli) && path.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
+        {
+            throw new ArgumentException("战斗诊断及钟离长 E 核验当前仅支持 TXT 战斗策略");
+        }
+    }
+
+    public static void ValidateCoreTeam(bool requireZhongli, string strategyPath, IEnumerable<string> actualNames)
+    {
+        if (!requireZhongli || Path.GetFileNameWithoutExtension(strategyPath) != "木偶星超导") return;
+        var roster = new HashSet<string>(actualNames, StringComparer.Ordinal);
+        foreach (var required in new[] { "桑多涅", "八重神子", "钟离" })
+            if (!roster.Contains(required)) throw new InvalidOperationException($"木偶星超导实际队伍缺少必需角色：{required}");
+    }
+
+    // 钟离点 E 为 4 秒，长 E 为 12 秒；收紧到刚释放区间，旧剩余 7~9 秒不能冒充新长 E。
+    public static bool IsObservedHoldCooldown(double seconds) => double.IsFinite(seconds) && seconds >= 9.5 && seconds <= 12.5;
+
+    // 两个独立截图的冷却应继续下降，允许 OCR 小幅抖动，不接受大幅跳变。
+    public static bool ConfirmObservedHoldCooldown(double first, double second) =>
+        IsObservedHoldCooldown(first) && IsObservedHoldCooldown(second) &&
+        second <= first + 0.5 && first - second <= 2;
+
+    public static bool ShouldRefresh(TimeSpan? sinceObservedCast, double nextCommandSeconds)
+    {
+        if (!double.IsFinite(nextCommandSeconds) || nextCommandSeconds < 0)
+            throw new ArgumentOutOfRangeException(nameof(nextCommandSeconds));
+        if (sinceObservedCast is null) return true;
+        // 通常 12 秒补一次；长动作可能跨越补盾窗口时提前等 CD 并补盾。
+        return sinceObservedCast.Value.TotalSeconds >= 12 ||
+               sinceObservedCast.Value.TotalSeconds + nextCommandSeconds >= 17;
+    }
+
+    public static double CommandDurationSeconds(CombatCommand command)
+    {
+        double seconds;
+        if (command.Method == Method.Burst) return 2;
+        if (command.Method == Method.Skill) return command.Args?.Contains("hold") == true ? 1.2 : 0.2;
+        var timed = command.Method == Method.Charge || command.Method == Method.Attack ||
+                    command.Method == Method.Wait || command.Method == Method.Dash ||
+                    command.Method == Method.Walk || command.Method == Method.W ||
+                    command.Method == Method.A || command.Method == Method.S || command.Method == Method.D;
+        if (!timed) return 0;
+        var argIndex = command.Method == Method.Walk ? 1 : 0;
+        if (command.Args is null || command.Args.Count <= argIndex)
+            seconds = command.Method == Method.Charge ? 1 : 0.2;
+        else if (!double.TryParse(command.Args[argIndex], NumberStyles.Float, CultureInfo.InvariantCulture, out seconds) ||
+                 !double.IsFinite(seconds) || seconds < 0)
+            throw new ArgumentException("战斗动作时长无效");
+        // 保持原策略 6 秒重击语义，不切碎长动作；更长动作需要单独适配。
+        if (seconds > 6) throw new ArgumentException("钟离长 E 核验不支持超过 6 秒的单个战斗动作");
+        // Avatar.Attack(ms) 每 200ms 一次且包含 ms==0 的末次；默认 attack 恰好一次。
+        if (command.Method == Method.Attack && command.Args is { Count: > 0 })
+            return (Math.Floor((int)(seconds * 1000) / 200d) + 1) * 0.2;
+        return seconds;
+    }
+}
+
+public enum CombatOnlyExitAction
+{
+    Wait,
+    PressEscape,
+    ClickExitDoor,
+    ConfirmExit,
+    Complete
+}
+
+/// <summary>
+/// CombatOnly 专用退出状态策略。未知/加载/菜单态不盲按 ESC，只有世界主 UI 能构成退出证据。
+/// </summary>
+public sealed class CombatOnlyExitPolicy
+{
+    private TimeSpan? _lastInput;
+    private int _escapeAttempts;
+    private int _doorAttempts;
+    private int _confirmAttempts;
+    private int _worldFrames;
+    public bool ExitDoorRequested { get; private set; }
+
+    public CombatOnlyExitAction Observe(bool isMainUi, bool isInDomain, bool exitDoorVisible,
+        bool exitDialogVisible, TimeSpan elapsed, bool anyDialogVisible = false)
+    {
+        if (isMainUi && !isInDomain && !exitDoorVisible && !exitDialogVisible && !anyDialogVisible)
+        {
+            return ++_worldFrames >= 2 ? CombatOnlyExitAction.Complete : CombatOnlyExitAction.Wait;
+        }
+        _worldFrames = 0;
+        var sinceInput = _lastInput is null ? TimeSpan.MaxValue : elapsed - _lastInput.Value;
+        if (exitDialogVisible)
+        {
+            if (_confirmAttempts >= 3 || sinceInput < TimeSpan.FromSeconds(1)) return CombatOnlyExitAction.Wait;
+            _confirmAttempts++;
+            _lastInput = elapsed;
+            return CombatOnlyExitAction.ConfirmExit;
+        }
+        if (exitDoorVisible)
+        {
+            if (_doorAttempts >= 3 || sinceInput < TimeSpan.FromSeconds(1)) return CombatOnlyExitAction.Wait;
+            _doorAttempts++;
+            _lastInput = elapsed;
+            ExitDoorRequested = true;
+            return CombatOnlyExitAction.ClickExitDoor;
+        }
+        if (anyDialogVisible) return CombatOnlyExitAction.Wait;
+        // 只有明确回到秘境战斗 HUD 才可重试；确认框或未知页绝不被第二次 ESC 取消。
+        // 秘境 HUD 不能要求世界专用的派蒙头像，使用实际秘境标记独立核验。
+        if (isInDomain && _escapeAttempts < 3 && sinceInput >= TimeSpan.FromSeconds(2))
+        {
+            _escapeAttempts++;
+            _lastInput = elapsed;
+            return CombatOnlyExitAction.PressEscape;
+        }
+        return CombatOnlyExitAction.Wait;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoDomain/SingleOriginal20ClaimSafety.cs b/BetterGenshinImpact/GameTask/AutoDomain/SingleOriginal20ClaimSafety.cs
new file mode 100644
index 00000000..ac20a1d1
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoDomain/SingleOriginal20ClaimSafety.cs
@@ -0,0 +1,124 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using OpenCvSharp;
+using BetterGenshinImpact.GameTask.AutoPathing;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+public sealed record SingleOriginal20Contract(bool RequireShield, bool CombatOnly, int Rounds, bool Specify,
+    int Original20, int LegacyOriginal, int Original40, int Condensed, int Transient, int Fragile, string[] Priority);
+public sealed record ClaimTextBox(string Text, Rect Bounds);
+public sealed record SingleOriginal20Proof(Rect Label, Rect Button, int Width, long ObservedAt);
+public sealed record ExactDomainExitProof(string Prompt, Rect Button, int Width, long ObservedAt);
+
+/// <summary>Only the existing protected one-claim original20 contract uses this path. No paid-success inference.</summary>
+public static class SingleOriginal20ClaimSafety
+{
+    public static bool Applies(SingleOriginal20Contract contract) => contract.RequireShield && !contract.CombatOnly &&
+        contract.Rounds == 1 && contract.Specify && contract.Original20 == 1 && contract.LegacyOriginal == 0 &&
+        contract.Original40 == 0 && contract.Condensed == 0 && contract.Transient == 0 && contract.Fragile == 0 &&
+        contract.Priority is { Length: 1 } && contract.Priority[0] == "原粹树脂";
+    public static string Normalize(string? text) => Regex.Replace(text ?? "", @"\s+", "");
+    public static Rect HeaderRect(int width, int height) => Scaled(width, 480, 220, 960, 205);
+    public static Rect OriginalRowRect(int width, int height) => Scaled(width, 540, 435, 835, 125);
+    private static Rect Scaled(int width, int x, int y, int w, int h) =>
+        new((int)(x * width / 1920d), (int)(y * width / 1920d), (int)(w * width / 1920d), (int)(h * width / 1920d));
+    private static bool Inside(Rect bounds, Rect outer) => bounds.Width > 0 && bounds.Height > 0 &&
+        bounds.Left >= outer.Left && bounds.Top >= outer.Top && bounds.Right <= outer.Right && bounds.Bottom <= outer.Bottom;
+    public static bool PromptHeader(IEnumerable<ClaimTextBox> header)
+    {
+        var texts = header.Select(t => Normalize(t.Text)).ToArray();
+        return texts.Count(t => t == "石化古树") == 1 && texts.Count(t => t == "请选择激活方式") == 1;
+    }
+    public static SingleOriginal20Proof? Select(IEnumerable<ClaimTextBox> header,
+        IEnumerable<ClaimTextBox> firstRow, int width, int height, long observedAt)
+    {
+        if (width < 800 || width * 9 != height * 16 || observedAt < 0 || !PromptHeader(header)) return null;
+        var rows = firstRow.ToArray();
+        // A coalesced second/third row must never become a clickable "使用" candidate.
+        if (rows.Any(t => Normalize(t.Text).Contains("脆弱", StringComparison.Ordinal) ||
+            Normalize(t.Text).Contains("原石", StringComparison.Ordinal) || Normalize(t.Text).Contains("浓缩", StringComparison.Ordinal) ||
+            Normalize(t.Text).Contains("40", StringComparison.Ordinal))) return null;
+        var labels = rows.Where(t => Normalize(t.Text) == "使用20个原粹树脂").ToArray();
+        var buttons = rows.Where(t => Normalize(t.Text) == "使用").ToArray();
+        if (labels.Length != 1 || buttons.Length != 1) return null;
+        var label = labels[0].Bounds; var button = buttons[0].Bounds; var scale = width / 1920d;
+        var band = OriginalRowRect(width, height);
+        if (!Inside(label, band) || !Inside(button, band) || label.Right > 1100 * scale ||
+            label.Width > 500 * scale || label.Height > 60 * scale || button.Left < 1150 * scale ||
+            button.Right > 1370 * scale || button.Width > 150 * scale || button.Height > 60 * scale ||
+            Math.Abs(label.Y + label.Height / 2d - button.Y - button.Height / 2d) > 20 * scale) return null;
+        return new SingleOriginal20Proof(label, button, width, observedAt);
+    }
+    public static bool SameRect(Rect first, Rect second, int width) =>
+        Math.Abs(first.X - second.X) <= 6 * width / 1920d && Math.Abs(first.Y - second.Y) <= 6 * width / 1920d &&
+        Math.Abs(first.Width - second.Width) <= 6 * width / 1920d && Math.Abs(first.Height - second.Height) <= 6 * width / 1920d;
+    public static bool Matching(SingleOriginal20Proof? first, SingleOriginal20Proof? second, long now) =>
+        first is not null && second is not null && first.Width == second.Width &&
+        second.ObservedAt > first.ObservedAt && second.ObservedAt - first.ObservedAt <= 5000 &&
+        now >= second.ObservedAt && now - second.ObservedAt <= 1500 &&
+        SameRect(first.Label, second.Label, second.Width) && SameRect(first.Button, second.Button, second.Width);
+}
+
+/// <summary>Latch before invoking input. Even an exception after a click never permits a second submission.</summary>
+public sealed class SingleOriginal20Submission
+{
+    public bool Requested { get; private set; }
+    public bool Submit(SingleOriginal20Proof? first, SingleOriginal20Proof? second, long now, Action<Rect> click)
+    {
+        if (Requested || !SingleOriginal20ClaimSafety.Matching(first, second, now)) return false;
+        Requested = true;
+        click(second!.Button);
+        return true;
+    }
+}
+
+public static class ExactDomainExitSafety
+{
+    public static string NormalizePrompt(string? text) => Regex.Replace(SingleOriginal20ClaimSafety.Normalize(text), @"[，,？?。.]", "");
+    public static bool IsExactPrompt(string? text) => NormalizePrompt(text) is
+        "是否退出秘境" or "是否离开秘境" or "是否结束挑战并离开秘境" or "尚未领取当前秘境的奖励是否退出";
+    public static ExactDomainExitProof? Select(IEnumerable<ClaimTextBox> rows, int width, int height, long observedAt)
+    {
+        var all = rows.ToArray();
+        var controls = all.Where(t => SingleOriginal20ClaimSafety.Normalize(t.Text) == "确认").ToArray();
+        if (controls.Length != 1 || observedAt < 0) return null;
+        var body = string.Concat(all.Select(t => SingleOriginal20ClaimSafety.Normalize(t.Text))
+            .Where(t => t is not ("确认" or "取消" or "提示")));
+        if (!IsExactPrompt(body)) return null;
+        var button = controls[0].Bounds; var scale = width / 1920d;
+        if (button.Width <= 0 || button.Height <= 0 || button.Width > 180 * scale || button.Height > 70 * scale ||
+            button.Left < width * 0.5 || button.Right > width * 0.85 || button.Top < height * 0.45 || button.Bottom > height * 0.85) return null;
+        return new ExactDomainExitProof(NormalizePrompt(body), button, width, observedAt);
+    }
+    public static bool Matching(ExactDomainExitProof? first, ExactDomainExitProof? second, long now) =>
+        first is not null && second is not null && first.Width == second.Width && first.Prompt == second.Prompt &&
+        second.ObservedAt > first.ObservedAt && second.ObservedAt - first.ObservedAt <= 5000 &&
+        now >= second.ObservedAt && now - second.ObservedAt <= 1500 &&
+        SingleOriginal20ClaimSafety.SameRect(first.Button, second.Button, second.Width);
+}
+
+/// <summary>Actual exit input, two positive load samples, then two outside-world samples. Never paid evidence.</summary>
+public sealed class ProtectedClaimExitProtocol
+{
+    public static bool WithinDeadline(TimeSpan elapsed) => elapsed >= TimeSpan.Zero && elapsed < TimeSpan.FromSeconds(30);
+    private MaterialTeleportProtocol _protocol = new();
+    private TimeSpan? _requestedAt;
+    public bool ExitRequested => _requestedAt.HasValue;
+    public bool LoadingObserved => _protocol.LoadingObserved;
+    public int WorldFrames => _protocol.WorldFrames;
+    public void MarkExitClicked(TimeSpan elapsed) { _requestedAt = elapsed; _protocol = new MaterialTeleportProtocol(); }
+    public bool Observe(bool mainUi, bool inDomain, bool door, bool countdown, bool resourcePrompt,
+        bool anyDialog, bool bigMap, bool revive, bool positiveLoading, TimeSpan elapsed)
+    {
+        if (!WithinDeadline(elapsed)) return false;
+        var blocked = inDomain || door || countdown || resourcePrompt || anyDialog || bigMap || revive;
+        var outsideWorld = mainUi && !blocked && !positiveLoading;
+        // Unknown/non-loading pages are interference, not substitute loading proof.
+        var interference = blocked || (!outsideWorld && !positiveLoading);
+        var sinceClick = _requestedAt.HasValue ? (long)(elapsed - _requestedAt.Value).TotalMilliseconds : 0;
+        return _protocol.Observe(ExitRequested, outsideWorld, interference, revive, sinceClick);
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoFight/MaterialSwitchSafety.cs b/BetterGenshinImpact/GameTask/AutoFight/MaterialSwitchSafety.cs
new file mode 100644
index 00000000..c8d80273
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/MaterialSwitchSafety.cs
@@ -0,0 +1,59 @@
+using System;
+using System.Diagnostics;
+using System.Threading;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.Core.Simulator.Extensions;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using static BetterGenshinImpact.GameTask.Common.TaskControl;
+
+namespace BetterGenshinImpact.GameTask.AutoFight;
+
+/// <summary>Material-only bounded state gate; no random movement, food, or revive.</summary>
+public static class MaterialSwitchSafety
+{
+    public static bool JumpBlocked(string text) => text.Contains("跳跃时不能切换", StringComparison.Ordinal);
+    public static bool CooldownBlocked(string text) => text.Contains("切换角色仍在冷却", StringComparison.Ordinal) ||
+        text.Contains("切换仍冷却", StringComparison.Ordinal);
+
+    public static (bool ready, bool airborne) Observe(ImageRegion frame)
+    {
+        if (Bv.IsInRevivePrompt(frame)) throw new InvalidOperationException("材料路线复苏提示禁止恢复或继续切人");
+        if (!Bv.IsInMainUi(frame) || Bv.IsInDomain(frame)) return (false, false);
+        var scale = TaskContext.Instance().SystemInfo.AssetScale;
+        using var prompt = frame.DeriveCrop(new Rect((int)(400 * scale), (int)(180 * scale),
+            (int)(1120 * scale), (int)(500 * scale)));
+        using var text = prompt.Find(RecognitionObject.OcrThis);
+        var airborne = Bv.GetMotionStatus(frame) != MotionStatus.Normal || JumpBlocked(text.Text);
+        return (!airborne && !CooldownBlocked(text.Text), airborne);
+    }
+
+    public static void WaitGrounded(CancellationToken ct, int maximumMs = 5000)
+    {
+        var timer = Stopwatch.StartNew();
+        var dropIssued = false;
+        var stable = 0;
+        Simulation.ReleaseAllKey();
+        while (timer.ElapsedMilliseconds < maximumMs)
+        {
+            ct.ThrowIfCancellationRequested();
+            using (var frame = CaptureToRectArea(forceNew: true))
+            {
+                var state = Observe(frame);
+                if (timer.ElapsedMilliseconds >= maximumMs) break;
+                stable = state.ready ? stable + 1 : 0;
+                if (stable >= 2) return;
+                if (state.airborne && !dropIssued)
+                {
+                    Simulation.SendInput.SimulateAction(GIActions.Drop);
+                    dropIssued = true;
+                }
+            }
+            Sleep(250, ct);
+        }
+        throw new InvalidOperationException("材料路线五秒内未核验落地或切换冷却提示消失");
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoFight/Model/PartyHudNameVerifier.cs b/BetterGenshinImpact/GameTask/AutoFight/Model/PartyHudNameVerifier.cs
