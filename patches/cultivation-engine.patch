+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using System.Text.Json;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoFightTests;
+
+public class PartyHudNameVerifierTests
+{
+    private static readonly string[] OfficialNames = ["奥黛塔", "奈芙尔", "钟离", "流浪者", "八重神子"];
+
+    [Fact]
+    public void RecordedHudEvidenceRestoresActualSlotNameFromLiveMismatch()
+    {
+        using var fixture = JsonDocument.Parse(File.ReadAllText(Path.Combine(AppContext.BaseDirectory,
+            "Fixtures", "PartyHudConflict_20261008.json")));
+        var evidence = fixture.RootElement;
+        var first = PartyHudNameVerifier.ExactOfficialName(evidence.GetProperty("first").GetProperty("offlineOcrText").GetString(), OfficialNames);
+        var second = PartyHudNameVerifier.ExactOfficialName(evidence.GetProperty("second").GetProperty("offlineOcrText").GetString(), OfficialNames);
+        Assert.Equal(evidence.GetProperty("expectedResolvedName").GetString(),
+            PartyHudNameVerifier.Resolve(evidence.GetProperty("liveModelName").GetString()!, first, second));
+    }
+
+    [Theory]
+    [InlineData("奥黛塔", "奥黛塔")]
+    [InlineData(" 奥 黛 塔\n", "奥黛塔")]
+    [InlineData("奥黛", null)]
+    [InlineData("奥黛塔2", null)]
+    [InlineData("奥黛塔(冰)", null)]
+    [InlineData("自定义角色名", null)]
+    [InlineData("", null)]
+    [InlineData(null, null)]
+    public void OnlyCompleteOfficialHudNameCanVerify(string? text, string? expected)
+    {
+        Assert.Equal(expected, PartyHudNameVerifier.ExactOfficialName(text, OfficialNames));
+    }
+
+    [Fact]
+    public void TwoMatchingHudFramesRepairModelMisclassification()
+    {
+        Assert.Equal("奥黛塔", PartyHudNameVerifier.Resolve("奈芙尔", "奥黛塔", "奥黛塔"));
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("奈芙尔")]
+    [InlineData("钟离")]
+    public void UnconfirmedConflictRejectsTeamInsteadOfSkippingActualCharacter(string? second)
+    {
+        Assert.Throws<InvalidOperationException>(() => PartyHudNameVerifier.Resolve("奈芙尔", "奥黛塔", second));
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("奥黛塔")]
+    public void AbsentOrAgreeingHudKeepsModelName(string? first)
+    {
+        Assert.Equal("奥黛塔", PartyHudNameVerifier.Resolve("奥黛塔", first, null));
+    }
+}
