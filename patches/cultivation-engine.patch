+    [InlineData("当前秘境 使用原粹树脂 是否退出？", false)]
+    [InlineData("退出游戏", false)]
+    [InlineData("领取秘境奖励 使用原粹树脂", false)]
+    [InlineData(null, false)]
+    public void OnlyExitPromptTextPermitsDirectEscapeDialogConfirmation(string? text, bool expected) =>
+        Assert.Equal(expected, DomainCombatSafety.IsExitConfirmationText(text));
