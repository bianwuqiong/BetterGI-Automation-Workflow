@@ -0,0 +1,23 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+
+namespace BetterGenshinImpact.GameTask.AutoFight.Model;
+
+internal static class PartyHudNameVerifier
+{
+    internal static string? ExactOfficialName(string? text, IReadOnlyCollection<string> officialNames)
+    {
+        if (string.IsNullOrWhiteSpace(text)) return null;
+        var name = string.Concat(text.Where(character => !char.IsWhiteSpace(character)));
+        return officialNames.Contains(name, StringComparer.Ordinal) ? name : null;
+    }
+
+    internal static string Resolve(string modelName, string? firstHudName, string? secondHudName)
+    {
+        if (firstHudName == null || firstHudName == modelName) return modelName;
+        if (firstHudName == secondHudName) return firstHudName;
+
+        throw new InvalidOperationException("队伍头像与 HUD 官方角色名冲突，第二帧未确认同名，拒绝初始化队伍。");
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoFight/ShieldSkillReadinessPolicy.cs b/BetterGenshinImpact/GameTask/AutoFight/ShieldSkillReadinessPolicy.cs
new file mode 100644
index 00000000..4e7bb036
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/ShieldSkillReadinessPolicy.cs
@@ -0,0 +1,38 @@
+using System;
+
+namespace BetterGenshinImpact.GameTask.AutoFight;
+
+public enum ShieldSkillReadinessAction { Wait, ReconfirmIdentity, Cast, Fail }
+
+/// <summary>护盾守卫的冷却前置条件；未知身份仅允许一次重新确认，不能授权释放E。</summary>
+public sealed class ShieldSkillReadinessPolicy
+{
+    private int _noCooldownFrames;
+    private bool _identityCorrectionUsed;
+    private bool _failed;
+
+    public void ResetCooldownObservations() => _noCooldownFrames = 0;
+
+    public ShieldSkillReadinessAction Observe(double seconds)
+    {
+        if (_failed) return ShieldSkillReadinessAction.Fail;
+        if (!double.IsFinite(seconds))
+        {
+            _noCooldownFrames = 0;
+            if (_identityCorrectionUsed)
+            {
+                _failed = true;
+                return ShieldSkillReadinessAction.Fail;
+            }
+            _identityCorrectionUsed = true;
+            return ShieldSkillReadinessAction.ReconfirmIdentity;
+        }
+        if (seconds > 12.5)
+        {
+            _failed = true;
+            return ShieldSkillReadinessAction.Fail;
+        }
+        _noCooldownFrames = seconds <= 0 ? _noCooldownFrames + 1 : 0;
+        return _noCooldownFrames >= 2 ? ShieldSkillReadinessAction.Cast : ShieldSkillReadinessAction.Wait;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoFight/ZhongliHoldShieldGuard.cs b/BetterGenshinImpact/GameTask/AutoFight/ZhongliHoldShieldGuard.cs
new file mode 100644
index 00000000..c03ebed0
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/ZhongliHoldShieldGuard.cs
@@ -0,0 +1,92 @@
+using System;
+using System.Diagnostics;
+using System.Threading;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.Common;
+using Microsoft.Extensions.Logging;
+using static BetterGenshinImpact.GameTask.Common.TaskControl;
+
+namespace BetterGenshinImpact.GameTask.AutoFight;
+
+/// <summary>共享已验收的双帧长E冷却核验；仅在无持有输入的命令边界调用。</summary>
+public sealed class ZhongliHoldShieldGuard
+{
+    public Stopwatch? LastObservedCast { get; private set; }
+    public int ObservedCastCount { get; private set; }
+    public void Reset() { LastObservedCast = null; ObservedCastCount = 0; }
+    public void EnsureCast(CombatScenes combatScenes, CancellationToken ct, Action<object> emit, string eventTask)
+    {
+        ct.ThrowIfCancellationRequested();
+        var zhongli = combatScenes.SelectAvatar("钟离") ?? throw new InvalidOperationException("队伍中不存在钟离");
+        using (AvatarRecognition.BeginExclusiveOperation())
+        {
+            Simulation.ReleaseAllKey();
+            var activeContext = new AvatarActiveCheckContext { StrictIdentity = true };
+            var readiness = new ShieldSkillReadinessPolicy();
+            for (var attempt = 0; attempt < 2; attempt++)
+            {
+                ct.ThrowIfCancellationRequested();
+                if (!zhongli.TrySwitchVerified(activeContext)) throw new InvalidOperationException("钟离连续两帧出战未获核验，停止战斗");
+
+                // 正冷却是旧技能证据。空白/0 只是未观察到冷却，不足以证明就绪；
+                // 两次未观察到后允许尝试，成功仍必须有刚释放区间的两帧长 CD。
+                // 已核实的上次释放另加确定的最短等待，避免 OCR 漏读提早重按。
+                if (LastObservedCast is not null && LastObservedCast.Elapsed.TotalSeconds < 12.2)
+                    Sleep((int)Math.Ceiling((12.2 - LastObservedCast.Elapsed.TotalSeconds) * 1000), ct);
+                var readyWait = Stopwatch.StartNew();
+                readiness.ResetCooldownObservations();
+                while (true)
+                {
+                    ct.ThrowIfCancellationRequested();
+                    var remaining = zhongli.ReadObservedSkillCooldown(activeContext);
+                    var action = readiness.Observe(remaining);
+                    if (action == ShieldSkillReadinessAction.ReconfirmIdentity)
+                    {
+                        // Correct only role selection, never cast E on the strength of ambiguous identity.
+                        Logger.LogWarning("钟离出战身份暂时不明，有限重新切换并核验，不释放战技");
+                        if (!zhongli.TrySwitchVerified(activeContext))
+                            throw new InvalidOperationException("钟离重新切换仍未取得连续两帧出战证据，停止战斗");
+                        continue;
+                    }
+                    if (action == ShieldSkillReadinessAction.Fail)
+                        throw new InvalidOperationException("无法核实钟离当前战技冷却/出战角色，停止战斗");
+                    if (action == ShieldSkillReadinessAction.Cast) break;
+                    if (readyWait.Elapsed.TotalSeconds > 14)
+                        throw new InvalidOperationException("钟离战技冷却等待超时，停止战斗");
+                    Sleep(200, ct);
+                }
+
+                var castTimer = Stopwatch.StartNew();
+                zhongli.UseSkill(hold: true);
+                ct.ThrowIfCancellationRequested();
+                var confirmationTimer = Stopwatch.StartNew();
+                double previous = double.NaN;
+                while (confirmationTimer.Elapsed.TotalSeconds < 2)
+                {
+                    ct.ThrowIfCancellationRequested();
+                    var observed = zhongli.ReadObservedSkillCooldown(activeContext);
+                    if (DomainCombatSafety.ConfirmObservedHoldCooldown(previous, observed))
+                    {
+                        LastObservedCast = castTimer;
+                        ObservedCastCount++;
+                        emit(new
+                        {
+                            task = eventTask, status = "cast_observed", avatar = "钟离",
+                            evidence = "hold_skill_cooldown_observed", observedCooldownSeconds = observed,
+                            elapsedSinceHoldRequestMs = Math.Round(castTimer.Elapsed.TotalMilliseconds),
+                            observedCastCount = ObservedCastCount
+                        });
+                        return;
+                    }
+                    previous = observed;
+                    Sleep(200, ct);
+                }
+                Logger.LogWarning("钟离长 E 未取得连续冷却证据，有限重试 {Attempt}/2", attempt + 1);
+            }
+        }
+        throw new InvalidOperationException("钟离长 E 冷却后置条件未获核验，停止并禁止领奖");
+    }
+
+}
diff --git a/BetterGenshinImpact/GameTask/AutoPathing/MaterialAreaSelectionPolicy.cs b/BetterGenshinImpact/GameTask/AutoPathing/MaterialAreaSelectionPolicy.cs
