+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Microsoft.Extensions.Logging;
+using OpenCvSharp;
+using static BetterGenshinImpact.GameTask.Common.TaskControl;
+using static Vanara.PInvoke.User32;
+using BetterGenshinImpact.GameTask.Common.Reward;
+
+namespace BetterGenshinImpact.GameTask.AutoDomain;
+
+public partial class AutoDomainTask
+{
+    private bool IsProtectedSingleOriginal20() => SingleOriginal20ClaimSafety.Applies(new SingleOriginal20Contract(
+        _taskParam.RequireZhongliShieldCast, _taskParam.CombatOnly, _taskParam.DomainRoundNum, _taskParam.SpecifyResinUse,
+        _taskParam.OriginalResin20UseCount, _taskParam.OriginalResinUseCount, _taskParam.OriginalResin40UseCount,
+        _taskParam.CondensedResinUseCount, _taskParam.TransientResinUseCount, _taskParam.FragileResinUseCount,
+        _taskParam.ResinPriorityList.ToArray()));
+    private static ClaimTextBox[] ReadClaimText(ImageRegion capture, Rect roi)
+    {
+        var regions = capture.FindMulti(RecognitionObject.Ocr(roi.X, roi.Y, roi.Width, roi.Height));
+        try { return regions.Select(r => new ClaimTextBox(r.Text, new Rect(r.X, r.Y, r.Width, r.Height))).ToArray(); }
+        finally { foreach (var region in regions) region.Dispose(); }
+    }
+    // Offline private replay calls this exact reader without invoking input or capture services.
+    internal static SingleOriginal20Proof? ReadSingleOriginal20Proof(ImageRegion capture, long observedAt) =>
+        SingleOriginal20ClaimSafety.Select(ReadClaimText(capture, SingleOriginal20ClaimSafety.HeaderRect(capture.Width, capture.Height)),
+            ReadClaimText(capture, SingleOriginal20ClaimSafety.OriginalRowRect(capture.Width, capture.Height)), capture.Width, capture.Height, observedAt);
+
+    internal static bool HasProtectedLoadingBackground(ImageRegion capture)
+    {
+        // Retained loading frames have white, black, or neutral deep-gray flat backgrounds.
+        // The deep-gray screen has RGB about (29,27,35), not the black fade's <=15 channels.
+        // Dark fades are also admissible,
+        // but only after an actual exit click and with all low-cost HUD/menu/dialog probes absent.
+        var white = 0; var dark = 0; var neutralGray = new List<Scalar>();
+        foreach (var (x,y) in new[]{(.1,.12),(.42,.12),(.8,.12),(.1,.5),(.85,.5),(.1,.8)})
+        {
+            using var patch = new Mat(capture.SrcMat, new Rect((int)(x*capture.Width),(int)(y*capture.Height),
+                Math.Max(8,capture.Width/64),Math.Max(8,capture.Height/64)));
+            Cv2.MeanStdDev(patch,out var mean,out var deviation);
+            if (deviation.Val0>3 || deviation.Val1>3 || deviation.Val2>3) continue;
+            if(mean.Val0>=240 && mean.Val1>=240 && mean.Val2>=240)white++;
+            if(mean.Val0<=15 && mean.Val1<=15 && mean.Val2<=15)dark++;
+            var low = Math.Min(mean.Val0,Math.Min(mean.Val1,mean.Val2));
+            var high = Math.Max(mean.Val0,Math.Max(mean.Val1,mean.Val2));
+            if(low>=20 && high<=40 && high-low<=12)neutralGray.Add(mean);
+        }
+        // A dark night scene or several unrelated dark patches must not count as the loading plane.
+        var sameGrayPlane = neutralGray.Count>=5 &&
+            neutralGray.Max(m=>m.Val0)-neutralGray.Min(m=>m.Val0)<=3 &&
+            neutralGray.Max(m=>m.Val1)-neutralGray.Min(m=>m.Val1)<=3 &&
+            neutralGray.Max(m=>m.Val2)-neutralGray.Min(m=>m.Val2)<=3;
+        return white>=5 || dark>=5 || sameGrayPlane;
+    }
+
+    private void ObserveProtectedClassicRewards()
+    {
+        if (!_taskParam.RewardRecognitionEnabled) return;
+        try
+        {
+            var observed = RewardResultRecognizer.Instance.RecognizeMultiPage();
+            RewardResultRecognizer.MergeIntoSummary(_rewardSummary, observed);
+            Logger.LogInformation("受保护单次领奖：经典结果页奖励仅作观察，paid状态仍待外层库存/余额，不累加native成功轮数");
+        }
+        catch(Exception exception) when(exception is not OperationCanceledException and not NormalEndException)
+        { Logger.LogWarning(exception,"受保护单次领奖：经典奖励观察失败，继续受保护退出，结果待外层核验"); }
+    }
+
+    private async Task<bool> GettingProtectedSingleOriginal20()
+    {
+        var prompt = await WaitForResinPrompt();
+        if (prompt is not { } firstPrompt) throw new NormalEndException("单次原粹20未核验树脂弹窗，未提交且禁止回退通用领奖");
+        using (firstPrompt.Capture)
+            if (firstPrompt.Status.OriginalResinCount < 20)
+                throw new NormalEndException("单次原粹20弹窗余额不足，未提交且禁止使用其他资源");
+        var submission = new SingleOriginal20Submission();
+        var timer = Stopwatch.StartNew();
+        SingleOriginal20Proof? previous = null;
+        while (timer.ElapsedMilliseconds < 12000)
+        {
+            _ct.ThrowIfCancellationRequested();
+            using var capture = CaptureToRectArea(forceNew: true);
+            var observedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+            var current = ReadSingleOriginal20Proof(capture, observedAt);
+            if (timer.ElapsedMilliseconds >= 12000) break;
+            _ct.ThrowIfCancellationRequested();
+            if (submission.Submit(previous, current, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
