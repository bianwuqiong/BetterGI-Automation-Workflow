+        Assert.Equal(expected, MaterialAreaSelectionPolicy.ExactName(candidate, "稻妻", "稻妻"));
+
+    [Fact]
+    public void EmptyNamesCannotMatchBackgroundText() =>
+        Assert.False(MaterialAreaSelectionPolicy.ExactName("望风角", "", ""));
+
+    [Theory]
+    [InlineData(1280, 720)]
+    [InlineData(1920, 1080)]
+    public void OptionsRoiContainsBothColumnsAndExcludesHeaderAndUid(int width, int height)
+    {
+        var roi = MaterialAreaSelectionPolicy.OptionsRect(width, height);
+        var title = MaterialAreaSelectionPolicy.TitleRect(width, height);
+        Assert.True(title.Contains((int)(width * 0.69), (int)(height * 0.03)));
+        Assert.False(title.Contains((int)(width * 0.69), (int)(height * 0.27)));
+        Assert.True(roi.Contains((int)(width * 0.69), (int)(height * 0.27)));
+        Assert.True(roi.Contains((int)(width * 0.87), (int)(height * 0.27)));
+        Assert.False(roi.Contains((int)(width * 0.69), (int)(height * 0.03)));
+        Assert.False(roi.Contains((int)(width * 0.9), (int)(height * 0.985)));
+        Assert.False(roi.Contains(width / 2, height / 2));
+    }
+}
