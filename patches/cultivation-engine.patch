@@ -0,0 +1,99 @@
+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.AutoFight;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoFightTests;
+
+public class ShieldAvatarIdentityTests
+{
+    [Fact]
+    public void BrightHudWithTwoMissingDigitsNeverInventsTheLastMissingSlot()
+    {
+        // Reproduces the live 20261009 failure: every edge is white, slots 3 and 4 both
+        // lack the exact black digit pixels. Only the unique-missing case can identify a slot.
+        var mats = Enumerable.Range(0, 4).Select(_ => new Mat(20, 20, MatType.CV_8UC1, Scalar.All(255))).ToArray();
+        try
+        {
+            mats[0].Set(10, 10, (byte)50);
+            mats[1].Set(10, 10, (byte)50);
+            Assert.Equal(-1, PartyAvatarSideIndexHelper.FindActiveIndexRectByEdgeColor(mats, strictIdentity: true));
+            var context = new AvatarActiveCheckContext { StrictIdentity = true };
+            Assert.Equal(-1, context.ObserveStrictCandidate(-1));
+        }
+        finally { foreach (var mat in mats) mat.Dispose(); }
+    }
+
+    [Fact]
+    public void UniqueMissingDigitIsOnlyACandidateUntilTwoConsecutiveFramesAgree()
+    {
+        var mats = Enumerable.Range(0, 4).Select(_ => new Mat(20, 20, MatType.CV_8UC1, Scalar.All(255))).ToArray();
+        try
+        {
+            foreach (var mat in mats.Take(3)) mat.Set(10, 10, (byte)50);
+            var candidate = PartyAvatarSideIndexHelper.FindActiveIndexRectByEdgeColor(mats, strictIdentity: true);
+            Assert.Equal(4, candidate);
+            var context = new AvatarActiveCheckContext { StrictIdentity = true };
+            Assert.Equal(-2, context.ObserveStrictCandidate(candidate));
+            Assert.Equal(4, context.ObserveStrictCandidate(candidate));
+        }
+        finally { foreach (var mat in mats) mat.Dispose(); }
+    }
+
+    [Theory]
+    [InlineData(3)]
+    [InlineData(-1)]
+    public void DifferentOrUncertainInterveningFrameBreaksRoleConfirmation(int intervening)
+    {
+        var context = new AvatarActiveCheckContext { StrictIdentity = true };
+        Assert.Equal(-2, context.ObserveStrictCandidate(4));
+        Assert.True(context.ObserveStrictCandidate(intervening) < 0);
+        Assert.Equal(-2, context.ObserveStrictCandidate(4));
+        Assert.Equal(4, context.ObserveStrictCandidate(4));
+    }
+
+    [Fact]
+    public void NewSwitchRequestMustDiscardAnEarlierConfirmedRole()
+    {
+        var context = new AvatarActiveCheckContext { StrictIdentity = true };
+        context.ObserveStrictCandidate(4); context.ObserveStrictCandidate(4);
+        context.ResetStrictCandidate();
+        Assert.Equal(-2, context.ObserveStrictCandidate(4));
+        Assert.False(new AvatarActiveCheckContext().StrictIdentity);
+    }
+
+    [Fact]
+    public void UnconfirmedRoleCannotAuthorizeEAndOnlyOneCorrectionIsAllowed()
+    {
+        var policy = new ShieldSkillReadinessPolicy();
+        var actions = new[] { policy.Observe(double.NaN), policy.Observe(double.NaN) };
+        Assert.Equal([ShieldSkillReadinessAction.ReconfirmIdentity, ShieldSkillReadinessAction.Fail], actions);
+        Assert.DoesNotContain(ShieldSkillReadinessAction.Cast, actions); // E requests remain zero.
+        policy.ResetCooldownObservations();
+        Assert.Equal(ShieldSkillReadinessAction.Fail, policy.Observe(double.NaN));
+    }
+
+    [Fact]
+    public void SuccessfulRoleCorrectionStillRequiresTwoFreshNoCooldownFrames()
+    {
+        var policy = new ShieldSkillReadinessPolicy();
+        Assert.Equal(ShieldSkillReadinessAction.Wait, policy.Observe(0));
+        Assert.Equal(ShieldSkillReadinessAction.ReconfirmIdentity, policy.Observe(double.NaN));
+        Assert.Equal(ShieldSkillReadinessAction.Wait, policy.Observe(0));
+        Assert.Equal(ShieldSkillReadinessAction.Cast, policy.Observe(0));
+    }
+
+    [Fact]
+    public void PositiveCooldownBreaksReadinessAndConflictingPostCastCooldownIsNotEvidence()
+    {
+        var policy = new ShieldSkillReadinessPolicy();
+        Assert.Equal(ShieldSkillReadinessAction.Wait, policy.Observe(0));
+        Assert.Equal(ShieldSkillReadinessAction.Wait, policy.Observe(2.4));
+        Assert.Equal(ShieldSkillReadinessAction.Wait, policy.Observe(0));
+        Assert.Equal(ShieldSkillReadinessAction.Fail, policy.Observe(13));
+        Assert.Equal(ShieldSkillReadinessAction.Fail, policy.Observe(0));
+        Assert.False(DomainCombatSafety.ConfirmObservedHoldCooldown(11.4, 2.4));
+        Assert.False(DomainCombatSafety.ConfirmObservedHoldCooldown(11.4, double.NaN));
+        Assert.True(DomainCombatSafety.ConfirmObservedHoldCooldown(11.4, 11.1));
+    }
+}
