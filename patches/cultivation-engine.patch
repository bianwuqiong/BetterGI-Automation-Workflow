+using BetterGenshinImpact.GameTask.Common.Job;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class BackpackInventoryEvidenceTests
+{
+    private const string Name="狮牙斗士的铁链";
+    private static readonly BackpackSelection Selection=new(new(110,300,125,150),172,365,1000);
+    private static BackpackFrameEvidence Frame(long at,string raw="9",string name=Name,bool selected=true)=>new() {
+        ObservedAt=at,NameRegion=new(1300,90,500,80),NameRows=[new(name,1320,110,300,30)],
+        CountRegion=new(115,425,115,22),CountRows=[new(raw,115,425,115,22)],RawCountText=raw,
+        SelectedItemVerified=selected,SelectedItemRect=Selection.ItemRect };
+    [Fact] public void RawSelectedNamedStackRequiresTwoFreshMatchingFrames()
+    {
+        Assert.True(BackpackInventoryEvidenceSafety.Verified(new(Selection,Frame(1400),Frame(1700)),Name));
+        Assert.False(BackpackInventoryEvidenceSafety.Verified(new(Selection,Frame(1400),Frame(1400)),Name));
+        Assert.False(BackpackInventoryEvidenceSafety.Verified(new(Selection,Frame(7000),Frame(7300)),Name));
+        Assert.False(BackpackInventoryEvidenceSafety.Verified(new(Selection,Frame(1400),Frame(1700,"8")),Name));
+    }
+    [Theory] [InlineData("g")] [InlineData("9/9")] [InlineData("可合成数量9")] [InlineData("")] [InlineData("O")]
+    public void NoIconNumberGoalRequirementOrDigitRepairCanSupplyRawCount(string raw)=>
+        Assert.Null(BackpackInventoryEvidenceSafety.RawCount(Frame(1400,raw),Name,Selection));
+    [Fact] public void WrongNameAndUnprovenSelectedHighlightCannotCountPreviousPanel()
+    {
+        Assert.Null(BackpackInventoryEvidenceSafety.RawCount(Frame(1400,"9","狮牙斗士的镣铐"),Name,Selection));
+        Assert.Null(BackpackInventoryEvidenceSafety.RawCount(Frame(1400,"9",Name,false),Name,Selection));
+        var missing=new BackpackFrameEvidence{ObservedAt=1400};
+        Assert.Null(BackpackInventoryEvidenceSafety.RawCount(missing,Name,Selection));
+    }
+    [Fact] public void RequestsCannotChooseCoordinatesOtherResourceIdsOrDuplicateNames()
+    {
+        new BackpackInventoryRequest{Materials=[new(){MaterialId="114010",MaterialName=Name}]}.Validate();
+        Assert.Throws<ArgumentException>(()=>new BackpackInventoryRequest{Materials=[new(){MaterialId="112044",MaterialName=Name}]}.Validate());
+        Assert.Throws<ArgumentException>(()=>new BackpackInventoryRequest{Materials=[new(){MaterialId="114010",MaterialName=Name},new(){MaterialId="114011",MaterialName=Name}]}.Validate());
+    }
+    [Fact] public void ActualJsonBoundaryRejectsCallerCoordinatesAndKeepsRawEvidence()
+    {
+        Assert.Throws<Newtonsoft.Json.JsonSerializationException>(()=>ReadBackpackInventoryTask.ParseRequest(
+            "{\"materials\":[{\"materialId\":\"114010\",\"materialName\":\"狮牙斗士的铁链\"}],\"x\":123}"));
+        var request=ReadBackpackInventoryTask.ParseRequest("{\"materials\":[{\"materialId\":\"114010\",\"materialName\":\"狮牙斗士的铁链\"}]}");
+        var result=new BackpackInventoryResult {MainUiRestored=false};
+        result.Observations.Add(request.Materials[0].MaterialId,new(Selection,Frame(1400),Frame(1700)));
+        var json=Newtonsoft.Json.Linq.JObject.Parse(ReadBackpackInventoryTask.Serialize(result));
+        Assert.False(json.Value<bool>("mainUiRestored"));
+        Assert.Equal("9",json["observations"]!["114010"]!["first"]!.Value<string>("rawCountText"));
+        Assert.True(json["observations"]!["114010"]!["first"]!.Value<bool>("selectedItemVerified"));
+        Assert.Null(json["inventory"]);
+    }
+    [Fact] public void CleanupOnlyEscapesItsKnownBackpackOnceAndNeverConfirmsUnknownDialog()
+    {
+        Assert.True(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,true,false,false));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,true,true,false));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,false,false,false));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(true,true,false,true));
+        Assert.False(BackpackInventoryEvidenceSafety.CanEscapeBackpack(false,true,false,false));
+    }
+    [Fact] public async Task ActualPairCollectorUsesTwoCapturesAndStopsIfFirstCaptureCancels()
+    {
+        int captures=0;
+        var pair=await ReadBackpackInventoryTask.ObservePair(Selection,(_,_)=>Frame(++captures==1?1400:1700),
+            (_,_)=>Task.CompletedTask,CancellationToken.None);
+        Assert.Equal(2,captures);Assert.True(BackpackInventoryEvidenceSafety.Verified(pair,Name));
+        using var cancelled=new CancellationTokenSource();captures=0;
+        await Assert.ThrowsAsync<OperationCanceledException>(()=>ReadBackpackInventoryTask.ObservePair(Selection,(_,_)=> {
+            captures++;cancelled.Cancel();return Frame(1400); },(_,_)=>Task.CompletedTask,cancelled.Token));
+        Assert.Equal(1,captures);
+    }
+    [Fact] public async Task CancelledPairCollectorCannotReadAFrameOrPublishPartialPair()
+    {
+        using var cancelled=new CancellationTokenSource();cancelled.Cancel();int captures=0;
+        await Assert.ThrowsAsync<OperationCanceledException>(()=>ReadBackpackInventoryTask.ObservePair(Selection,
+            (_,_)=>{captures++;return Frame(1400);},(_,_)=>Task.CompletedTask,cancelled.Token));
+        Assert.Equal(0,captures);
+    }
+    [Fact] public void ActualSelectionRecordsClickTimeBeforeHoverLeaveAndChecksCancellationBeforeEachInput()
+    {
+        long now=1000;var actions=new List<string>();
+        var selection=ReadBackpackInventoryTask.SelectCell(Selection.ItemRect,()=>{actions.Add("click");now=1100;},
+            ()=>{actions.Add("leave_hover");now=1200;},()=>now,CancellationToken.None);
+        Assert.Equal(1000,selection.ClickedAt);Assert.Equal(new[]{"click","leave_hover"},actions);
+        using var cancelled=new CancellationTokenSource();actions.Clear();
+        Assert.Throws<OperationCanceledException>(()=>ReadBackpackInventoryTask.SelectCell(Selection.ItemRect,
+            ()=>{actions.Add("click");cancelled.Cancel();},()=>actions.Add("leave_hover"),()=>now,cancelled.Token));
+        Assert.Equal(new[]{"click"},actions);
+    }
+    [Fact] public void FourSidesRejectBottomLabelAloneAndMissingVerticalOutline()
+    {
+        var item=new Rect(30,30,125,153);
+        using var mat=new Mat(250,250,MatType.CV_8UC3,new Scalar(90,90,90));
+        Cv2.Rectangle(mat,new Rect(30,158,125,25),new Scalar(230,230,230),-1);
+        Assert.False(BackpackInventoryEvidenceSafety.ReadSelectedBorder(mat,item).Verified);
+        Cv2.Rectangle(mat,item,new Scalar(250,250,250),2);
+        Assert.True(BackpackInventoryEvidenceSafety.ReadSelectedBorder(mat,item).Verified);
+        Cv2.Rectangle(mat,new Rect(20,40,20,100),new Scalar(90,90,90),-1);
+        Assert.False(BackpackInventoryEvidenceSafety.ReadSelectedBorder(mat,item).Verified);
+    }
+    [Theory]
+    [InlineData("lion-chain-selected-frame-1-2026-10-10T02-36-25-187Z.png")]
+    [InlineData("lion-chain-selected-frame-2-2026-10-10T02-36-46-962Z.png")]
+    [Trait("Fixture","PrivateBackpack")]
+    public void ActualRetainedSelectedBorderRejectsBothAdjacentStacks(string file)
+    {
+        // Private local fixture is opt-in; the full selected regression command sets this path.
+        // No screenshots or UID-containing pixels are copied into the source tree.
+        var directory=Environment.GetEnvironmentVariable("BGI_PRIVATE_BACKPACK_FIXTURE_DIR");
+        if(string.IsNullOrEmpty(directory))return;
+        using var image=Cv2.ImRead(Path.Combine(directory,file));
+        Assert.False(image.Empty());
+        using var client=new Mat(image,new Rect(2,29,1280,720));
+        var positive=BackpackInventoryEvidenceSafety.ReadSelectedBorder(client,new Rect(663,208,82,103));
+        Assert.True(positive.Verified);
+        Assert.All(positive.Sides,s=>Assert.Equal(s.SampleCount,s.NeutralCount));
+        Assert.False(BackpackInventoryEvidenceSafety.ReadSelectedBorder(client,new Rect(565,208,82,103)).Verified);
+        Assert.False(BackpackInventoryEvidenceSafety.ReadSelectedBorder(client,new Rect(760,208,82,103)).Verified);
+    }
+}
