+                        TaskTriggerDispatcher.Instance().SetTriggers(savedTriggers.Values.OrderByDescending(t => t.Priority).ToList());
+                    }
+                }
+                cleanupCompleted = true;
+            }
+            catch (Exception cleanupError)
+            {
+                status = "failed";
+                error = (error is null ? "" : error + "; ") + "cleanup: " + cleanupError.Message;
+            }
+        }
+        var result = new { task = "material-route", status, runId = request.RunId, routePath = request.RoutePath,
+            sha256 = request.Sha256, parameterEvidence = request, fightPointCount,
+            completedFightPoints = execution?.CompletedFightPoints ?? [], observedHoldCasts = execution?.ObservedHoldCasts ?? 0,
+            actualTeam = execution?.ActualTeam ?? [],
+            shieldEvidence = execution?.ObservedHoldCasts > 0 ? "hold_skill_cooldown_observed" : "not_observed",
+            cleanupCompleted, mainUiRestored, noResinSpend = true, noCrafting = true, noUpgrade = true,
+            noFood = true, noRevive = true, ordinaryPick = true,
+            elapsedMs = Math.Round(timer.Elapsed.TotalMilliseconds), error };
+        Emit(result);
+        return JsonConvert.SerializeObject(result, jsonSettings);
+    }
