+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ResinSnapshotTests
+{
+    [Theory]
+    [InlineData(null, null)]
+    [InlineData("", null)]
+    [InlineData("unknown", null)]
+    [InlineData("201/200", null)]
+    [InlineData("20/160", null)]
+    [InlineData("20200", null)]
+    [InlineData("abc20/200", null)]
+    [InlineData("0/200", 0)]
+    [InlineData("200/200", 200)]
+    [InlineData(" １２０／２００ ", 120)]
+    public void OriginalRequiresCompleteCapacityReading(string? text, int? expected)
+        => Assert.Equal(expected, ResinSnapshot.ParseOriginal(text));
+
+    [Theory]
+    [InlineData(null, null)]
+    [InlineData("", null)]
+    [InlineData("6", null)]
+    [InlineData("-1", null)]
+    [InlineData("1/5", null)]
+    [InlineData("15", null)]
+    [InlineData("0", 0)]
+    [InlineData(" ５ ", 5)]
+    public void CondensedRequiresKnownBoundedNumber(string? text, int? expected)
+        => Assert.Equal(expected, ResinSnapshot.ParseCondensed(text));
+
+    [Theory]
+    [InlineData(null, null, 200, null)]
+    [InlineData(null, 0, 200, null)]
+    [InlineData(0, null, 200, null)]
+    [InlineData(120, 121, 200, null)]
+    [InlineData(-1, -1, 200, null)]
+    [InlineData(201, 201, 200, null)]
+    [InlineData(6, 6, 5, null)]
+    [InlineData(0, 0, 200, 0)]
+    [InlineData(120, 120, 200, 120)]
+    [InlineData(5, 5, 5, 5)]
+    public void VerificationNeedsTwoValidIdenticalObservations(int? first, int? second, int max, int? expected)
+        => Assert.Equal(expected, ResinSnapshot.StableCount(first, second, max));
+
+    [Theory]
+    [InlineData(147)]
+    [InlineData(0)]
+    public void TwoStableOriginalFramesFinishWithUnknownCondensed(int original)
+    {
+        var first = ResinSnapshot.ObservePair(null, original, null, null, default);
+        Assert.Null(first.Original);
+        Assert.False(first.CanFinish);
+        var second = ResinSnapshot.ObservePair(original, original, null, null, default);
+        Assert.Equal(original, second.Original);
+        Assert.Null(second.Condensed);
+        Assert.True(second.CanFinish);
+    }
+
+    [Theory]
+    [InlineData(147, 148, null, null)]
+    [InlineData(147, 147, 2, null)]
+    [InlineData(147, 147, null, 2)]
+    [InlineData(147, 147, 2, 3)]
+    public void UnstableOriginalOrOneFrameCondensedMissCannotFinish(
+        int previousOriginal, int currentOriginal, int? previousCondensed, int? currentCondensed)
+    {
+        var pair = ResinSnapshot.ObservePair(previousOriginal, currentOriginal,
+            previousCondensed, currentCondensed, default);
+        Assert.False(pair.CanFinish);
+        Assert.Null(pair.Condensed);
+    }
+
+    [Fact]
+    public void StableExplicitCondensedZeroRemainsKnownZero()
+    {
+        var pair = ResinSnapshot.ObservePair(147, 147, 0, 0, default);
+        Assert.Equal(0, pair.Condensed);
+        Assert.True(pair.CanFinish);
+    }
+
+    [Fact]
+    public void CancellationBetweenOcrFramesCannotPublishPartialVerification()
+    {
+        using var cts = new CancellationTokenSource();
+        var first = ResinSnapshot.ObservePair(null, 147, null, null, cts.Token);
+        Assert.Null(first.Original);
+        cts.Cancel();
+        Assert.Throws<OperationCanceledException>(() => ResinSnapshot.ObservePair(147, 147, null, null, cts.Token));
+    }
+}
