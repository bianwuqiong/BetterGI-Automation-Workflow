+using System.Dynamic;
+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CultivationCraftTaskTests
+{
+    [Theory]
+    [InlineData("", 1, "蒙德")]
+    [InlineData(" ", 1, "蒙德")]
+    [InlineData("材料\n", 1, "蒙德")]
+    [InlineData("浓缩树脂", 1, "蒙德")]
+    [InlineData("脆弱树脂", 1, "璃月")]
+    [InlineData("须臾树脂", 1, "璃月")]
+    [InlineData("树 脂", 1, "蒙德")]
+    [InlineData("濃縮樹脂", 1, "蒙德")]
+    [InlineData("Condensed RESIN", 1, "蒙德")]
+    [InlineData("「自由」的指引", 0, "蒙德")]
+    [InlineData("「自由」的指引", -1, "蒙德")]
+    [InlineData("「自由」的指引", 1000, "蒙德")]
+    [InlineData("「自由」的指引", 1, "稻妻")]
+    [InlineData("「自由」的指引", 1, "../璃月")]
+    public async Task InvalidInputNeverReachesNavigation(string name, int quantity, string country)
+    {
+        var calls = 0;
+        var task = new CultivationCraftTask((_, _) => { calls++; return Task.CompletedTask; },
+            (_, _, _) => { calls++; return Task.FromResult(new CraftMaterialResult()); },
+            _ => { calls++; return Task.FromResult(true); });
+        await Assert.ThrowsAnyAsync<ArgumentException>(() => task.Start(name, quantity, country, default, default));
+        Assert.Equal(0, calls);
+    }
+
+    [Fact]
+    public void LongNamesAreRejected() => Assert.Throws<ArgumentException>(
+        () => CultivationCraftTask.Validate(new string('材', 81), 1, "蒙德"));
+
+    [Theory]
+    [InlineData("蒙德", 1)]
+    [InlineData("璃月", 999)]
+    public async Task ValidRequestUsesOneTokenAndExposesOnlyOutcome(string country, int quantity)
+    {
+        var tokens = new List<CancellationToken>();
+        var task = new CultivationCraftTask((actualCountry, ct) =>
+        {
+            Assert.Equal(country, actualCountry); tokens.Add(ct); return Task.CompletedTask;
+        }, (name, q, ct) =>
+        {
+            Assert.Equal("「自由」的指引", name); Assert.Equal(quantity, q); tokens.Add(ct);
+            return Task.FromResult(CraftMaterialResult.CreateSuccess(name, q, q, "角色天赋素材", []));
+        }, ct => { tokens.Add(ct); return Task.FromResult(true); });
+        var result = (IDictionary<string, object?>)await task.Start("「自由」的指引", quantity, country, default, default);
+        Assert.Equal(3, tokens.Count);
+        Assert.True(tokens.All(t => t == tokens[0] && t.CanBeCanceled));
+        Assert.Equal(true, result["Success"]);
+        Assert.Equal(true, result["MainUiRestored"]);
+        Assert.Equal(quantity, result["ActualQuantity"]);
+        Assert.False(result.ContainsKey("Rewards"));
+    }
+
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public async Task PreCancelledCallerOrGlobalNeverStarts(bool cancelCaller)
+    {
+        using var caller = new CancellationTokenSource();
+        using var global = new CancellationTokenSource();
+        (cancelCaller ? caller : global).Cancel();
+        var calls = 0;
+        var task = new CultivationCraftTask((_, _) => { calls++; return Task.CompletedTask; },
+            (_, _, _) => throw new Xunit.Sdk.XunitException("Craft must not start"),
+            _ => throw new Xunit.Sdk.XunitException("Restore must not start"));
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => task.Start("材料", 1, "蒙德", caller.Token, global.Token));
+        Assert.Equal(0, calls);
+    }
+
+    [Theory]
+    [InlineData(true)]
+    [InlineData(false)]
+    public async Task CancellationDuringNavigationReachesAwaitAndPreventsCraft(bool cancelCaller)
+    {
+        using var caller = new CancellationTokenSource();
+        using var global = new CancellationTokenSource();
+        var task = new CultivationCraftTask(async (_, ct) =>
+        {
+            (cancelCaller ? caller : global).Cancel();
+            await Task.Delay(Timeout.Infinite, ct);
+        }, (_, _, _) => throw new Xunit.Sdk.XunitException("Craft must not start"),
+            _ => throw new Xunit.Sdk.XunitException("Restore must not start"));
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => task.Start("材料", 1, "蒙德", caller.Token, global.Token));
+    }
+
+    [Fact]
+    public async Task CancellationAfterNavigationCannotStartCraftEvenIfNavigationSwallowedIt()
+    {
+        using var caller = new CancellationTokenSource();
+        var task = new CultivationCraftTask((_, _) => { caller.Cancel(); return Task.CompletedTask; },
+            (_, _, _) => throw new Xunit.Sdk.XunitException("Craft must not start"),
+            _ => throw new Xunit.Sdk.XunitException("Restore must not start"));
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => task.Start("材料", 1, "蒙德", caller.Token, default));
+    }
+
+    [Fact]
+    public async Task CancellationDuringCraftPreventsRestorationAndFalseSuccess()
+    {
+        using var caller = new CancellationTokenSource();
+        var calls = 0;
+        var task = new CultivationCraftTask((_, _) => Task.CompletedTask, async (_, _, ct) =>
+        {
+            calls++; caller.Cancel(); await Task.Delay(Timeout.Infinite, ct); return new CraftMaterialResult();
+        }, _ => throw new Xunit.Sdk.XunitException("Restore must not start"));
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => task.Start("材料", 1, "蒙德", caller.Token, default));
+        Assert.Equal(1, calls);
+    }
+
+    [Fact]
+    public async Task FailedCraftIsNotRetriedOrFollowedByCleanupInputs()
+    {
+        var calls = 0;
+        var task = new CultivationCraftTask((_, _) => Task.CompletedTask, (_, _, _) =>
+        {
+            calls++; throw new InvalidOperationException("outcome unknown");
+        }, _ => throw new Xunit.Sdk.XunitException("Restore must not start"));
+        await Assert.ThrowsAsync<InvalidOperationException>(() => task.Start("材料", 1, "蒙德", default, default));
+        Assert.Equal(1, calls);
+    }
+
+    [Fact]
+    public async Task UnverifiedMainUiRestorationIsReportedSeparately()
+    {
+        var task = new CultivationCraftTask((_, _) => Task.CompletedTask,
+            (n, q, _) => Task.FromResult(CraftMaterialResult.CreateSuccess(n, q, q, "角色天赋素材", [])),
+            _ => Task.FromResult(false));
+        var result = (IDictionary<string, object?>)await task.Start("材料", 1, "蒙德", default, default);
+        Assert.Equal(true, result["Success"]);
+        Assert.Equal(false, result["MainUiRestored"]);
+    }
+}
