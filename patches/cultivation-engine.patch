+using System;
+using System.Text.RegularExpressions;
+using System.Threading;
+using BetterGenshinImpact.Helpers;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>Strict parsing for read-only observations. Missing icons/text are unknown, never zero.</summary>
+public static class ResinSnapshot
+{
+    public static int? ParseOriginal(string? text)
+    {
+        var normalized = StringUtils.ConvertFullWidthNumToHalfWidth(text ?? string.Empty).Replace('／', '/');
+        var match = Regex.Match(normalized, @"^\s*(?<count>[0-9]{1,3})\s*/\s*200\s*$");
+        return match.Success && int.TryParse(match.Groups["count"].Value, out var count) && count <= 200
+            ? count : null;
+    }
+
+    public static int? ParseCondensed(string? text)
+    {
+        var normalized = StringUtils.ConvertFullWidthNumToHalfWidth(text ?? string.Empty);
+        var match = Regex.Match(normalized, @"^\s*(?<count>[0-5])\s*$");
+        return match.Success ? int.Parse(match.Groups["count"].Value) : null;
+    }
+
+    public static int? StableCount(int? first, int? second, int maximum)
+    {
+        return first.HasValue && first == second && first >= 0 && first <= maximum ? first : null;
+    }
+
+    internal static (int? Original, int? Condensed, bool CanFinish) ObservePair(
+        int? previousOriginal, int? currentOriginal, int? previousCondensed, int? currentCondensed,
+        CancellationToken ct)
+    {
+        // OCR may finish after cancellation. Do not publish that frame as verified.
+        ct.ThrowIfCancellationRequested();
+        var original = StableCount(previousOriginal, currentOriginal, 200);
+        var condensed = StableCount(previousCondensed, currentCondensed, 5);
+        // Two unreadable condensed observations remain unknown; they need not delay a
+        // verified original-only observation. A one-frame miss still waits for stability.
+        var canFinish = original.HasValue && (condensed.HasValue
+            || (previousCondensed is null && currentCondensed is null));
+        return (original, condensed, canFinish);
+    }
+}
