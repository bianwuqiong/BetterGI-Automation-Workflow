+        string? terminal = null;
+        var timer = Stopwatch.StartNew();
+        var settings = new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver(),
+            MissingMemberHandling = MissingMemberHandling.Error };
+        void Emit(object payload)
+        {
+            var json = JsonConvert.SerializeObject(payload, settings);
+            TaskControl.Logger.LogInformation("[AUTO_GAME_EVENT] {Payload}", json);
+            if ((string?)JObject.Parse(json)["status"] != "started") terminal = json;
+        }
+        var previous = Avatar.MaterialRouteRecoveryForbidden.Value;
+        Avatar.MaterialRouteRecoveryForbidden.Value = true;
+        using var linked = CancellationTokenSource.CreateLinkedTokenSource(
+            CancellationContext.Instance.Cts.Token, customCt ?? CancellationToken.None);
+        try
+        {
+            request = JsonConvert.DeserializeObject<PartyPreparationRequest>(requestJson, settings)
+                ?? throw new ArgumentException("队伍免费恢复参数为空");
+            await PartyPreparation.Prepare(request, linked.Token, Emit);
+        }
+        catch (Exception exception)
+        {
+            if (terminal is null)
+                Emit(new { task = "party-preparation", status = linked.IsCancellationRequested ? "cancelled" : "failed",
+                    runId = request.RunId, parameterEvidence = request, statue = PartyPreparation.StatueEvidence,
+                    evidenceVerified = false, cleanupCompleted = false, actualTeam = Array.Empty<string>(),
+                    slotHealthEvidence = Array.Empty<PartySlotHealthEvidence>(), teamObservationCount = 0,
+                    revivalMayHaveOccurred = false, noItemConsumption = true, noRevivalItemConsumption = true,
+                    noResinSpend = true, noFood = true, noCrafting = true, noUpgrade = true,
+                    elapsedMs = Math.Round(timer.Elapsed.TotalMilliseconds), error = exception.Message });
+        }
+        finally { Avatar.MaterialRouteRecoveryForbidden.Value = previous; }
+        return terminal!;
+    }
