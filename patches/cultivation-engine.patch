+using BetterGenshinImpact.GameTask.AutoPathing;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MaterialTeleportTracePolicyTests
+{
+    [Fact]
+    public void UnchangedStateIsThrottledButResetAndTransitionsAreRecorded()
+    {
+        var trace = new MaterialTeleportTracePolicy();
+        Assert.True(trace.Record("map", 0));
+        Assert.False(trace.Record("map", 100));
+        Assert.True(trace.Record("loading", 200));
+        Assert.False(trace.Record("loading", 1199));
+        Assert.True(trace.Record("loading", 1200));
+        Assert.True(trace.Record("world_without_loading", 1201));
+    }
+    [Fact]
+    public void DiagnosticsCannotBecomeAnUnboundedPerFrameLog()
+    {
+        var trace = new MaterialTeleportTracePolicy();
+        for (var i = 0; i < 500; i++) trace.Record("state-" + i, i);
+        Assert.Equal(60, trace.Rows);
+        Assert.False(trace.Record("later", 60000));
+    }
+    [Fact]
+    public void FinalResetReasonDistinguishesMissedLoadingFromMapReappearance()
+    {
+        var proof = new MaterialTeleportProtocol();
+        proof.Observe(true, false, false, false, 0);
+        Assert.Equal(1, proof.LoadingFrames);
+        proof.Observe(true, false, false, false, 100);
+        Assert.True(proof.LoadingObserved);
+        proof.Observe(true, true, false, false, 1500);
+        Assert.Equal(1, proof.WorldFrames);
+        proof.Observe(true, false, true, false, 1600);
+        Assert.Equal("big_map_visible", proof.StateReason);
+        Assert.False(proof.LoadingObserved);
+        proof.Observe(true, true, false, false, 1700);
+        Assert.Equal("world_without_loading", proof.StateReason);
+        Assert.Equal(0, proof.WorldFrames);
+    }
+    [Fact]
+    public void FiveUnitPreparationRadiusCannotBorrowTwentyUnitRouteTolerance()
+    {
+        var tracker = new MaterialArrivalTracker(0, 0, maximumDistance: 5);
+        Assert.False(tracker.Observe(true, 6, 0));
+        Assert.False(tracker.Observe(true, 5, 0));
+        Assert.True(tracker.Observe(true, 4, 0));
+        foreach (var invalid in new[] {-1d, 0, 21, double.PositiveInfinity, double.NaN}) {
+            var bad = new MaterialArrivalTracker(0, 0, invalid);
+            Assert.False(bad.Observe(true, 0, 0));
+            Assert.False(bad.Observe(true, 0, 0));
+        }
+    }
+}
