+using BetterGenshinImpact.Core.Recognition.ONNX;
+
+namespace BetterGenshinImpact.UnitTest.CoreTests.RecognitionTests;
+
+public class BgiOnnxProviderPolicyTests
+{
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(false, true)]
+    [InlineData(true, false)]
+    [InlineData(true, true)]
+    public void AvatarGridIconAlwaysUsesCpu(bool cpuOcr, bool ocr)
+    {
+        Assert.Equal(new[] { ProviderType.Cpu },
+            BgiOnnxFactory.SelectForcedProviders("AvatarGridIcon", cpuOcr, ocr));
+    }
+
+    [Theory]
+    [InlineData("PpOcrDetV5", false, true)]
+    [InlineData("PpOcrRecV5", false, true)]
+    [InlineData("BgiTree", false, false)]
+    [InlineData("BgiFish", true, false)]
+    [InlineData("BgiAvatarSide", true, false)]
+    public void OtherModelsKeepConfiguredProviders(string modelName, bool cpuOcr, bool ocr)
+    {
+        Assert.Null(BgiOnnxFactory.SelectForcedProviders(modelName, cpuOcr, ocr));
+    }
+
+    [Fact]
+    public void ExplicitCpuOcrSettingStillForcesCpu()
+    {
+        Assert.Equal(new[] { ProviderType.Cpu },
+            BgiOnnxFactory.SelectForcedProviders("PpOcrDetV5", true, true));
+    }
+}
