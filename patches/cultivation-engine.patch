+using BetterGenshinImpact.GameTask.AutoPathing;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MaterialTeleportProtocolTests
+{
+    [Fact]
+    public void SlowFirstGlobalReadNeedsSecondFreshReadingWithinArrivalWindow()
+    {
+        var tracker = new MaterialArrivalTracker(-867.7, 2281.4);
+        Assert.False(tracker.Observe(true, -867.68164, 2281.37793, elapsedMs: 5366));
+        Assert.False(tracker.Verified);
+        Assert.True(tracker.Observe(true, -867.682, 2281.378, elapsedMs: 10800));
+        Assert.True(tracker.Verified);
+        Assert.Equal(15000, MaterialArrivalTracker.ReadWindowMs);
+    }
+
+    [Fact]
+    public void SlowSecondReadingAtDeadlineFailsEvenWithCorrectPositionAndKeepsReading()
+    {
+        var tracker = new MaterialArrivalTracker(-867.7, 2281.4);
+        Assert.False(tracker.Observe(true, -867.68164, 2281.37793, elapsedMs: 5366));
+        Assert.False(tracker.Observe(true, -867.682, 2281.378, elapsedMs: 15000));
+        Assert.False(tracker.Verified);
+        Assert.Equal("arrival_deadline_expired", tracker.Rejection);
+        Assert.Equal(-867.682, tracker.ActualX);
+    }
+
+    [Fact]
+    public void LargerReadWindowDoesNotPermitSingleFrameOrWrongWorldPosition()
+    {
+        var tracker = new MaterialArrivalTracker(-766.2, -3560.5);
+        Assert.False(tracker.Observe(true, -867.68164, 2281.37793, elapsedMs: 5366));
+        Assert.False(tracker.Observe(true, -766.2, -3560.5, elapsedMs: 10800));
+        Assert.False(tracker.Verified);
+        Assert.False(tracker.Observe(true, null, null, elapsedMs: 14000));
+        Assert.False(tracker.Verified);
+    }
+
+    [Fact]
+    public void ClosingMapWithoutConfirmCannotCountAsLoadingOrCompleted()
+    {
+        var protocol = new MaterialTeleportProtocol();
+        Assert.False(protocol.Observe(false, false, false, false, 0));
+        Assert.False(protocol.Observe(false, false, false, false, 100));
+        Assert.False(protocol.Observe(false, true, false, false, 1500));
+        Assert.False(protocol.Observe(false, true, false, false, 1700));
+        Assert.False(protocol.LoadingObserved);
+    }
+
+    [Fact]
+    public void SingleUnknownFlashCannotMasqueradeAsLoading()
+    {
+        var protocol = new MaterialTeleportProtocol();
+        Assert.False(protocol.Observe(true, false, false, false, 100));
+        Assert.False(protocol.Observe(true, true, false, false, 1500));
+        Assert.False(protocol.Observe(true, true, false, false, 1800));
+        Assert.False(protocol.LoadingObserved);
+    }
+
+    [Fact]
+    public void ActualConfirmNeedsTwoLoadingAndTwoWorldFrames()
+    {
+        var protocol = new MaterialTeleportProtocol();
+        Assert.False(protocol.Observe(true, false, true, false, 0));
+        Assert.False(protocol.Observe(true, false, false, false, 100));
+        Assert.False(protocol.Observe(true, false, false, false, 200));
+        Assert.True(protocol.LoadingObserved);
+        Assert.False(protocol.Observe(true, true, false, false, 1100));
+        Assert.True(protocol.Observe(true, true, false, false, 1300));
+    }
+
+    [Fact]
+    public void MinimumWaitAndReviveStillBlockCompletion()
+    {
+        var protocol = new MaterialTeleportProtocol();
+        protocol.Observe(true, false, false, false, 100);
+        protocol.Observe(true, false, false, false, 200);
+        Assert.False(protocol.Observe(true, true, false, false, 500));
+        Assert.False(protocol.Observe(true, true, false, false, 800));
+        Assert.False(protocol.Observe(true, true, false, true, 1100));
+        Assert.False(protocol.LoadingObserved);
+    }
+
+    [Fact]
+    public void ReappearingMapInvalidatesOldLoadingProof()
+    {
+        var protocol = new MaterialTeleportProtocol();
+        protocol.Observe(true, false, false, false, 100);
+        protocol.Observe(true, false, false, false, 200);
+        protocol.Observe(true, false, true, false, 800);
+        Assert.False(protocol.Observe(true, true, false, false, 1200));
+        Assert.False(protocol.Observe(true, true, false, false, 1500));
+    }
+
+    [Fact]
+    public void MondstadtCannotProveWatatsumiArrival()
+    {
+        var tracker = new MaterialArrivalTracker(-766.2, -3560.5);
+        Assert.False(tracker.Observe(true, -867.7, 2281.4));
+        Assert.False(tracker.Observe(true, -867.7, 2281.4));
+        Assert.False(tracker.Verified);
+        Assert.Equal(-867.7, tracker.ActualX);
+        Assert.Equal(2281.4, tracker.ActualY);
+        Assert.Contains("outside", tracker.Rejection);
+    }
+
+    [Fact]
+    public void RejectedFrameResetsTwoConsecutiveArrivals()
+    {
+        var tracker = new MaterialArrivalTracker(-867.7, 2281.4);
+        Assert.False(tracker.Observe(true, -867.7, 2281.4));
+        Assert.False(tracker.Observe(true, -900, 2300));
+        Assert.False(tracker.Observe(true, -867.7, 2281.4));
+        Assert.True(tracker.Observe(true, -868, 2281));
+    }
+
+    [Fact]
+    public void NullGroundedAndNanCannotUseLastObservedPositionAsProof()
+    {
+        var tracker = new MaterialArrivalTracker(1, 2);
+        tracker.Observe(true, 1, 2);
+        Assert.False(tracker.Observe(false, 1, 2));
+        Assert.False(tracker.Observe(true, 1, 2));
+        Assert.False(tracker.Observe(true, null, null));
+        Assert.False(tracker.Observe(true, double.NaN, 2));
+        Assert.False(tracker.Verified);
+    }
+
+    [Fact]
+    public void KeepsRejectedReadingEvenIfFollowingFrameIsUnrecognized()
+    {
+        var tracker = new MaterialArrivalTracker(1, 2);
+        tracker.Observe(true, 100, 200);
+        tracker.Observe(true, null, null);
+        Assert.Equal(100, tracker.ActualX);
+        Assert.Equal(200, tracker.ActualY);
+        Assert.False(tracker.Verified);
+    }
+
+    [Fact]
+    public void TwentyUnitBoundIsUnchangedAndDeadlineCannotReturnSuccess()
+    {
+        var tracker = new MaterialArrivalTracker(100, 200);
+        Assert.False(tracker.Observe(true, 120.01, 200));
+        Assert.False(tracker.Observe(true, 115, 215));
+        Assert.False(tracker.Observe(true, 120, 200));
+        Assert.True(tracker.Observe(true, 120, 200));
+        tracker.Expire();
+        Assert.False(tracker.Verified);
+        Assert.Equal("arrival_deadline_expired", tracker.Rejection);
+        Assert.Equal(120, tracker.ActualX);
+    }
+}
