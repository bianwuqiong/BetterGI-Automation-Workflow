+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoFight;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MaterialRecoverySafetyTests
+{
+    private static readonly string[] Team = ["桑多涅", "奥黛塔", "八重神子", "钟离"];
+    private static MaterialRecoveryRequest Request() => new() { RunId = "test-s1", ExpectedTeam = Team };
+
+    [Fact]
+    public void HistoricalSingleRouteMayOmitTargetButCannotClaimMatchedTeam()
+    {
+        MaterialRouteSafety.ValidateRequest(new MaterialRouteRequest { RunId = "legacy", PartyName = "预设名称",
+            Sha256 = new string('a', 64) });
+        Assert.False(MaterialRouteSafety.TeamMatches([], Team, [1, 2, 3, 4], false));
+        var recovery = Request(); recovery.ExpectedTeam = [];
+        Assert.Throws<ArgumentException>(recovery.Validate);
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(3)]
+    [InlineData(5)]
+    public void RecoveryRequiresFullFourSlots(int count)
+    {
+        var request = Request(); request.ExpectedTeam = Enumerable.Repeat("钟离", count).ToArray();
+        Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    [Fact]
+    public void RejectsDuplicateAndWhitespaceIdentities()
+    {
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateExpectedTeam(["钟离", "钟离", "八重神子", "奥黛塔"]));
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateExpectedTeam(["桑多涅", "奥黛塔", " 八重神子", "钟离"]));
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateExpectedTeam(null));
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(61)]
+    public void RecoveryCannotExtendSixtySecondLimit(int timeout)
+    {
+        var request = Request(); request.TimeoutSeconds = timeout;
+        Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    [Theory]
+    [InlineData("nearest-statue")]
+    [InlineData("route-point")]
+    [InlineData("-867,2281")]
+    public void CallerCannotChooseUntrustedRecoveryPosition(string hub)
+    {
+        var request = Request(); request.SafeHub = hub;
+        Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    [Fact]
+    public void ExplicitStartupAndAfterAreValidButNeverFightOrReplay()
+    {
+        var request = Request(); request.Stage = "startup"; request.Validate();
+        request.Stage = "after"; request.Validate();
+        request.Stage = "retry"; Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    [Fact]
+    public void ExactTeamMustIncludeFourMatchingNamesInObservedSlots()
+    {
+        Assert.True(MaterialRouteSafety.TeamMatches(Team, Team, [1, 2, 3, 4], false));
+        Assert.False(MaterialRouteSafety.TeamMatches(Team, Team.Reverse().ToArray(), [1, 2, 3, 4], false));
+        Assert.False(MaterialRouteSafety.TeamMatches(Team, Team, [1, 3, 2, 4], false));
+        Assert.False(MaterialRouteSafety.TeamMatches(Team, Team, [1, 2, 3, 4], true));
+        Assert.False(MaterialRouteSafety.TeamMatches(Team, Team[..3], [1, 2, 3], false));
+        Assert.False(MaterialRouteSafety.TeamMatches([], Team, [1, 2, 3, 4], false));
+    }
+
+    [Fact]
+    public void PositionMustBeFiniteAndInsideFixedCityRadius()
+    {
+        var x = MaterialRecoveryRequest.HubX; var y = MaterialRecoveryRequest.HubY;
+        Assert.True(MaterialRouteSafety.SafeHubPosition(x, y));
+        Assert.True(MaterialRouteSafety.SafeHubPosition(x + 20, y));
+        Assert.False(MaterialRouteSafety.SafeHubPosition(x + 20.01, y));
+        Assert.False(MaterialRouteSafety.SafeHubPosition(x + 15, y + 15));
+        Assert.False(MaterialRouteSafety.SafeHubPosition(double.NaN, y));
+        Assert.False(MaterialRouteSafety.SafeHubPosition(x, double.PositiveInfinity));
+        Assert.False(MaterialRouteSafety.SafeHubPosition(0, 0));
+    }
+
+    [Theory]
+    [InlineData("loading")]
+    [InlineData("mainUi")]
+    [InlineData("grounded")]
+    [InlineData("position")]
+    [InlineData("revive")]
+    [InlineData("team")]
+    public void TeleportReturnAloneCannotProveRecovery(string missing)
+    {
+        var proof = new MaterialRecoveryProof { LoadingObserved = true, MainUiRestored = true, Grounded = true,
+            PositionVerified = true, NoRevivePrompt = true, TeamVerified = true };
+        Assert.True(proof.EvidenceVerified(true));
+        switch (missing)
+        {
+            case "loading": proof.LoadingObserved = false; break;
+            case "mainUi": proof.MainUiRestored = false; break;
+            case "grounded": proof.Grounded = false; break;
+            case "position": proof.PositionVerified = false; break;
+            case "revive": proof.NoRevivePrompt = false; break;
+            case "team": proof.TeamVerified = false; break;
+        }
+        Assert.False(proof.EvidenceVerified(true));
+        Assert.Equal(missing == "team", proof.EvidenceVerified(false));
+    }
+
+    [Theory]
+    [InlineData("跳跃时不能切换角色", true, false)]
+    [InlineData("切换角色仍在冷却", false, true)]
+    [InlineData("切换仍冷却", false, true)]
+    [InlineData("", false, false)]
+    public void ExplicitSwitchBlockersCannotBeIgnored(string text, bool jump, bool cooldown)
+    {
+        Assert.Equal(jump, MaterialSwitchSafety.JumpBlocked(text));
+        Assert.Equal(cooldown, MaterialSwitchSafety.CooldownBlocked(text));
+    }
+}
