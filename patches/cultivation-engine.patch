+using BetterGenshinImpact.Core.Config;
+using Newtonsoft.Json;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class OneDragonFlowConfigTests
+{
+    [Fact]
+    public void LegacyConfigKeepsFinalRewardCheck()
+    {
+        var config = JsonConvert.DeserializeObject<OneDragonFlowConfig>("{\"Name\":\"legacy\"}");
+        Assert.NotNull(config);
+        Assert.False(config.SkipFinalRewardCheck);
+        Assert.False(new OneDragonFlowConfig().SkipFinalRewardCheck);
+    }
+
+    [Fact]
+    public void ScanConfigRoundTripPreservesSkipAndCompletionAction()
+    {
+        var config = JsonConvert.DeserializeObject<OneDragonFlowConfig>(
+            "{\"SkipFinalRewardCheck\":true,\"CompletionAction\":\"关闭游戏和软件\"}");
+        var restored = JsonConvert.DeserializeObject<OneDragonFlowConfig>(JsonConvert.SerializeObject(config));
+        Assert.NotNull(restored);
+        Assert.True(restored.SkipFinalRewardCheck);
+        Assert.Equal("关闭游戏和软件", restored.CompletionAction);
+    }
+}
