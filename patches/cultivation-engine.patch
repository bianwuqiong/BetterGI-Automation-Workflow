@@ -0,0 +1,56 @@
+using Microsoft.ClearScript;
+using Microsoft.ClearScript.V8;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+/// <summary>真实 ClearScript 与 List&lt;T&gt; 的边界验证，不使用游戏、图像或 UI。</summary>
+public class GuideCollectionInteropTests
+{
+    public sealed class OcrRow : IDisposable
+    {
+        public string Text { get; init; } = "武器";
+        public int X => 730;
+        public int Y => 220;
+        public int Width => 300;
+        public int Height => 28;
+        public int Disposals { get; private set; }
+        public void Dispose() => Disposals++;
+    }
+
+    [Fact]
+    public void DotNetListUsesNativeIterableAndDisposesRowsAfterOcrRead()
+    {
+        using var engine = new V8ScriptEngine();
+        var row = new OcrRow();
+        engine.AddHostObject("matches", new List<OcrRow> { row });
+        Assert.Equal(false, engine.Evaluate("Array.isArray(matches)"));
+        Assert.Equal("undefined", engine.Evaluate("typeof matches.get_Item"));
+        Assert.Equal("[{\"text\":\"武器\",\"x\":730,\"y\":220,\"width\":300,\"height\":28}]",
+            engine.Evaluate("""
+                (() => {
+                    const rows = Array.from(matches);
+                    try {
+                        return JSON.stringify(rows.map(row => ({text:String(row.Text),x:Number(row.X),y:Number(row.Y),
+                            width:Number(row.Width),height:Number(row.Height)})));
+                    } finally { for (const row of rows) row.Dispose(); }
+                })()
+                """));
+        Assert.Equal(1, row.Disposals);
+    }
+
+    [Fact]
+    public void NativeRowsStillDisposeWhenScriptProcessingThrows()
+    {
+        using var engine = new V8ScriptEngine();
+        var rows = new List<OcrRow> { new(), new() };
+        engine.AddHostObject("matches", rows);
+        Assert.Throws<ScriptEngineException>(() => engine.Evaluate("""
+            (() => {
+                const rows = Array.from(matches);
+                try { throw new Error('processing failed'); }
+                finally { for (const row of rows) row.Dispose(); }
+            })()
+            """));
+        Assert.All(rows, row => Assert.Equal(1, row.Disposals));
+    }
+}
