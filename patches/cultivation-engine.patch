+            {
+                Logger.LogInformation("单次原粹20提交请求已发送：Original20第一行和独立使用按钮双帧；singleClick=True button={Button}；消费与材料结果仍待外层实际库存和余额核验", current!.Button);
+                break;
+            }
+            previous = current;
+            await Delay(250, _ct);
+        }
+        if (!submission.Requested) throw new NormalEndException("单次原粹20第一行/独立使用按钮未获新鲜双帧证明，未提交且禁止通用确认或其他资源");
+        await Delay(1000, _ct); // Read-only UI settling, never a claim-success condition.
+        // The new reward UI can return directly to the domain HUD. Never reopen the tree or resubmit.
+        // A normal return merely permits the caller's mandatory exact inventory/resin checks.
+        if (!await ExitAfterSingleOriginalSubmission())
+            throw new NormalEndException("单次原粹20提交后安全退出未获双帧世界证明；结果未知，禁止再次领奖或普通退出兜底");
+        Logger.LogInformation("单次原粹20提交后已安全退出到世界双帧，native不宣称已消费或发奖，交外层库存/余额验收");
+        return false;
+    }
+
+    private async Task<bool> ExitAfterSingleOriginalSubmission()
+    {
+        var policy = new CombatOnlyExitPolicy();
+        var completion = new ProtectedClaimExitProtocol();
+        var timer = Stopwatch.StartNew();
+        ExactDomainExitProof? previousDialog = null;
+        Rect? previousRewardExit = null;
+        bool rewardExitClicked = false;
+        bool recognizedRewards = false;
+        Simulation.ReleaseAllKey();
+        while (timer.ElapsedMilliseconds < 30000)
+        {
+            _ct.ThrowIfCancellationRequested();
+            using var capture = CaptureToRectArea(forceNew: true);
+            if (Bv.IsInRevivePrompt(capture)) return false;
+            using var exitDoor = capture.Find(ElementRecognition.Get("BtnExitDoor", capture));
+            using var blackConfirm = capture.Find(ElementRecognition.Get("BtnBlackConfirm", capture));
+            using var legacyConfirm = capture.Find(RecognitionAssets.Get("AutoFight", "Confirm", capture));
+            using var legacyExit = capture.Find(RecognitionAssets.Get("AutoFight", "Exit", capture));
+            var mainUi = Bv.IsInMainUi(capture);
+            var inDomain = Bv.IsInDomain(capture);
+            var bigMap = Bv.IsInBigMapUi(capture);
+            var lowCostDialog = blackConfirm.IsExist() || legacyConfirm.IsExist();
+            // During a positive load candidate, avoid OCR and sample at 120ms so short loading remains observable twice.
+            if (completion.ExitRequested && !mainUi && !inDomain && !exitDoor.IsExist() && !lowCostDialog &&
+                !bigMap && HasProtectedLoadingBackground(capture))
+            {
+                if (!ProtectedClaimExitProtocol.WithinDeadline(timer.Elapsed)) break;
+                completion.Observe(false,false,false,false,false,false,false,false,true,timer.Elapsed);
+                await Delay(120,_ct); continue;
+            }
+            // Preserve classic results, but never click their continue/rechallenge control.
+            if (!rewardExitClicked && legacyExit.IsExist() && legacyConfirm.IsExist())
+            {
+                var controls = ReadClaimText(capture, new Rect(0, capture.Height / 2, capture.Width / 2, capture.Height / 2))
+                    .Where(t => SingleOriginal20ClaimSafety.Normalize(t.Text) is "退出" or "退出秘境").ToArray();
+                if (controls.Length == 1 && controls[0].Bounds.Height <= 80 * capture.Width / 1920d)
+                {
+                    var button = controls[0].Bounds;
+                    if (previousRewardExit.HasValue && SingleOriginal20ClaimSafety.SameRect(previousRewardExit.Value, button, capture.Width))
+                    {
+                        if (!recognizedRewards) { ObserveProtectedClassicRewards(); recognizedRewards = true; }
+                        // Reward recognition can move/drag the page. Obtain a new matching exit frame afterwards.
+                        using var fresh = CaptureToRectArea(forceNew: true);
+                        using var freshExit = fresh.Find(RecognitionAssets.Get("AutoFight", "Exit", fresh));
+                        var freshControls = ReadClaimText(fresh, new Rect(0, fresh.Height / 2, fresh.Width / 2, fresh.Height / 2))
+                            .Where(t => SingleOriginal20ClaimSafety.Normalize(t.Text) is "退出" or "退出秘境").ToArray();
+                        if (!freshExit.IsExist() || freshControls.Length != 1 || !SingleOriginal20ClaimSafety.SameRect(button, freshControls[0].Bounds, fresh.Width) || timer.ElapsedMilliseconds>=30000) return false;
