+            CancellationContext.Instance.Cts.Token, customCt ?? CancellationToken.None, timeout.Token);
+        var jsonSettings = new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() };
+        void Emit(object payload) => TaskControl.Logger.LogInformation("[AUTO_GAME_EVENT] {Payload}", JsonConvert.SerializeObject(payload, jsonSettings));
+        try
+        {
+            request = JsonConvert.DeserializeObject<MaterialRouteRequest>(requestJson) ?? throw new ArgumentException("路线参数为空");
+            MaterialRouteSafety.ValidateRequest(request);
+            if (!string.IsNullOrWhiteSpace(TaskContext.Instance().Config.AutoFightConfig.TeamNames))
+                throw new InvalidOperationException("材料路线禁止强制队伍姓名配置，必须实际识别世界队伍");
+            if (RunnerContext.Instance.AutoPickTriggerStopCount != 0)
+                throw new InvalidOperationException("自动拾取当前被其他任务暂停，拒绝开始材料路线");
+            timeout.CancelAfter(TimeSpan.FromSeconds(request.TimeoutSeconds));
+            var root = Global.Absolute(@"User\AutoPathing");
+            var fullPath = MaterialRouteSafety.ResolvePath(root, request.RoutePath);
+            var manifestPath = MaterialRouteSafety.ResolvePath(root, "auto_game_handguard/manifest.json");
+            var manifest = JObject.Parse(await File.ReadAllTextAsync(manifestPath, linked.Token));
+            var normalizedPath = request.RoutePath.Replace('\\', '/');
+            var allowed = manifest["routes"]?.Any(item =>
+                string.Equals((string?)item["path"], normalizedPath, StringComparison.OrdinalIgnoreCase) &&
+                string.Equals((string?)item["sha256"], request.Sha256, StringComparison.OrdinalIgnoreCase)) == true;
+            if (!allowed) throw new ArgumentException("路线路径/哈希不在本机固定订阅白名单");
+            var bytes = await File.ReadAllBytesAsync(fullPath, linked.Token);
+            if (!string.Equals(MaterialRouteSafety.Hash(bytes), request.Sha256, StringComparison.OrdinalIgnoreCase))
+                throw new ArgumentException("路线文件哈希不匹配");
+            var task = PathingTask.BuildFromJson(Encoding.UTF8.GetString(bytes).TrimStart('\uFEFF'));
+            MaterialRouteSafety.ValidateTask(task);
+            fightPointCount = task.Positions.Count(p => p.Action == "fight");
+            execution = new MaterialRouteExecution(request, Emit);
+            savedTriggers = new ConcurrentDictionary<string, ITaskTrigger>(GameTaskManager.TriggerDictionary ?? new());
+            TaskTriggerDispatcher.Instance().ClearTriggers();
+            if (!TaskTriggerDispatcher.Instance().AddTrigger("AutoPick", new AutoPickExternalConfig
+                { MaterialDropNames = ["破旧的刀镡", "影打刀镡", "名刀镡"] }))
+                throw new InvalidOperationException("无法启用普通怪刀镡拾取");
+            Emit(new { task = "material-route", status = "started", runId = request.RunId, routePath = request.RoutePath,
+                sha256 = request.Sha256, parameterEvidence = request, fightPointCount });
+            using (var capture = TaskControl.CaptureToRectArea(forceNew: true))
+                if (!Bv.IsInMainUi(capture) || Bv.IsInDomain(capture) || Bv.IsInRevivePrompt(capture))
+                    throw new InvalidOperationException("必须在可核验世界主界面开始材料路线");
+            bool skipPartyMenu = false;
+            if (request.ExpectedTeam.Length != 0)
+            {
+                var observed = await MaterialRecovery.ReadTeam(request.ExpectedTeam, linked.Token);
+                skipPartyMenu = observed.TwoFrames && observed.StateReady && observed.Matched;
+                if (!skipPartyMenu)
+                {
+                    await MaterialRecovery.Recover(new MaterialRecoveryRequest { RunId = request.RunId, Stage = "startup",
+                        ExpectedTeam = request.ExpectedTeam }, linked.Token, Emit, requireTeam: false);
+                    observed = await MaterialRecovery.ReadTeam(request.ExpectedTeam, linked.Token);
+                    skipPartyMenu = observed.TwoFrames && observed.StateReady && observed.Matched;
+                }
+            }
+            // Historical callers with no expectedTeam always select the requested party.
+            if (!skipPartyMenu && !await new SwitchPartyTask().Start(request.PartyName, linked.Token))
+                throw new InvalidOperationException("材料路线世界队伍切换失败");
+            if (request.ExpectedTeam.Length != 0)
+            {
+                var verifiedTeam = await MaterialRecovery.ReadTeam(request.ExpectedTeam, linked.Token);
+                if (!verifiedTeam.TwoFrames || !verifiedTeam.Matched)
+                    throw new InvalidOperationException("材料路线完整四人名单与号位未获两帧精确核验");
+                Emit(new { task = "material-route-team", status = "verified", runId = request.RunId,
+                    expectedTeam = request.ExpectedTeam, actualTeam = verifiedTeam.ActualTeam,
+                    slots = verifiedTeam.Slots, twoFrames = true, skipPartyMenu });
+            }
+            // Identity alone accepts defeated inactive members. Prove every slot alive and >=80% HP
+            // before the route's first teleport/approach. This gate never performs healing or resurrection.
+            var healthTeam = request.ExpectedTeam;
+            if (healthTeam.Length == 0)
+            {
+                using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                using var scene = new CombatScenes().InitializeTeam(frame, new AutoFightConfig { TeamNames = "" });
+                healthTeam = scene.GetAvatars().Select(a => a.Name).ToArray();
+            }
+            var slotHealth = await PartyHealth.VerifyAll(healthTeam, linked.Token);
+            Emit(new { task = "material-route-party-health", status = "verified", runId = request.RunId,
+                actualTeam = healthTeam, slotHealthEvidence = slotHealth, minimumHpRatio = PartyHealthSafety.MinimumRatio,
+                activeSlotRestored = 4, teamObservationCount = 2, noFood = true, noRevive = true });
+            RunnerContext.Instance.ClearCombatScenes();
+            var party = new PathingPartyConfig
+            {
+                Enabled = true, PartyName = request.PartyName, SkipPartySwitch = true,
+                AutoPickEnabled = true, AutoEatEnabled = false, AutoSkipEnabled = false,
+                RecoverTiming = RecoverTiming.Never, MaterialRoute = execution,
+                AutoFightEnabled = true,
+                AutoFightConfig = new AutoFightConfig { StrategyName = request.StrategyName }
+            };
+            var executor = new PathExecutor(linked.Token) { PartyConfig = party };
+            await executor.Pathing(task);
+            linked.Token.ThrowIfCancellationRequested();
+            if (!executor.SuccessEnd || execution.CompletedFightPoints.Count != fightPointCount || execution.ObservedHoldCasts == 0)
+                throw new InvalidOperationException("路线/逐战斗点完成证据不完整");
+            using (var finalCapture = TaskControl.CaptureToRectArea(forceNew: true))
+                mainUiRestored = Bv.IsInMainUi(finalCapture) && !Bv.IsInDomain(finalCapture) && !Bv.IsInRevivePrompt(finalCapture);
+            if (!mainUiRestored) throw new InvalidOperationException("材料路线结束后世界主界面未获核验");
+            status = "completed";
+        }
+        catch (Exception e)
+        {
+            status = CancellationContext.Instance.Cts.IsCancellationRequested || customCt?.IsCancellationRequested == true ? "cancelled" :
+                timeout.IsCancellationRequested ? "timeout" : "failed";
+            error = e.Message;
+        }
+        finally
+        {
+            Avatar.MaterialRouteRecoveryForbidden.Value = previousRecoveryPolicy;
+            try
+            {
+                try { Simulation.ReleaseAllKey(); }
+                finally
+                {
+                    RunnerContext.Instance.SuspendableDictionary.Remove("PathExecutor");
