+
+    [Fact]
+    public void SwallowedEscapeAndPersistentConfirmationHaveBoundedRetries()
+    {
+        var swallowed = new CombatOnlyExitPolicy();
+        for (var attempt = 0; attempt < 3; attempt++)
+            Assert.Equal(CombatOnlyExitAction.PressEscape, swallowed.Observe(true, true, false, false, TimeSpan.FromSeconds(attempt * 2)));
+        Assert.Equal(CombatOnlyExitAction.Wait, swallowed.Observe(true, true, false, false, TimeSpan.FromSeconds(10)));
+        var dialog = new CombatOnlyExitPolicy();
+        for (var attempt = 0; attempt < 3; attempt++)
+            Assert.Equal(CombatOnlyExitAction.ConfirmExit, dialog.Observe(false, true, false, true, TimeSpan.FromSeconds(attempt)));
+        Assert.Equal(CombatOnlyExitAction.Wait, dialog.Observe(false, true, false, true, TimeSpan.FromSeconds(5)));
+    }
+
+    [Theory]
