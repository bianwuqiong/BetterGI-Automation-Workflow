+using BetterGenshinImpact.GameTask.AutoFight.Model;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoFightTests;
+
+public class MaterialSwitchTimingPolicyTests
+{
+    [Fact]
+    public void GroundingDoesNotConsumeThePostKeyIdentityWindow()
+    {
+        // A 4.7s grounded check leaves a complete new phase after sending the first target key.
+        Assert.Equal(5000, MaterialSwitchTimingPolicy.GroundingBudgetMs);
+        Assert.True(MaterialSwitchTimingPolicy.IdentityWindowOpen(0));
+        Assert.True(MaterialSwitchTimingPolicy.IdentityWindowOpen(4700));
+        Assert.False(MaterialSwitchTimingPolicy.IdentityWindowOpen(5000));
+        Assert.False(MaterialSwitchTimingPolicy.IdentityWindowOpen(-1));
+    }
+
+    [Fact]
+    public void FirstStrictCandidateIsNeverInterruptedOrPromotedToVerified()
+    {
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(true, -2, 2, 1800, 0));
+        var identity = new AvatarActiveCheckContext { StrictIdentity = true };
+        Assert.Equal(-2, identity.ObserveStrictCandidate(2));
+        Assert.Equal(2, identity.ObserveStrictCandidate(2));
+        identity.ResetStrictCandidate();
+        Assert.Equal(-2, identity.ObserveStrictCandidate(1));
+        Assert.Equal(1, identity.ObserveStrictCandidate(1));
+        // A completed proof of the wrong slot permits a bounded target-key retry, never success.
+        Assert.True(MaterialSwitchTimingPolicy.ShouldRetryTarget(true, 1, 2, 1800, 0));
+    }
+
+    [Theory]
+    [InlineData(false, -1, 2, 1800, 0, false)]
+    [InlineData(true, 2, 2, 1800, 0, false)]
+    [InlineData(true, -1, 2, 999, 0, false)]
+    [InlineData(true, -1, 2, 1000, 0, true)]
+    [InlineData(true, -1, 2, 4999, 4000, false)]
+    [InlineData(true, -1, 2, 4999, 3999, true)]
+    [InlineData(true, -1, 2, 5000, 0, false)]
+    [InlineData(true, -1, 0, 1800, 0, false)]
+    [InlineData(true, -1, 5, 1800, 0, false)]
+    [InlineData(true, -1, 2, 1800, -1, false)]
+    public void RetryRequiresReadyStateValidSlotAndUnexpiredOneSecondBudget(bool ready, int active,
+        int target, long elapsed, long lastPress, bool retry) =>
+        Assert.Equal(retry, MaterialSwitchTimingPolicy.ShouldRetryTarget(ready, active, target, elapsed, lastPress));
+}
