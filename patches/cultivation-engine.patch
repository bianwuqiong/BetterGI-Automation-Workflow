+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.AutoFight.Script;
+using System.Runtime.CompilerServices;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoDomainTests;
+
+public class DomainCombatSafetyTests
+{
+    [Fact]
+    public void CombatOnlyNeverEnablesClaimEvenWhenConfiguredRoundCountIsUnlimited()
+    {
+        Assert.False(DomainCombatSafety.CanClaimRewards(true));
+        Assert.Equal(1, DomainCombatSafety.RoundLimit(true, 9999));
+        Assert.True(DomainCombatSafety.CanClaimRewards(false));
+        Assert.Equal(9999, DomainCombatSafety.RoundLimit(false, 9999));
+    }
+
+    [Theory]
+    [InlineData(4, 3.8)]
+    [InlineData(0, 0)]
+    [InlineData(double.NaN, 11)]
+    [InlineData(11, double.NaN)]
+    [InlineData(11, 13)]
+    [InlineData(11, 8)]
+    [InlineData(8, 7.8)]
+    [InlineData(9, 8.8)]
+    public void TapCooldownUnreadableOrInconsistentFramesCannotConfirmHold(double first, double second) =>
+        Assert.False(DomainCombatSafety.ConfirmObservedHoldCooldown(first, second));
+
+    [Theory]
+    [InlineData(11.8, 11.4)]
+    [InlineData(10.8, 11.1)]
+    public void FreshConsistentLongCooldownConfirmsOnlyCastEvidence(double first, double second) =>
+        Assert.True(DomainCombatSafety.ConfirmObservedHoldCooldown(first, second));
+
+    [Theory]
+    [InlineData(11, 6, true)]
+    [InlineData(10, 6, false)]
+    [InlineData(12, 0.2, true)]
+    [InlineData(5, 6, false)]
+    public void RefreshProtectsTheWindowBeforeAnUninterruptedCharge(double age, double duration, bool expected) =>
+        Assert.Equal(expected, DomainCombatSafety.ShouldRefresh(TimeSpan.FromSeconds(age), duration));
+
+    [Fact]
+    public void FirstCommandNeedsObservedCastAndOldChargeDurationIsPreserved()
+    {
+        Assert.True(DomainCombatSafety.ShouldRefresh(null, 0));
+        var charge = new CombatCommand("桑多涅", "charge(6)");
+        Assert.Equal(6, DomainCombatSafety.CommandDurationSeconds(charge));
+        Assert.Equal(new[] { "6" }, charge.Args);
+        Assert.Throws<ArgumentException>(() => DomainCombatSafety.CommandDurationSeconds(new("桑多涅", "charge(7)")));
+    }
+
+    [Theory]
+    [InlineData(true, false)]
+    [InlineData(false, true)]
+    [InlineData(true, true)]
+    public void UnadaptedJsonStrategyFailsBeforeNavigation(bool combatOnly, bool requireZhongli) =>
+        Assert.Throws<ArgumentException>(() => DomainCombatSafety.ValidateStrategy(combatOnly, requireZhongli, "strategy.JSON"));
+
+    [Fact]
+    public void LegacyDefaultsKeepJsonAllowed() => DomainCombatSafety.ValidateStrategy(false, false, "strategy.json");
+
+    [Theory]
+    [InlineData("桑多涅")]
+    [InlineData("八重神子")]
+    [InlineData("钟离")]
+    public void DeployedPresetNameCannotSubstituteForMissingActualCoreAvatar(string missing)
+    {
+        var actual = new[] { "桑多涅", "八重神子", "钟离", "奥黛塔" }.Where(name => name != missing);
+        Assert.Throws<InvalidOperationException>(() =>
+            DomainCombatSafety.ValidateCoreTeam(true, "木偶星超导.txt", actual));
+    }
+
+    [Theory]
+    [InlineData("奥黛塔")]
+    [InlineData("七七")]
+    public void ThreeActualCoreAvatarsPermitTheSupportedFourthSlot(string fourth) =>
+        DomainCombatSafety.ValidateCoreTeam(true, "木偶星超导.txt", ["桑多涅", "八重神子", "钟离", fourth]);
+
+    [Fact]
+    public void LegacyDefaultDoesNotAddCoreRosterRestrictions() =>
+        DomainCombatSafety.ValidateCoreTeam(false, "木偶星超导.txt", ["烟绯", "香菱", "班尼特", "钟离"]);
+
+    [Theory]
+    [InlineData("attack", 0.2)]
+    [InlineData("attack(0)", 0.2)]
+    [InlineData("attack(0.2)", 0.4)]
+    [InlineData("attack(1)", 1.2)]
+    public void AttackEstimateIncludesItsLastTwoHundredMillisecondPulse(string action, double expected) =>
+        Assert.Equal(expected, DomainCombatSafety.CommandDurationSeconds(new("桑多涅", action)), 6);
+
+    [Fact]
+    public void ClearingOrReplacingTaskPrioritiesNeverMutatesGlobalConfigOrSiblingTask()
+    {
+        var config = new AutoDomainConfig { ResinPriorityList = ["浓缩树脂", "原粹树脂"] };
+        // 绕过只与应用 DI/语言有关的构造，直接验证 SetDefault 使用的列表快照方法。
+        var first = (AutoDomainParam)RuntimeHelpers.GetUninitializedObject(typeof(AutoDomainParam));
+        var sibling = (AutoDomainParam)RuntimeHelpers.GetUninitializedObject(typeof(AutoDomainParam));
+        first.SetResinPriorityDefaults(config);
+        sibling.SetResinPriorityDefaults(config);
+        Assert.NotSame(config.ResinPriorityList, first.ResinPriorityList);
+        first.ResinPriorityList.Clear();
+        first.SetResinPriorityList("原粹树脂20");
+        Assert.Equal(new[] { "原粹树脂20" }, first.ResinPriorityList);
+        Assert.Equal(new[] { "浓缩树脂", "原粹树脂" }, config.ResinPriorityList);
+        Assert.Equal(config.ResinPriorityList, sibling.ResinPriorityList);
+    }
+
+    [Fact]
+    public async Task ProtectedEntryVerifiesWorldPartyBeforeTeleportAndStopsOnFailure()
+    {
+        var calls = new List<string>();
+        await Assert.ThrowsAsync<InvalidOperationException>(() => AutoDomainTask.RunDomainEntry(true, "目标队伍",
+            () => { calls.Add("world-switch-failed"); return Task.FromResult(false); },
+            () => { calls.Add("teleport"); return Task.CompletedTask; },
+            _ => { calls.Add("enter"); return Task.CompletedTask; }));
+        Assert.Equal(new[] { "world-switch-failed" }, calls);
+
+        calls.Clear();
+        await AutoDomainTask.RunDomainEntry(true, "目标队伍",
+            () => { calls.Add("world-switch-verified"); return Task.FromResult(true); },
+            () => { calls.Add("teleport"); return Task.CompletedTask; },
+            verified => { Assert.True(verified); calls.Add("enter-without-redundant-switch"); return Task.CompletedTask; });
+        Assert.Equal(new[] { "world-switch-verified", "teleport", "enter-without-redundant-switch" }, calls);
+    }
+
+    [Fact]
+    public void ExitDialogIsConfirmedWithoutSecondEscapeAndWorldEvidenceMustBeConsecutive()
+    {
+        var policy = new CombatOnlyExitPolicy();
+        Assert.Equal(CombatOnlyExitAction.PressEscape, policy.Observe(true, true, false, false, TimeSpan.Zero));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(true, true, false, false, TimeSpan.FromSeconds(0.5)));
+        Assert.Equal(CombatOnlyExitAction.ConfirmExit, policy.Observe(false, true, false, true, TimeSpan.FromSeconds(1)));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(false, false, false, false, TimeSpan.FromSeconds(3)));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(true, false, false, false, TimeSpan.FromSeconds(5)));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(false, false, false, false, TimeSpan.FromSeconds(5.5)));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(true, false, false, false, TimeSpan.FromSeconds(6)));
+        Assert.Equal(CombatOnlyExitAction.Complete, policy.Observe(true, false, false, false, TimeSpan.FromSeconds(6.5)));
+    }
+
+    [Fact]
+    public void RecognizedExitMenuUsesDoorBeforeConfirmation()
+    {
+        var policy = new CombatOnlyExitPolicy();
+        policy.Observe(true, true, false, false, TimeSpan.Zero);
+        Assert.Equal(CombatOnlyExitAction.ClickExitDoor, policy.Observe(false, true, true, false, TimeSpan.FromSeconds(1)));
+        Assert.True(policy.ExitDoorRequested);
+        Assert.Equal(CombatOnlyExitAction.ConfirmExit, policy.Observe(false, true, false, true, TimeSpan.FromSeconds(2)));
+    }
+
+    [Fact]
+    public void UnknownUiNeverReceivesAnEscapeRetryEvenAfterTheWaitWindow()
+    {
+        var policy = new CombatOnlyExitPolicy();
+        policy.Observe(true, true, false, false, TimeSpan.Zero);
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(false, true, false, false, TimeSpan.FromSeconds(5), anyDialogVisible: true));
+        Assert.Equal(CombatOnlyExitAction.Wait, policy.Observe(false, false, false, false, TimeSpan.FromSeconds(8)));
+        Assert.False(policy.ExitDoorRequested);
