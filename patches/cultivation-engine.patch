+using BetterGenshinImpact.GameTask.AutoDomain;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoDomainTests;
+
+public class ProtectedLoadingBackgroundTests
+{
+    private static bool Background(Scalar color)
+    {
+        using var frame=new ImageRegion(new Mat(720,1280,MatType.CV_8UC3,color),0,0);
+        return AutoDomainTask.HasProtectedLoadingBackground(frame);
+    }
+    [Fact] public void ActualNeutralGrayAndExistingWhiteBlackLoadingPlanesAreRecognized()
+    {
+        Assert.True(Background(new(35,27,29)));
+        Assert.True(Background(new(250,250,250)));
+        Assert.True(Background(new(10,10,10)));
+    }
+    [Theory] [InlineData(35,25,10)] [InlineData(60,60,60)] [InlineData(41,27,29)] [InlineData(35,19,29)]
+    public void NonNeutralOrOutsideTheRetainedDarkBandIsRejected(int b,int g,int r)=>
+        Assert.False(Background(new(b,g,r)));
+    [Fact] public void TextureAndDifferentNightScenePatchesAreNotOneFlatLoadingPlane()
+    {
+        using var frame=new ImageRegion(new Mat(720,1280,MatType.CV_8UC3,new Scalar(35,27,29)),0,0);
+        foreach(var (x,y) in new[]{(.1,.12),(.42,.12),(.8,.12),(.1,.5),(.85,.5),(.1,.8)})
+            for(var column=0;column<20;column+=2)
+                Cv2.Line(frame.SrcMat,new Point((int)(1280*x)+column,(int)(720*y)),
+                    new Point((int)(1280*x)+column,(int)(720*y)+10),new Scalar(55,47,49));
+        Assert.False(AutoDomainTask.HasProtectedLoadingBackground(frame));
+        using var night=new ImageRegion(new Mat(720,1280,MatType.CV_8UC3,new Scalar(35,27,29)),0,0);
+        foreach(var (x,y) in new[]{(.1,.12),(.42,.12),(.8,.12)})
+            Cv2.Rectangle(night.SrcMat,new Rect((int)(1280*x),(int)(720*y),20,11),new Scalar(39,31,33),-1);
+        Assert.False(AutoDomainTask.HasProtectedLoadingBackground(night));
+    }
+    [Fact] public void FiveOfSixFlatPatchesAreStillRequired()
+    {
+        using var frame=new ImageRegion(new Mat(720,1280,MatType.CV_8UC3,new Scalar(35,27,29)),0,0);
+        Cv2.Rectangle(frame.SrcMat,new Rect(128,86,20,11),new Scalar(120,80,20),-1);
+        Assert.True(AutoDomainTask.HasProtectedLoadingBackground(frame));
+        Cv2.Rectangle(frame.SrcMat,new Rect(537,86,20,11),new Scalar(120,80,20),-1);
+        Assert.False(AutoDomainTask.HasProtectedLoadingBackground(frame));
+    }
+    [Fact] public void GrayBackgroundDoesNotRelaxExitClickLoadingPairWorldPairOrDeadline()
+    {
+        var exit=new ProtectedClaimExitProtocol();
+        Assert.False(exit.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromSeconds(1)));
+        exit.MarkExitClicked(TimeSpan.FromSeconds(2));
+        Assert.False(exit.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromSeconds(2.2)));
+        Assert.False(exit.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(3.2)));
+        Assert.False(exit.LoadingObserved);
+        Assert.False(exit.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromSeconds(4)));
+        Assert.False(exit.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromSeconds(4.12)));
+        Assert.True(exit.LoadingObserved);
+        Assert.False(exit.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(5)));
+        Assert.True(exit.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(5.12)));
+        Assert.False(exit.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(30)));
+    }
+    [Theory]
+    [InlineData("exit-432s.png",true)]
+    [InlineData("loading-434s.png",true)]
+    [InlineData("transition-436s.png",true)]
+    [InlineData("outside-438s.png",false)]
+    [InlineData("safe-exit-loading-440s.png",false)]
+    [InlineData("safe-exit-unverified-450s.png",false)]
+    [Trait("Fixture","PrivateProtectedLoading")]
+    public void ActualPrivateLoadingAndNightWorldFramesUseProductionClassifier(string file,bool expected)
+    {
+        var directory=Environment.GetEnvironmentVariable("BGI_PRIVATE_PROTECTED_LOADING_FIXTURE_DIR");
+        if(string.IsNullOrEmpty(directory))return;
+        using var frame=new ImageRegion(Cv2.ImRead(Path.Combine(directory,file)),0,0);
+        Assert.False(frame.SrcMat.Empty());
+        Assert.Equal(expected,AutoDomainTask.HasProtectedLoadingBackground(frame));
+    }
+}
