+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public static class MaterialTravelShieldPolicy
+{
+    public static bool RefreshAtFightStart(TimeSpan? sinceObservedCast)
+    {
+        if (sinceObservedCast is { } elapsed && elapsed < TimeSpan.Zero)
+            throw new ArgumentOutOfRangeException(nameof(sinceObservedCast));
