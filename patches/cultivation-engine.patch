diff --git a/BetterGenshinImpact/GameTask/AutoPathing/PartyHealth.cs b/BetterGenshinImpact/GameTask/AutoPathing/PartyHealth.cs
new file mode 100644
index 00000000..2e62482e
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoPathing/PartyHealth.cs
@@ -0,0 +1,187 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.Linq;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.GameTask.AutoFight;
+using BetterGenshinImpact.GameTask.AutoFight.Config;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public sealed record PartyHp(int Hp, int MaxHp)
+{
+    public double Ratio => Hp / (double)MaxHp;
+}
+
+/// <summary>Reject uncertain OCR rather than inventing or repairing digits.</summary>
+public static class PartyHealthSafety
+{
+    public const double MinimumRatio = 0.8;
+    public static PartyHp? Parse(string? text)
+    {
+        var compact = Regex.Replace(text ?? "", @"\s+", "");
+        var match = Regex.Match(compact, @"\A([0-9]{1,7})[/／]([0-9]{1,7})\z", RegexOptions.CultureInvariant);
+        if (!match.Success || !int.TryParse(match.Groups[1].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var hp) ||
+            !int.TryParse(match.Groups[2].Value, NumberStyles.None, CultureInfo.InvariantCulture, out var maximum) ||
+            maximum <= 0 || hp > maximum) return null;
+        return new PartyHp(hp, maximum);
+    }
+    public static bool Healthy(PartyHp? hp) => hp is { Hp: > 0, MaxHp: > 0 } && hp.Hp <= hp.MaxHp && hp.Ratio >= MinimumRatio;
+    public static bool MatchingHealthy(PartyHp? first, PartyHp? second) => first == second && Healthy(first) && Healthy(second);
+}
+
+public sealed class PartySlotHealthEvidence
+{
+    public int Slot { get; init; }
+    public string Name { get; init; } = "";
+    public int? Hp { get; init; }
+    public int? MaxHp { get; init; }
+    public double? Ratio { get; init; }
+    public int Observations { get; init; }
+    public int IdentityObservations { get; init; }
+    public int OcrMatchingObservations { get; init; }
+    public bool IdentityVerified { get; init; }
+}
+
+public static class PartyHealth
+{
+    internal static PartyHp? ReadHp(ImageRegion frame)
+    {
+        // Current character's numeric HP/maxHP, immediately above the bottom green HP bar.
+        var scale = TaskContext.Instance().SystemInfo.AssetScale;
+        using var crop = frame.DeriveCrop(new Rect((int)(800 * scale), (int)(985 * scale),
+            (int)(330 * scale), (int)(48 * scale)));
+        using var found = crop.Find(RecognitionObject.OcrThis);
+        return PartyHealthSafety.Parse(found.Text);
+    }
+
+    internal static void RequireSafeWorld(ImageRegion frame)
+    {
+        if (!MaterialSwitchSafety.Observe(frame).ready)
+            throw new InvalidOperationException("队伍生命核验必须处于落地且可切人的世界主界面");
+        if (!PartyPreparationSafety.HealthyWorldAllowed(true, CombatObserved(frame)))
+            throw new InvalidOperationException("队伍生命核验发现战斗状态或敌人血条，停止");
+    }
+
+    internal static bool CombatObserved(ImageRegion frame) => AutoFightTask.FightStatusFlag ||
+        AvatarRecognition.FindBloodBars(frame).Any(b => b.x > 200 * TaskContext.Instance().SystemInfo.AssetScale);
+
+    internal static async Task RequireDepartureWorld(CancellationToken ct)
+    {
+        // Emergency departure permits visible enemies. It issues no attack, movement, drop or role switch.
+        // Unknown pages, domains, death/item dialogs and an unsettled character still block map departure.
+        var timer = Stopwatch.StartNew();
+        var stable = 0;
+        while (timer.ElapsedMilliseconds < 5000)
+        {
+            ct.ThrowIfCancellationRequested();
+            using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+            var revive = Bv.IsInRevivePrompt(frame);
+            var main = Bv.IsInMainUi(frame);
+            var domain = Bv.IsInDomain(frame);
+            var grounded = Bv.GetMotionStatus(frame) == MotionStatus.Normal;
+            var ready = PartyPreparationSafety.DepartureWorldAllowed(main, domain, revive, grounded);
+            if (timer.ElapsedMilliseconds >= 5000) break;
+            stable = ready ? stable + 1 : 0;
+            if (stable >= 2) return;
+            await TaskControl.Delay(250, ct);
+        }
+        throw new InvalidOperationException("队伍免费恢复五秒内未取得可打开地图的落地世界双帧；未攻击、移动或切人");
+    }
+
+    internal static CombatScenes ReadScene(ImageRegion frame, string[] expected)
+    {
+        var scene = new CombatScenes().InitializeTeam(frame, new AutoFightConfig { TeamNames = "" });
+        var actual = scene.GetAvatars().Select(a => a.Name).ToArray();
+        var slots = scene.GetAvatars().Select(a => a.Index).ToArray();
+        if (!MaterialRouteSafety.TeamMatches(expected, actual, slots, scene.CurrentMultiGameStatus?.IsInMultiGame != false))
+        {
+            scene.Dispose();
+            throw new InvalidOperationException("队伍生命核验实际姓名或号位不匹配");
+        }
+        return scene;
+    }
+
+    public static async Task<PartySlotHealthEvidence[]> VerifyAll(string[] expected, CancellationToken ct,
+        List<PartySlotHealthEvidence>? retainedEvidence = null)
+    {
+        MaterialRouteSafety.ValidateExpectedTeam(expected);
+        var team = await MaterialRecovery.ReadTeam(expected, ct);
+        if (!team.TwoFrames || !team.Matched) throw new InvalidOperationException("队伍生命核验四人名单未获双帧证明");
+        using var initial = TaskControl.CaptureToRectArea(forceNew: true);
+        RequireSafeWorld(initial);
+        using var scene = ReadScene(initial, expected);
+        scene.BeforeTask(ct);
+        var evidence = retainedEvidence ?? [];
+        try
+        {
+            foreach (var avatar in scene.GetAvatars())
+            {
+                var context = new AvatarActiveCheckContext { StrictIdentity = true };
+                if (!avatar.TrySwitchVerified(context))
+                    throw new InvalidOperationException($"队伍生命核验{avatar.Index}号位切换未获双帧身份核验");
+                context.ResetStrictCandidate();
+                PartyHp? previous = null;
+                PartyHp? lastRead = null;
+                var matchingReadCount = 0;
+                bool identityVerified = false;
+                var timer = Stopwatch.StartNew();
+                bool verified = false;
+                while (timer.ElapsedMilliseconds < 5000)
+                {
+                    ct.ThrowIfCancellationRequested();
+                    using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                    RequireSafeWorld(frame);
+                    var active = scene.GetActiveAvatarIndex(frame, context);
+                    var hp = active == avatar.Index ? ReadHp(frame) : null;
+                    identityVerified = active == avatar.Index;
+                    matchingReadCount = hp is null ? 0 : hp == previous ? matchingReadCount + 1 : 1;
+                    lastRead = hp;
+                    if (timer.ElapsedMilliseconds >= 5000) break;
+                    if (PartyHealthSafety.MatchingHealthy(previous, hp))
+                    {
+                        evidence.Add(new PartySlotHealthEvidence { Slot = avatar.Index, Name = avatar.Name,
+                            Hp = hp!.Hp, MaxHp = hp.MaxHp, Ratio = hp.Ratio, Observations = 2,
+                            IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true });
+                        verified = true;
+                        break;
+                    }
+                    previous = hp;
+                    await TaskControl.Delay(250, ct);
+                }
+                if (!verified)
+                {
+                    evidence.Add(new PartySlotHealthEvidence { Slot = avatar.Index, Name = avatar.Name,
+                        Hp = lastRead?.Hp, MaxHp = lastRead?.MaxHp, Ratio = lastRead?.Ratio,
+                        Observations = Math.Min(2, matchingReadCount), OcrMatchingObservations = Math.Min(2, matchingReadCount),
+                        IdentityObservations = identityVerified ? 2 : 0, IdentityVerified = identityVerified });
+                    throw new InvalidOperationException($"队伍生命核验{avatar.Index}号位HP未知、不一致、倒下或低于80%; observed={lastRead?.Hp}/{lastRead?.MaxHp}");
+                }
+            }
+            // Leave Zhongli active, after an explicit key request and two fresh identity observations.
+            if (!scene.SelectAvatar(4)!.TrySwitchVerified(new AvatarActiveCheckContext { StrictIdentity = true }))
+                throw new InvalidOperationException("队伍生命核验后未能双帧恢复4号位出战");
+            using var final = TaskControl.CaptureToRectArea(forceNew: true);
+            RequireSafeWorld(final);
+            return evidence.ToArray();
+        }
+        finally
+        {
+            Simulation.ReleaseAllKey();
+            // A dead-slot key can open the item dialog; ESC only, never its confirm button.
+            using var final = TaskControl.CaptureToRectArea(forceNew: true);
+            if (Bv.IsInRevivePrompt(final)) Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+        }
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoPathing/PartyPreparation.cs b/BetterGenshinImpact/GameTask/AutoPathing/PartyPreparation.cs
new file mode 100644
index 00000000..b844f6ba
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoPathing/PartyPreparation.cs
@@ -0,0 +1,244 @@
+using System;
+using System.Collections.Generic;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.AutoTrackPath;
+using BetterGenshinImpact.GameTask.AutoTrackPath.Model;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+using BetterGenshinImpact.GameTask.AutoPathing.Model.Enum;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Common.Map.Maps;
+using OpenCvSharp;
+using Microsoft.Extensions.Logging;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public sealed class PartyPreparationRequest
+{
+    public string RunId { get; set; } = "";
+    public string[] ExpectedTeam { get; set; } = [];
+    public bool AllowStatueRevival { get; set; }
+    public int TimeoutSeconds { get; set; } = 120;
+    public void Validate()
+    {
+        MaterialRouteSafety.ValidateExpectedTeam(ExpectedTeam);
+        if (string.IsNullOrWhiteSpace(RunId) || !AllowStatueRevival || TimeoutSeconds is < 1 or > 120)
+            throw new ArgumentException("队伍免费恢复需要runId、四人实际姓名、明确允许神像复活及1至120秒上限");
+    }
+}
+
+public static class PartyPreparationSafety
+{
+    public static bool DepartureWorldAllowed(bool mainUi, bool domain, bool revivePrompt, bool grounded) =>
+        mainUi && !domain && !revivePrompt && grounded;
+    public static bool HealthyWorldAllowed(bool departureWorld, bool combatObserved) => departureWorld && !combatObserved;
+    // Local tp.json Goddess 4; no settings, nearest-point selection, or caller-provided destination.
+    public const string StatueId = "4";
+    public const double StatueX = -1265.917;
+    public const double StatueY = 1928.381;
+    public const double ArrivalX = -1266.3422;
+    public const double ArrivalY = 1934.3658;
+    public const int ApproachTimeoutMs = 8000;
+    public static bool ApproachWithinBudget(long elapsedMs) => elapsedMs >= 0 && elapsedMs < ApproachTimeoutMs;
+    public static bool PositionWithin(double x, double y, double radius) => double.IsFinite(x) && double.IsFinite(y) &&
+        Math.Pow(x - StatueX, 2) + Math.Pow(y - StatueY, 2) <= radius * radius;
+    // Same projection as TpToStatueOfTheSeven.GetClosestPoint; this desired boundary is diagnostics,
+    // not MoveTo's coarse goal (a goal only two units away could immediately satisfy its four-image-unit threshold).
+    public static (double x, double y) DesiredBoundary(double x, double y)
+    {
+        if (!PositionWithin(x, y, 10)) throw new ArgumentException("神像接近起点必须来自实际到点证明且距离固定神像不超过10单位");
+        var distance = Math.Sqrt(Math.Pow(x - StatueX, 2) + Math.Pow(y - StatueY, 2));
+        if (distance <= 4) return (x, y);
+        return (StatueX + (x - StatueX) * 4 / distance, StatueY + (y - StatueY) * 4 / distance);
+    }
+    public static bool IsFixedStatue(GiTpPosition point) => point.Id == StatueId && point.Type == "Goddess" &&
+        point.Country == "蒙德" && point.Areas.Contains("风起地") &&
+        Math.Abs(point.X - StatueX) < 0.00001 && Math.Abs(point.Y - StatueY) < 0.00001 &&
+        Math.Abs(point.TranX - ArrivalX) < 0.00001 && Math.Abs(point.TranY - ArrivalY) < 0.00001;
+    public static bool Complete(bool loading, bool arrival, bool team, bool finalWorld,
+        int activeSlot, IReadOnlyList<PartySlotHealthEvidence> health, string[] expected,
+        bool statueProximityVerified = false, int statueProximityObservationCount = 0) =>
+        loading && arrival && team && finalWorld && statueProximityVerified && statueProximityObservationCount == 2 &&
+        activeSlot == 4 && health.Count == 4 && expected.Length == 4 &&
+        health.Select(e => e.Slot).SequenceEqual(new[] { 1, 2, 3, 4 }) &&
+        health.Select(e => e.Name).SequenceEqual(expected) && health.All(e => e.Observations == 2 &&
+            e.IdentityObservations == 2 && e.OcrMatchingObservations == 2 && e.IdentityVerified &&
+            e.Hp.HasValue && e.MaxHp.HasValue && PartyHealthSafety.Healthy(new PartyHp(e.Hp.Value, e.MaxHp.Value)));
+}
+
+public static class PartyPreparation
+{
+    public static object StatueEvidence => new { id = PartyPreparationSafety.StatueId, country = "蒙德", area = "风起地",
+        x = PartyPreparationSafety.StatueX, y = PartyPreparationSafety.StatueY,
+        arrivalX = PartyPreparationSafety.ArrivalX, arrivalY = PartyPreparationSafety.ArrivalY };
+
+    public static async Task Prepare(PartyPreparationRequest request, CancellationToken ct, Action<object> emit)
+    {
+        request.Validate();
+        var timer = Stopwatch.StartNew();
+        var health = new List<PartySlotHealthEvidence>();
+        var before = new List<PartySlotHealthEvidence>();
+        string[] actualTeam = [];
+        bool loadingObserved = false, positionVerified = false, finalWorld = false, teamVerified = false;
+        bool cleanupCompleted = false, revivalMayHaveOccurred = false;
+        bool statueApproachPerformed = false, statueProximityVerified = false;
+        int statueProximityObservationCount = 0;
+        bool beforeCombatObserved = false;
+        string departureReason = "departure_not_observed";
+        string? beforeHpObservationError = null;
+        int activeSlotRestored = 0;
+        double? actualX = null, actualY = null;
+        string status = "failed";
+        string? error = null;
+        ConcurrentDictionary<string, ITaskTrigger>? savedTriggers = null;
+        emit(new { task = "party-preparation", status = "started", runId = request.RunId,
+            parameterEvidence = request, statue = StatueEvidence });
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(request.TimeoutSeconds));
+        try
+        {
+            // No background pickup, skip, or consume trigger may issue input during this independent task.
+            savedTriggers = new ConcurrentDictionary<string, ITaskTrigger>(GameTaskManager.TriggerDictionary ?? new());
+            TaskTriggerDispatcher.Instance().ClearTriggers();
+            Simulation.ReleaseAllKey();
+            // The initial item-revival modal may be cancelled, never accepted.
+            using (var initial = TaskControl.CaptureToRectArea(forceNew: true))
+                if (Bv.IsInRevivePrompt(initial))
+                    Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+            await TaskControl.Delay(400, timeout.Token);
+            await PartyHealth.RequireDepartureWorld(timeout.Token);
+            // Depart before expensive roster reads or switches: enemies can still be next to the
+            // failed route's saved position. This one numeric reading is unbound diagnostic data.
+            using (var frame = TaskControl.CaptureToRectArea(forceNew: true))
+            {
+                beforeCombatObserved = PartyHealth.CombatObserved(frame);
+                departureReason = beforeCombatObserved ? "enemy_bloodbars_or_active_combat_observed" : "world_departure_without_combat_observation";
+                PartyHp? hp = null;
+                try { hp = PartyHealth.ReadHp(frame); }
+                catch (Exception exception) { beforeHpObservationError = exception.Message; }
+                before.Add(new PartySlotHealthEvidence { Slot = 0, Name = "", Hp = hp?.Hp, MaxHp = hp?.MaxHp,
+                    Ratio = hp?.Ratio, Observations = hp is null ? 0 : 1, IdentityObservations = 0, IdentityVerified = false });
+            }
+            if (!MapLazyAssets.Get().GoddessPositions.TryGetValue(PartyPreparationSafety.StatueId, out var statue) ||
+                !PartyPreparationSafety.IsFixedStatue(statue))
+                throw new InvalidOperationException("本地风起地神像白名单身份或坐标不匹配");
+            var tp = new TpTask(timeout.Token, materialRecoveryProof: true);
+            revivalMayHaveOccurred = true; // Passive statue healing/revival may begin upon arrival, even if later verification fails.
+            await tp.Tp(statue.X, statue.Y, "Teyvat", true);
+            loadingObserved = tp.LoadingTransitionVerified;
+            var arrival = await MaterialRecovery.VerifyArrival(statue.TranX, statue.TranY, timeout.Token);
+            actualX = arrival.ActualX; actualY = arrival.ActualY;
+            positionVerified = arrival.Verified;
+            if (!loadingObserved || !positionVerified) throw new InvalidOperationException("神像传送真实加载或双帧实际到点证明失败");
+            if (!actualX.HasValue || !actualY.HasValue || !PartyPreparationSafety.PositionWithin(actualX.Value, actualY.Value, 10))
+                throw new InvalidOperationException("神像实际到点距离中心超过10单位，禁止不确定长距离接近");
+            var desired = PartyPreparationSafety.DesiredBoundary(actualX.Value, actualY.Value);
+            if (!PartyPreparationSafety.PositionWithin(actualX.Value, actualY.Value, 5))
+            {
+                using var movement = CancellationTokenSource.CreateLinkedTokenSource(timeout.Token);
+                movement.CancelAfter(PartyPreparationSafety.ApproachTimeoutMs);
+                var matching = TaskContext.Instance().Config.PathingConditionConfig.MapMatchingMethod;
+                var actualImage = MapManager.GetMap("Teyvat", matching).ConvertGenshinMapCoordinatesToImageCoordinates(
+                    new Point2f((float)actualX.Value, (float)actualY.Value));
+                Navigation.SetPrevPosition(actualImage.X, actualImage.Y);
+                var mover = new PathExecutor(movement.Token, movementOnly: true) { PartyConfig = new PathingPartyConfig {
+                    MainAvatarIndex = "", GuardianAvatarIndex = "", HurryOnAvatar = "", UseGadgetIntervalMs = 0,
+                    AutoRunEnabled = false, AutoFightEnabled = false, AutoEatEnabled = false,
+                    AutoPickEnabled = false, AutoSkipEnabled = false, RecoverTiming = RecoverTiming.Never,
+                    SkipPartySwitch = true } };
+                // Center is the bounded movement goal, so coarse MoveTo cannot accept the original six-unit spawn.
+                var goal = new WaypointForTrack(new Waypoint { X = PartyPreparationSafety.StatueX,
+                    Y = PartyPreparationSafety.StatueY, Type = WaypointType.Path.Code, MoveMode = MoveModeEnum.Walk.Code }, "Teyvat", matching);
+                TaskControl.Logger.LogInformation("神像短距离接近：actual=({ActualX},{ActualY}) desired4=({DesiredX},{DesiredY}) fixedCenter=({CenterX},{CenterY}) timeoutMs={TimeoutMs}",
+                    actualX, actualY, desired.x, desired.y, PartyPreparationSafety.StatueX, PartyPreparationSafety.StatueY, PartyPreparationSafety.ApproachTimeoutMs);
+                var movementTimer = Stopwatch.StartNew();
+                try {
+                    await mover.MoveTo(goal); movement.Token.ThrowIfCancellationRequested();
+                    if (!PartyPreparationSafety.ApproachWithinBudget(movementTimer.ElapsedMilliseconds))
+                        throw new TimeoutException("神像短距离接近超过8秒，禁止继续移动或假定到达");
+                    statueApproachPerformed = true;
+                }
+                finally { Simulation.ReleaseAllKey(); }
+            }
+            // A returned movement call or assumed spawn never proves healing range. Require fresh actual positions.
+            var proximity = await MaterialRecovery.VerifyArrival(PartyPreparationSafety.StatueX, PartyPreparationSafety.StatueY, timeout.Token,
+                maximumDistance: 5, requireNoEnemies: true);
+            if (!proximity.Verified) throw new InvalidOperationException("神像短距离接近后双帧实际位置未进入5单位范围；禁止假定回血");
+            actualX = proximity.ActualX; actualY = proximity.ActualY;
+            statueProximityVerified = true; statueProximityObservationCount = 2;
+            // Passive restoration only. No F, dialogue, food, inventory, attack, or item-revival confirmation.
+            var passive = Stopwatch.StartNew();
+            while (passive.ElapsedMilliseconds < 8000)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                PartyHealth.RequireSafeWorld(frame);
+                await TaskControl.Delay(500, timeout.Token);
+            }
+            if (passive.ElapsedMilliseconds > 30000)
+                throw new InvalidOperationException("神像被动恢复观察超过30秒，未允许延长或交互恢复");
+            await PartyHealth.VerifyAll(request.ExpectedTeam, timeout.Token, health);
+            var team = await MaterialRecovery.ReadTeam(request.ExpectedTeam, timeout.Token);
+            actualTeam = team.ActualTeam;
+            teamVerified = team.Matched && team.TwoFrames;
+            using (var final = TaskControl.CaptureToRectArea(forceNew: true))
+            {
+                PartyHealth.RequireSafeWorld(final);
+                finalWorld = true;
+            }
+            activeSlotRestored = 4;
+            if (!PartyPreparationSafety.Complete(loadingObserved, positionVerified, teamVerified,
+                    finalWorld, activeSlotRestored, health, request.ExpectedTeam, statueProximityVerified, statueProximityObservationCount))
+                throw new InvalidOperationException("免费队伍恢复完整证据不足");
+            timeout.Token.ThrowIfCancellationRequested();
+            status = "completed";
+        }
+        catch (Exception exception)
+        {
+            status = ct.IsCancellationRequested ? "cancelled" : timeout.IsCancellationRequested ? "timeout" : "failed";
+            error = exception.Message;
+        }
+        finally
+        {
+            try
+            {
+                try
+                {
+                    Simulation.ReleaseAllKey();
+                    using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                    if (Bv.IsInRevivePrompt(frame)) Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+                }
+                finally
+                {
+                    if (savedTriggers is not null)
+                    {
+                        TaskTriggerDispatcher.Instance().ClearTriggers();
+                        GameTaskManager.TriggerDictionary = savedTriggers;
+                        TaskTriggerDispatcher.Instance().SetTriggers(savedTriggers.Values.OrderByDescending(t => t.Priority).ToList());
+                    }
+                }
+                cleanupCompleted = true;
+            }
+            catch (Exception exception) { status = "failed"; error = (error ?? "") + "; cleanup: " + exception.Message; }
+        }
+        emit(new { task = "party-preparation", status, runId = request.RunId, parameterEvidence = request,
+            statue = StatueEvidence, actualTeam, slotHealthEvidence = health, beforeSlotHealthEvidence = before,
+            beforeCombatObserved, departureReason, beforeHpObservationError,
+            statueApproachPerformed, statueProximityVerified, statueProximityObservationCount,
+            teamObservationCount = teamVerified ? 2 : 0, loadingObserved, positionVerified,
+            actualPosition = new { x = actualX, y = actualY }, mainUiRestored = finalWorld, grounded = finalWorld,
+            noRevivePrompt = finalWorld, teamVerified, activeSlotRestored, cleanupCompleted,
+            evidenceVerified = status == "completed" && cleanupCompleted, revivalMayHaveOccurred,
+            noItemConsumption = true, noRevivalItemConsumption = true, noResinSpend = true,
+            noFood = true, noCrafting = true, noUpgrade = true, elapsedMs = Math.Round(timer.Elapsed.TotalMilliseconds), error });
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/BackpackInventoryEvidence.cs b/BetterGenshinImpact/GameTask/Common/Job/BackpackInventoryEvidence.cs
new file mode 100644
index 00000000..1d6ff1fb
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/BackpackInventoryEvidence.cs
@@ -0,0 +1,126 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+public sealed class BackpackInventoryRequest
+{
+    public BackpackMaterial[] Materials { get; set; } = [];
+    public void Validate()
+    {
+        if (Materials is not { Length: > 0 and <= 8 } || Materials.Any(m=>m is null ||
+                !Regex.IsMatch(m.MaterialId??"",@"\A114[0-9]+\z") || string.IsNullOrWhiteSpace(m.MaterialName) ||
+                m.MaterialName!=m.MaterialName.Trim() || m.MaterialName.Length>64 || m.MaterialName.Any(char.IsControl)) ||
+            Materials.Select(m=>m.MaterialId).Distinct(StringComparer.Ordinal).Count()!=Materials.Length ||
+            Materials.Select(m=>m.MaterialName).Distinct(StringComparer.Ordinal).Count()!=Materials.Length)
+            throw new ArgumentException("背包只读请求必须为1至8个不同114武器材料的完整名称，禁止坐标或其他资源");
+    }
+}
+public sealed class BackpackMaterial { public string MaterialId { get; set; }=""; public string MaterialName { get; set; }=""; }
+public sealed record BackpackRect(int X,int Y,int Width,int Height)
+{
+    public static BackpackRect From(Rect r)=>new(r.X,r.Y,r.Width,r.Height);
+    public Rect ToRect()=>new(X,Y,Width,Height);
+}
+public sealed record BackpackOcrRow(string Text,int X,int Y,int Width,int Height);
+public sealed record BackpackSelection(BackpackRect ItemRect,double X,double Y,long ClickedAt);
+public sealed class BackpackFrameEvidence
+{
+    public long ObservedAt { get; init; }
+    public BackpackRect NameRegion { get; init; }=new(0,0,0,0);
+    public BackpackOcrRow[] NameRows { get; init; }=[];
+    public BackpackRect CountRegion { get; init; }=new(0,0,0,0);
+    public BackpackOcrRow[] CountRows { get; init; }=[];
+    public string CountMethod { get; init; }="raw_ocr_without_detector";
+    public string RawCountText { get; init; }="";
+    public bool SelectedItemVerified { get; init; }
+    public BackpackRect SelectedItemRect { get; init; }=new(0,0,0,0);
+    public object? SelectionEvidence { get; init; }
+}
+public sealed record BackpackObservation(BackpackSelection Selection,BackpackFrameEvidence First,BackpackFrameEvidence Second);
+public sealed record BackpackBorderPixel(int X,int Y,int B,int G,int R);
+public sealed record BackpackBorderSide(string Axis,int Coordinate,int SampleCount,int NeutralCount,BackpackBorderPixel[] Samples);
+public sealed record BackpackBorderEvidence(bool Verified,string Method,int MinimumChannel,int MaximumSpread,
+    double MinimumFraction,BackpackBorderSide[] Sides);
+public sealed class BackpackInventoryResult
+{
+    public string Source { get; init; }="backpack_selected_stack";
+    public bool ReadOnly { get; init; }=true;
+    public bool MainUiRestored { get; set; }
+    public bool CleanupCompleted { get; set; }
+    public string Status { get; set; }="unknown";
+    public string? Reason { get; set; }
+    public Dictionary<string,BackpackObservation> Observations { get; init; }=new(StringComparer.Ordinal);
+}
+
+public static class BackpackInventoryEvidenceSafety
+{
+    public static bool CanEscapeBackpack(bool opened,bool recognizedBackpack,bool prompt,bool alreadyEscaped)=>
+        opened && recognizedBackpack && !prompt && !alreadyEscaped;
+    // Retained 1280 client frames show a neutral white four-side outline only on the selected
+    // stack. Ignore the upper-right NEW badge and the icon interior; never use the bottom label alone.
+    public static BackpackBorderEvidence ReadSelectedBorder(Mat image,Rect item)
+    {
+        const int minimum=225,spread=35;const double fraction=.9;
+        var sides=new List<BackpackBorderSide>();
+        int radius=Math.Max(3,(int)Math.Round(item.Width*8d/125));
+        if(image.Type()!=MatType.CV_8UC3 || item.Width<20 || item.Height<30 || item.X-radius<0 || item.Y-radius<0 ||
+            item.Right+radius>=image.Width || item.Bottom+radius>=image.Height)
+            return new(false,"four_side_neutral_outline",minimum,spread,fraction,[]);
+        void Side(bool vertical,int edge)
+        {
+            BackpackBorderSide? best=null;
+            int begin=vertical?item.Y+(int)(item.Height*.2):item.X+(int)(item.Width*.12);
+            int end=vertical?item.Y+(int)(item.Height*.75):item.X+(int)(item.Width*.55);
+            for(int line=edge-radius;line<=edge+radius;line++)
+            {
+                int neutral=0;var samples=new List<BackpackBorderPixel>();
+                for(int p=begin;p<end;p++)
+                {
+                    int x=vertical?line:p,y=vertical?p:line;var pixel=image.At<Vec3b>(y,x);
+                    int lo=Math.Min(pixel.Item0,Math.Min(pixel.Item1,pixel.Item2));
+                    int hi=Math.Max(pixel.Item0,Math.Max(pixel.Item1,pixel.Item2));
+                    if(lo>=minimum && hi-lo<=spread)neutral++;
+                    if((p-begin)%Math.Max(1,(end-begin)/12)==0)samples.Add(new(x,y,pixel.Item0,pixel.Item1,pixel.Item2));
+                }
+                if(best is null || neutral>best.NeutralCount)
+                    best=new(vertical?"x":"y",line,end-begin,neutral,samples.ToArray());
+            }
+            sides.Add(best!);
+        }
+        Side(true,item.X);Side(true,item.Right-1);Side(false,item.Y);Side(false,item.Bottom-1);
+        return new(sides.All(s=>s.SampleCount>0 && s.NeutralCount/(double)s.SampleCount>=fraction),
+            "four_side_neutral_outline",minimum,spread,fraction,sides.ToArray());
+    }
+    public static string Normalize(string? text)=>Regex.Replace(text??"",@"\s+","");
+    public static bool Inside(BackpackRect a,BackpackRect b)=>a.Width>0 && a.Height>0 && b.Width>0 && b.Height>0 &&
+        a.X>=b.X && a.Y>=b.Y && a.X+a.Width<=b.X+b.Width && a.Y+a.Height<=b.Y+b.Height;
+    public static Rect NameRect(int width)=>new((int)(width*.682),(int)(width*.0625),(int)(width*.256),(int)(width*.03125));
+    public static Rect RawCountRect(Rect item)=>new(item.X+item.Width*5/125,item.Y+item.Height*128/153,
+        item.Width*120/125-item.Width*5/125,item.Height*150/153-item.Height*128/153);
+    public static int? RawCount(BackpackFrameEvidence frame,string fullName,BackpackSelection selection)
+    {
+        if(!frame.SelectedItemVerified || frame.SelectedItemRect!=selection.ItemRect ||
+            frame.CountMethod!="raw_ocr_without_detector" || !Inside(frame.CountRegion,selection.ItemRect) ||
+            frame.NameRows.Any(r=>!Inside(new(r.X,r.Y,r.Width,r.Height),frame.NameRegion)) ||
+            frame.CountRows.Any(r=>!Inside(new(r.X,r.Y,r.Width,r.Height),frame.CountRegion)) ||
+            frame.NameRows.Count(r=>Normalize(r.Text)==Normalize(fullName))!=1 || frame.CountRows.Length!=1 ||
+            Normalize(frame.RawCountText)!=Normalize(frame.CountRows[0].Text))return null;
+        var raw=Normalize(frame.RawCountText);
+        return Regex.IsMatch(raw,@"\A[0-9]{1,9}\z") && int.TryParse(raw,out var number) && number<=999999999 ? number : null;
+    }
+    public static bool Verified(BackpackObservation pair,string name)
+    {
+        var selected=pair.Selection;var first=pair.First;var second=pair.Second;
+        if(selected.ItemRect.Width<=0 || selected.ItemRect.Height<=0 || selected.X<selected.ItemRect.X ||
+            selected.X>selected.ItemRect.X+selected.ItemRect.Width || selected.Y<selected.ItemRect.Y ||
+            selected.Y>selected.ItemRect.Y+selected.ItemRect.Height || first.ObservedAt-selected.ClickedAt is <100 or >5000 ||
+            second.ObservedAt-first.ObservedAt is <100 or >5000 || first.NameRegion!=second.NameRegion ||
+            first.CountRegion!=second.CountRegion)return false;
+        var a=RawCount(first,name,selected);var b=RawCount(second,name,selected);
+        return a.HasValue && a==b;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/CultivationCraftTask.cs b/BetterGenshinImpact/GameTask/Common/Job/CultivationCraftTask.cs
new file mode 100644
index 00000000..42e1d5d1
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/CultivationCraftTask.cs
@@ -0,0 +1,123 @@
+using System;
+using System.Collections.Generic;
+using System.Dynamic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.Helpers;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>One material-crafting attempt with one linked cancellation token throughout.</summary>
+public sealed class CultivationCraftTask
+{
+    private readonly Func<string, CancellationToken, Task> openBench;
+    private readonly Func<string, int, CancellationToken, Task<CraftMaterialResult>> craft;
+    private readonly Func<CancellationToken, Task<bool>> restore;
+
+    public CultivationCraftTask() : this(OpenBench, Craft, RestoreMainUi) { }
+
+    internal CultivationCraftTask(Func<string, CancellationToken, Task> openBench,
+        Func<string, int, CancellationToken, Task<CraftMaterialResult>> craft,
+        Func<CancellationToken, Task<bool>> restore)
+    {
+        this.openBench = openBench;
+        this.craft = craft;
+        this.restore = restore;
+    }
+
+    public async Task<object> Start(string materialName, int quantity, string country,
+        CancellationToken callerToken, CancellationToken globalToken)
+    {
+        Validate(materialName, quantity, country);
+        materialName = materialName.Trim();
+        country = country.Trim();
+        using var linked = CancellationTokenSource.CreateLinkedTokenSource(callerToken, globalToken);
+        var ct = linked.Token;
+        ct.ThrowIfCancellationRequested();
+        await openBench(country, ct);
+        ct.ThrowIfCancellationRequested();
+        var result = await craft(materialName, quantity, ct);
+        ct.ThrowIfCancellationRequested();
+        var restored = result.Success && await restore(ct);
+        ct.ThrowIfCancellationRequested();
+        // Rewards may be inferred defaults in the existing task: never expose them as inventory evidence.
+        IDictionary<string, object?> scriptResult = new ExpandoObject();
+        scriptResult["Success"] = result.Success;
+        scriptResult["MaterialName"] = result.MaterialName;
+        scriptResult["TargetQuantity"] = result.TargetQuantity;
+        scriptResult["ActualQuantity"] = result.ActualQuantity;
+        scriptResult["MainUiRestored"] = restored;
+        return scriptResult;
+    }
+
+    internal static void Validate(string materialName, int quantity, string country)
+    {
+        if (string.IsNullOrWhiteSpace(materialName) || materialName.Length > 80 || materialName.Any(char.IsControl))
+            throw new ArgumentException("材料名必须是1至80个非控制字符。", nameof(materialName));
+        var compact = string.Concat(materialName.Where(c => !char.IsWhiteSpace(c)));
+        if (compact.Contains("树脂", StringComparison.Ordinal) || compact.Contains("樹脂", StringComparison.Ordinal)
+            || compact.Contains("resin", StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("培养材料合成接口禁止合成任何树脂。", nameof(materialName));
+        if (quantity is < 1 or > 999)
+            throw new ArgumentOutOfRangeException(nameof(quantity), "合成数量必须为1至999。");
+        if (country?.Trim() is not ("蒙德" or "璃月"))
+            throw new ArgumentException("合成台仅支持蒙德或璃月。", nameof(country));
+    }
+
+    private static async Task OpenBench(string country, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        using (var capture = TaskControl.CaptureToRectArea())
+        {
+            if (!SystemControl.IsGenshinImpactActiveByProcess() || !Bv.IsInMainUi(capture))
+                throw new InvalidOperationException("培养合成须从已核验的游戏主界面开始。");
+        }
+        ct.ThrowIfCancellationRequested();
+        // The usual GoToCraftingBench wrapper retries; this entry must never replay after failure.
+        await new GoToCraftingBenchTask().GoToCraftingBenchOnce(country, ct);
+    }
+
+    private static Task<CraftMaterialResult> Craft(string name, int quantity, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        return new CraftMaterialTask(name, quantity).Start(ct);
+    }
+
+    private static async Task<bool> RestoreMainUi(CancellationToken ct)
+    {
+        for (var attempt = 0; attempt < 5; attempt++)
+        {
+            await Task.Delay(250, ct);
+            using var capture = TaskControl.CaptureToRectArea();
+            ct.ThrowIfCancellationRequested();
+            if (Bv.IsInMainUi(capture)) return true;
+            if (!SystemControl.IsGenshinImpactActiveByProcess()) return false;
+            // Read the same header/filter labels used by CraftMaterialTask, while rejecting
+            // confirmation dialogs even if the underlying crafting page remains visible.
+            var header = Text(new Rect(0, 0, 260, 95));
+            var filter = Text(new Rect(40, 960, 720, 105));
+            var modal = Text(new Rect(600, 600, 880, 400));
+            ct.ThrowIfCancellationRequested();
+            if (modal.Contains("确认", StringComparison.Ordinal)) continue;
+            if (!header.Contains("合成", StringComparison.Ordinal) || !filter.Contains("筛选", StringComparison.Ordinal))
+                return false;
+            Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+
+            string Text(Rect rect)
+            {
+                var scale = capture.SrcMat.Width / 1920d;
+                var roi = new Rect((int)(rect.X * scale), (int)(rect.Y * scale),
+                    (int)(rect.Width * scale), (int)(rect.Height * scale));
+                return string.Concat(capture.FindMulti(RecognitionObject.Ocr(roi.X, roi.Y, roi.Width, roi.Height))
+                    .Select(r => StringUtils.RemoveAllSpace(r.Text)));
+            }
+        }
+        return false;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/ReadBackpackInventoryTask.cs b/BetterGenshinImpact/GameTask/Common/Job/ReadBackpackInventoryTask.cs
new file mode 100644
index 00000000..bc28e80e
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/ReadBackpackInventoryTask.cs
@@ -0,0 +1,174 @@
+using System;
+using System.Collections.Concurrent;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.Core.Simulator.Extensions;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.GameTask.Model.GameUI;
+using BetterGenshinImpact.Helpers;
+using Microsoft.Extensions.Logging;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>Only selects existing development-material stacks. Never confirms any dialog.</summary>
+public sealed class ReadBackpackInventoryTask
+{
+    private readonly BackpackInventoryRequest request;
+    private readonly ILogger logger=App.GetLogger<ReadBackpackInventoryTask>();
+    private static readonly JsonSerializerSettings JsonSettings=new() {
+        ContractResolver=new CamelCasePropertyNamesContractResolver(), MissingMemberHandling=MissingMemberHandling.Error };
+    public ReadBackpackInventoryTask(BackpackInventoryRequest request) { request.Validate();this.request=request; }
+    public static BackpackInventoryRequest ParseRequest(string json)
+    {
+        var request=JsonConvert.DeserializeObject<BackpackInventoryRequest>(json,JsonSettings)
+            ?? throw new ArgumentException("背包只读请求为空");
+        request.Validate();return request;
+    }
+    public static string Serialize(BackpackInventoryResult result)=>JsonConvert.SerializeObject(result,JsonSettings);
+    private static bool Tab(ImageRegion frame,string suffix)
+    {
+        using var found=frame.Find(ElementRecognition.Get("BagCharacterDevelopmentItem"+suffix,frame));
+        return found.IsExist();
+    }
+    private static bool World(ImageRegion frame)=>Bv.IsInMainUi(frame) && !Bv.IsInDomain(frame) && !Bv.IsInRevivePrompt(frame);
+    public async Task<string> Start(CancellationToken ct)
+    {
+        var result=new BackpackInventoryResult(); bool opened=false;
+        var saved=new ConcurrentDictionary<string,ITaskTrigger>(GameTaskManager.TriggerDictionary??new());
+        using var timeout=CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(120));
+        try
+        {
+            TaskTriggerDispatcher.Instance().ClearTriggers();Simulation.ReleaseAllKey();
+            for(var i=0;i<2;i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var initial=TaskControl.CaptureToRectArea(forceNew:true);
+                if(!SystemControl.IsGenshinImpactActiveByProcess() || !World(initial))
+                    throw new InvalidOperationException("背包只读入口需要新鲜世界双帧");
+                await Task.Delay(200,timeout.Token);
+            }
+            timeout.Token.ThrowIfCancellationRequested();
+            Simulation.SendInput.SimulateAction(GIActions.OpenInventory);opened=true;
+            await Task.Delay(1000,timeout.Token);
+            bool selected=false;
+            for(var i=0;i<8;i++)
+            {
+                using var frame=TaskControl.CaptureToRectArea(forceNew:true);
+                timeout.Token.ThrowIfCancellationRequested();
+                if(Bv.IsInPromptDialog(frame)||Bv.IsInRevivePrompt(frame))
+                    throw new InvalidOperationException("背包出现未知或物品提示，禁止确认");
+                if(Tab(frame,"Checked")){selected=true;break;}
+                using var button=frame.Find(ElementRecognition.Get("BagCharacterDevelopmentItemUnchecked",frame));
+                if(button.IsExist()) { timeout.Token.ThrowIfCancellationRequested();button.Click(); }
+                await Task.Delay(250,timeout.Token);
+            }
+            if(!selected)throw new InvalidOperationException("未核验角色培养材料背包分类");
+            using var recognizer=ItemIconRecognizerFactory.Create(ItemIconRecognitionMode.Item);
+            var gridParams=GridParams.Templates[GridScreenName.CharacterDevelopmentItems];
+            var grid=new GridScreen(gridParams,logger,timeout.Token);int pages=0;
+            grid.OnAfterTurnToNewPage=_=> { if(++pages>30)throw new InvalidOperationException("背包只读达到30页上限"); };
+            await foreach(var (page,itemRect) in grid)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var item=page.DeriveCrop(itemRect);using var icon=item.SrcMat.GetGridIcon();
+                var candidate=recognizer.Recognize(icon);
+                var target=request.Materials.FirstOrDefault(m=>m.MaterialName==candidate && !result.Observations.ContainsKey(m.MaterialId));
+                if(target is null)continue;
+                var fullRect=new Rect(itemRect.X+gridParams.Roi.X,itemRect.Y+gridParams.Roi.Y,itemRect.Width,itemRect.Height);
+                BackpackSelection selection;
+                using(var fresh=TaskControl.CaptureToRectArea(forceNew:true))
+                {
+                    if(!Tab(fresh,"Checked")||Bv.IsInPromptDialog(fresh))throw new InvalidOperationException("选中前背包状态改变");
+                    using var cell=fresh.DeriveCrop(fullRect);
+                    // Prove persistent selection rather than the pointer's hover outline.
+                    // Moving to the known bottom margin sends no click, category change, or scroll.
+                    selection=SelectCell(BackpackRect.From(fullRect),()=>cell.Click(),
+                        ()=>fresh.MoveTo(fresh.Width/2,fresh.Height-40),()=>DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),timeout.Token);
+                }
+                // No scrolling, category changes, or second click between these independent captures.
+                var pair=await ObservePair(selection,ReadFrame,(milliseconds,token)=>Task.Delay(milliseconds,token),timeout.Token);
+                if(BackpackInventoryEvidenceSafety.Verified(pair,target.MaterialName))result.Observations.Add(target.MaterialId,pair);
+                else logger.LogWarning("背包候选{name}完整标题、选中框或原始数量双帧未通过，数量保持未知",target.MaterialName);
+                if(result.Observations.Count==request.Materials.Length)break;
+            }
+            result.Status=result.Observations.Count==request.Materials.Length?"verified":"unknown";
+            result.Reason=result.Status=="verified"?"selected_stack_raw_ocr_pair":"missing_or_unverified_stack";
+        }
+        catch(Exception ex) { result.Status="unknown";result.Reason=ex is OperationCanceledException?"observation_cancelled_or_timeout":ex.Message; }
+        finally
+        {
+            try { result.MainUiRestored=await Restore(opened);result.CleanupCompleted=result.MainUiRestored; }
+            catch(Exception ex) { result.MainUiRestored=false;result.Reason+="; cleanup: "+ex.Message; }
+            finally
+            {
+                Simulation.ReleaseAllKey();TaskTriggerDispatcher.Instance().ClearTriggers();
+                GameTaskManager.TriggerDictionary=saved;
+                TaskTriggerDispatcher.Instance().SetTriggers(saved.Values.OrderByDescending(t=>t.Priority).ToList());
+            }
+        }
+        if(!result.MainUiRestored)result.Status="unknown";
+        ct.ThrowIfCancellationRequested();return Serialize(result);
+    }
+    internal static BackpackSelection SelectCell(BackpackRect item,Action click,Action leaveHover,
+        Func<long> clock,CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();long clickedAt=clock();click();
+        ct.ThrowIfCancellationRequested();leaveHover();
+        return new(item,item.X+item.Width/2d,item.Y+item.Height/2d,clickedAt);
+    }
+    internal static async Task<BackpackObservation> ObservePair(BackpackSelection selection,
+        Func<BackpackSelection,CancellationToken,BackpackFrameEvidence> capture,
+        Func<int,CancellationToken,Task> delay,CancellationToken ct)
+    {
+        await delay(300,ct);ct.ThrowIfCancellationRequested();
+        var first=capture(selection,ct);ct.ThrowIfCancellationRequested();
+        await delay(250,ct);ct.ThrowIfCancellationRequested();
+        var second=capture(selection,ct);ct.ThrowIfCancellationRequested();
+        return new(selection,first,second);
+    }
+    internal static BackpackFrameEvidence ReadFrame(BackpackSelection selection,CancellationToken ct)
+    {
+        using var frame=TaskControl.CaptureToRectArea(forceNew:true);
+        long observedAt=DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();ct.ThrowIfCancellationRequested();
+        var nameRect=BackpackInventoryEvidenceSafety.NameRect(frame.Width);
+        var countRect=BackpackInventoryEvidenceSafety.RawCountRect(selection.ItemRect.ToRect());
+        using var title=frame.DeriveCrop(nameRect);using var count=frame.DeriveCrop(countRect);
+        var names=OcrFactory.Paddle.OcrResult(title.SrcMat).Regions.Select(row=> {
+            var r=row.Rect.BoundingRect();return new BackpackOcrRow(row.Text,r.X+nameRect.X,r.Y+nameRect.Y,r.Width,r.Height); }).ToArray();
+        var raw=OcrFactory.Paddle.OcrWithoutDetector(count.SrcMat);ct.ThrowIfCancellationRequested();
+        var border=BackpackInventoryEvidenceSafety.ReadSelectedBorder(frame.SrcMat,selection.ItemRect.ToRect());
+        return new() {ObservedAt=observedAt,NameRegion=BackpackRect.From(nameRect),NameRows=names,
+            CountRegion=BackpackRect.From(countRect),CountRows=[new(raw,countRect.X,countRect.Y,countRect.Width,countRect.Height)],
+            RawCountText=raw,SelectedItemVerified=Tab(frame,"Checked") && border.Verified,
+            SelectedItemRect=border.Verified?selection.ItemRect:new(0,0,0,0),SelectionEvidence=border};
+    }
+    private static async Task<bool> Restore(bool opened)
+    {
+        using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(6));bool escape=false;int world=0;
+        for(var i=0;i<20;i++)
+        {
+            timeout.Token.ThrowIfCancellationRequested();using var frame=TaskControl.CaptureToRectArea(forceNew:true);
+            if(!SystemControl.IsGenshinImpactActiveByProcess())return false;
+            if(World(frame)) {if(++world>=2)return true;}
+            else
+            {
+                world=0;
+                if(BackpackInventoryEvidenceSafety.CanEscapeBackpack(opened,Tab(frame,"Checked")||Tab(frame,"Unchecked"),
+                    Bv.IsInPromptDialog(frame)||Bv.IsInRevivePrompt(frame),escape))
+                {timeout.Token.ThrowIfCancellationRequested();Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);escape=true;}
+            }
+            await Task.Delay(200,timeout.Token);
+        }
+        return false;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/ReadResinSnapshotTask.cs b/BetterGenshinImpact/GameTask/Common/Job/ReadResinSnapshotTask.cs
new file mode 100644
index 00000000..d9ea74fe
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/ReadResinSnapshotTask.cs
@@ -0,0 +1,200 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Dynamic;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.Core.Simulator.Extensions;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.Helpers;
+using Microsoft.Extensions.Logging;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>
+/// Observes the map header only. No reward, refill, crafting, or encounter-point controls are used.
+/// A hidden condensed icon does not prove an empty inventory. Two identical OCR frames prove only
+/// an observation, not server authority. The 8s observation + 4s cleanup budget is cooperative:
+/// synchronous capture/OCR cannot be forcibly interrupted safely.
+/// </summary>
+public sealed class ReadResinSnapshotTask
+{
+    private readonly ILogger logger = App.GetLogger<ReadResinSnapshotTask>();
+
+    public async Task<object> Start(CancellationToken ct)
+    {
+        int? original = null, condensed = null;
+        string? observedAt = null;
+        string reason = "unverified";
+        bool restoreMap = false, restored = false;
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(8));
+        try
+        {
+            timeout.Token.ThrowIfCancellationRequested();
+            // Do not navigate out of unknown dialogs: generic ReturnMainUi can click an exit/Enter.
+            using (var initial = TaskControl.CaptureToRectArea())
+            {
+                if (!SystemControl.IsGenshinImpactActiveByProcess())
+                {
+                    reason = "game_not_focused";
+                    return Result();
+                }
+                if (Bv.IsInBigMapUi(initial))
+                {
+                    restoreMap = true;
+                }
+                else if (Bv.IsInMainUi(initial))
+                {
+                    restored = true;
+                    Simulation.SendInput.SimulateAction(GIActions.OpenMap);
+                    restoreMap = true;
+                    restored = false;
+                    await Task.Delay(800, timeout.Token);
+                }
+                else
+                {
+                    reason = "unsupported_ui";
+                    return Result();
+                }
+            }
+
+            int? previousOriginal = null, previousCondensed = null;
+            for (var attempt = 0; attempt < 6; attempt++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var capture = TaskControl.CaptureToRectArea();
+                var capturedAt = DateTimeOffset.UtcNow.ToString("O");
+                if (!Bv.IsInBigMapUi(capture))
+                {
+                    previousOriginal = previousCondensed = original = condensed = null;
+                    observedAt = null;
+                    reason = "map_not_visible";
+                }
+                else
+                {
+                    var originalReading = ReadCount(capture, "original_resin.png", true, OcrFactory.Paddle);
+                    var condensedReading = ReadCount(capture, "condensed_resin.png", false, OcrFactory.Paddle);
+                    logger.LogInformation("[RESIN_SNAPSHOT_OCR] attempt={Attempt} original={Original} condensed={Condensed}",
+                        attempt + 1, Newtonsoft.Json.JsonConvert.SerializeObject(originalReading),
+                        Newtonsoft.Json.JsonConvert.SerializeObject(condensedReading));
+                    var currentOriginal = originalReading.Value;
+                    var currentCondensed = condensedReading.Value;
+                    var pair = ResinSnapshot.ObservePair(previousOriginal, currentOriginal,
+                        previousCondensed, currentCondensed, timeout.Token);
+                    original = pair.Original;
+                    condensed = pair.Condensed;
+                    observedAt = (original.HasValue || condensed.HasValue) ? capturedAt : null;
+                    previousOriginal = currentOriginal;
+                    previousCondensed = currentCondensed;
+                    reason = original.HasValue && condensed.HasValue ? "stable_map_ocr" : "incomplete_map_ocr";
+                    if (pair.CanFinish) break;
+                }
+                await Task.Delay(250, timeout.Token);
+            }
+        }
+        catch (OperationCanceledException) when (!ct.IsCancellationRequested)
+        {
+            original = condensed = null;
+            observedAt = null;
+            reason = "observation_timeout";
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception ex)
+        {
+            // Do not salvage a partially completed/failed observation as verified.
+            original = condensed = null;
+            observedAt = null;
+            reason = "observation_failed";
+            logger.LogWarning(ex, "只读树脂观测失败，数量保持未知");
+        }
+        finally
+        {
+            if (restoreMap && !ct.IsCancellationRequested)
+            {
+                var cleanup = Stopwatch.StartNew();
+                using var cleanupTimeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+                cleanupTimeout.CancelAfter(TimeSpan.FromSeconds(4));
+                var escapeSent = false;
+                try
+                {
+                    while (cleanup.ElapsedMilliseconds < 4000)
+                    {
+                        cleanupTimeout.Token.ThrowIfCancellationRequested();
+                        using var capture = TaskControl.CaptureToRectArea();
+                        cleanupTimeout.Token.ThrowIfCancellationRequested();
+                        if (!SystemControl.IsGenshinImpactActiveByProcess()) break;
+                        if (Bv.IsInMainUi(capture)) { restored = true; break; }
+                        if (!escapeSent)
+                        {
+                            if (!Bv.IsInBigMapUi(capture)) break;
+                            cleanupTimeout.Token.ThrowIfCancellationRequested();
+                            // Send Escape once from a confirmed map. Subsequent cached/transition
+                            // frames only trigger another capture, never another keypress.
+                            Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+                            escapeSent = true;
+                        }
+                        await Task.Delay(250, cleanupTimeout.Token);
+                    }
+                }
+                catch (OperationCanceledException) when (ct.IsCancellationRequested) { throw; }
+                catch (Exception ex) { logger.LogWarning(ex, "只读树脂观测后未能核验主界面恢复"); }
+            }
+        }
+        ct.ThrowIfCancellationRequested();
+        return Result();
+
+        object Result()
+        {
+            IDictionary<string, object?> result = new ExpandoObject();
+            result["originalResin"] = original;
+            result["condensedResin"] = condensed;
+            result["originalVerified"] = original.HasValue;
+            result["condensedVerified"] = condensed.HasValue;
+            result["verified"] = original.HasValue && condensed.HasValue && restored;
+            result["observedAt"] = observedAt;
+            result["mainUiRestored"] = restored;
+            result["source"] = original.HasValue || condensed.HasValue ? "stable_map_ocr" : "unknown";
+            result["reason"] = reason;
+            return result;
+        }
+    }
+
+    internal sealed record CountReading(int? Value, string Reason, string Raw,
+        double? IconScore, Rect? IconRect, Rect? CountRect);
+
+    internal static CountReading ReadCount(ImageRegion capture, string asset, bool original, IOcrService ocr)
+    {
+        // Use the actual normalized capture dimensions, not the raw game-window asset scale.
+        using var template = GameTaskManager.LoadAssetImage("AutoLeyLineOutcrop", asset,
+            capture.SrcMat.Width, capture.SrcMat.Height);
+        var recognition = RecognitionObject.TemplateMatch(template);
+        try
+        {
+            recognition.RegionOfInterest = new Rect(capture.SrcMat.Width / 2, 0,
+                capture.SrcMat.Width / 2, capture.SrcMat.Height / 8);
+            using var icon = capture.Find(recognition);
+            if (icon.IsEmpty()) return new(null, "icon_missing", "", null, null, null);
+            var scale = capture.SrcMat.Width / 1920d;
+            // The original header's + button begins about 120px after the icon's right edge;
+            // the condensed header's old 90px crop reached the neighboring original icon.
+            // Keep the maximum seven-character N/200 text and one condensed digit only.
+            var roi = new Rect(icon.Right, icon.Y, (int)((original ? 110 : 45) * scale), (int)(40 * scale));
+            var iconRect = new Rect(icon.X, icon.Y, icon.Width, icon.Height);
+            if (roi.Right > capture.SrcMat.Width || roi.Bottom > capture.SrcMat.Height || roi.Width <= 0 || roi.Height <= 0)
+                return new(null, "count_crop_out_of_bounds", "", icon.MatchScore, iconRect, roi);
+            using var number = capture.DeriveCrop(roi);
+            var text = ocr.OcrWithoutDetector(number.CacheGreyMat);
+            var value = original ? ResinSnapshot.ParseOriginal(text) : ResinSnapshot.ParseCondensed(text);
+            return new(value, value.HasValue ? "ocr_parsed" : "ocr_unparsed",
+                text.Length > 80 ? text[..80] : text, icon.MatchScore, iconRect, roi);
+        }
+        finally { recognition.TemplateImageGreyMat?.Dispose(); }
+    }
+}
