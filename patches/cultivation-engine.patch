+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class SwitchPartyDeploymentTests
+{
+    [Theory]
+    [InlineData("目标队伍", "目标队伍", "出战", false)] // 已选中但未提交，不能把预览当出战。
+    [InlineData("目标队伍", "目标队伍", "已出战", true)]
+    [InlineData(" 目标 队伍 ", "目标队伍", "已 出 战", true)]
+    [InlineData("目标队伍备用", "目标队伍", "已出战", false)] // 搜索正则能命中也不能代替确切预设。
+    [InlineData("旧队伍", "目标队伍", "已出战", false)]
+    [InlineData("", "目标队伍", "已出战", false)]
+    [InlineData(null, "目标队伍", "已出战", false)]
+    [InlineData("目标队伍", "", "已出战", false)]
+    [InlineData("目标队伍", null, "已出战", false)]
+    [InlineData("目标队伍", "目标队伍", "", false)]
+    [InlineData("目标队伍", "目标队伍", null, false)]
+    [InlineData("目标队伍", "目标队伍", "未出战", false)]
+    [InlineData("目标队伍", "目标队伍", "当前已出战", false)]
+    [InlineData("目标队伍", "目标队伍", "已出战\n出战", false)]
+    public void SuccessRequiresTheExactSelectedPresetAndDeployedState(
+        string? actual, string? expected, string? state, bool verified)
+    {
+        Assert.Equal(verified, SwitchPartyTask.IsPartyDeploymentVerified(actual, expected, state));
+    }
+
+    [Fact]
+    public void PreviewAndDeploymentAreIndependentOfThePresetSearchRegex()
+    {
+        const string regex = "目标.*";
+        Assert.True(System.Text.RegularExpressions.Regex.IsMatch("目标队伍", regex));
+        Assert.False(SwitchPartyTask.IsPartyDeploymentVerified("目标队伍", "目标队伍", "出战"));
+        Assert.False(SwitchPartyTask.IsPartyDeploymentVerified("目标队伍备用", "目标队伍", "已出战"));
+        Assert.True(SwitchPartyTask.IsPartyDeploymentVerified("目标队伍", "目标队伍", "已出战"));
+    }
+}
