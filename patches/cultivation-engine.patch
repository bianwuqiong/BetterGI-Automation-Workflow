+using System.Reflection;
+using System.Runtime.CompilerServices;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.View.Drawable;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoFightTests;
+
+public class MaterialSwitchWrapperIntegrationTests
+{
+    private static readonly Rect[] Boxes = Enumerable.Range(0,4).Select(i=>new Rect(100+i*40,100,20,20)).ToArray();
+    private static (CombatScenes scene,Avatar target) Make()
+    {
+        // No predictor/service initialization or input: the real getter needs only observed index rectangles.
+        var scene=(CombatScenes)RuntimeHelpers.GetUninitializedObject(typeof(CombatScenes));
+        var avatars=Enumerable.Range(0,4).Select(i=>{
+            var a=(Avatar)RuntimeHelpers.GetUninitializedObject(typeof(Avatar));
+            a.Index=i+1;a.IndexRect=Boxes[i];
+            a.CombatScenes=scene;
+            return a;
+        }).ToArray();
+        typeof(CombatScenes).GetProperty("Avatars",BindingFlags.NonPublic|BindingFlags.Instance)!.SetValue(scene,avatars);
+        scene.LastActiveAvatarIndex=-1;
+        return(scene,avatars[1]);
+    }
+    private static ImageRegion Frame(int active)
+    {
+        var mat=new Mat(1080,1920,MatType.CV_8UC3,Scalar.Black);
+        for(var i=0;i<4;i++)using(var box=new Mat(mat,Boxes[i]))box.SetTo(i+1==active?Scalar.All(50):Scalar.All(255));
+        return new ImageRegion(mat,0,0,drawContent:new DrawContent());
+    }
+
+    [Fact]
+    public void RealStrictWrapperPendingReachesAvatarWithoutRepressOrResetThenSecondFrameVerifies()
+    {
+        var (scene,avatar)=Make();var context=new AvatarActiveCheckContext{StrictIdentity=true};
+        var presses=1; // The initial target key was already requested, as in the production loop.
+        using(var first=Frame(2))
+        {
+            var observed=avatar.ReadMaterialSwitchAndMaybeRetry(first,context,()=>1500,()=>0,()=>presses++);
+            Assert.Equal(-2,observed);
+            Assert.Equal(-1,scene.LastActiveAvatarIndex);
+            Assert.Equal(1,presses); // Old wrapper converted pending to -1 and sent/reset at this elapsed time.
+        }
+        using(var second=Frame(2))
+        {
+            Assert.Equal(2,avatar.ReadMaterialSwitchAndMaybeRetry(second,context,()=>2000,()=>0,()=>presses++));
+            Assert.Equal(2,scene.LastActiveAvatarIndex);
+            Assert.Equal(1,presses); // A reset on the first observation would make this -2 again.
+        }
+    }
+
+    [Fact]
+    public void RealWrongSlotDoesNotAuthorizeTargetAndRetryResetsBeforeTwoNewTargetFrames()
+    {
+        var (scene,avatar)=Make();var context=new AvatarActiveCheckContext{StrictIdentity=true};int presses=1;
+        using(var wrongFirst=Frame(3))Assert.Equal(-2,avatar.ReadMaterialSwitchAndMaybeRetry(wrongFirst,context,()=>1500,()=>0,()=>presses++));
+        Assert.Equal(1,presses);
+        using(var wrongSecond=Frame(3))Assert.Equal(3,avatar.ReadMaterialSwitchAndMaybeRetry(wrongSecond,context,()=>2000,()=>0,()=>presses++));
+        Assert.Equal(2,presses);Assert.NotEqual(avatar.Index,scene.LastActiveAvatarIndex);
+        using(var targetFirst=Frame(2))Assert.Equal(-2,avatar.ReadMaterialSwitchAndMaybeRetry(targetFirst,context,()=>2500,()=>2000,()=>presses++));
+        using(var targetSecond=Frame(2))Assert.Equal(2,avatar.ReadMaterialSwitchAndMaybeRetry(targetSecond,context,()=>3000,()=>2000,()=>presses++));
+        Assert.Equal(2,presses);
+    }
+
+    [Fact]
+    public void NonStrictRealWrapperStillReturnsItsExistingSingleFrameIdentity()
+    {
+        var (scene,_)=Make();var context=new AvatarActiveCheckContext();using var frame=Frame(2);
+        Assert.Equal(2,scene.GetActiveAvatarIndex(frame,context));
+        Assert.Equal(2,scene.LastActiveAvatarIndex);
+    }
+
+    [Fact]
+    public void InterveningUncertaintyStillBreaksTheRealWrapperTwoFrameProofAndExpiredKeyCannotReplay()
+    {
+        var (scene,avatar)=Make();var context=new AvatarActiveCheckContext{StrictIdentity=true};int presses=1;
+        using(var first=Frame(2))Assert.Equal(-2,scene.GetActiveAvatarIndex(first,context));
+        Assert.Equal(-1,context.ObserveStrictCandidate(-1)); // The unchanged classifier's explicit unknown path.
+        using(var next=Frame(2))Assert.Equal(-2,avatar.ReadMaterialSwitchAndMaybeRetry(next,context,()=>5000,()=>0,()=>presses++));
+        Assert.Equal(1,presses);Assert.Equal(-1,scene.LastActiveAvatarIndex);
+        using(var fresh=Frame(2))Assert.Equal(2,scene.GetActiveAvatarIndex(fresh,context));
+    }
+}
