+using System.Runtime.CompilerServices;
+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MaterialRouteSafetyTests
+{
+    private static MaterialRouteRequest ValidRequest() => new()
+    { RunId = "today-test", PartyName = "待命队伍", Sha256 = new string('a', 64), RoutePath = "auto_game_handguard/commit/route.json" };
+
+    [Theory]
+    [InlineData("../route.json")]
+    [InlineData("auto_game_handguard/../../route.json")]
+    [InlineData("other/route.json")]
+    [InlineData("auto_game_handguard_old/route.json")]
+    [InlineData("auto_game_handguard/route.js")]
+    [InlineData("C:/outside.json")]
+    [InlineData("auto_game_handguard/route.json:stream")]
+    public void RejectsEscapesOtherSubscriptionsAndExecutableContent(string path) =>
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ResolvePath(Path.GetTempPath(), path));
+
+    [Fact]
+    public void AcceptsOnlyNormalizedPathInsideTheFixedSubscription()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "material-route-tests-nonexistent");
+        Assert.Equal(Path.Combine(root, "auto_game_handguard", "commit", "route.json"),
+            MaterialRouteSafety.ResolvePath(root, "auto_game_handguard/commit/route.json"));
+    }
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(481)]
+    public void RejectsUnboundedOrEmptyTimeout(int timeout)
+    {
+        var request = ValidRequest(); request.TimeoutSeconds = timeout;
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateRequest(request));
+    }
+
+    [Theory]
+    [InlineData("runId")]
+    [InlineData("partyName")]
+    [InlineData("sha256")]
+    [InlineData("strategyName")]
+    [InlineData("requireShield")]
+    public void RejectsMissingIdentityAndUnprotectedStrategies(string field)
+    {
+        var request = ValidRequest();
+        switch (field)
+        {
+            case "runId": request.RunId = ""; break;
+            case "partyName": request.PartyName = ""; break;
+            case "sha256": request.Sha256 = new string('z', 64); break;
+            case "strategyName": request.StrategyName = "其他"; break;
+            case "requireShield": request.RequireZhongliShield = false; break;
+        }
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateRequest(request));
+    }
+
+    [Fact]
+    public void FixedHashMatchesBytesAndDoesNotNormalizeContents()
+    {
+        Assert.Equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", MaterialRouteSafety.Hash("abc"u8.ToArray()));
+        Assert.NotEqual(MaterialRouteSafety.Hash("abc"u8.ToArray()), MaterialRouteSafety.Hash("abc\n"u8.ToArray()));
+    }
+
+    [Theory]
+    [InlineData("combat_script")]
+    [InlineData("use_gadget")]
+    [InlineData("exit_and_relogin")]
+    [InlineData("set_time")]
+    public void RejectsUnsafeNativeActionsBeforeAnyInput(string action)
+    {
+        var task = (PathingTask)RuntimeHelpers.GetUninitializedObject(typeof(PathingTask));
+        task.Positions = [new() { Action = "fight" }, new() { Action = action }];
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateTask(task));
+    }
+
+    [Fact]
+    public void RejectsEmbeddedCommandParametersEvenOnPermittedActions()
+    {
+        var task = (PathingTask)RuntimeHelpers.GetUninitializedObject(typeof(PathingTask));
+        task.Positions = [new() { Action = "fight", ActionParams = "inject()" }];
+        Assert.Throws<ArgumentException>(() => MaterialRouteSafety.ValidateTask(task));
+    }
+
+    [Fact]
+    public void RetainsSafeFlightLandingAndPlainCombat()
+    {
+        var task = (PathingTask)RuntimeHelpers.GetUninitializedObject(typeof(PathingTask));
+        task.Positions = [new() { Action = "stop_flying", MoveMode = "fly" }, new() { Action = "fight" }];
+        MaterialRouteSafety.ValidateTask(task);
+        Assert.Equal("hash:10.5,-2", MaterialRouteSafety.PointId("hash", 10.5, -2));
+    }
+}
