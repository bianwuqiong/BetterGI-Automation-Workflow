+using BetterGenshinImpact.GameTask.AutoPathing;
+using BetterGenshinImpact.GameTask.AutoTrackPath.Model;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class PartyPreparationSafetyTests
+{
+    [Fact]
+    public void EmergencyDepartureFromEnemiesDoesNotCertifyAHealthyOrClearedWorld()
+    {
+        var departure = PartyPreparationSafety.DepartureWorldAllowed(true, false, false, true);
+        Assert.True(departure);
+        Assert.False(PartyPreparationSafety.HealthyWorldAllowed(departure, combatObserved: true));
+        Assert.True(PartyPreparationSafety.HealthyWorldAllowed(departure, combatObserved: false));
+        // Even enemy-free pages cannot certify health without the ordinary world gate.
+        Assert.False(PartyPreparationSafety.HealthyWorldAllowed(false, combatObserved: false));
+    }
+
+    [Theory]
+    [InlineData(false, false, false, true)]
+    [InlineData(true, true, false, true)]
+    [InlineData(true, false, true, true)]
+    [InlineData(true, false, false, false)]
+    public void EmergencyDepartureCannotAcceptLoadingDomainReviveOrAirborne(bool main, bool domain, bool revive, bool grounded) =>
+        Assert.False(PartyPreparationSafety.DepartureWorldAllowed(main, domain, revive, grounded));
+
+    private static readonly string[] Team = ["桑多涅", "奥黛塔", "八重神子", "钟离"];
+    private static PartySlotHealthEvidence[] Health() => Team.Select((name, i) => new PartySlotHealthEvidence
+        { Slot = i + 1, Name = name, Hp = 8000, MaxHp = 10000, Ratio = 0.8, Observations = 2,
+            IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true }).ToArray();
+
+    [Theory]
+    [InlineData("3723/50388", 3723, 50388)]
+    [InlineData(" 40 000 / 50 000 ", 40000, 50000)]
+    [InlineData("8000／10000", 8000, 10000)]
+    [InlineData("0/12345", 0, 12345)]
+    public void NumericHpRequiresBothActualValues(string text, int hp, int maximum)
+    {
+        var parsed = PartyHealthSafety.Parse(text);
+        Assert.Equal(new PartyHp(hp, maximum), parsed);
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("O/12345")]
+    [InlineData("12345")]
+    [InlineData("12345/0")]
+    [InlineData("12346/12345")]
+    [InlineData("1.2/12345")]
+    [InlineData("123/456 789/999")]
+    [InlineData("HP123/456")]
+    [InlineData("-1/12345")]
+    [InlineData("99999999/99999999")]
+    public void UnknownOcrCannotBeRepairedIntoLifeProof(string? text) => Assert.Null(PartyHealthSafety.Parse(text));
+
+    [Fact]
+    public void PreviouslyObservedZhongliLowHpAndDeadSlotBothBlockRoute()
+    {
+        Assert.False(PartyHealthSafety.Healthy(PartyHealthSafety.Parse("3723/50388")));
+        Assert.False(PartyHealthSafety.Healthy(PartyHealthSafety.Parse("0/12345")));
+        Assert.False(PartyHealthSafety.Healthy(new PartyHp(-1, 12345)));
+        Assert.False(PartyHealthSafety.Healthy(new PartyHp(1, 0)));
+        Assert.False(PartyHealthSafety.Healthy(new PartyHp(101, 100)));
+        Assert.False(PartyHealthSafety.Healthy(new PartyHp(7999, 10000)));
+        Assert.True(PartyHealthSafety.Healthy(new PartyHp(8000, 10000)));
+    }
+
+    [Fact]
+    public void TwoDifferentHealingReadingsOrOneFreshFrameCannotProveHealth()
+    {
+        Assert.False(PartyHealthSafety.MatchingHealthy(null, new PartyHp(10000, 10000)));
+        Assert.False(PartyHealthSafety.MatchingHealthy(new PartyHp(8000, 10000), new PartyHp(8500, 10000)));
+        Assert.False(PartyHealthSafety.MatchingHealthy(new PartyHp(8000, 10000), new PartyHp(8000, 11000)));
+        Assert.True(PartyHealthSafety.MatchingHealthy(new PartyHp(8000, 10000), new PartyHp(8000, 10000)));
+    }
+
+    [Fact]
+    public void StatueRevivalRequiresExplicitSeparatePermission()
+    {
+        var request = new PartyPreparationRequest { RunId = "test", ExpectedTeam = Team };
+        Assert.Throws<ArgumentException>(request.Validate);
+        request.AllowStatueRevival = true;
+        request.Validate();
+        request.TimeoutSeconds = 121;
+        Assert.Throws<ArgumentException>(request.Validate);
+        request.TimeoutSeconds = 0;
+        Assert.Throws<ArgumentException>(request.Validate);
+        request.TimeoutSeconds = 120;
+        request.ExpectedTeam = ["桑多涅", "桑多涅", "八重神子", "钟离"];
+        Assert.Throws<ArgumentException>(request.Validate);
+    }
+
+    [Fact]
+    public void FixedStatueCannotBeReplacedByAnotherIdTypeOrPosition()
+    {
+        var statue = new GiTpPosition { Id = "4", Type = "Goddess", Country = "蒙德", Areas = ["风起地"],
+            Position = [1928.381m, 196.139m, -1265.917m], TranPosition = [1934.3658m, 196.139m, -1266.3422m] };
+        Assert.True(PartyPreparationSafety.IsFixedStatue(statue));
+        statue.Id = "3"; Assert.False(PartyPreparationSafety.IsFixedStatue(statue));
+        statue.Id = "4"; statue.Type = "TeleportWaypoint"; Assert.False(PartyPreparationSafety.IsFixedStatue(statue));
+        statue.Type = "Goddess"; statue.Position[2] += 0.1m; Assert.False(PartyPreparationSafety.IsFixedStatue(statue));
+    }
+
+    [Fact]
+    public void DelayOrRosterWithoutIndividualHpDoesNotCompletePreparation()
+    {
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 4, [], Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(false, true, true, true, 4, Health(), Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(true, false, true, true, 4, Health(), Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(true, true, false, true, 4, Health(), Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, false, 4, Health(), Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 2, Health(), Team, true, 2));
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 4, Health().Reverse().ToArray(), Team, true, 2));
+        Assert.True(PartyPreparationSafety.Complete(true, true, true, true, 4, Health(), Team, true, 2));
+    }
+
+    [Fact]
+    public void DeadLowUnknownAndSingleFrameSlotsCannotPassEvenWithOtherGates()
+    {
+        foreach (var bad in new[] {
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 0, MaxHp = 10000, Observations = 2, IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 7999, MaxHp = 10000, Observations = 2, IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = null, MaxHp = null, Observations = 2, IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 10000, MaxHp = 10000, Observations = 1, IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 10000, MaxHp = 10000, Observations = 2, IdentityObservations = 1, OcrMatchingObservations = 2, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 10000, MaxHp = 10000, Observations = 2, IdentityObservations = 2, OcrMatchingObservations = 1, IdentityVerified = true },
+            new PartySlotHealthEvidence { Slot = 2, Name = Team[1], Hp = 10000, MaxHp = 10000, Observations = 2, IdentityObservations = 2, OcrMatchingObservations = 2, IdentityVerified = false }
+        })
+        {
+            var health = Health(); health[1] = bad;
+            Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 4, health, Team, true, 2));
+        }
+    }
+
+    [Fact]
+    public void GoodPartyAtSixUnitSpawnStillNeedsActualTwoFrameProximityProof()
+    {
+        Assert.False(PartyPreparationSafety.PositionWithin(PartyPreparationSafety.ArrivalX, PartyPreparationSafety.ArrivalY, 5));
+        var desired = PartyPreparationSafety.DesiredBoundary(PartyPreparationSafety.ArrivalX, PartyPreparationSafety.ArrivalY);
+        var distance = Math.Sqrt(Math.Pow(desired.x - PartyPreparationSafety.StatueX, 2) + Math.Pow(desired.y - PartyPreparationSafety.StatueY, 2));
+        Assert.Equal(4, distance, 6);
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 4, Health(), Team));
+        Assert.False(PartyPreparationSafety.Complete(true, true, true, true, 4, Health(), Team, true, 1));
+        Assert.True(PartyPreparationSafety.Complete(true, true, true, true, 4, Health(), Team, true, 2));
+        Assert.Throws<ArgumentException>(() => PartyPreparationSafety.DesiredBoundary(double.NaN, 1928));
+        Assert.Throws<ArgumentException>(() => PartyPreparationSafety.DesiredBoundary(PartyPreparationSafety.StatueX + 11, PartyPreparationSafety.StatueY));
+    }
+
+    [Theory]
+    [InlineData(-1, false)]
+    [InlineData(0, true)]
+    [InlineData(7999, true)]
+    [InlineData(8000, false)]
+    [InlineData(9000, false)]
+    public void ApproachCannotTurnAnExpiredMovementIntoArrival(long elapsed, bool allowed) =>
+        Assert.Equal(allowed, PartyPreparationSafety.ApproachWithinBudget(elapsed));
+}
