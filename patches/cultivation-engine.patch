@@ -0,0 +1,25 @@
+using System;
+using System.Linq;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public sealed class MaterialAreaSelectionPolicy
+{
+    public const int MenuOpenTimeoutMs = 5000;
+    public const int CandidateTimeoutMs = 5000;
+    private int _openFrames;
+    public bool ObserveMenu(bool titleObserved) => (_openFrames = titleObserved ? _openFrames + 1 : 0) >= 2;
+    public static Rect TitleRect(int width, int height) => new(width * 2 / 3, 0,
+        width - width * 2 / 3, height / 10);
+    public static Rect OptionsRect(int width, int height) => new(width * 2 / 3, height / 10,
+        width - width * 2 / 3, height * 82 / 100);
+    public static bool ExactName(string candidate, string localizedName, string areaName)
+    {
+        static string Normalize(string text) => new(text.Where(c => !char.IsWhiteSpace(c) &&
+            c is not ('"' or '“' or '”' or '「' or '」')).ToArray());
+        var name = Normalize(candidate);
+        return name.Length > 0 && ((!string.IsNullOrWhiteSpace(localizedName) && name == Normalize(localizedName)) ||
+            (!string.IsNullOrWhiteSpace(areaName) && name == Normalize(areaName)));
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoPathing/MaterialRecovery.cs b/BetterGenshinImpact/GameTask/AutoPathing/MaterialRecovery.cs
new file mode 100644
index 00000000..12bf37e4
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoPathing/MaterialRecovery.cs
@@ -0,0 +1,212 @@
+using System;
+using System.Diagnostics;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.GameTask.AutoFight;
+using BetterGenshinImpact.GameTask.AutoFight.Config;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.AutoTrackPath;
+using BetterGenshinImpact.GameTask.Common;
+using BetterGenshinImpact.GameTask.Common.Map.Maps;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Job;
+using Microsoft.Extensions.Logging;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public sealed class MaterialRecoveryRequest
+{
+    public const double HubX = -867.7041015625;
+    public const double HubY = 2281.378173828125;
+    public string RunId { get; set; } = "";
+    public string SessionId { get; set; } = "";
+    public string PartyName { get; set; } = "";
+    public string Stage { get; set; } = "after";
+    public string SafeHub { get; set; } = "mondstadt-city";
+    public string[] ExpectedTeam { get; set; } = [];
+    public int TimeoutSeconds { get; set; } = 60;
+    public void Validate()
+    {
+        MaterialRouteSafety.ValidateExpectedTeam(ExpectedTeam);
+        if (string.IsNullOrWhiteSpace(RunId) || Stage is not ("startup" or "after") ||
+            SafeHub != "mondstadt-city" || TimeoutSeconds is < 1 or > 60)
+            throw new ArgumentException("材料安全恢复参数无效");
+    }
+}
+
+public sealed class MaterialTeamProof
+{
+    public string[] ActualTeam { get; init; } = [];
+    public int[] Slots { get; init; } = [];
+    public bool Matched { get; init; }
+    public bool StateReady { get; init; }
+    public bool TwoFrames { get; init; }
+}
+
+public sealed class MaterialRecoveryProof
+{
+    public bool LoadingObserved { get; set; }
+    public bool MainUiRestored { get; set; }
+    public bool Grounded { get; set; }
+    public bool PositionVerified { get; set; }
+    public bool NoRevivePrompt { get; set; }
+    public bool TeamVerified { get; set; }
+    public string[] ActualTeam { get; set; } = [];
+    public double? ActualX { get; set; }
+    public double? ActualY { get; set; }
+    public bool EvidenceVerified(bool requireTeam) => LoadingObserved && MainUiRestored && Grounded &&
+        PositionVerified && NoRevivePrompt && (!requireTeam || TeamVerified);
+}
+
+public static class MaterialRecovery
+{
+    public static async Task<MaterialArrivalTracker> VerifyArrival(double targetX, double targetY, CancellationToken ct,
+        double maximumDistance = 20, bool requireNoEnemies = false)
+    {
+        var proof = new MaterialArrivalTracker(targetX, targetY, maximumDistance);
+        var matchingMethod = TaskContext.Instance().Config.PathingConditionConfig.MapMatchingMethod;
+        Navigation.WarmUp(matchingMethod);
+        var timer = Stopwatch.StartNew();
+        while (timer.ElapsedMilliseconds < MaterialArrivalTracker.ReadWindowMs)
+        {
+            ct.ThrowIfCancellationRequested();
+            var readStartedAt = timer.ElapsedMilliseconds;
+            using (var frame = TaskControl.CaptureToRectArea(forceNew: true))
+            {
+                if (Bv.IsInRevivePrompt(frame))
+                {
+                    proof.Observe(false, null, null);
+                    TaskControl.Logger.LogWarning("材料传送实际位置核验发现复苏提示，停止");
+                    return proof;
+                }
+                var ready = MaterialSwitchSafety.Observe(frame).ready;
+                if (requireNoEnemies) { PartyHealth.RequireSafeWorld(frame); ready = true; }
+                double? actualX = null, actualY = null;
+                if (ready)
+                {
+                    Navigation.Reset();
+                    var image = Navigation.GetPositionStable(frame, "Teyvat", matchingMethod);
+                    var world = image == default ? null : MapManager.GetMap("Teyvat", matchingMethod)
+                        .ConvertImageCoordinatesToGenshinMapCoordinates(image);
+                    actualX = world?.X;
+                    actualY = world?.Y;
+                    TaskControl.Logger.LogInformation("材料传送实际位置：image=({ImageX},{ImageY}) world=({ActualX},{ActualY}) target=({TargetX},{TargetY}) arrivalElapsedMs={ElapsedMs} frameReadMs={FrameReadMs}",
+                        image.X, image.Y, actualX, actualY, targetX, targetY,
+                        timer.ElapsedMilliseconds, timer.ElapsedMilliseconds - readStartedAt);
+                }
+                // Always preserve the rejected reading before deciding whether to stop.
+                proof.Observe(ready, actualX, actualY, timer.ElapsedMilliseconds);
+                ct.ThrowIfCancellationRequested();
+                if (timer.ElapsedMilliseconds >= MaterialArrivalTracker.ReadWindowMs) break;
+                if (proof.Verified) return proof;
+                TaskControl.Logger.LogWarning("材料传送到点证明尚未通过：{Reason}，仅等待新帧，不移动/重传", proof.Rejection);
+            }
+            await TaskControl.Delay(250, ct);
+        }
+        return proof;
+    }
+
+    public static async Task<MaterialTeamProof> ReadTeam(string[] expected, CancellationToken ct)
+    {
+        if (!string.IsNullOrWhiteSpace(TaskContext.Instance().Config.AutoFightConfig.TeamNames))
+            throw new InvalidOperationException("材料队伍核验禁止强制队伍姓名配置");
+        string[] previous = [];
+        int[] previousSlots = [];
+        bool ready = true, matched = true;
+        for (var i = 0; i < 2; i++)
+        {
+            ct.ThrowIfCancellationRequested();
+            if (i > 0) await TaskControl.Delay(250, ct);
+            using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+            var state = MaterialSwitchSafety.Observe(frame);
+            ready &= state.ready;
+            if (!state.ready) return new MaterialTeamProof();
+            // Explicit empty TeamNames: never source identities from the configured preset.
+            using var scene = new CombatScenes().InitializeTeam(frame, new AutoFightConfig { TeamNames = "" });
+            ct.ThrowIfCancellationRequested();
+            var actual = scene.GetAvatars().Select(a => a.Name).ToArray();
+            var slots = scene.GetAvatars().Select(a => a.Index).ToArray();
+            matched &= MaterialRouteSafety.TeamMatches(expected, actual, slots,
+                scene.CurrentMultiGameStatus?.IsInMultiGame != false);
+            if (i > 0 && (!actual.SequenceEqual(previous) || !slots.SequenceEqual(previousSlots)))
+                return new MaterialTeamProof { ActualTeam = actual, Slots = slots };
+            previous = actual;
+            previousSlots = slots;
+        }
+        return new MaterialTeamProof { ActualTeam = previous, Slots = previousSlots,
+            Matched = matched, StateReady = ready, TwoFrames = true };
+    }
+
+    // A startup recovery may precede a required party switch; independent recovery requires the target team.
+    public static async Task<MaterialRecoveryProof> Recover(MaterialRecoveryRequest request, CancellationToken ct,
+        Action<object> emit, bool requireTeam = true)
+    {
+        request.Validate();
+        var proof = new MaterialRecoveryProof();
+        var timer = Stopwatch.StartNew();
+        string status = "failed";
+        string? error = null;
+        bool cleanupCompleted = false;
+        emit(new { task = "material-route-recovery", status = "started", runId = request.RunId,
+            sessionId = request.SessionId, stage = request.Stage, parameterEvidence = request });
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(request.TimeoutSeconds));
+        try
+        {
+            Simulation.ReleaseAllKey();
+            MaterialSwitchSafety.WaitGrounded(timeout.Token);
+            // Fixed city anchor from Common/Element/Assets/Json/合成台_蒙德.json's first teleport point.
+            // No statue healing, dialogue, crafting, party attack, food, or revival occurs here.
+            var tp = new TpTask(timeout.Token, materialRecoveryProof: true);
+            await tp.Tp(MaterialRecoveryRequest.HubX, MaterialRecoveryRequest.HubY, "Teyvat", true);
+            proof.LoadingObserved = tp.LoadingTransitionVerified;
+            var arrival = await VerifyArrival(MaterialRecoveryRequest.HubX, MaterialRecoveryRequest.HubY, timeout.Token);
+            proof.ActualX = arrival.ActualX;
+            proof.ActualY = arrival.ActualY;
+            if (!arrival.Verified) throw new InvalidOperationException($"安全传送后两帧实际位置证明失败：{arrival.Rejection}; observed=({arrival.ActualX},{arrival.ActualY})");
+            proof.MainUiRestored = proof.Grounded = proof.PositionVerified = proof.NoRevivePrompt = true;
+            var team = await ReadTeam(request.ExpectedTeam, timeout.Token);
+            if (requireTeam && request.Stage == "startup" && !team.Matched)
+            {
+                if (string.IsNullOrWhiteSpace(request.PartyName))
+                    throw new InvalidOperationException("安全启动实际队伍不匹配且未提供必要的 partyName");
+                if (!await new SwitchPartyTask().Start(request.PartyName, timeout.Token))
+                    throw new InvalidOperationException("安全城市启动队伍切换失败");
+                RunnerContext.Instance.ClearCombatScenes();
+                team = await ReadTeam(request.ExpectedTeam, timeout.Token);
+            }
+            proof.ActualTeam = team.ActualTeam;
+            proof.TeamVerified = team.TwoFrames && team.Matched;
+            if (!proof.EvidenceVerified(requireTeam)) throw new InvalidOperationException("安全恢复实际四人队伍未获两帧精确核验");
+            timeout.Token.ThrowIfCancellationRequested();
+            status = "completed";
+        }
+        catch (Exception exception)
+        {
+            status = ct.IsCancellationRequested ? "cancelled" : timeout.IsCancellationRequested ? "timeout" : "failed";
+            error = exception.Message;
+        }
+        finally
+        {
+            try { Simulation.ReleaseAllKey(); cleanupCompleted = true; }
+            catch (Exception exception) { status = "failed"; error = (error ?? "") + "; cleanup: " + exception.Message; }
+        }
+        emit(new { task = "material-route-recovery", status, runId = request.RunId,
+            sessionId = request.SessionId, stage = request.Stage, parameterEvidence = request,
+            loadingObserved = proof.LoadingObserved, mainUiRestored = proof.MainUiRestored,
+            grounded = proof.Grounded, positionVerified = proof.PositionVerified, noRevivePrompt = proof.NoRevivePrompt,
+            actualTeam = proof.ActualTeam, teamVerified = proof.TeamVerified,
+            actualPosition = new { x = proof.ActualX, y = proof.ActualY },
+            evidenceVerified = status == "completed" && proof.EvidenceVerified(requireTeam),
+            scopeRecovered = status == "completed", cleanupCompleted, noResinSpend = true, noFood = true,
+            noRevive = true, noCrafting = true, noUpgrade = true, elapsedMs = Math.Round(timer.Elapsed.TotalMilliseconds), error });
+        if (status != "completed")
+        {
+            ct.ThrowIfCancellationRequested();
+            throw new InvalidOperationException(error ?? "材料安全恢复失败");
+        }
+        return proof;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoPathing/MaterialRouteExecution.cs b/BetterGenshinImpact/GameTask/AutoPathing/MaterialRouteExecution.cs
new file mode 100644
index 00000000..ac4dd2e3
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoPathing/MaterialRouteExecution.cs
@@ -0,0 +1,108 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using BetterGenshinImpact.GameTask.AutoPathing.Model;
+using Newtonsoft.Json;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+public sealed class MaterialRouteRequest
+{
+    public string RunId { get; set; } = "";
+    public string RoutePath { get; set; } = "";
+    public string Sha256 { get; set; } = "";
+    public string PartyName { get; set; } = "";
+    public string StrategyName { get; set; } = "木偶星超导";
+    public bool RequireZhongliShield { get; set; } = true;
+    public int TimeoutSeconds { get; set; } = 480;
+    public string[] ExpectedTeam { get; set; } = [];
+}
+
+public static class MaterialRouteSafety
+{
+    public const string SubscriptionDirectory = "auto_game_handguard";
+    public static string ResolvePath(string root, string relativePath)
+    {
+        if (string.IsNullOrWhiteSpace(relativePath) || Path.IsPathRooted(relativePath) || relativePath.Contains(':'))
+            throw new ArgumentException("路线必须是订阅目录内的相对路径");
+        var subscription = Path.GetFullPath(Path.Combine(root, SubscriptionDirectory)) + Path.DirectorySeparatorChar;
+        var full = Path.GetFullPath(Path.Combine(root, relativePath.Replace('/', Path.DirectorySeparatorChar)));
+        if (!full.StartsWith(subscription, StringComparison.OrdinalIgnoreCase) || !full.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("路线不在固定刀镡订阅白名单目录");
+        // Reject junctions/symlinks, including an ancestor of the subscription root.
+        for (var current = full; !string.IsNullOrEmpty(current); current = Path.GetDirectoryName(current))
+            if ((File.Exists(current) || Directory.Exists(current)) && (File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                throw new ArgumentException("路线不允许使用重解析路径");
+        return full;
+    }
+
+    public static void ValidateRequest(MaterialRouteRequest request)
+    {
+        // Historical single-route callers remain conservative: absent names never permit skipping the party menu.
+        if (request.ExpectedTeam.Length != 0) ValidateExpectedTeam(request.ExpectedTeam);
+        if (string.IsNullOrWhiteSpace(request.RunId) || string.IsNullOrWhiteSpace(request.PartyName) ||
+            request.StrategyName != "木偶星超导" || !request.RequireZhongliShield ||
+            request.TimeoutSeconds < 1 || request.TimeoutSeconds > 480 ||
+            request.Sha256.Length != 64 || request.Sha256.Any(c => !Uri.IsHexDigit(c)))
+            throw new ArgumentException("刀镡路线参数无效：必须指定 runId、队伍、固定策略、护盾及1至480秒上限和SHA256");
+    }
+
+    public static void ValidateExpectedTeam(string[]? names)
+    {
+        if (names is not { Length: 4 } || names.Any(n => string.IsNullOrWhiteSpace(n) || n != n.Trim()) ||
+            names.Distinct(StringComparer.Ordinal).Count() != 4)
+            throw new ArgumentException("材料路线必须提供按1至4号位排列的四个不同实际角色名 expectedTeam");
+    }
+
+    public static bool TeamMatches(string[] expected, string[] actual, int[] slots, bool inMultiGame) =>
+        !inMultiGame && actual.Length == 4 && slots.SequenceEqual(new[] { 1, 2, 3, 4 }) &&
+        expected.Length == 4 && expected.SequenceEqual(actual, StringComparer.Ordinal);
+
+    public static bool SafeHubPosition(double x, double y) => double.IsFinite(x) && double.IsFinite(y) &&
+        Math.Pow(x - MaterialRecoveryRequest.HubX, 2) + Math.Pow(y - MaterialRecoveryRequest.HubY, 2) <= 20 * 20;
+
+    public static string Hash(byte[] bytes) => Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+
+    public static void ValidateTask(PathingTask task)
+    {
+        var actions = new HashSet<string>(StringComparer.Ordinal) { "", "fight", "pick_around", "force_tp", "stop_flying" };
+        var types = new HashSet<string>(StringComparer.Ordinal) { "path", "target", "teleport", "orientation" };
+        var moves = new HashSet<string>(StringComparer.Ordinal) { "walk", "run", "dash", "climb", "fly", "swim", "jump" };
+        if (task.Positions.Count == 0 || !task.Positions.Any(p => p.Action == "fight"))
+            throw new ArgumentException("路线没有有效战斗点");
+        foreach (var point in task.Positions)
+            if (!double.IsFinite(point.X) || !double.IsFinite(point.Y) || !actions.Contains(point.Action ?? "") ||
+                !types.Contains(point.Type) || !moves.Contains(point.MoveMode) || !string.IsNullOrWhiteSpace(point.ActionParams))
+                throw new ArgumentException("路线含不支持的点位、动作或注入参数");
+    }
+
+    public static string PointId(string hash, double x, double y) =>
+        hash + ":" + x.ToString("R", CultureInfo.InvariantCulture) + "," + y.ToString("R", CultureInfo.InvariantCulture);
+}
+
+public sealed class MaterialRouteExecution(MaterialRouteRequest request, Action<object> emit)
+{
+    public MaterialRouteRequest Request { get; } = request;
+    public BetterGenshinImpact.GameTask.AutoFight.ZhongliHoldShieldGuard ShieldGuard { get; } = new();
+    public List<string> CompletedFightPoints { get; } = [];
+    public int ObservedHoldCasts { get; private set; }
+    public string[] ActualTeam { get; set; } = [];
+    public void ShieldEvent(object payload)
+    {
+        ObservedHoldCasts++;
+        emit(new { task = "material-route-shield-cast", status = "cast_observed", runId = Request.RunId,
+            routePath = Request.RoutePath, sha256 = Request.Sha256, evidence = "hold_skill_cooldown_observed", detail = payload });
+    }
+    public void FightEvent(string status, WaypointForTrack point, string? error = null)
+    {
+        var id = MaterialRouteSafety.PointId(Request.Sha256, point.GameX, point.GameY);
+        if (status == "cleared") CompletedFightPoints.Add(id);
+        emit(new { task = "material-route-fight", status, runId = Request.RunId, routePath = Request.RoutePath,
+            sha256 = Request.Sha256, pointId = id, x = point.GameX, y = point.GameY, error,
+            battleEndDetected = status == "cleared", enemyObserved = status == "cleared",
+            evidence = status == "cleared" ? "enemy_bloodbar_observed_then_party_setup_progress_white_yellow_detected_and_pickup_returned" : null });
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/AutoPathing/MaterialTeleportProtocol.cs b/BetterGenshinImpact/GameTask/AutoPathing/MaterialTeleportProtocol.cs
new file mode 100644
index 00000000..0ee11ac4
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoPathing/MaterialTeleportProtocol.cs
@@ -0,0 +1,85 @@
+using System;
+
+namespace BetterGenshinImpact.GameTask.AutoPathing;
+
+/// <summary>Material-only protocol: a closed map is never a teleport acknowledgement.</summary>
+public sealed class MaterialTeleportProtocol
+{
+    private int _loadingFrames;
+    private int _worldFrames;
+    public bool LoadingObserved { get; private set; }
+    public int LoadingFrames => _loadingFrames;
+    public int WorldFrames => _worldFrames;
+    public string StateReason { get; private set; } = "not_observed";
+    public bool Observe(bool confirmIssued, bool mainUi, bool bigMapUi, bool revivePrompt, long elapsedMs)
+    {
+        if (!confirmIssued || revivePrompt || bigMapUi)
+        {
+            _loadingFrames = _worldFrames = 0;
+            LoadingObserved = false;
+            StateReason = !confirmIssued ? "confirm_not_issued" : revivePrompt ? "revive_prompt" : "big_map_visible";
+            return false;
+        }
+        if (!mainUi)
+        {
+            _worldFrames = 0;
+            LoadingObserved |= ++_loadingFrames >= 2;
+            StateReason = LoadingObserved ? "loading_verified_waiting_world" : "loading_candidate";
+            return false;
+        }
+        _loadingFrames = 0;
+        if (!LoadingObserved || elapsedMs < 1000) {
+            _worldFrames = 0;
+            StateReason = !LoadingObserved ? "world_without_loading" : "completion_minimum_wait";
+            return false;
+        }
+        var complete = ++_worldFrames >= 2;
+        StateReason = complete ? "completed" : "world_candidate";
+        return complete;
+    }
+}
+
+/// <summary>Material-only diagnostics are bounded; no proof counter or input is affected.</summary>
+public sealed class MaterialTeleportTracePolicy
+{
+    public const int MaximumRows = 60;
+    private string? _lastState;
+    private long _lastAt = -1000;
+    public int Rows { get; private set; }
+    public bool Record(string state, long elapsedMs)
+    {
+        if (Rows >= MaximumRows || elapsedMs < 0 || (state == _lastState && elapsedMs - _lastAt < 1000)) return false;
+        Rows++; _lastState = state; _lastAt = elapsedMs; return true;
+    }
+}
+
+/// <summary>Two real observations inside the original 20-unit bound; no target/cached-position fallback.</summary>
+public sealed class MaterialArrivalTracker(double targetX, double targetY, double maximumDistance = 20)
+{
+    // Real global map matching can take over five seconds per observation on this host.
+    // This read-only arrival window is separate from the five-second character-switch gate.
+    public const int ReadWindowMs = 15000;
+    private int _validFrames;
+    public double? ActualX { get; private set; }
+    public double? ActualY { get; private set; }
+    public string Rejection { get; private set; } = "actual_position_not_observed";
+    public bool Verified => _validFrames >= 2;
+    public void Expire()
+    {
+        _validFrames = 0;
+        Rejection = "arrival_deadline_expired";
+    }
+    public bool Observe(bool worldReady, double? actualX, double? actualY, long elapsedMs = 0)
+    {
+        if (actualX.HasValue && actualY.HasValue) { ActualX = actualX; ActualY = actualY; }
+        if (elapsedMs >= ReadWindowMs) { Expire(); return false; }
+        bool positionValid = actualX.HasValue && actualY.HasValue && double.IsFinite(actualX.Value) &&
+            double.IsFinite(actualY.Value) && Math.Pow(actualX.Value - targetX, 2) +
+            Math.Pow(actualY.Value - targetY, 2) <= maximumDistance * maximumDistance &&
+            double.IsFinite(maximumDistance) && maximumDistance > 0 && maximumDistance <= 20;
+        _validFrames = worldReady && positionValid ? _validFrames + 1 : 0;
+        Rejection = !worldReady ? "world_or_grounded_state_not_verified" :
+            !positionValid ? "actual_position_outside_target_or_unrecognized" : "";
+        return Verified;
+    }
+}
