+
+public class MaterialAreaSelectionTests
+{
+    [Fact]
+    public void BackgroundAndSingleTitleCannotUnlockAreaOcr()
+    {
+        var policy = new MaterialAreaSelectionPolicy();
+        Assert.False(policy.ObserveMenu(false));
+        Assert.False(policy.ObserveMenu(true));
+        Assert.False(policy.ObserveMenu(false));
+        Assert.False(policy.ObserveMenu(true));
+        Assert.True(policy.ObserveMenu(true));
+    }
+
+    [Theory]
+    [InlineData("稻妻", true)]
+    [InlineData(" 稻 妻 ", true)]
+    [InlineData("“稻妻”", true)]
+    [InlineData("稻妻探索度", false)]
+    [InlineData("前往稻妻", false)]
+    [InlineData("坠星山谷", false)]
+    [InlineData("", false)]
