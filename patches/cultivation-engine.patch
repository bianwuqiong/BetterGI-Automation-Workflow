+using BetterGenshinImpact.GameTask.AutoDomain;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.AutoDomainTests;
+
+public class SingleOriginal20ClaimSafetyTests
+{
+    private static readonly ClaimTextBox[] Header = [new("石化古树", new Rect(880,260,160,40)), new("请选择激活方式", new Rect(820,380,270,30))];
+    private static readonly ClaimTextBox[] ValidRow = [new("使用20个原粹树脂", new Rect(674,480,220,30)), new("使用", new Rect(1230,480,45,30))];
+    private static SingleOriginal20Proof? Proof(long at, IEnumerable<ClaimTextBox>? row = null) => SingleOriginal20ClaimSafety.Select(Header,row??ValidRow,1920,1080,at);
+    private static SingleOriginal20Contract Contract() => new(true,false,1,true,1,0,0,0,0,0,["原粹树脂"]);
+
+    [Fact]
+    public void OrdinaryCoreCombatOnlyAndOtherResourceContractsRemainOnTheirExistingPath()
+    {
+        var valid=Contract(); Assert.True(SingleOriginal20ClaimSafety.Applies(valid));
+        foreach(var other in new[]{valid with{RequireShield=false},valid with{CombatOnly=true},valid with{Rounds=2},
+            valid with{Specify=false},valid with{Original20=2},valid with{LegacyOriginal=1},valid with{Original40=1},
+            valid with{Condensed=1},valid with{Transient=1},valid with{Fragile=1},valid with{Priority=["原粹树脂","脆弱树脂"]}})
+            Assert.False(SingleOriginal20ClaimSafety.Applies(other));
+    }
+
+    [Fact]
+    public void TwoFreshFramesPermitOnlyTheIndependentOriginal20Button()
+    {
+        var first=Proof(1000); var second=Proof(1300); Assert.NotNull(first);
+        Assert.True(SingleOriginal20ClaimSafety.Matching(first,second,1400));
+        Assert.Equal(new Rect(1230,480,45,30),second!.Button);
+        Assert.False(SingleOriginal20ClaimSafety.Matching(first,first,1400));
+        Assert.False(SingleOriginal20ClaimSafety.Matching(first,Proof(7000),7100));
+        Assert.False(SingleOriginal20ClaimSafety.Matching(first,second,2900));
+        Assert.False(SingleOriginal20ClaimSafety.Matching(null,second,1400));
+        Assert.Null(SingleOriginal20ClaimSafety.Select([],ValidRow,1920,1080,1000));
+    }
+
+    [Fact]
+    public void NoFragilePrimogemFortyMergedOrCrossRowCandidateCanBeClicked()
+    {
+        foreach(var label in new[]{"使用1个脆弱树脂，获取3次产出","使用50原石，获取3次产出","使用40个原粹树脂","使用20个原粹树脂使用1个脆弱树脂"})
+            Assert.Null(Proof(1000,[new(label,ValidRow[0].Bounds),ValidRow[1]]));
+        Assert.Null(Proof(1000,[ValidRow[0],new("使用使用使用",new Rect(1230,480,45,280))]));
+        Assert.Null(Proof(1000,[ValidRow[0],new("使用",new Rect(1230,620,45,30))]));
+        Assert.Null(Proof(1000,[ValidRow[0],new("使用",new Rect(1230,480,45,150))]));
+        Assert.Null(Proof(1000,[ValidRow[0],ValidRow[1],ValidRow[1]]));
+        Assert.Null(Proof(1000,[ValidRow[0],ValidRow[0],ValidRow[1]]));
+        Assert.Null(Proof(1000,[ValidRow[0],new("使用",new Rect(900,480,45,30))]));
+        var shifted=Proof(1300,[ValidRow[0],new("使用",new Rect(1240,480,45,30))]);
+        Assert.False(SingleOriginal20ClaimSafety.Matching(Proof(1000),shifted,1400));
+    }
+
+    [Fact]
+    public void ASubmissionOrExceptionAfterItsInputNeverPermitsASecondClick()
+    {
+        var clicks=new List<Rect>(); var submission=new SingleOriginal20Submission();
+        Assert.True(submission.Submit(Proof(1000),Proof(1300),1400,clicks.Add));
+        Assert.False(submission.Submit(Proof(1600),Proof(1900),2000,clicks.Add));
+        Assert.Single(clicks);
+        var interrupted=new SingleOriginal20Submission(); int calls=0;
+        Assert.Throws<InvalidOperationException>(()=>interrupted.Submit(Proof(1000),Proof(1300),1400,_=>{calls++;throw new InvalidOperationException("after click");}));
+        Assert.True(interrupted.Requested);
+        Assert.False(interrupted.Submit(Proof(1600),Proof(1900),2000,_=>calls++));
+        Assert.Equal(1,calls);
+    }
+
+    [Theory]
+    [InlineData("尚未领取当前秘境的奖励，是否退出？",true)]
+    [InlineData("是否退出秘境？",true)]
+    [InlineData("当前秘境 使用原粹树脂 是否退出？",false)]
+    [InlineData("是否退出秘境？使用脆弱树脂",false)]
+    [InlineData("是否使用50原石？",false)]
+    [InlineData("退出游戏",false)]
+    [InlineData("确认",false)]
+    public void ExactExitPromptCannotBeReplacedByAResourceOrGenericConfirmation(string text,bool accepted) =>
+        Assert.Equal(accepted,ExactDomainExitSafety.IsExactPrompt(text));
+
+    [Fact]
+    public void ExitRequiresFullPromptUniqueSmallButtonAndTwoMatchingFrames()
+    {
+        ClaimTextBox[] rows=[new("是否退出秘境？",new Rect(700,400,400,40)),new("取消",new Rect(700,650,50,40)),new("确认",new Rect(1100,650,50,40))];
+        var first=ExactDomainExitSafety.Select(rows,1920,1080,1000); var second=ExactDomainExitSafety.Select(rows,1920,1080,1400);
+        Assert.NotNull(first); Assert.True(ExactDomainExitSafety.Matching(first,second,1500));
+        Assert.False(ExactDomainExitSafety.Matching(first,first,1500));
+        Assert.Null(ExactDomainExitSafety.Select(rows.Concat([rows[^1]]),1920,1080,1400));
+        Assert.Null(ExactDomainExitSafety.Select([rows[0],new("确认",new Rect(700,650,50,40))],1920,1080,1400));
+        Assert.Null(ExactDomainExitSafety.Select([new("是否使用原粹树脂？",rows[0].Bounds),rows[1],rows[2]],1920,1080,1400));
+        var policy=new CombatOnlyExitPolicy();
+        Assert.Equal(CombatOnlyExitAction.Wait,policy.Observe(false,true,false,false,TimeSpan.Zero,anyDialogVisible:true));
+        Assert.Equal(CombatOnlyExitAction.ConfirmExit,policy.Observe(false,true,false,true,TimeSpan.FromSeconds(1),anyDialogVisible:true));
+        var completion=new ProtectedClaimExitProtocol();
+        Assert.False(completion.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(3)));
+        Assert.False(completion.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromSeconds(3.5)));
+        // The protected integration rejects generic world frames without a clicked-exit/loading chain.
+    }
+
+    [Fact]
+    public void ActualExitTwoShortLoadingFramesAndOutsideWorldTwiceRestoreOnlyExitContext()
+    {
+        var protocol=new ProtectedClaimExitProtocol();protocol.MarkExitClicked(TimeSpan.Zero);
+        Assert.False(protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(546)));
+        Assert.False(protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(779)));
+        Assert.True(protocol.LoadingObserved);
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1710)));
+        Assert.True(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1951)));
+    }
+
+    [Fact]
+    public void OneLoadingFrameOrUnclickedExitCannotComplete()
+    {
+        var one=new ProtectedClaimExitProtocol();one.MarkExitClicked(TimeSpan.Zero);
+        one.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(546));
+        Assert.False(one.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1710)));
+        Assert.False(one.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1951)));
+        var none=new ProtectedClaimExitProtocol();
+        none.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(546));
+        none.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(779));
+        Assert.False(none.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1710)));
+        Assert.False(none.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1951)));
+    }
+
+    [Fact]
+    public void SlowFinalOcrAtDeadlineCannotTurnAnExitIntoSuccessfulReturn()
+    {
+        var protocol=new ProtectedClaimExitProtocol();protocol.MarkExitClicked(TimeSpan.Zero);
+        protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(546));
+        protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(779));
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(29900)));
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(30000)));
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(31000)));
+        Assert.True(ProtectedClaimExitProtocol.WithinDeadline(TimeSpan.FromMilliseconds(29999)));
+        Assert.False(ProtectedClaimExitProtocol.WithinDeadline(TimeSpan.FromMilliseconds(30000)));
+    }
+
+    [Theory]
+    [InlineData(true,false,false,false,false)]
+    [InlineData(false,true,false,false,false)]
+    [InlineData(false,false,true,false,false)]
+    [InlineData(false,false,false,true,false)]
+    [InlineData(false,false,false,false,true)]
+    public void DoorCountdownResourceDialogOrUnknownPageResetsLoading(bool door,bool countdown,bool resource,bool dialog,bool unknown)
+    {
+        var protocol=new ProtectedClaimExitProtocol();protocol.MarkExitClicked(TimeSpan.Zero);
+        protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(300));
+        protocol.Observe(false,false,false,false,false,false,false,false,true,TimeSpan.FromMilliseconds(500));
+        Assert.False(protocol.Observe(!unknown,false,door,countdown,resource,dialog,false,false,false,TimeSpan.FromMilliseconds(800)));
+        Assert.False(protocol.LoadingObserved);
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1700)));
+        Assert.False(protocol.Observe(true,false,false,false,false,false,false,false,false,TimeSpan.FromMilliseconds(1950)));
+    }
+}
