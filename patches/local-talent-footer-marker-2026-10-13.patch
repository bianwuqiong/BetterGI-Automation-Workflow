+            x.ReaderStartedAt<x.CaptureReturnedAt||x.ReaderCompletedAt<x.ReaderStartedAt||
+            x.PairEvaluatedAt is not null||x.PairAccepted is not null||
+            y.CaptureCallStartedAt<=x.ReaderCompletedAt||y.CaptureCallStartedAt>y.CaptureReturnedAt||
+            y.CaptureReturnedAt!=b.ObservedAt||y.ReaderStartedAt<y.CaptureReturnedAt||
+            y.ReaderCompletedAt<y.ReaderStartedAt||y.PairEvaluatedAt is not long evaluated||
+            evaluated<y.ReaderCompletedAt||y.PairAccepted is not true||
+            x.DiagnosticPngCompletedAt is not long firstDone||y.DiagnosticPngCompletedAt is not long secondDone||
+            firstDone<evaluated||secondDone<firstDone||
+            a.PrivateCapture is not { } firstImage||b.PrivateCapture is not { } secondImage||
+            firstImage.ObservedAt!=a.ObservedAt||secondImage.ObservedAt!=b.ObservedAt||
+            a.Width!=1920||a.Height!=1080||b.Width!=1920||b.Height!=1080||
+            firstImage.Width!=a.Width||firstImage.Height!=a.Height||secondImage.Width!=b.Width||secondImage.Height!=b.Height||
+            !PrivateCaptureShape(firstImage)||!PrivateCaptureShape(secondImage))return false;
+        return TooltipPair(a,b,item,evaluated);
+    }
     // Tooltip's aggregate cultivation denominator is intentionally not the next-upgrade requirement.
 }
