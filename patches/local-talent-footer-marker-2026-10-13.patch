+            first with{ReadTiming=first.ReadTiming! with{DiagnosticPngCompletedAt=2000}},
+            second with{ReadTiming=second.ReadTiming! with{PairEvaluatedAt=1900,DiagnosticPngCompletedAt=2100}},item));
+        Assert.False(TalentUpgradePreviewEvidence.TimedTooltipPair(first,second with{PrivateCapture=null},item));
+        Assert.False(TalentUpgradePreviewEvidence.TimedTooltipPair(first,second with{ReadTiming=second.ReadTiming! with{CaptureReturnedAt=401}},item));
+    }
+}
