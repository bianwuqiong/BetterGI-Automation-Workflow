+    internal readonly record struct GridScrollInputAudit(string Stage, int WheelIndex, int GroupIndex,
+        long GuardCheckedAt, long InputSentAt);
+
+    internal static class GridIndividualInputGuard
+    {
+        internal static void BeforeWheel(Action? fullGuard, Func<bool>? fastGuard)
+        {
+            fullGuard?.Invoke();
+            if (fastGuard is not null && !fastGuard())
+            {
+                fullGuard?.Invoke();
+                if (!fastGuard()) throw new InvalidOperationException("grid_scroll_individual_fresh_guard_expired_after_refresh");
+            }
+        }
+    }
+
+    // A fresh page proof may cover a short, bounded burst of second-stage wheel inputs.
+    // The fast guard still runs before every input and may only return false for expiry.
+    internal sealed class GridSecondStageInputBatch
+    {
+        private readonly int maximumWheels;
+        private readonly Action fullGuard;
+        private readonly Func<bool> fastGuard;
+        private readonly Func<long> monotonicMilliseconds;
+        private long openedAt;
+        private int used;
+        private int groupIndex = -1;
+
+        internal GridSecondStageInputBatch(int maximumWheels, Action fullGuard, Func<bool> fastGuard,
+            Func<long> monotonicMilliseconds)
+        {
+            if (maximumWheels is < 1 or > 4) throw new ArgumentOutOfRangeException(nameof(maximumWheels));
+            this.maximumWheels = maximumWheels;
+            this.fullGuard = fullGuard ?? throw new ArgumentNullException(nameof(fullGuard));
+            this.fastGuard = fastGuard ?? throw new ArgumentNullException(nameof(fastGuard));
+            this.monotonicMilliseconds = monotonicMilliseconds ?? throw new ArgumentNullException(nameof(monotonicMilliseconds));
+        }
+
+        internal int BeforeWheel()
+        {
+            bool refreshRequired = false;
+            for (int attempt = 0; attempt < 2; attempt++)
+            {
+                var now = monotonicMilliseconds();
+                if (refreshRequired || used == 0 || used >= maximumWheels || now < openedAt || now - openedAt > 250)
+                    Refresh();
+                // Only an expired proof may return false. A lost focus, owner, binding,
+                // process or cancellation must throw and can never be reacquired here.
+                if (!fastGuard()) { refreshRequired = true; continue; }
+                now = monotonicMilliseconds();
+                if (now < openedAt || now - openedAt > 250) { refreshRequired = true; continue; }
+                used++;
+                return groupIndex;
+            }
+            throw new InvalidOperationException("grid_scroll_fresh_guard_expired_after_refresh");
+        }
+
+        private void Refresh()
+        {
+            fullGuard();
+            openedAt = monotonicMilliseconds();
+            used = 0;
+            groupIndex++;
+        }
+    }
