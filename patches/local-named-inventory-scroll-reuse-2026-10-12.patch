+// SPDX-License-Identifier: GPL-3.0-only
+// Modified 2026-10-12: pure bounds for named inventory second-stage wheel guards.
+using System;
+using BetterGenshinImpact.GameTask.Model.GameUI;
+using Xunit;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests.Model.GameUI;
+
+public sealed class GridSecondStageInputBatchTests
+{
+    [Fact]
+    public void DefaultGridPolicyAndIndividualProbeFineWheelRemainOneFullGuardPerInput()
+    {
+        Assert.Equal(1, GridScroller.DefaultSecondStageMaxWheelsPerFreshGuard);
+        int fullGuards = 0, fastGuards = 0;
+        for (int i = 0; i < 3; i++)
+            GridIndividualInputGuard.BeforeWheel(() => fullGuards++, () => { fastGuards++; return true; });
+        Assert.Equal(3, fullGuards);
+        Assert.Equal(3, fastGuards);
+    }
+
+    [Fact]
+    public void ExpiredIndividualWheelProofAlsoRequiresANewFullGuard()
+    {
+        int fullGuards = 0, fastGuards = 0;
+        GridIndividualInputGuard.BeforeWheel(() => fullGuards++, () => ++fastGuards > 1);
+        Assert.Equal(2, fullGuards);
+        Assert.Equal(2, fastGuards);
+    }
+
+    [Theory]
+    [InlineData(1, 32, 32)]
+    [InlineData(4, 32, 8)]
+    public void OnlyExplicitOptInCanReuseOneFreshProofForUpToFourWheels(int maximum, int wheels, int expectedFullGuards)
+    {
+        long now = 1000;
+        int fullGuards = 0, fastGuards = 0;
+        var batch = new GridSecondStageInputBatch(maximum, () => fullGuards++, () => { fastGuards++; return true; }, () => now);
+        for (int i = 0; i < wheels; i++)
+        {
+            Assert.Equal(i / maximum, batch.BeforeWheel());
+            now += 40;
+        }
+        Assert.Equal(expectedFullGuards, fullGuards);
+        Assert.Equal(wheels, fastGuards);
+    }
+
+    [Fact]
+    public void ZeroAndMoreThanFourWheelsPerProofAreRejected()
+    {
+        Assert.Throws<ArgumentOutOfRangeException>(() => new GridSecondStageInputBatch(0, () => { }, () => true, () => 0));
+        Assert.Throws<ArgumentOutOfRangeException>(() => new GridSecondStageInputBatch(5, () => { }, () => true, () => 0));
+    }
+
+    [Fact]
+    public void QuarterSecondBoundaryRequiresNewFullGuard()
+    {
+        long now = 1000;
+        int fullGuards = 0;
+        var batch = new GridSecondStageInputBatch(4, () => fullGuards++, () => true, () => now);
+        Assert.Equal(0, batch.BeforeWheel());
+        now = 1250;
+        Assert.Equal(0, batch.BeforeWheel());
+        now = 1251;
+        Assert.Equal(1, batch.BeforeWheel());
+        Assert.Equal(2, fullGuards);
+    }
+
+    [Fact]
+    public void ExpiredProofIsRefreshedBeforeAnyFurtherWheel()
+    {
+        long now = 1000;
+        int fullGuards = 0, fastGuards = 0;
+        var batch = new GridSecondStageInputBatch(4,
+            () => fullGuards++,
+            () => { fastGuards++; return fastGuards != 2; }, () => now);
+        Assert.Equal(0, batch.BeforeWheel());
+        now = 1040;
+        Assert.Equal(1, batch.BeforeWheel());
+        Assert.Equal(2, fullGuards);
+        Assert.Equal(3, fastGuards);
+    }
+
+    [Theory]
+    [InlineData("foreground")]
+    [InlineData("binding")]
+    [InlineData("cancel")]
+    public void FocusBindingAndCancellationFailureNeverTriggerRefresh(string failure)
+    {
+        int fullGuards = 0, fastGuards = 0;
+        var batch = new GridSecondStageInputBatch(4, () => fullGuards++, () =>
+        {
+            fastGuards++;
+            if (fastGuards == 2)
+            {
+                if (failure == "cancel") throw new OperationCanceledException();
+                throw new InvalidOperationException(failure);
+            }
+            return true;
+        }, () => 1000);
+        Assert.Equal(0, batch.BeforeWheel());
+        if (failure == "cancel") Assert.Throws<OperationCanceledException>(() => batch.BeforeWheel());
+        else Assert.Throws<InvalidOperationException>(() => batch.BeforeWheel());
+        Assert.Equal(1, fullGuards);
+    }
+
+    [Fact]
+    public void ProofStillExpiredAfterRefreshFailsClosed()
+    {
+        int fullGuards = 0;
+        var batch = new GridSecondStageInputBatch(4, () => fullGuards++, () => false, () => 1000);
+        Assert.Throws<InvalidOperationException>(() => batch.BeforeWheel());
+        Assert.Equal(2, fullGuards);
+    }
+
+    [Fact]
+    public void SlowFastGuardCannotSendAfterTheQuarterSecondWindow()
+    {
+        long now = 1000;
+        int fullGuards = 0, fastGuards = 0;
+        var batch = new GridSecondStageInputBatch(4, () => fullGuards++, () =>
+        {
+            if (++fastGuards == 2) now += 251;
+            return true;
+        }, () => now);
+        Assert.Equal(0, batch.BeforeWheel());
+        Assert.Equal(1, batch.BeforeWheel());
+        Assert.Equal(2, fullGuards);
+        Assert.Equal(3, fastGuards);
+    }
+
+    [Fact]
+    public void RepeatedSlowFastGuardFailsAfterTwoBoundedAttempts()
+    {
+        long now = 1000;
+        int fullGuards = 0, fastGuards = 0;
+        var batch = new GridSecondStageInputBatch(4, () => fullGuards++, () =>
+        {
+            fastGuards++;
+            now += 251;
+            return true;
+        }, () => now);
+        Assert.Throws<InvalidOperationException>(() => batch.BeforeWheel());
+        Assert.Equal(2, fullGuards);
+        Assert.Equal(2, fastGuards);
+    }
+}
