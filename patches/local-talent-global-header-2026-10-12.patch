+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentGlobalHeaderPrivateTests
+{
+    [Fact] [Trait("Fixture","PrivateTalentGlobalHeader")]
+    public void ActualOtherCharacterHeaderIsReadByCurrentV6WithoutAssumingTargetIdentity()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_TALENT_GLOBAL_HEADER_MANIFEST");Assert.False(string.IsNullOrWhiteSpace(path));
+        var fixture=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        using var image=Cv2.ImRead(fixture.Image);var r=fixture.ClientRect;using var client=new Mat(image,new Rect(r[0],r[1],r[2],r[3]));
+        using var resized=new Mat();Cv2.Resize(client,resized,new Size(1920,1080));using var frame=new ImageRegion(resized.Clone(),0,0);
+        using var ocr=new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),PaddleOcrService.PaddleOcrModelType.V6);
+        var rows=TalentUpgradePreviewReader.Rows(frame,TalentGlobalHeaderEvidence.ReferenceRegion,ocr);var raw=string.Concat(rows.Select(t=>t.Text));
+        var parsed=TalentGlobalHeaderEvidence.Parse(raw);var header=new UpgradePreviewCharacter(0,true,parsed.Name){Width=1920,Height=1080,
+            NameRegion=TalentGlobalHeaderEvidence.ReferenceRegion,NameRows=rows,NameSource="talent_global_header",NameBoxMethod="whole_header_ocr_box_contains_name",HeaderRaw=raw,HeaderElement=parsed.Element};
+        var menuRows=TalentUpgradePreviewReader.Rows(frame,TalentGlobalHeaderEvidence.TalentMenuReference,ocr);
+        File.WriteAllText(fixture.DiagnosticPath,Newtonsoft.Json.JsonConvert.SerializeObject(new{source="private_sky_jpeg_static_not_native_fresh",header,menuRows}));
+        Assert.True(TalentGlobalHeaderEvidence.CharacterFrame(header,fixture.ExpectedName));
+        Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(header,"目标角色"));
+        Assert.Single(menuRows);Assert.Equal("天赋",TalentUpgradePreviewEvidence.Normalize(menuRows[0].Text));
+    }
+    private sealed class Fixture{public string Image{get;set;}="";public int[] ClientRect{get;set;}=[];public string ExpectedName{get;set;}="";public string DiagnosticPath{get;set;}="";}
+}
