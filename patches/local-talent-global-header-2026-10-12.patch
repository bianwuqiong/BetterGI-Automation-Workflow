diff --git a/BetterGenshinImpact/GameTask/CharacterDevelopment/TalentGlobalHeaderEvidence.cs b/BetterGenshinImpact/GameTask/CharacterDevelopment/TalentGlobalHeaderEvidence.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/CharacterDevelopment/TalentGlobalHeaderEvidence.cs
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Copyright (C) 2026 bianwuqiong. BetterGI upstream authors retain their copyrights.
+// Modified 2026-10-12: independent current character identity from the global talent header.
+using System;
+using System.Linq;
+using System.Text.RegularExpressions;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+public static class TalentGlobalHeaderEvidence
+{
+    public static readonly Rect ReferenceRegion=new(130,20,320,85);
+    public static readonly Rect TalentMenuReference=new(40,390,320,100);
+    public static (string Element,string Name) Parse(string raw)
+    {
+        var match=Regex.Match(TalentUpgradePreviewEvidence.Normalize(raw),@"\A(火|水|风|雷|草|冰|岩)元素/([^/]+)\z");
+        return match.Success?(match.Groups[1].Value,match.Groups[2].Value):("","");
+    }
+    private static bool Complete(UpgradePreviewRow row,Rect region,int width)
+    {
+        var box=row.Bounds;double margin=2*width/1920d;
+        return box.Width>0&&box.Height>0&&box.Left-region.Left>=margin&&region.Right-box.Right>=margin&&
+            box.Top-region.Top>=margin&&region.Bottom-box.Bottom>=margin;
+    }
+    public static bool CharacterFrame(UpgradePreviewCharacter frame,string official)
+    {
+        if(frame.NameSource!="talent_global_header"||frame.NameBoxMethod!="whole_header_ocr_box_contains_name"||
+            !frame.Overview||frame.Width<800||frame.Width*9!=frame.Height*16||frame.NameRows.Length!=1||
+            frame.NameRegion!=TalentUpgradePreviewReader.Scale(ReferenceRegion,frame.Width)||
+            frame.HeaderRaw!=string.Concat(frame.NameRows.Select(r=>r.Text))||!Complete(frame.NameRows[0],frame.NameRegion,frame.Width))return false;
+        var parsed=Parse(frame.HeaderRaw);
+        return parsed.Name.Length>0&&parsed.Name==TalentUpgradePreviewEvidence.Normalize(official)&&frame.Name==parsed.Name&&frame.HeaderElement==parsed.Element;
+    }
+    public static bool Menu(UpgradePreviewTalentEntries frame)=>frame.MenuRegion==TalentUpgradePreviewReader.Scale(TalentMenuReference,frame.Width)&&
+        frame.MenuRows.Length==1&&TalentUpgradePreviewEvidence.Normalize(frame.MenuRows[0].Text)=="天赋"&&
+        Complete(frame.MenuRows[0],frame.MenuRegion,frame.Width);
+}
diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentGlobalHeaderEvidenceTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentGlobalHeaderEvidenceTests.cs
new file mode 100644
--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentGlobalHeaderEvidenceTests.cs
@@ -0,0 +1,51 @@
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentGlobalHeaderEvidenceTests
+{
+    private static UpgradePreviewCharacter Header(string text="风元素 / 目标角色",long at=100)=>new(at,true,TalentGlobalHeaderEvidence.Parse(text).Name){
+        Width=1920,Height=1080,NameRegion=TalentGlobalHeaderEvidence.ReferenceRegion,
+        NameRows=[new(text,new(145,42,250,28))],NameSource="talent_global_header",NameBoxMethod="whole_header_ocr_box_contains_name",
+        HeaderRaw=text,HeaderElement=TalentGlobalHeaderEvidence.Parse(text).Element};
+    [Fact] public void CurrentNameComesOnlyFromWholeActualElementHeader()
+    {
+        var frame=Header();Assert.True(TalentGlobalHeaderEvidence.CharacterFrame(frame,"目标角色"));
+        Assert.False(TalentUpgradePreviewEvidence.CharacterFrame(frame,"目标角色"));
+        Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(frame with{Name="不同角色"},"不同角色"));
+    }
+    [Theory] [InlineData("风元素/目标角色。")] [InlineData("风元素1目标角色")] [InlineData("风/目标角色")]
+    [InlineData("风元素/目标角色/另一角色")] [InlineData("风元素/其他角色")] [InlineData("梦我梦心")]
+    public void MissingSeparatorOtherCharacterOrPunctuationNeverGetsRepaired(string raw)=>
+        Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(Header(raw),"目标角色"));
+    [Fact] public void CompleteActualHeaderBoxIsRequiredWithoutInventingSubstringBox()
+    {
+        var frame=Header();Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(frame with{NameRows=[new(frame.HeaderRaw,new(131,42,250,28))]},"目标角色"));
+        Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(frame with{NameRows=[frame.NameRows[0],frame.NameRows[0]]},"目标角色"));
+        Assert.False(TalentGlobalHeaderEvidence.CharacterFrame(frame with{HeaderRaw="风元素/目标角色。"},"目标角色"));
+    }
+    private static UpgradePreviewTalentEntries Entry(string name="其他角色")
+    {
+        var rows=Enumerable.Range(0,3).Select(i=>new UpgradePreviewRow("Lv.1",new(1640,170+i*90,60,28))).ToArray();
+        return new(100,1920,1080,true,true,false,false,Header("风元素/"+name),TalentEntryObservationEvidence.ReferenceRegion,rows,rows){
+            MenuRegion=TalentGlobalHeaderEvidence.TalentMenuReference,MenuRows=[new("天赋",new(155,415,80,30))]};
+    }
+    [Fact] public void KnownTalentSceneMayRetainMismatchOnlyAsPrivateDiagnostics()
+    {
+        var entry=Entry();Assert.True(TalentEntryObservationEvidence.CanRetainFailedHeaderDiagnostic(entry));
+        Assert.False(TalentEntryObservationEvidence.KnownPage(entry,"目标角色"));
+        Assert.False(TalentEntryObservationEvidence.CanRetainFailedHeaderDiagnostic(entry with{PromptVisible=true}));
+        Assert.False(TalentEntryObservationEvidence.CanRetainFailedHeaderDiagnostic(entry with{MenuRows=[]}));
+        Assert.False(TalentEntryObservationEvidence.CanRetainFailedHeaderDiagnostic(entry with{Candidates=entry.Candidates.Take(2).ToArray()}));
+    }
+    [Fact] public void EntryKeepsOriginalDoubleFreshAndNewClickBinding()
+    {
+        var a=Entry("目标角色");var b=a with{ObservedAt=400,Character=Header(at:400)};
+        var click=b with{ObservedAt=700,Character=Header(at:700)};
+        Assert.Equal("verified_entry_pair",TalentEntryObservationEvidence.PairFailure(a,b,"目标角色",450));
+        Assert.True(TalentEntryObservationEvidence.ClickBound(b,click,"目标角色",750));
+        Assert.False(TalentEntryObservationEvidence.ClickBound(b,click with{Character=Header("风元素/其他角色",700)},"目标角色",750));
+        Assert.False(TalentEntryObservationEvidence.ClickBound(b,click with{Character=Header("冰元素/目标角色",700)},"目标角色",750));
+    }
+}
