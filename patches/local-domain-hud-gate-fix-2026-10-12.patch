+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ProtectedShieldHudEvidenceTests
+{
+    private static ProtectedShieldHudFrame Entrance()=>new(true,false,false,true,true,false,false,false,"verified");
+    [Fact] public void EntranceHudDoesNotRequireTheLegacyTimedDomainOrPaimonMarker()=>Assert.True(Entrance().Ready);
+    [Theory]
+    [InlineData(0)] [InlineData(1)] [InlineData(2)] [InlineData(3)] [InlineData(4)]
+    public void SceneFocusPartyAndModalEachIndependentlyBlockInput(int failure)
+    {
+        var scene=Entrance();
+        scene=failure switch {0=>scene with{Focused=false},1=>scene with{DomainExitHud=false},
+            2=>scene with{FullParty=false},3=>scene with{Prompt=true},_=>scene with{Revive=true}};
+        Assert.False(scene.Ready);
+    }
+    [Fact] public void MapOrClosableMenuCannotBorrowUnderlyingDomainMarkers()=>Assert.False((Entrance() with{MapOrMenu=true}).Ready);
+    [Fact] public void ExitButtonOnResultsPageOrMiddleOfScreenIsNotDomainHud()
+    {
+        Assert.True(ProtectedShieldHudEvidence.ExitIsDomainHud(new(20,20,45,45),1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.ExitIsDomainHud(new(20,800,45,45),1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.ExitIsDomainHud(new(850,20,45,45),1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.ExitIsDomainHud(new(20,20,200,200),1920,1080));
+    }
+    [Fact] public void FullPartyRequiresFreshFourOrderedNumberedSlots()
+    {
+        Rect[] slots=[new(1860,260,16,17),new(1860,352,16,17),new(1860,444,16,17),new(1860,536,16,17)];
+        Assert.True(ProtectedShieldHudEvidence.CompleteParty(slots,4,1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.CompleteParty(slots,3,1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.CompleteParty(slots[..3],4,1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.CompleteParty([slots[0],slots[2],slots[1],slots[3]],4,1920,1080));
+        Assert.False(ProtectedShieldHudEvidence.CompleteParty([default,slots[1],slots[2],slots[3]],4,1920,1080));
+    }
+    [Fact] public void SceneProofDoesNotReplaceTwoFreshIdentityCandidates()
+    {
+        Assert.True(Entrance().Ready);var context=new AvatarActiveCheckContext{StrictIdentity=true};
+        Assert.Equal(-2,context.ObserveStrictCandidate(4));Assert.Equal(4,context.ObserveStrictCandidate(4));
+        context.ResetStrictCandidate();Assert.Equal(-2,context.ObserveStrictCandidate(4));
+    }
+}
