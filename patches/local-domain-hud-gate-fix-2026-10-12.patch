@@ -0,0 +1,58 @@
+using BetterGenshinImpact.GameTask;
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Microsoft.Extensions.Logging.Abstractions;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ProtectedShieldHudPrivateImageTests(ITestOutputHelper output)
+{
+    [Fact] [Trait("Fixture","PrivateDomainHud")]
+    public void RetainedChallengeEntranceHasCompleteDomainHudWithoutClaimingFreshPair()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_DOMAIN_HUD_MANIFEST");
+        Assert.False(string.IsNullOrWhiteSpace(path),"Explicit private fixture manifest required.");
+        var fixture=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        Assert.Equal(4,fixture.ClientRect.Length);
+        using var source=Cv2.ImRead(fixture.File);var r=fixture.ClientRect;
+        using var client=new Mat(source,new Rect(r[0],r[1],r[2],r[3]));
+        var context=TaskContext.Instance();var original=context.SystemInfo;
+        try
+        {
+            foreach(int width in new[]{1536,1920})
+            {
+                using var resized=new Mat();Cv2.Resize(client,resized,new Size(width,width*9/16));
+                context.SystemInfo=new FakeSystemInfo(new Vanara.PInvoke.RECT(0,0,width,width*9/16),width/1920d);
+                using var frame=new ImageRegion(resized.Clone(),0,0);
+                var scene=ProtectedShieldHudEvidence.ReadFrame(frame,new MultiGameStatus(),4,NullLogger.Instance,true);
+                output.WriteLine("Static domain HUD width={0}; {1}",width,Newtonsoft.Json.JsonConvert.SerializeObject(scene));
+                Assert.True(scene.Ready,"Complete private static domain HUD must pass every scene gate.");
+                Assert.True(scene.FullParty);
+                Assert.True(scene.DomainExitHud);
+                Assert.True(scene.DomainMarkerScore>=.8);
+                using var noMarker=resized.Clone();
+                noMarker[new Rect(0,0,width/5,(width*9/16)/5)].SetTo(Scalar.All(40));
+                using var unknown=new ImageRegion(noMarker.Clone(),0,0);
+                var unknownScene=ProtectedShieldHudEvidence.ReadFrame(unknown,new MultiGameStatus(),4,NullLogger.Instance,true);
+                Assert.True(unknownScene.FullParty);
+                Assert.False(unknownScene.Ready,"Complete party alone must never permit input on unknown UI.");
+                using var noParty=resized.Clone();
+                noParty[new Rect(width*4/5,(width*9/16)/5,width/5,(width*9/16)*3/5)].SetTo(Scalar.All(40));
+                using var partial=new ImageRegion(noParty.Clone(),0,0);
+                Assert.False(ProtectedShieldHudEvidence.ReadFrame(partial,new MultiGameStatus(),4,NullLogger.Instance,true).Ready);
+                // A single image only proves the static gate, never active-avatar pair or live resource safety.
+            }
+        }
+        finally{context.SystemInfo=original;}
+    }
+    [Theory] [InlineData(0)] [InlineData(255)]
+    public void ConstantBackgroundCannotBeAnExitGlyph(int shade)
+    {
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.All(shade));
+        using var frame=new ImageRegion(image.Clone(),0,0);
+        Assert.True(ProtectedShieldHudEvidence.FindDomainExitGlyph(frame).Score<.8);
+    }
+    private sealed class Fixture {public string File{get;set;}="";public int[] ClientRect{get;set;}=[];}
+}
