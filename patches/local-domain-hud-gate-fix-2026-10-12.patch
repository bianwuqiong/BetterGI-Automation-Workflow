diff --git a/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldHudEvidence.cs b/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldHudEvidence.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldHudEvidence.cs
@@ -0,0 +1,84 @@
+using System;
+using System.Linq;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Microsoft.Extensions.Logging;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.AutoFight.Model;
+
+/// <summary>Domain entrance HUD is distinct from the legacy timed-domain/main-world detectors.</summary>
+public sealed record ProtectedShieldHudFrame(bool Focused,bool MainUi,bool TimedDomain,bool DomainExitHud,
+    bool FullParty,bool Prompt,bool Revive,bool MapOrMenu,string PartyReason,double DomainMarkerScore=0)
+{
+    public bool Ready=>Focused && (MainUi||TimedDomain||DomainExitHud) && FullParty && !Prompt && !Revive && !MapOrMenu;
+}
+
+public static class ProtectedShieldHudEvidence
+{
+    public static bool ExitIsDomainHud(Rect bounds,int width,int height)
+    {
+        double s=width/1920d;
+        return width>=800 && width*9==height*16 && bounds.Width>=18*s && bounds.Height>=18*s &&
+            bounds.Width<=100*s && bounds.Height<=100*s && bounds.X>=0 && bounds.Y>=0 &&
+            bounds.Right<=width*.20 && bounds.Bottom<=height*.20;
+    }
+    public static bool CompleteParty(Rect[] rects,int expected,int width,int height)
+    {
+        if(expected!=4 || rects.Length!=4 || width<800 || width*9!=height*16)return false;
+        double s=width/1920d;
+        for(int i=0;i<4;i++)
+        {
+            var r=rects[i];
+            if(r.Width<8*s || r.Width>50*s || r.Height<8*s || r.Height>50*s ||
+                r.Left<width*.85 || r.Right>width || r.Top<height*.12 || r.Bottom>height*.8)return false;
+            if(i>0 && (Math.Abs(r.X-rects[i-1].X)>16*s || r.Y-rects[i-1].Y<60*s || r.Y-rects[i-1].Y>140*s))return false;
+        }
+        return true;
+    }
+    internal static ProtectedShieldHudFrame Read(ImageRegion frame,MultiGameStatus? status,int expected,ILogger logger)
+        =>ReadFrame(frame,status,expected,logger,SystemControl.IsGenshinImpactActiveByProcess());
+    internal static ProtectedShieldHudFrame ReadFrame(ImageRegion frame,MultiGameStatus? status,int expected,ILogger logger,bool focused)
+    {
+        using var exit=frame.Find(ElementRecognition.Get("BtnExitDoor",frame));
+        using var confirm=frame.Find(ElementRecognition.Get("BtnBlackConfirm",frame));
+        bool party=false;string reason="fresh_full_party_unverified";
+        try
+        {
+            if(status is not null && !status.IsInMultiGame)
+            {
+                // New helper requires actual numbered templates or the active-arrow reconstruction;
+                // it never falls back to default/cache rectangles here.
+                var (rects,icons)=PartyAvatarSideIndexHelper.GetAllIndexRectsNew(frame,status,logger,TaskContext.Instance().SystemInfo);
+                party=icons.Count==4 && CompleteParty(rects.ToArray(),expected,frame.Width,frame.Height);
+                if(party)reason="fresh_numbered_slots_and_active_arrow_geometry";
+            }
+        }
+        catch(Exception ex){reason="fresh_party_detection_failed:"+ex.GetType().Name;}
+        var marker=FindDomainExitGlyph(frame);
+        return new(focused,Bv.IsInMainUi(frame),Bv.IsInDomain(frame),
+            (exit.IsExist() && ExitIsDomainHud(exit.ToRect(),frame.Width,frame.Height)) ||
+            marker.Score>=.8 && ExitIsDomainHud(marker.Bounds,frame.Width,frame.Height),party,
+            Bv.IsInPromptDialog(frame)||confirm.IsExist(),Bv.IsInRevivePrompt(frame),
+            Bv.IsInBigMapUi(frame)||Bv.IsInAnyClosableUi(frame)||Bv.IsInPartyViewUi(frame),reason,marker.Score);
+    }
+    internal static (Rect Bounds,double Score) FindDomainExitGlyph(ImageRegion frame)
+    {
+        // Reuse the upstream exit glyph. Binarizing foreground excludes the obsolete green
+        // backing plane; both door directions exist across UI versions. No account image asset.
+        var ro=ElementRecognition.Get("InDomain",frame);
+        using var template=ro.TemplateImageGreyMat!.Threshold(235,255,ThresholdTypes.Binary);
+        using var upperLeft=new Mat(frame.CacheGreyMat,new Rect(0,0,(int)(frame.Width*.20),(int)(frame.Height*.20)));
+        using var ink=upperLeft.Threshold(235,255,ThresholdTypes.Binary);
+        Rect best=default;double score=-1;
+        for(int mirror=0;mirror<2;mirror++)
+        {
+            using var glyph=mirror==0?template.Clone():template.Flip(FlipMode.Y);
+            using var result=new Mat();Cv2.MatchTemplate(ink,glyph,result,TemplateMatchModes.CCoeffNormed);
+            Cv2.MinMaxLoc(result,out _,out var peak,out _,out var at);
+            if(peak>score){score=peak;best=new(at.X,at.Y,glyph.Width,glyph.Height);}
+        }
+        return(best,score);
+    }
+}
