+    /// <summary>必须在创建游戏进程之前调用；失败时禁止继续关联启动。</summary>
+    public static bool EnsureDirectXUserGlobalSettings()
+    {
+        const string keyPath = @"Software\Microsoft\DirectX\UserGpuPreferences";
+        const string valueName = "DirectXUserGlobalSettings";
+        using var key = Registry.CurrentUser.CreateSubKey(keyPath)
+            ?? throw new InvalidOperationException("无法打开 BitBlt 兼容设置注册表键");
+        var original = key.GetValue(valueName) as string ?? "";
+        var updated = MergeDirectXUserGlobalSettings(original);
+        if (string.Equals(original, updated, StringComparison.Ordinal))
+        {
+            return false;
+        }
+
+        key.SetValue(valueName, updated, RegistryValueKind.String);
+        if (!string.Equals(key.GetValue(valueName) as string, updated, StringComparison.Ordinal))
+        {
+            throw new InvalidOperationException("BitBlt 兼容设置写入后核验失败");
+        }
+        return true;
+    }
+
+    /// <summary>仅替换兼容字段，保留其他全局 GPU 偏好；不读取或写入注册表。</summary>
+    public static string MergeDirectXUserGlobalSettings(string original)
+    {
+        const string settingName = "SwapEffectUpgradeEnable";
+        var parts = original.Split(';').ToList();
+        var firstMatch = -1;
+        for (var i = 0; i < parts.Count; i++)
+        {
+            var equals = parts[i].IndexOf('=');
+            if (equals < 0 || !string.Equals(parts[i][..equals].Trim(), settingName,
+                    StringComparison.OrdinalIgnoreCase))
+            {
+                continue;
+            }
+
+            if (firstMatch < 0)
+            {
+                firstMatch = i;
+                parts[i] = settingName + "=0";
+            }
+            else
+            {
+                parts.RemoveAt(i--);
+            }
+        }
+
+        // Split 保留最后的分号；添加新字段前只移除末尾空片段。
+        if (parts.Count > 0 && parts[^1].Length == 0)
+        {
+            parts.RemoveAt(parts.Count - 1);
+        }
+        if (firstMatch < 0)
+        {
+            parts.Add(settingName + "=0");
+        }
+        return string.Join(';', parts) + ";";
+    }
 }
