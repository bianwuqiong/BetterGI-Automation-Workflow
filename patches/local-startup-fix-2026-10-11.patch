+using BetterGenshinImpact.Service;
+using Microsoft.Extensions.Time.Testing;
+
+namespace BetterGenshinImpact.UnitTest.ServiceTests;
+
+public class StartupReadinessGateTests
+{
+    [Fact]
+    public async Task VerifiedUiWithinDeadlineAllowsTheNextStage()
+    {
+        var clock = new FakeTimeProvider();
+        var nodes = 0;
+        await StartupReadinessGate.WaitAsync((_, _) => Task.FromResult(true), clock,
+            clock.GetTimestamp(), TimeSpan.FromSeconds(1), CancellationToken.None);
+        nodes++;
+        Assert.Equal(1, nodes);
+    }
+
+    [Fact]
+    public async Task UnverifiedUiTimesOutAndCannotReachTheNextStage()
+    {
+        var clock = new FakeTimeProvider();
+        var nodes = 0;
+        async Task Run()
+        {
+            await StartupReadinessGate.WaitAsync((_, _) => Task.FromResult(false), clock,
+                clock.GetTimestamp(), TimeSpan.FromMilliseconds(500), CancellationToken.None);
+            nodes++;
+        }
+        var run = Run();
+        clock.Advance(TimeSpan.FromMilliseconds(500));
+        await Assert.ThrowsAsync<TimeoutException>(() => run.WaitAsync(TimeSpan.FromSeconds(2)));
+        Assert.Equal(0, nodes);
+    }
+
+    [Fact]
+    public async Task ADeadlineConsumedByProcessStartupDoesNotProbeOrReset()
+    {
+        var clock = new FakeTimeProvider();
+        var processStart = clock.GetTimestamp();
+        clock.Advance(StartupReadinessGate.DefaultTimeout);
+        var probes = 0;
+        await Assert.ThrowsAsync<TimeoutException>(() => StartupReadinessGate.WaitAsync((_, _) =>
+            {
+                probes++;
+                return Task.FromResult(true);
+            }, clock, processStart, StartupReadinessGate.DefaultTimeout, CancellationToken.None));
+        Assert.Equal(0, probes);
+    }
+
+    [Fact]
+    public async Task AUiMatchArrivingAfterTheDeadlineDoesNotPass()
+    {
+        var clock = new FakeTimeProvider();
+        await Assert.ThrowsAsync<TimeoutException>(() => StartupReadinessGate.WaitAsync((_, _) =>
+            {
+                clock.Advance(TimeSpan.FromSeconds(2));
+                return Task.FromResult(true);
+            }, clock, clock.GetTimestamp(), TimeSpan.FromSeconds(1), CancellationToken.None));
+    }
+
+    [Fact]
+    public async Task WaitingForDispatcherInitializationSharesTheSameDeadline()
+    {
+        var clock = new FakeTimeProvider();
+        var start = clock.GetTimestamp();
+        clock.Advance(TimeSpan.FromSeconds(179.5));
+        var wait = StartupReadinessGate.WaitAsync((_, _) => Task.FromResult(false), clock,
+            start, StartupReadinessGate.DefaultTimeout, CancellationToken.None);
+        clock.Advance(TimeSpan.FromMilliseconds(500));
+        await Assert.ThrowsAsync<TimeoutException>(() => wait.WaitAsync(TimeSpan.FromSeconds(2)));
+    }
+
+    [Fact]
+    public async Task CancellationStopsPollingAndDoesNotAcceptALaterMatch()
+    {
+        var clock = new FakeTimeProvider();
+        using var stop = new CancellationTokenSource();
+        var probes = 0;
+        var wait = StartupReadinessGate.WaitAsync((_, _) =>
+            {
+                probes++;
+                return Task.FromResult(false);
+            }, clock, clock.GetTimestamp(), TimeSpan.FromSeconds(10), stop.Token);
+        stop.Cancel();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => wait.WaitAsync(TimeSpan.FromSeconds(2)));
+        clock.Advance(TimeSpan.FromSeconds(20));
+        Assert.Equal(1, probes);
+    }
+
+    [Fact]
+    public async Task CancellationDuringRecognitionOverridesAUiMatch()
+    {
+        var clock = new FakeTimeProvider();
+        using var stop = new CancellationTokenSource();
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => StartupReadinessGate.WaitAsync((_, _) =>
+            {
+                stop.Cancel();
+                return Task.FromResult(true);
+            }, clock, clock.GetTimestamp(), TimeSpan.FromSeconds(10), stop.Token));
+    }
+
+    [Fact]
+    public async Task SystemWallClockChangesDoNotInvalidateTheMonotonicDeadline()
+    {
+        var clock = new WallClockJumpProvider();
+        await StartupReadinessGate.WaitAsync((_, _) =>
+            {
+                clock.UtcNow = clock.UtcNow.AddYears(10);
+                return Task.FromResult(true);
+            }, clock, clock.GetTimestamp(), TimeSpan.FromSeconds(1), CancellationToken.None);
+    }
+
+    private sealed class WallClockJumpProvider : TimeProvider
+    {
+        public DateTimeOffset UtcNow { get; set; } = DateTimeOffset.UtcNow;
+        public override DateTimeOffset GetUtcNow() => UtcNow;
+        public override long GetTimestamp() => 100;
+        public override long TimestampFrequency => TimeSpan.TicksPerSecond;
+    }
+}
