@@ -0,0 +1,45 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace BetterGenshinImpact.Service;
+
+/// <summary>启动阶段的单调时钟期限；未经核验或已超时绝不能放行任务节点。</summary>
+public static class StartupReadinessGate
+{
+    public static readonly TimeSpan DefaultTimeout = TimeSpan.FromSeconds(180);
+    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(500);
+
+    public static async Task WaitAsync(
+        Func<TimeSpan, CancellationToken, Task<bool>> isReady,
+        TimeProvider timeProvider,
+        long startTimestamp,
+        TimeSpan timeout,
+        CancellationToken cancellationToken)
+    {
+        while (true)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            var elapsed = timeProvider.GetElapsedTime(startTimestamp);
+            if (elapsed >= timeout)
+            {
+                throw new TimeoutException("启动等待超时，未核验可交互 UI，禁止执行任务节点");
+            }
+
+            var ready = await isReady(elapsed, cancellationToken);
+            cancellationToken.ThrowIfCancellationRequested();
+            var remaining = timeout - timeProvider.GetElapsedTime(startTimestamp);
+            if (remaining <= TimeSpan.Zero)
+            {
+                throw new TimeoutException("启动核验超过总期限，禁止执行任务节点");
+            }
+            if (ready)
+            {
+                return;
+            }
+
+            await Task.Delay(remaining < PollInterval ? remaining : PollInterval,
+                timeProvider, cancellationToken);
+        }
+    }
+}
