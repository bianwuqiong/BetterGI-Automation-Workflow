+/// <summary>Reuses grid geometry/HSV rules only. Never performs one/seven substitutions or cleans numeric text.</summary>
+public static class NamedStackCountReader
+{
+    public static Rect NameRect(int width)=>new((int)Math.Round(1280*width/1920d),(int)Math.Round(110*width/1920d),
+        (int)Math.Round(540*width/1920d),(int)Math.Round(78*width/1920d));
+    public static Rect SourceRect(Rect item)
+    {
+        var old=BackpackInventoryEvidenceSafety.RawCountRect(item);
+        int pad=Math.Max(1,(int)Math.Round(8*item.Width/125d));
+        return new(old.X,old.Y-pad,old.Width,old.Height+pad*2);
+    }
+    internal static NamedStackCountReading Read(Mat full,Rect item,IOcrService ocr,IOcrService fixedDetector)
+    {
+        var source=SourceRect(item);using var crop=new Mat(full,source);using var enlarged=new Mat();
+        Cv2.Resize(crop,enlarged,new Size(crop.Width*3,crop.Height*3));
+        using var hsv=new Mat();Cv2.CvtColor(enlarged,hsv,ColorConversionCodes.BGR2HSV);using var mask=new Mat();
+        Cv2.InRange(hsv,new Scalar(0,0,0),new Scalar(180,140,210),mask);
+        var all=mask.FindContoursAsArray(RetrievalModes.External,ContourApproximationModes.ApproxSimple)
+            .Select(Cv2.BoundingRect).OrderBy(r=>r.X).ThenBy(r=>r.Y).ToArray();
+        var components=all.Where(r=>r.Width>1&&r.Height>=12&&r.Width*r.Height>=20&&r.Bottom>=mask.Height*.55&&r.Width/(double)r.Height<=3).ToArray();
+        var zero=new BackpackRect(0,0,0,0);var sourceHash=InspectionNativeFrameEncoding.Encode(crop).NativePixelsSha256;
+        var maskHash=InspectionNativeFrameEncoding.Encode(mask).NativePixelsSha256;
+        if(components.Length==0)return new(BackpackRect.From(source),all.Select(BackpackRect.From).ToArray(),[],zero,zero,0,0,0,"",[],[],sourceHash,maskHash,"");
+        var bounds=new Rect(components.Min(r=>r.Left),components.Min(r=>r.Top),
+            components.Max(r=>r.Right)-components.Min(r=>r.Left),components.Max(r=>r.Bottom)-components.Min(r=>r.Top));
+        using var foreground=new Mat(mask,bounds);using var inverted=new Mat();Cv2.BitwiseNot(foreground,inverted);
+        int glyphWidth=Math.Max(1,(int)Math.Round(inverted.Width*48d/inverted.Height));using var glyph=new Mat();
+        Cv2.Resize(inverted,glyph,new Size(glyphWidth,48),0,0,InterpolationFlags.Nearest);
+        using var normalized=new Mat(96,glyphWidth+48,MatType.CV_8UC1,Scalar.White);using(var target=new Mat(normalized,new Rect(24,24,glyphWidth,48)))glyph.CopyTo(target);
+        using var input=normalized.Clone();
+        string raw=ocr.OcrWithoutDetector(input);
+        var rows=fixedDetector.OcrResult(input).Regions.Select(r=>{var b=r.Rect.BoundingRect();return new BackpackOcrRow(r.Text,b.X,b.Y,b.Width,b.Height);}).ToArray();
+        int left=source.X+(int)Math.Floor(bounds.Left/3d),top=source.Y+(int)Math.Floor(bounds.Top/3d);
+        var original=new Rect(left,top,source.X+(int)Math.Ceiling(bounds.Right/3d)-left,source.Y+(int)Math.Ceiling(bounds.Bottom/3d)-top);
+        var projected=rows.Select(r=>{
+            int x=source.X+(int)Math.Floor((bounds.X+(r.X-24)*bounds.Width/(double)glyphWidth)/3),
+                y=source.Y+(int)Math.Floor((bounds.Y+(r.Y-24)*bounds.Height/48d)/3);
+            int right=source.X+(int)Math.Ceiling((bounds.X+(r.X+r.Width-24)*bounds.Width/(double)glyphWidth)/3),
+                bottom=source.Y+(int)Math.Ceiling((bounds.Y+(r.Y+r.Height-24)*bounds.Height/48d)/3);
+            return new BackpackOcrRow(r.Text,x,y,right-x,bottom-y);
+        }).ToArray();
+        return new(BackpackRect.From(source),all.Select(BackpackRect.From).ToArray(),components.Select(BackpackRect.From).ToArray(),
+            BackpackRect.From(bounds),BackpackRect.From(original),normalized.Width,normalized.Height,glyphWidth,raw,rows,projected,
+            sourceHash,maskHash,InspectionNativeFrameEncoding.Encode(normalized).NativePixelsSha256)
+            {OcrInputPixelsSha256=InspectionNativeFrameEncoding.Encode(input).NativePixelsSha256};
+    }
+    private static bool Away(BackpackOcrRow row,BackpackRect box,double margin)=>row.Width>0&&row.Height>0&&
+        row.X-box.X>=margin&&row.Y-box.Y>=margin&&box.X+box.Width-row.X-row.Width>=margin&&box.Y+box.Height-row.Y-row.Height>=margin;
+    public static int? Exact(NamedStackCountReading reading,Rect item,int width)
+    {
+        if(reading.Method!="grid_hsv_foreground_exact_dual_ocr"||reading.SourceRegion!=BackpackRect.From(SourceRect(item))||
+            reading.SourceScale!=3||reading.MaximumSaturation!=140||reading.MaximumValue!=210||reading.MinimumComponentArea!=20||
+            reading.MinimumComponentHeight!=12||reading.MinimumComponentBottomRatio!=.55||reading.MaximumComponentAspectRatio!=3||
+            reading.GlyphHeight!=48||reading.HorizontalPadding!=24||reading.VerticalPadding!=24||reading.TopPaddingReference!=8||reading.BottomPaddingReference!=8||reading.OcrScale!=1||
+            reading.DetectorModel!="PaddleV4_fixed"||reading.RawModel!="configured_native_paddle_without_detector"||
+            reading.SourceInterpolation!="linear"||reading.GlyphInterpolation!="nearest"||reading.OcrInterpolation!="nearest"||
+            reading.NormalizedHeight!=96||reading.NormalizedWidth!=reading.GlyphWidth+48||reading.Components.Length==0||
+            reading.DetectorRows.Length!=1||reading.SourceRows.Length!=1||reading.ForegroundBounds.Width<=0||reading.ForegroundBounds.Height<=0)return null;
+        var expected=reading.AllComponents.Where(r=>r.Width>1&&r.Height>=12&&r.Width*r.Height>=20&&
+            r.Y+r.Height>=reading.SourceRegion.Height*3*.55&&r.Width/(double)r.Height<=3).ToArray();
+        if(!expected.SequenceEqual(reading.Components)||expected.Length==0||
+            reading.AllComponents.Any(r=>r.Width<=0||r.Height<=0||r.X<0||r.Y<0||r.X+r.Width>reading.SourceRegion.Width*3||r.Y+r.Height>reading.SourceRegion.Height*3)||
+            !reading.AllComponents.SequenceEqual(reading.AllComponents.OrderBy(r=>r.X).ThenBy(r=>r.Y))||
+            new[]{reading.SourcePixelsSha256,reading.MaskPixelsSha256,reading.NormalizedPixelsSha256,reading.OcrInputPixelsSha256}.Any(s=>s.Length!=64||s.Any(c=>!Uri.IsHexDigit(c))))return null;
+        var f=reading.ForegroundBounds;
+        if(f.X!=expected.Min(r=>r.X)||f.Y!=expected.Min(r=>r.Y)||f.X+f.Width!=expected.Max(r=>r.X+r.Width)||f.Y+f.Height!=expected.Max(r=>r.Y+r.Height)||
+            reading.GlyphWidth!=Math.Max(1,(int)Math.Round(f.Width*48d/f.Height)))return null;
+        double margin=2*width/1920d;
+        var row=reading.DetectorRows[0];var sourceRow=reading.SourceRows[0];
+        var source=reading.SourceRegion;
+        var expectedForeground=new BackpackRect(source.X+(int)Math.Floor(f.X/3d),source.Y+(int)Math.Floor(f.Y/3d),
+            (int)Math.Ceiling((f.X+f.Width)/3d)-(int)Math.Floor(f.X/3d),(int)Math.Ceiling((f.Y+f.Height)/3d)-(int)Math.Floor(f.Y/3d));
+        int x=source.X+(int)Math.Floor((f.X+(row.X-24)*f.Width/(double)reading.GlyphWidth)/3),
+            y=source.Y+(int)Math.Floor((f.Y+(row.Y-24)*f.Height/48d)/3),
+            right=source.X+(int)Math.Ceiling((f.X+(row.X+row.Width-24)*f.Width/(double)reading.GlyphWidth)/3),
+            bottom=source.Y+(int)Math.Ceiling((f.Y+(row.Y+row.Height-24)*f.Height/48d)/3);
+        if(reading.ForegroundSourceBounds!=expectedForeground||sourceRow!=new BackpackOcrRow(row.Text,x,y,right-x,bottom-y))return null;
+        if(!Away(row,new(0,0,reading.NormalizedWidth,reading.NormalizedHeight),Math.Max(2,margin*48*3/f.Height))||
+            !Away(sourceRow,reading.SourceRegion,margin)||!Away(new("",reading.ForegroundSourceBounds.X,reading.ForegroundSourceBounds.Y,
+                reading.ForegroundSourceBounds.Width,reading.ForegroundSourceBounds.Height),reading.SourceRegion,margin))return null;
+        if(BackpackInventoryEvidenceSafety.Normalize(reading.Raw)!=BackpackInventoryEvidenceSafety.Normalize(row.Text)||row.Text!=sourceRow.Text)return null;
+        var raw=BackpackInventoryEvidenceSafety.Normalize(reading.Raw);
+        return System.Text.RegularExpressions.Regex.IsMatch(raw,@"\A(?:0|[1-9][0-9]{0,8})\z")&&int.TryParse(raw,out var value)?value:null;
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/NamedCountModelPin.cs b/BetterGenshinImpact/GameTask/Common/Job/NamedCountModelPin.cs
