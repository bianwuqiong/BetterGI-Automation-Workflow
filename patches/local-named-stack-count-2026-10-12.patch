--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/NamedCountModelPin.cs
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Copyright (C) 2026 bianwuqiong. BetterGI upstream authors retain their copyrights.
+// Modified 2026-10-12: actual bundled count OCR model read locks and version evidence.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+public sealed record NamedOcrModelAsset(string ModelName,string RelativePath,string Sha256,long Length);
+public sealed record NamedCountModelEvidence(int RawPaddleConfig,string RawPaddleName,int FixedDetectorConfig,string FixedDetectorName,
+    string PinMethod,NamedOcrModelAsset[] Assets);
+
+internal sealed class NamedCountModelPin:IDisposable
+{
+    private readonly List<FileStream> streams=[];
+    public NamedCountModelEvidence Evidence{get;}
+    internal static (string Name,string Path)[] ExpectedAssets()=>[
+        (BgiOnnxModel.PaddleOcrDetV4.Name,BgiOnnxModel.PaddleOcrDetV4.ModelRelativePath.Replace('\\','/')),
+        (BgiOnnxModel.PaddleOcrRecV4.Name,BgiOnnxModel.PaddleOcrRecV4.ModelRelativePath.Replace('\\','/')),
+        (BgiOnnxModel.PaddleOcrRecV6.Name,BgiOnnxModel.PaddleOcrRecV6.ModelRelativePath.Replace('\\','/')),
+        ("PpOcrRecV4-labels",Path.ChangeExtension(BgiOnnxModel.PaddleOcrRecV4.ModelRelativePath,"yml").Replace("slim.yml","inference.yml").Replace('\\','/')),
+        ("PpOcrRecV6-labels",Path.ChangeExtension(BgiOnnxModel.PaddleOcrRecV6.ModelRelativePath,"yml").Replace("slim.yml","inference.yml").Replace('\\','/'))];
+    internal NamedCountModelPin()
+    {
+        RequireConfiguredV6();
+        try
+        {
+            var assets=ExpectedAssets().Select(asset=>{
+                var stream=File.Open(Global.Absolute(asset.Path),FileMode.Open,FileAccess.Read,FileShare.Read);streams.Add(stream);
+                var sha=Convert.ToHexString(SHA256.HashData(stream));stream.Position=0;
+                return new NamedOcrModelAsset(asset.Name,asset.Path,sha,stream.Length);
+            }).ToArray();
+            Evidence=new(8,"V6",7,"V4","actual_bundled_open_read_sha256_hold_session",assets);
+        }
+        catch{Dispose();throw;}
+    }
+    internal int Readback(){RequireConfiguredV6();return (int)TaskContext.Instance().Config.OtherConfig.OcrConfig.PaddleOcrModelConfig;}
+    private static void RequireConfiguredV6()
+    {
+        if(TaskContext.Instance().Config.OtherConfig.OcrConfig.PaddleOcrModelConfig!=PaddleOcrModelConfig.V6)
+            throw new InvalidOperationException("named_count_configured_paddle_v6_required_for_verified_profile");
+    }
+    internal static bool Verified(NamedCountModelEvidence? evidence)
+    {
+        if(evidence is null||evidence.RawPaddleConfig!=8||evidence.RawPaddleName!="V6"||evidence.FixedDetectorConfig!=7||evidence.FixedDetectorName!="V4"||
+            evidence.PinMethod!="actual_bundled_open_read_sha256_hold_session"||evidence.Assets.Length!=5)return false;
+        var expected=ExpectedAssets();
+        return evidence.Assets.Zip(expected).All(p=>p.First.ModelName==p.Second.Name&&p.First.RelativePath==p.Second.Path&&
+            p.First.Length>0&&p.First.Sha256.Length==64&&p.First.Sha256.All(Uri.IsHexDigit));
+    }
+    public void Dispose(){foreach(var stream in streams)stream.Dispose();streams.Clear();}
+}
diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/NamedStackCountReaderTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/NamedStackCountReaderTests.cs
new file mode 100644
