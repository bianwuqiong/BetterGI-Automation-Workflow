--- /dev/null
+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native20PrivateCountTests.cs
@@ -0,0 +1,46 @@
+using BetterGenshinImpact.UnitTest.CoreTests.RecognitionTests.OCRTests;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using OpenCvSharp;
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+public class Native20PrivateCountTests
+{
+    [Fact] [Trait("Fixture","PrivateNative20Count")]
+    public void ActualSelectedNativePixelsUseProductionExactCountAndRetainPrivateExpectations()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_NATIVE20_COUNT_MANIFEST");Assert.False(string.IsNullOrWhiteSpace(path));
+        var fixture=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        Assert.NotEmpty(fixture.Samples);var readings=new List<object>();var models=new PaddleFixture();
+        var diagnosticRejectedV6=new List<object>();
+        foreach(var sample in fixture.Samples)
+        {
+            using var image=Cv2.ImRead(sample.Image);var item=new Rect(sample.Item[0],sample.Item[1],sample.Item[2],sample.Item[3]);
+            foreach(var version in new[]{"V4","V5","V6"})
+            {
+                var ocr=version=="V6"?new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),PaddleOcrService.PaddleOcrModelType.V6):models.Get(version:version);
+                var read=NamedStackCountReader.Read(image,item,ocr,models.Get(version:"V4"));
+                if(version=="V6")
+                {
+                    var rejected=NamedStackCountReader.Read(image,item,ocr,ocr) with{DetectorModel="V6_configured_diagnostic_only"};
+                    diagnosticRejectedV6.Add(new{sample.Image,source="actual_native_png_offline_original_v6_detector_not_live",rejected});
+                    File.WriteAllText(fixture.RejectedV6DiagnosticPath,Newtonsoft.Json.JsonConvert.SerializeObject(diagnosticRejectedV6));
+                }
+                var exact=NamedStackCountReader.Exact(read,item,image.Width);
+                var nameBox=NamedStackCountReader.NameRect(image.Width);using var nameCrop=new Mat(image,nameBox);
+                var names=ocr.OcrResult(nameCrop).Regions.Select(r=>new{r.Text,bounds=r.Rect.BoundingRect()}).ToArray();
+                readings.Add(new{sample.Image,version,read,exact,nameBox,names});
+                File.WriteAllText(fixture.DiagnosticPath,Newtonsoft.Json.JsonConvert.SerializeObject(readings));
+                Assert.Equal(sample.ExpectedCount,exact);
+                if(version is "V4" or "V6")
+                {
+                    var name=Assert.Single(names);Assert.Equal(sample.ExpectedName,name.Text);
+                    Assert.True(name.bounds.Left>=2&&name.bounds.Top>=2&&nameBox.Width-name.bounds.Right>=2&&nameBox.Height-name.bounds.Bottom>=2);
+                }
+            }
+        }
+        Assert.Equal(fixture.Samples.Length*3,readings.Count);
+    }
+    private sealed class Fixture{public Sample[] Samples{get;set;}=[];public string DiagnosticPath{get;set;}="";public string RejectedV6DiagnosticPath{get;set;}="";}
+    private sealed class Sample{public string Image{get;set;}="";public int[] Item{get;set;}=[];public int? ExpectedCount{get;set;}public string ExpectedName{get;set;}="";}
+}
