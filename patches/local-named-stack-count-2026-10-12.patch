+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/NamedStackCountReaderTests.cs
@@ -0,0 +1,108 @@
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Common.Job;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class NamedStackCountReaderTests
+{
+    private static readonly Rect Item=new(400,200,125,153);
+    private static NamedStackCountReading Reading(string raw="8",string detected="8")
+    {
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.White);var source=NamedStackCountReader.SourceRect(Item);
+        Cv2.Rectangle(image,new Rect(source.X+35,source.Y+15,12,16),Scalar.Black,-1);
+        var ocr=new NumericOcr(raw,detected);return NamedStackCountReader.Read(image,Item,ocr,ocr);
+    }
+    [Fact] public void GeometryAndTwoExactMethodsPermitAnonymousInteger()
+    {
+        var read=Reading();Assert.Equal(8,NamedStackCountReader.Exact(read,Item,1920));
+        Assert.Equal(38,read.SourceRegion.Height);Assert.Equal(96,read.NormalizedHeight);
+        Assert.NotEmpty(read.AllComponents);Assert.Equal(64,read.SourcePixelsSha256.Length);
+    }
+    [Theory] [InlineData("~8~","8")] [InlineData("8","9")] [InlineData("08","08")] [InlineData("8日","8日")]
+    [InlineData("1","7")] [InlineData("+8","+8")]
+    [InlineData("８","８")]
+    public void NumericDisagreementOrExtraSymbolsNeverGetCleaned(string raw,string detector)=>
+        Assert.Null(NamedStackCountReader.Exact(Reading(raw,detector),Item,1920));
+    [Fact] public void TrueObservedZeroIsNotMissing()=>Assert.Equal(0,NamedStackCountReader.Exact(Reading("0","0"),Item,1920));
+    [Fact] public void EmptyActualForegroundCannotBeZero()
+    {
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.White);
+        var ocr=new NumericOcr("0","0");Assert.Null(NamedStackCountReader.Exact(NamedStackCountReader.Read(image,Item,ocr,ocr),Item,1920));
+    }
+    [Theory] [InlineData("source")] [InlineData("union")] [InlineData("projection")] [InlineData("hash")]
+    [InlineData("parameter")] [InlineData("components")]
+    public void DerivedPixelGeometryCannotBeRewritten(string fault)
+    {
+        var read=Reading();read=fault switch{
+            "source"=>read with{SourceRegion=read.SourceRegion with{Height=read.SourceRegion.Height-1}},
+            "union"=>read with{ForegroundBounds=read.ForegroundBounds with{Width=read.ForegroundBounds.Width+1}},
+            "projection"=>read with{SourceRows=[read.SourceRows[0] with{Y=read.SourceRows[0].Y+1}]},
+            "hash"=>read with{MaskPixelsSha256="not-a-hash"},"parameter"=>read with{MaximumValue=220},
+            _=>read with{AllComponents=[]}};
+        Assert.Null(NamedStackCountReader.Exact(read,Item,1920));
+    }
+    [Fact] public void NameExpansionIsSpecificToIndependentReader()
+    {
+        Assert.Equal(new Rect(1280,110,540,78),NamedStackCountReader.NameRect(1920));
+        Assert.Equal(new Rect(1309,120,491,60),BackpackInventoryEvidenceSafety.NameRect(1920));
+    }
+    [Fact] public void FixedModelProofRequiresActualProfileIdentifiersAndFiveExactPaths()
+    {
+        var assets=NamedCountModelPin.ExpectedAssets().Select(a=>new NamedOcrModelAsset(a.Name,a.Path,new string('A',64),1)).ToArray();
+        var proof=new NamedCountModelEvidence(8,"V6",7,"V4","actual_bundled_open_read_sha256_hold_session",assets);
+        Assert.True(NamedCountModelPin.Verified(proof));
+        Assert.False(NamedCountModelPin.Verified(proof with{RawPaddleConfig=1}));
+        Assert.False(NamedCountModelPin.Verified(proof with{FixedDetectorName="V6"}));
+        Assert.False(NamedCountModelPin.Verified(proof with{Assets=assets.Skip(1).ToArray()}));
+    }
+    private static WeeklyInventoryFrameEvidence Frame(long at)
+    {
+        var proof=new NamedCountModelEvidence(8,"V6",7,"V4","actual_bundled_open_read_sha256_hold_session",
+            NamedCountModelPin.ExpectedAssets().Select(a=>new NamedOcrModelAsset(a.Name,a.Path,new string('A',64),1)).ToArray());
+        var count=Reading() with{ModelEvidence=proof,RawPaddleReadback=8};
+        using var image=new Mat(1080,1920,MatType.CV_8UC3,Scalar.White);
+        var border=BackpackInventoryEvidenceSafety.ReadSelectedBorder(image,Item);var selected=BackpackRect.From(Item);
+        var initial=new BackpackFrameEvidence{ObservedAt=at,NameRegion=BackpackRect.From(BackpackInventoryEvidenceSafety.NameRect(1920)),
+            NameRows=[new("残火灯烛",1309,125,160,35)],CountRegion=BackpackRect.From(BackpackInventoryEvidenceSafety.RawCountRect(Item)),
+            RawCountText="~8~",CountRows=[],SelectedItemVerified=true,SelectedItemRect=selected,SelectionEvidence=border};
+        var stack=new BackpackFrameEvidence{ObservedAt=at,NameRegion=BackpackRect.From(NamedStackCountReader.NameRect(1920)),
+            NameRows=[new("残火灯烛",1330,125,160,35)],CountRegion=count.SourceRegion,RawCountText=count.Raw,CountRows=count.SourceRows,
+            CountMethod="grid_hsv_foreground_exact_dual_ocr",SelectedItemVerified=true,SelectedItemRect=selected,SelectionEvidence=border};
+        return new(stack,1920,1080,"characterDevelopmentItems",true,false,true,WeeklyConversionInventoryEvidence.HeaderRect(1920),
+            [new("养成道具",120,30,200,25)],"残火灯烛",.9,new(400,200,125,125)){InitialStack=initial,CountReading=count};
+    }
+    [Fact] public void NewWeeklyPairPublishesOnlyTheRefinedExactCountAndRetainsInitialFailure()
+    {
+        var first=Frame(400);var second=Frame(700);var selected=new BackpackSelection(BackpackRect.From(Item),462,265,100);
+        Assert.Equal(8,WeeklyConversionInventoryEvidence.Count(new(selected,first,second),WeeklyInventoryCatalog.Materials[0]));
+        Assert.Equal("~8~",first.InitialStack!.RawCountText);Assert.Equal(1309,first.InitialStack.NameRegion.X);
+    }
+    [Fact] public void NewWeeklyPairCannotDowngradeOrLoseItsModelAndInitialScope()
+    {
+        var first=Frame(400);var second=Frame(700);var selected=new BackpackSelection(BackpackRect.From(Item),462,265,100);
+        foreach(var bad in new[]{second with{InitialStack=null},second with{CountReading=null},
+            second with{CountReading=second.CountReading! with{RawPaddleReadback=1}},
+            second with{CountReading=second.CountReading! with{ModelEvidence=null}},second with{IconScore=.74}})
+            Assert.Null(WeeklyConversionInventoryEvidence.Count(new(selected,first,bad),WeeklyInventoryCatalog.Materials[0]));
+    }
+    [Fact] public void ExactIdentityRollingWindowRetainsPhantomPunctuation()
+    {
+        UpgradePreviewCharacter Name(long at,string text)=>new(at,true,text){Width=1920,Height=1080,
+            NameRegion=TalentUpgradePreviewEvidence.InspectionNameReference,NameRows=[new(text,new(1460,125,180,38))]};
+        var trials=new[]{Name(100,"目标角色。"),Name(400,"目标角色"),Name(700,"目标角色"),Name(1000,"目标角色")};
+        Assert.False(TalentUpgradePreviewEvidence.CharacterTriple(trials.Take(3).ToArray(),"目标角色",700));
+        Assert.True(TalentUpgradePreviewEvidence.CharacterTriple(trials.TakeLast(3).ToArray(),"目标角色",1000));
+        Assert.Equal("目标角色。",trials[0].Name);
+    }
+    private sealed class NumericOcr(string raw,string detector):IOcrService
+    {
+        public string Ocr(Mat m)=>detector;public string OcrWithoutDetector(Mat m)=>raw;
+        public OcrResult OcrResult(Mat m)
+        {
+            var b=new Rect(24,24,m.Width-48,48);
+            return new([new(new RotatedRect(new Point2f(b.X+b.Width/2f,b.Y+b.Height/2f),new Size2f(b.Width,b.Height),0),detector,.99f)]);
+        }
+    }
+}
diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native20PrivateCountTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/Native20PrivateCountTests.cs
