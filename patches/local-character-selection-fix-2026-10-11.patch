+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.View.Drawable;
+using Newtonsoft.Json;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CharacterSelectionPrivateImageTests(ITestOutputHelper output)
+{
+    [Theory]
+    [Trait("Fixture", "PrivateCharacterSelection")]
+    [InlineData("before")]
+    [InlineData("after")]
+    public void LocalGridFramesKeepTargetCandidateAndObservedFullNameSeparate(string caseId)
+    {
+        var directory = Environment.GetEnvironmentVariable("BETTERGI_PRIVATE_CHARACTER_GRID_FIXTURE_DIR");
+        Assert.False(string.IsNullOrWhiteSpace(directory), "私人头像夹具缺失不能记为通过");
+        var manifest = JsonConvert.DeserializeObject<Dictionary<string, Fixture>>(
+            File.ReadAllText(Path.Combine(directory!, "character-selection-fixtures.json")))!;
+        Assert.True(manifest.TryGetValue(caseId, out var expected));
+        using var screenshot = Cv2.ImRead(Path.Combine(directory!, expected!.Filename));
+        Assert.Equal(new Size(1538, 895), screenshot.Size());
+        using var client = new Mat(screenshot, new Rect(1, 30, 1536, 864));
+        using var recognizer = new AvatarGridIconRecognizer();
+        using var ocr = new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),
+            PaddleOcrService.PaddleOcrModelType.V6);
+        foreach (var width in new[] { 1536, 1920 })
+        {
+            var scale = width / 1920d;
+            using var frame = new Mat();
+            Cv2.Resize(client, frame, new Size(width, width * 9 / 16));
+            using var capture = new ImageRegion(frame.Clone(), 0, 0, drawContent: new DrawContent());
+            var name = CharacterSelectionHelper.ReadSelectedName(capture, scale, ocr);
+            Assert.Equal(expected.ObservedName, CharacterSelectionConfirmationPolicy.Normalize(name));
+            var roi = new Rect((int)Math.Round(40 * scale), (int)Math.Round(76 * scale),
+                (int)Math.Round(641 * scale), (int)Math.Round(897 * scale));
+            using var grid = capture.DeriveCrop(roi);
+            var cards = CharacterSelectionHelper.DetectCharacterCards(grid.SrcMat, scale, out _, out _);
+            var targetCards = cards.Select(card =>
+            {
+                using var avatar = grid.SrcMat.SubMat(card.AvatarRect);
+                using var element = grid.SrcMat.SubMat(card.ElementRect);
+                var candidate = recognizer.Recognize(avatar, element, false);
+                return (Card: card, Candidate: candidate);
+            }).Where(pair => pair.Candidate.CharacterName == expected.TargetName &&
+                pair.Candidate.Score >= CharacterSelectionHelper.MatchThreshold).ToArray();
+            Assert.Single(targetCards);
+            var policy = new CharacterSelectionConfirmationPolicy([expected.TargetName], [expected.ObservedName]);
+            Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, name));
+            Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, name));
+            Assert.Equal(expected.IsTarget ? CharacterSelectionObservation.TargetConfirmed
+                : CharacterSelectionObservation.KnownWrongConfirmed, policy.Observe(true, name));
+            output.WriteLine("case={0}; width={1}; card={2}; score={3}; name={4}", caseId, width,
+                targetCards[0].Card.CardRect, targetCards[0].Candidate.Score, name);
+        }
+    }
+
+    private sealed class Fixture
+    {
+        public string Filename { get; set; } = "";
+        public string TargetName { get; set; } = "";
+        public string ObservedName { get; set; } = "";
+        public bool IsTarget { get; set; }
+    }
+}
