new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/CharacterDevelopment/CharacterSelectionConfirmationPolicy.cs
@@ -0,0 +1,40 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+internal enum CharacterSelectionObservation { Pending, TargetConfirmed, KnownWrongConfirmed }
+
+/// <summary>只有角色列表内完整已知姓名连续三帧一致，才放行或允许局部重选。</summary>
+internal sealed class CharacterSelectionConfirmationPolicy
+{
+    internal const int MaximumClicks = 3;
+    internal const int MaximumObservations = 6;
+    private readonly HashSet<string> _targets;
+    private readonly HashSet<string> _known;
+    private readonly StableValueAccumulator<string> _stable = new(3);
+
+    public CharacterSelectionConfirmationPolicy(IEnumerable<string> targets, IEnumerable<string> knownNames)
+    {
+        _targets = targets.Select(Normalize).ToHashSet(StringComparer.Ordinal);
+        _known = knownNames.Select(Normalize).Concat(_targets).ToHashSet(StringComparer.Ordinal);
+    }
+
+    internal static string Normalize(string text) =>
+        string.Concat(text.Normalize(NormalizationForm.FormKC).Where(character => !char.IsWhiteSpace(character)));
+
+    public CharacterSelectionObservation Observe(bool isCharacterList, string text)
+    {
+        var name = Normalize(text);
+        if (!isCharacterList || string.IsNullOrEmpty(name) || !_known.Contains(name))
+        {
+            _stable.Reset();
+            return CharacterSelectionObservation.Pending;
+        }
+        if (!_stable.Add(name)) return CharacterSelectionObservation.Pending;
+        return _targets.Contains(name) ? CharacterSelectionObservation.TargetConfirmed
+            : CharacterSelectionObservation.KnownWrongConfirmed;
+    }
+}
