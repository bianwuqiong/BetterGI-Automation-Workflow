+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.GameTask.Model.Area.Converter;
+using BetterGenshinImpact.UnitTest.GameTaskTests.AutoFishingTests;
+using BetterGenshinImpact.View.Drawable;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class CharacterSelectionConfirmationPolicyTests
+{
+    private static CharacterSelectionConfirmationPolicy Policy() => new(["目标角色"], ["目标角色", "已有角色"]);
+
+    [Fact]
+    public void TwoTargetObservationsCannotReleaseTheSelection()
+    {
+        var policy = Policy();
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "目标角色"));
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "目标角色"));
+        Assert.Equal(CharacterSelectionObservation.TargetConfirmed, policy.Observe(true, "目标角色"));
+    }
+
+    [Fact]
+    public void OnlyThreeCompleteKnownWrongNamesPermitLocalReacquisition()
+    {
+        var policy = Policy();
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "已有角色"));
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "已有角色"));
+        Assert.Equal(CharacterSelectionObservation.KnownWrongConfirmed, policy.Observe(true, "已有角色"));
+    }
+
+    [Theory]
+    [InlineData(false, "目标角色")]
+    [InlineData(true, "")]
+    [InlineData(true, "目标")]
+    [InlineData(true, "陌生角色")]
+    [InlineData(true, "已有")]
+    public void UnknownPageOrPartialNameNeverPermitsReleaseOrReclick(bool page, string name)
+    {
+        var policy = Policy();
+        for (var i = 0; i < CharacterSelectionConfirmationPolicy.MaximumObservations; i++)
+            Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(page, name));
+    }
+
+    [Theory]
+    [InlineData(false, "目标角色")]
+    [InlineData(true, "")]
+    [InlineData(true, "目标")]
+    public void UnknownObservationBreaksPriorTargetConsecutiveness(bool page, string name)
+    {
+        var policy = Policy();
+        policy.Observe(true, "目标角色"); policy.Observe(true, "目标角色");
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(page, name));
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "目标角色"));
+        Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, "目标角色"));
+        Assert.Equal(CharacterSelectionObservation.TargetConfirmed, policy.Observe(true, "目标角色"));
+    }
+
+    [Fact]
+    public void AlternatingKnownNamesCannotAuthorizeAnotherClick()
+    {
+        var policy = Policy();
+        for (var i = 0; i < 6; i++)
+            Assert.Equal(CharacterSelectionObservation.Pending, policy.Observe(true, i % 2 == 0 ? "已有角色" : "目标角色"));
+    }
+
+    [Fact]
+    public void WhitespaceNormalizationKeepsTheCompleteIdentity()
+    {
+        var policy = Policy();
+        policy.Observe(true, "目标角色"); policy.Observe(true, "目标 角色");
+        Assert.Equal(CharacterSelectionObservation.TargetConfirmed, policy.Observe(true, "目标\n角色"));
+    }
+
+    [Fact]
+    public void NestedGridCardTransformsToPhysicalDesktopWithoutDpiDivision()
+    {
+        var desktop = new DesktopRegion(2560, 1440, new FakeMouseSimulator());
+        using var pixels = new Mat(1080, 1920, MatType.CV_8UC3, Scalar.Black);
+        using var capture = desktop.Derive(pixels.Clone(), 400, 232);
+        using var grid = capture.DeriveCrop(new Rect(40, 76, 641, 897));
+        using var card = grid.DeriveCrop(new Rect(520, 25, 115, 140));
+        var converted = ConvertRes<DesktopRegion>.ConvertPositionToTargetRegion(0, 0, card.Width, card.Height, card);
+        Assert.Equal(new Rect(960, 333, 115, 140), converted.ToRect());
+        Assert.Equal(1017.5, converted.X + converted.Width / 2d);
+        Assert.Equal(2560, converted.TargetRegion.Width);
+    }
+
+    [Fact]
+    public void SelectionLimitsAreFinite()
+    {
+        Assert.Equal(3, CharacterSelectionConfirmationPolicy.MaximumClicks);
+        Assert.Equal(6, CharacterSelectionConfirmationPolicy.MaximumObservations);
+    }
+}
