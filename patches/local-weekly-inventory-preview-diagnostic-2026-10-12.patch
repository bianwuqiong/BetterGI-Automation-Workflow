+// Modified 2026-10-12: synthetic contract tests; no game processes or account fixtures.
+using System;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.GameUI;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public sealed class WeeklyConversionInventoryTests
+{
+    private static readonly BackpackSelection Selection = new(new(110, 300, 125, 150), 172, 365, 1000);
+    private static WeeklyInventoryMaterial Target(string id = "113060") => WeeklyInventoryCatalog.Materials.Single(m => m.MaterialId == id);
+    private static BackpackBorderEvidence Border(bool verified = true)
+    {
+        var rect=Selection.ItemRect.ToRect();
+        BackpackBorderSide Side(string axis,int coordinate)
+        {
+            int begin=axis=="x"?rect.Y+(int)(rect.Height*.2):rect.X+(int)(rect.Width*.12);
+            int end=axis=="x"?rect.Y+(int)(rect.Height*.75):rect.X+(int)(rect.Width*.55);
+            return new(axis,coordinate,end-begin,end-begin,[new(axis=="x"?coordinate:begin,axis=="x"?begin:coordinate,250,250,250)]);
+        }
+        return new(verified,"four_side_neutral_outline",225,35,.9,[Side("x",rect.X),Side("x",rect.Right-1),Side("y",rect.Y),Side("y",rect.Bottom-1)]);
+    }
+    private static WeeklyInventoryFrameEvidence Frame(long at, WeeklyInventoryMaterial? target = null, string raw = "9",
+        string? name = null, string? header = null, bool selected = true, bool edge = false, bool border = true)
+    {
+        target ??= Target();
+        var nameRect = BackpackRect.From(BackpackInventoryEvidenceSafety.NameRect(1920));
+        var countRect = BackpackRect.From(BackpackInventoryEvidenceSafety.RawCountRect(Selection.ItemRect.ToRect()));
+        var headerRect = WeeklyConversionInventoryEvidence.HeaderRect(1920);
+        var stack = new BackpackFrameEvidence { ObservedAt = at, NameRegion = nameRect,
+            NameRows = [new(name ?? target.MaterialName, nameRect.X + 10, nameRect.Y + 10, 200, 30)],
+            CountRegion = countRect, CountRows = [new(raw, countRect.X + (edge ? 0 : 3), countRect.Y + 3, 100, countRect.Height - 6)],
+            RawCountText = raw, SelectedItemVerified = selected, SelectedItemRect = Selection.ItemRect, SelectionEvidence = Border(border) };
+        return new(stack, 1920, 1080, target.Category, true, false, true, headerRect,
+            [new(header ?? WeeklyInventoryCatalog.Header(target.Category), 120, 30, 200, 25)], target.MaterialName,.9,
+            new(Selection.ItemRect.X,Selection.ItemRect.Y,Selection.ItemRect.Width,(int)Math.Round(Selection.ItemRect.Height*125d/153)));
+    }
+    private static WeeklyInventoryObservation Pair(string id = "113060", string raw = "9") =>
+        new(Selection, Frame(1400, Target(id), raw), Frame(1700, Target(id), raw));
+
+    [Fact] public void CatalogHasExactIdsNamesAndCategoryRouting()
+    {
+        Assert.Equal(new[] { "113060", "113061", "113062", "113021" }, WeeklyInventoryCatalog.Materials.Select(m => m.MaterialId));
+        Assert.Equal("异梦溶媒", Target("113021").MaterialName);
+        Assert.Equal("preciousItems", Target("113021").Category);
+        Assert.Equal("BagPreciousItem", WeeklyInventoryCatalog.TabPrefix("preciousItems"));
+        Assert.Equal("贵重道具", WeeklyInventoryCatalog.Header("preciousItems"));
+        Assert.Equal(GridScreenName.PreciousItems, WeeklyInventoryCatalog.Grid("preciousItems"));
+        Assert.Equal(GridScreenName.CharacterDevelopmentItems, WeeklyInventoryCatalog.Grid("characterDevelopmentItems"));
+        Assert.Throws<ArgumentException>(() => WeeklyInventoryCatalog.Grid("crafting"));
+    }
+    [Theory]
+    [InlineData("101016", "异梦溶媒")]
+    [InlineData("113021", "残火灯烛")]
+    [InlineData("113060", "灯烛")]
+    [InlineData("113060", "残火灯烛 ")]
+    [InlineData("201", "原石")]
+    [InlineData("107001", "脆弱树脂")]
+    public void RequestRejectsWrongIdsPartialNamesAndForbiddenResources(string id, string name) =>
+        Assert.Throws<ArgumentException>(() => new WeeklyConversionInventoryRequest {
+            Materials = [new() { MaterialId = id, MaterialName = name }] }.Validate());
+    [Fact] public void JsonBoundaryRejectsCallerCoordinatesCategoryAndUnknownReplayFields()
+    {
+        Assert.Equal(4, ReadWeeklyConversionInventoryTask.ParseRequest("{}").Materials.Length);
+        foreach (var json in new[] { "{\"x\":100}", "{\"category\":\"crafting\"}", "{\"confirm\":true}", "{\"replay\":true}" })
+            Assert.Throws<JsonSerializationException>(() => ReadWeeklyConversionInventoryTask.ParseRequest(json));
+        Assert.Throws<ArgumentException>(() => ReadWeeklyConversionInventoryTask.ParseRequest("{\"materials\":[]}"));
+        Assert.Throws<ArgumentException>(() => ReadWeeklyConversionInventoryTask.ParseRequest("{\"materials\":null}"));
