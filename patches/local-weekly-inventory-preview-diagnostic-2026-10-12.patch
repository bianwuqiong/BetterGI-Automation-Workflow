+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class PreviewPaddingPrivateDiagnosticTests(ITestOutputHelper output)
+{
+    [Fact] [Trait("Fixture","PrivatePreviewPaddingDiagnostic")]
+    public void OneFixedRealBackgroundVariantRetainsInitialReadingsWithoutClaimingIdentitySuccess()
+    {
+        var path=Environment.GetEnvironmentVariable("BGI_PRIVATE_TALENT_UPGRADE_MANIFEST");
+        Assert.False(string.IsNullOrWhiteSpace(path),"Explicit private manifest required.");
+        var f=Newtonsoft.Json.JsonConvert.DeserializeObject<Fixture>(File.ReadAllText(path!))!;
+        Assert.False(string.IsNullOrWhiteSpace(f.DiagnosticPath));
+        using var model=new ItemRecognizer();var results=new List<UpgradePreviewFrame>();
+        foreach(var file in f.Previews)
+        {
+            using var image=Cv2.ImRead(file);var c=f.ClientRect;using var client=new Mat(image,new Rect(c[0],c[1],c[2],c[3]));
+            using var full=new Mat();Cv2.Resize(client,full,new Size(1920,1080));using var frame=new ImageRegion(full.Clone(),0,0);
+            var result=TalentUpgradePreviewReader.Preview(frame,OcrFactory.Paddle,model,0);results.Add(result);
+            Assert.True(result.Page);Assert.Equal("real_background_padding_8_reference_53",result.CoinVariant);
+            Assert.Equal(new Rect(845,791,53,53),result.CoinRegion);Assert.Equal(new Rect(853,799,37,37),result.InitialCoinRegion);
+            Assert.NotNull(result.Mora.InitialReading);
+            Assert.True(result.CoinRegion.Right<result.Mora.InitialReading!.Bounds.Left);
+            Assert.All(result.Materials,m=>Assert.NotNull(m.Quantity.InitialReading));
+            output.WriteLine("STATIC only: selected={0}:{1:F4}; original={2}:{3:F4}; quantityVerified={4}; MoraNumericVerified={5}",
+                result.CoinName,result.CoinScore,result.InitialCoinName,result.InitialCoinScore,result.Materials.Count(m=>m.Quantity.Complete),result.Mora.Complete);
+        }
+        // Private raw parser diagnostics are retained separately. No account quantities enter public tests.
+        File.WriteAllText(f.DiagnosticPath,Newtonsoft.Json.JsonConvert.SerializeObject(new{source="private_static_parser_diagnostic_not_live",frames=results}));
+    }
+    private sealed class Fixture {public int[] ClientRect{get;set;}=[];public string[] Previews{get;set;}=[];public string DiagnosticPath{get;set;}="";}
+}
