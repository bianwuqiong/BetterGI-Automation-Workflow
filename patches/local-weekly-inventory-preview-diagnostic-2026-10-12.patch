@@ -0,0 +1,18 @@
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class InspectionNativeFrameEncodingTests
+{
+    [Fact] public void DiagnosticPngPreservesEveryPixelAndReportsActualEncodedHash()
+    {
+        using var original=new Mat(18,32,MatType.CV_8UC3,new Scalar(12,34,56));original.Set(7,11,new Vec3b(255,127,3));
+        var encoded=InspectionNativeFrameEncoding.Encode(original);
+        using var decoded=Cv2.ImDecode(encoded.Png,ImreadModes.Unchanged);
+        Assert.Equal(original.Size(),decoded.Size());Assert.Equal(original.Type(),decoded.Type());
+        Assert.Equal(0,Cv2.Norm(original,decoded,NormTypes.INF));
+        Assert.Equal(Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(encoded.Png)),encoded.PngSha256);
+        Assert.Equal(encoded.NativePixelsSha256,InspectionNativeFrameEncoding.Encode(decoded).NativePixelsSha256);
+    }
+}
