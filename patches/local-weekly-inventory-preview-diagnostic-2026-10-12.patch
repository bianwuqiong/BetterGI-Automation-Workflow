diff --git a/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionNativeFrameEncoding.cs b/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionNativeFrameEncoding.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/CharacterDevelopment/InspectionNativeFrameEncoding.cs
@@ -0,0 +1,19 @@
+using System;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+internal sealed record EncodedInspectionFrame(byte[] Png,string PngSha256,string NativePixelsSha256);
+/// <summary>Lossless diagnostics only. No capture, transformation, UI input or verification decision.</summary>
+internal static class InspectionNativeFrameEncoding
+{
+    internal static EncodedInspectionFrame Encode(Mat source)
+    {
+        using var exact=source.Clone(); // Contiguous copy only, pixels/geometry/type remain unchanged.
+        var pixels=new byte[checked((int)(exact.Total()*exact.ElemSize()))];
+        System.Runtime.InteropServices.Marshal.Copy(exact.Data,pixels,0,pixels.Length);
+        if(!Cv2.ImEncode(".png",exact,out var png)||png.Length==0)throw new InvalidOperationException("PNG encoding failed.");
+        return new(png,Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(png)),
+            Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(pixels)));
+    }
+}
