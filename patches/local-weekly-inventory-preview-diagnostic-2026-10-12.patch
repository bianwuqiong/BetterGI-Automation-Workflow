+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>Only opens inventory, changes verified bag tabs, scrolls and selects named stacks.
+/// No conversion, crafting, battle, claim, upgrade, use, or general confirmation input exists here.</summary>
+public sealed class ReadWeeklyConversionInventoryTask
+{
+    private readonly WeeklyConversionInventoryRequest request;
+    private readonly ILogger logger = App.GetLogger<ReadWeeklyConversionInventoryTask>();
+    private static readonly JsonSerializerSettings JsonSettings = new() {
+        ContractResolver = new CamelCasePropertyNamesContractResolver(), MissingMemberHandling = MissingMemberHandling.Error };
+    public ReadWeeklyConversionInventoryTask(WeeklyConversionInventoryRequest request)
+    {
+        request.Validate();
+        // Freeze caller-owned mutable arrays before any awaits.
+        this.request = new() { Materials = request.Materials.Select(m => new BackpackMaterial {
+            MaterialId = m.MaterialId, MaterialName = m.MaterialName }).ToArray() };
+    }
+    public static WeeklyConversionInventoryRequest ParseRequest(string json)
+    {
+        var parsed = JsonConvert.DeserializeObject<WeeklyConversionInventoryRequest>(json, JsonSettings)
+            ?? throw new ArgumentException("Empty weekly inventory request.");
+        parsed.Validate(); return parsed;
+    }
+    public static string Serialize(WeeklyConversionInventoryResult result) => JsonConvert.SerializeObject(result, JsonSettings);
+    private static bool Prompt(ImageRegion frame)
+    {using var confirm=frame.Find(ElementRecognition.Get("BtnBlackConfirm",frame));return Bv.IsInPromptDialog(frame)||Bv.IsInRevivePrompt(frame)||confirm.IsExist();}
+    private static bool Tab(ImageRegion frame, string category, string suffix)
+    {
+        using var tab = frame.Find(ElementRecognition.Get(WeeklyInventoryCatalog.TabPrefix(category) + suffix, frame));
+        return tab.IsExist();
+    }
+    private static BackpackOcrRow[] Rows(ImageRegion frame, Rect rect)
+    {
+        using var crop = frame.DeriveCrop(rect);
+        return OcrFactory.Paddle.OcrResult(crop.SrcMat).Regions.Select(r => {
+            var b = r.Rect.BoundingRect(); return new BackpackOcrRow(r.Text, b.X + rect.X, b.Y + rect.Y, b.Width, b.Height);
+        }).ToArray();
+    }
+    private static bool Header(ImageRegion frame, string category)
+    {
+        var rect = WeeklyConversionInventoryEvidence.HeaderRect(frame.Width);
+        return WeeklyConversionInventoryEvidence.HeaderVerified(Rows(frame, rect.ToRect()), rect, category);
+    }
+    private static void RequirePage(ImageRegion frame, string category, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested();
+        if (!SystemControl.IsGenshinImpactActiveByProcess() || Prompt(frame) || !Tab(frame, category, "Checked") || !Header(frame, category))
+            throw new InvalidOperationException("Weekly inventory page, complete header or game focus unverified.");
+        ct.ThrowIfCancellationRequested();
+    }
+    private static async Task SelectTab(string category, CancellationToken ct)
+    {
+        for (int i = 0; i < 8; i++)
+        {
+            ct.ThrowIfCancellationRequested(); using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+            if (!SystemControl.IsGenshinImpactActiveByProcess() || Prompt(frame))
+                throw new InvalidOperationException("Weekly inventory tab switch blocked by focus or dialog.");
+            if (Tab(frame, category, "Checked") && Header(frame, category)) return;
+            // Only known inventory tab templates may be clicked. Never any generic button.
+            using var tab = frame.Find(ElementRecognition.Get(WeeklyInventoryCatalog.TabPrefix(category) + "Unchecked", frame));
+            if (tab.IsExist()) { ct.ThrowIfCancellationRequested(); tab.Click(); }
+            await Task.Delay(250, ct);
+        }
+        throw new InvalidOperationException("Weekly inventory category/header could not be selected.");
+    }
+    public async Task<string> Start(CancellationToken ct)
+    {
+        var result = new WeeklyConversionInventoryResult();
+        foreach (var m in request.Materials) result.Inventory.Add(m.MaterialId, null);
+        bool opened = false, observationCompleted = false;
+        var saved = new ConcurrentDictionary<string, ITaskTrigger>(GameTaskManager.TriggerDictionary ?? new());
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        // Six seconds are reserved for bounded cleanup; total cooperative budget is 120 seconds.
+        timeout.CancelAfter(TimeSpan.FromSeconds(114));
+        try
+        {
+            TaskTriggerDispatcher.Instance().ClearTriggers(); Simulation.ReleaseAllKey();
+            for (int i = 0; i < 2; i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested(); using var initial = TaskControl.CaptureToRectArea(forceNew: true);
+                if (!SystemControl.IsGenshinImpactActiveByProcess() || !ReadBackpackInventoryTask.World(initial) || Prompt(initial))
+                    throw new InvalidOperationException("Weekly inventory needs two fresh outside-world entry frames.");
+                await Task.Delay(200, timeout.Token);
+            }
+            timeout.Token.ThrowIfCancellationRequested();
+            Simulation.SendInput.SimulateAction(GIActions.OpenInventory); opened = true;
+            await Task.Delay(800, timeout.Token);
+            using var recognizer = new ItemRecognizer();
+            var targets = WeeklyInventoryCatalog.Materials.Where(m => request.Materials.Any(r => r.MaterialId == m.MaterialId)).ToArray();
+            foreach (var group in targets.GroupBy(m => m.Category))
+            {
+                await SelectTab(group.Key, timeout.Token);
+                var gridParams = GridParams.Templates[WeeklyInventoryCatalog.Grid(group.Key)];
+                var grid = new GridScreen(gridParams, logger, timeout.Token); int pages = 0;
+                grid.OnBeforeScroll = () => {
+                    using var fresh = TaskControl.CaptureToRectArea(forceNew: true);
+                    RequirePage(fresh, group.Key, timeout.Token);
+                };
+                grid.OnAfterTurnToNewPage = _ => {
+                    timeout.Token.ThrowIfCancellationRequested();
+                    if (++pages > 30) throw new InvalidOperationException("Weekly inventory reached bounded 30-page limit.");
+                };
+                await foreach (var (page, itemRect) in grid)
+                {
+                    timeout.Token.ThrowIfCancellationRequested();
+                    using var item = page.DeriveCrop(itemRect); using var icon = item.SrcMat.GetGridIcon();
+                    var candidate = recognizer.Match(icon);
+                    var target = group.FirstOrDefault(m => m.MaterialName == candidate.Name && double.IsFinite(candidate.Score)&&candidate.Score>=.75&&!result.Observations.ContainsKey(m.MaterialId));
+                    if (target is null) continue;
+                    var fullRect = new Rect(itemRect.X + gridParams.Roi.X, itemRect.Y + gridParams.Roi.Y, itemRect.Width, itemRect.Height);
+                    BackpackSelection selection;
+                    using (var fresh = TaskControl.CaptureToRectArea(forceNew: true))
+                    {
+                        RequirePage(fresh, group.Key, timeout.Token);
+                        using var cell = fresh.DeriveCrop(fullRect); using var currentIcon = cell.SrcMat.GetGridIcon();
+                        var current=recognizer.Match(currentIcon);
+                        if (current.Name != target.MaterialName||!double.IsFinite(current.Score)||current.Score<.75) continue;
+                        selection = ReadBackpackInventoryTask.SelectCell(BackpackRect.From(fullRect), () => cell.Click(),
+                            () => fresh.MoveTo(fresh.Width / 2, fresh.Height - 40),
+                            () => DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), timeout.Token);
+                    }
+                    // Captures are independent and contain same-frame model/header/title/border/raw count evidence.
+                    var pair = await ObservePair(selection, (s, token) => ReadFrame(s, group.Key, recognizer, token),
+                        (ms, token) => Task.Delay(ms, token), timeout.Token);
+                    var count = WeeklyConversionInventoryEvidence.Count(pair, target);
+                    if (count.HasValue) { result.Observations.Add(target.MaterialId, pair); result.Inventory[target.MaterialId] = count; }
+                    else
+                    {
+                        if(!result.RejectedObservations.TryGetValue(target.MaterialId,out var rejected))result.RejectedObservations[target.MaterialId]=rejected=[];
+                        if(rejected.Count<2)rejected.Add(pair);
+                        logger.LogWarning("Named weekly inventory stack evidence rejected; count remains unknown.");
+                    }
+                    if (group.All(m => result.Observations.ContainsKey(m.MaterialId))) break;
+                }
+            }
+            result.PrimaryReason = result.Inventory.Values.All(v => v.HasValue) ? "selected_stack_model_header_raw_ocr_pair" : "missing_or_unverified_stack";
+            observationCompleted = true;
+        }
+        catch (Exception ex)
+        {
+            result.PrimaryReason = ex is OperationCanceledException ? "observation_cancelled_or_timeout" : ex.Message;
+        }
+        finally
+        {
+            try { result.MainUiRestored = await Restore(opened,result); result.CleanupCompleted = result.MainUiRestored;result.CleanupReason=result.MainUiRestored?"world_restored":"world_restore_unverified"; }
+            catch { result.MainUiRestored = false; result.CleanupCompleted = false; result.CleanupReason="world_restore_deadline_or_failure"; }
+            finally
+            {
+                Simulation.ReleaseAllKey(); TaskTriggerDispatcher.Instance().ClearTriggers();
+                GameTaskManager.TriggerDictionary = saved;
+                TaskTriggerDispatcher.Instance().SetTriggers(saved.Values.OrderByDescending(t => t.Priority).ToList());
+            }
+        }
+        result.Status = observationCompleted && WeeklyConversionInventoryEvidence.CanPublish(result, request) ? "verified" : "unknown";
+        if (!result.MainUiRestored)
+            foreach (var id in result.Inventory.Keys.ToArray()) result.Inventory[id] = null;
+        result.Reason=result.PrimaryReason=="selected_stack_model_header_raw_ocr_pair"&&!result.MainUiRestored?result.CleanupReason:result.PrimaryReason;
+        if(result.Status=="verified")result.ObservedAt=DateTimeOffset.FromUnixTimeMilliseconds(result.Observations.Values.Max(p=>p.Second.Stack.ObservedAt)).ToString("O");
+        ct.ThrowIfCancellationRequested();
+        var folder=Global.Absolute("log\\weekly-conversion-inventory");
+        result.RawReportPath=System.IO.Path.Combine(folder,DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmssfff")+"-"+Guid.NewGuid().ToString("N")[..8]+".json");
+        var payload=Serialize(result);
+        try{System.IO.Directory.CreateDirectory(folder);System.IO.File.WriteAllText(result.RawReportPath,payload);}catch(Exception ex){logger.LogWarning("Weekly read-only report save failed: {Type}",ex.GetType().Name);}
+        return payload;
+    }
+    internal static async Task<WeeklyInventoryObservation> ObservePair(BackpackSelection selection,
+        Func<BackpackSelection, CancellationToken, WeeklyInventoryFrameEvidence> capture,
+        Func<int, CancellationToken, Task> delay, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested(); await delay(300, ct); ct.ThrowIfCancellationRequested();
+        var first = capture(selection, ct); ct.ThrowIfCancellationRequested();
+        await delay(250, ct); ct.ThrowIfCancellationRequested();
+        var second = capture(selection, ct); ct.ThrowIfCancellationRequested();
+        return new(selection, first, second);
+    }
+    internal static WeeklyInventoryFrameEvidence ReadFrame(BackpackSelection selection, string category,
+        ItemRecognizer recognizer, CancellationToken ct)
+    {
+        ct.ThrowIfCancellationRequested(); using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+        long at = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(); ct.ThrowIfCancellationRequested();
+        var nameRect = BackpackInventoryEvidenceSafety.NameRect(frame.Width);
+        var countRect = BackpackInventoryEvidenceSafety.RawCountRect(selection.ItemRect.ToRect());
+        var headerRect = WeeklyConversionInventoryEvidence.HeaderRect(frame.Width);
+        var names = Rows(frame, nameRect); var counts = Rows(frame, countRect); var headers = Rows(frame, headerRect.ToRect());
+        using var count = frame.DeriveCrop(countRect);
+        var raw = OcrFactory.Paddle.OcrWithoutDetector(count.SrcMat);
+        using var cell = frame.DeriveCrop(selection.ItemRect.ToRect()); using var icon = cell.SrcMat.GetGridIcon();
+        var matched = recognizer.Match(icon);
+        var border = BackpackInventoryEvidenceSafety.ReadSelectedBorder(frame.SrcMat, selection.ItemRect.ToRect());
+        bool tab = Tab(frame, category, "Checked"); bool active = SystemControl.IsGenshinImpactActiveByProcess(); bool prompt = Prompt(frame);
+        ct.ThrowIfCancellationRequested();
+        var stack = new BackpackFrameEvidence { ObservedAt = at, NameRegion = BackpackRect.From(nameRect), NameRows = names,
+            CountRegion = BackpackRect.From(countRect), CountRows = counts, RawCountText = raw,
+            SelectedItemVerified = tab && active && !prompt && border.Verified,
+            SelectedItemRect = border.Verified ? selection.ItemRect : new(0, 0, 0, 0), SelectionEvidence = border };
+        var iconRegion=new BackpackRect(selection.ItemRect.X,selection.ItemRect.Y,selection.ItemRect.Width,(int)Math.Round(selection.ItemRect.Height*125d/153));
+        return new(stack, frame.Width, frame.Height, category, active, prompt, tab, headerRect, headers, matched.Name,matched.Score,iconRegion);
+    }
+    private static async Task<bool> Restore(bool opened,WeeklyConversionInventoryResult result)
+    {
+        using var cleanup = new CancellationTokenSource(TimeSpan.FromSeconds(6)); bool escaped = false;WeeklyInventoryWorldFrame? previous=null;int bagFrames=0;
+        for (int i = 0; i < 20; i++)
+        {
+            cleanup.Token.ThrowIfCancellationRequested(); using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+            var active=SystemControl.IsGenshinImpactActiveByProcess();var prompt=Prompt(frame);
+            var world=active&&ReadBackpackInventoryTask.World(frame)&&!prompt;
+            bool recognized=!world&&!prompt&&new[]{"characterDevelopmentItems","preciousItems"}.Any(c=>Tab(frame,c,"Checked")&&Header(frame,c));
+            var current=new WeeklyInventoryWorldFrame(DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),frame.Width,frame.Height,active,world,prompt,recognized,false);
+            if (!active)return false;
+            if(world)
+            {result.WorldFrames.Add(current);if(previous is not null&&WeeklyConversionInventoryEvidence.WorldPair(previous,current))return true;previous=current;}
+            else
+            {
+                previous=null;bagFrames=recognized?bagFrames+1:0;
+                if (bagFrames>=2&&BackpackInventoryEvidenceSafety.CanEscapeBackpack(opened, recognized, prompt, escaped))
+                {
+                    cleanup.Token.ThrowIfCancellationRequested(); Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE); escaped = true;
+                    current=current with{EscapeRequested=true};
+                }
+                result.WorldFrames.Add(current);
+            }
+            await Task.Delay(200, cleanup.Token);
+        }
+        return false;
+    }
+}
