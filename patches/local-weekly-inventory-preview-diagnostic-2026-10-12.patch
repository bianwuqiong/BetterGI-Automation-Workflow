+    public static bool HeaderVerified(BackpackOcrRow[] rows, BackpackRect region, string category) =>
+        rows.All(r => BackpackInventoryEvidenceSafety.Inside(new(r.X, r.Y, r.Width, r.Height), region)) &&
+        rows.Count(r => BackpackInventoryEvidenceSafety.Normalize(r.Text) == WeeklyInventoryCatalog.Header(category)) == 1 &&
+        rows.Where(r=>BackpackInventoryEvidenceSafety.Normalize(r.Text)==WeeklyInventoryCatalog.Header(category))
+            .All(r=>AwayFromEdges(r,region,2*region.Width/350d));
+    private static bool AwayFromEdges(BackpackOcrRow row, BackpackRect region, double margin) =>
+        row.X - region.X >= margin && row.Y - region.Y >= margin &&
+        region.X + region.Width - row.X - row.Width >= margin &&
+        region.Y + region.Height - row.Y - row.Height >= margin;
+    private static bool FrameVerified(WeeklyInventoryFrameEvidence f, WeeklyInventoryMaterial target)
+    {
+        if (f.Width < 800 || f.Width * 9 != f.Height * 16 || !f.GameActive || f.PromptVisible || !f.TabVerified ||
+            f.Category != target.Category || f.IconName != target.MaterialName || !double.IsFinite(f.IconScore)||f.IconScore<.75||
+            f.HeaderRegion != HeaderRect(f.Width) || !HeaderVerified(f.HeaderRows, f.HeaderRegion, target.Category)) return false;
+        var stack = f.Stack;
+        var selected=stack.SelectedItemRect;
+        var expectedIcon=new BackpackRect(selected.X,selected.Y,selected.Width,(int)Math.Round(selected.Height*125d/153));
+        if(f.IconRegion!=expectedIcon||f.IconMethod!="cell_resize_125x153_top_125x125")return false;
+        // Evidence must retain actual four-side selected-border proof, not only a Boolean assertion.
+        if (stack.SelectionEvidence is not BackpackBorderEvidence { Verified: true, Method: "four_side_neutral_outline" } border ||
+            border.MinimumChannel != 225 || border.MaximumSpread != 35 || border.MinimumFraction != .9 ||
+            border.Sides.Length != 4 || border.Sides.Count(s => s.Axis == "x") != 2 || border.Sides.Count(s => s.Axis == "y") != 2 ||
+            border.Sides.Any(s => s.SampleCount <= 0 || s.NeutralCount > s.SampleCount || s.NeutralCount / (double)s.SampleCount < .9)) return false;
+        var rect=stack.SelectedItemRect.ToRect();int radius=Math.Max(3,(int)Math.Round(rect.Width*8d/125));
+        bool Side(string axis,int edge)
+        {
+            int begin=axis=="x"?rect.Y+(int)(rect.Height*.2):rect.X+(int)(rect.Width*.12);
+            int end=axis=="x"?rect.Y+(int)(rect.Height*.75):rect.X+(int)(rect.Width*.55);
+            var matches=border.Sides.Where(s=>s.Axis==axis&&Math.Abs(s.Coordinate-edge)<=radius).ToArray();
+            return matches.Length==1&&matches[0].SampleCount==end-begin&&matches[0].Samples.Length>0&&matches[0].Samples.All(p=>
+                (axis=="x"?p.X:p.Y)==matches[0].Coordinate&&(axis=="x"?p.Y:p.X)>=begin&&(axis=="x"?p.Y:p.X)<end&&
+                p.B is >=0 and <=255&&p.G is >=0 and <=255&&p.R is >=0 and <=255);
+        }
+        if(!Side("x",rect.X)||!Side("x",rect.Right-1)||!Side("y",rect.Y)||!Side("y",rect.Bottom-1))return false;
+        if(!Regex.IsMatch(BackpackInventoryEvidenceSafety.Normalize(stack.RawCountText),@"\A(?:0|[1-9][0-9]{0,8})\z"))return false;
+        if (stack.NameRegion != BackpackRect.From(BackpackInventoryEvidenceSafety.NameRect(f.Width)) ||
+            stack.CountRegion != BackpackRect.From(BackpackInventoryEvidenceSafety.RawCountRect(stack.SelectedItemRect.ToRect())) ||
+            stack.CountRows.Length != 1) return false;
+        var names = stack.NameRows.Where(r => BackpackInventoryEvidenceSafety.Normalize(r.Text) == target.MaterialName).ToArray();
+        var name = names.Length == 1 ? names[0] : null;
+        double margin = 2*f.Width/1920d;
+        return name is not null && AwayFromEdges(name, stack.NameRegion, margin) &&
+            AwayFromEdges(stack.CountRows[0], stack.CountRegion, margin);
+    }
+    public static int? Count(WeeklyInventoryObservation pair, WeeklyInventoryMaterial target)
+    {
+        if (ReferenceEquals(pair.First, pair.Second) || pair.First.Width != pair.Second.Width ||
+            pair.First.Height != pair.Second.Height || !FrameVerified(pair.First, target) || !FrameVerified(pair.Second, target)) return null;
+        var backpackPair = new BackpackObservation(pair.Selection, pair.First.Stack, pair.Second.Stack);
+        return BackpackInventoryEvidenceSafety.Verified(backpackPair, target.MaterialName)
+            ? BackpackInventoryEvidenceSafety.RawCount(pair.Second.Stack, target.MaterialName, pair.Selection) : null;
+    }
+    public static bool CanPublish(WeeklyConversionInventoryResult result, WeeklyConversionInventoryRequest request) =>
+        result.ReadOnly && result.MainUiRestored && result.CleanupCompleted &&
+        result.WorldFrames.Count>=2 && WorldPair(result.WorldFrames[^2],result.WorldFrames[^1]) &&
+        request.Materials.All(m => result.Inventory.TryGetValue(m.MaterialId, out var count) && count.HasValue &&
+            result.Observations.TryGetValue(m.MaterialId, out var pair) &&
+            Count(pair, WeeklyInventoryCatalog.Materials.Single(a => a.MaterialId == m.MaterialId)) == count);
+    public static bool WorldPair(WeeklyInventoryWorldFrame a,WeeklyInventoryWorldFrame b)=>
+        !ReferenceEquals(a,b)&&a.Width>=800&&a.Width*9==a.Height*16&&a.Width==b.Width&&a.Height==b.Height&&
+        a.Focused&&b.Focused&&a.World&&b.World&&!a.Prompt&&!b.Prompt&&
+        b.ObservedAt>a.ObservedAt&&b.ObservedAt-a.ObservedAt<=5000;
+}
