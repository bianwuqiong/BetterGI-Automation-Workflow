+using System;
+using System.Linq;
+using System.Text.RegularExpressions;
+using BetterGenshinImpact.Helpers;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>Read-only bottom-left currency crops, calibrated to the observed precious-items page.</summary>
+public sealed class MoraSnapshotRequest
+{
+    public BackpackRect BalanceRegion { get; set; } = new(397, 1000, 140, 40);
+    public BackpackRect IconRegion { get; set; } = new(354, 1000, 37, 37);
+    public void Validate()
+    {
+        static bool Within(BackpackRect? r, int left, int top, int right, int bottom) => r is not null &&
+            r.Width >= 20 && r.Height >= 15 && r.X >= left && r.Y >= top && r.X + r.Width <= right && r.Y + r.Height <= bottom;
+        if (!Within(BalanceRegion, 390, 970, 750, 1070) || BalanceRegion.Width > 320 || BalanceRegion.Height > 70 ||
+            !Within(IconRegion, 330, 970, 420, 1070) || IconRegion.Width > 70 || IconRegion.Height > 70 ||
+            IconRegion.X + IconRegion.Width > BalanceRegion.X || BalanceRegion.X - IconRegion.X - IconRegion.Width > 25)
+            throw new ArgumentException("Mora observation requires adjacent bottom-left Mora icon/balance crops; primogem region is excluded.");
+    }
+    public static Rect Scale(BackpackRect r, int width) => new((int)Math.Round(r.X * width / 1920d),
+        (int)Math.Round(r.Y * width / 1920d), (int)Math.Round(r.Width * width / 1920d), (int)Math.Round(r.Height * width / 1920d));
+}
+
+public sealed record MoraFrameEvidence(long ObservedAt, int Width, int Height, bool BackpackTabVerified,
+    bool PromptVisible, BackpackOcrRow[] HeaderRows, string IconName, double IconScore, BackpackRect IconRegion,
+    BackpackRect BalanceRegion, BackpackOcrRow[] BalanceRows, string RawBalanceText);
+
+public static class MoraSnapshotEvidence
+{
+    public static int? ParseBalance(string? raw)
+    {
+        var text = StringUtils.ConvertFullWidthNumToHalfWidth(raw ?? "").Trim();
+        return Regex.IsMatch(text, @"\A(?:0|[1-9][0-9]{0,9})\z") && int.TryParse(text, out var count) ? count : null;
+    }
+    public static int? Read(MoraFrameEvidence frame)
+    {
+        if (frame.Width < 800 || frame.Width * 9 != frame.Height * 16 || !frame.BackpackTabVerified || frame.PromptVisible ||
+            frame.ObservedAt < 0 || frame.HeaderRows.Count(r => BackpackInventoryEvidenceSafety.Normalize(r.Text) == "贵重道具") != 1 ||
+            frame.IconName != "摩拉" || !double.IsFinite(frame.IconScore) || frame.IconScore < .75 || frame.BalanceRows.Length != 1 ||
+            frame.IconRegion.X + frame.IconRegion.Width > frame.BalanceRegion.X ||
+            frame.IconRegion.X < 330 * frame.Width / 1920d - 1 || frame.IconRegion.Y < 970 * frame.Width / 1920d - 1 ||
+            frame.IconRegion.X + frame.IconRegion.Width > 420 * frame.Width / 1920d + 1 ||
+            frame.BalanceRegion.X < 390 * frame.Width / 1920d - 1 ||
+            frame.BalanceRegion.X + frame.BalanceRegion.Width > 750 * frame.Width / 1920d + 1)
+            return null;
+        var row = frame.BalanceRows[0];
+        if (!BackpackInventoryEvidenceSafety.Inside(new(row.X, row.Y, row.Width, row.Height), frame.BalanceRegion) ||
+            row.X - frame.BalanceRegion.X < 2 * frame.Width / 1920d ||
+            frame.BalanceRegion.X + frame.BalanceRegion.Width - row.X - row.Width < 2 * frame.Width / 1920d)
+            return null; // Digits at a crop boundary may be truncated; never recover a shorter balance.
+        var raw = ParseBalance(frame.RawBalanceText);
+        return raw.HasValue && raw == ParseBalance(row.Text) ? raw : null;
+    }
+    public static int? Pair(MoraFrameEvidence? first, MoraFrameEvidence? second, long now)
+    {
+        if (first is null || second is null || first.Width != second.Width || first.Height != second.Height ||
+            first.BalanceRegion != second.BalanceRegion || first.IconRegion != second.IconRegion || second.ObservedAt <= first.ObservedAt ||
+            second.ObservedAt - first.ObservedAt > 5000 || now < second.ObservedAt || now - second.ObservedAt > 1500)
+            return null;
+        var value = Read(first);
+        return value.HasValue && value == Read(second) ? value : null;
+    }
+}
