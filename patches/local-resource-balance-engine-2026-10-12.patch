+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class WeaponExperienceInventoryRequestTests
+{
+    [Fact]
+    public void ExplicitExperienceCategoryAcceptsOnlyTheThreeFixedIdsAndNames()
+    {
+        var request = ReadBackpackInventoryTask.ParseRequest("""
+            {"category":"weaponExperience","materials":[
+              {"materialId":"104011","materialName":"精锻用杂矿"},
+              {"materialId":"104012","materialName":"精锻用良矿"},
+              {"materialId":"104013","materialName":"精锻用魔矿"}]}
+            """);
+        Assert.Equal("weaponExperience", request.Category);
+        Assert.Equal(3, request.Materials.Length);
+    }
+    [Theory]
+    [InlineData("104013", "精锻用杂矿")]
+    [InlineData("202", "摩拉")]
+    [InlineData("114001", "高塔孤王的破瓦")]
+    public void ForeignOrCrossedResourceCannotEnterExperienceScan(string id, string name) =>
+        Assert.Throws<ArgumentException>(() => new BackpackInventoryRequest {
+            Category="weaponExperience",Materials=[new() {MaterialId=id,MaterialName=name}]}.Validate());
