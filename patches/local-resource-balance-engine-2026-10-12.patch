@@ -0,0 +1,51 @@
+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MoraSnapshotEvidenceTests
+{
+    private static MoraFrameEvidence Frame(long at, string raw = "12345678") => new(at, 1920, 1080, true, false,
+        [new("贵重道具", 143, 30, 105, 30)], "摩拉", .9, new(354, 1000, 37, 37),
+        new(397, 1000, 140, 40), [new(raw, 401, 1005, 113, 24)], raw);
+    [Fact]
+    public void NamedCoinFullIntegerAndTwoIndependentFramesAreRequired()
+    {
+        Assert.Equal(12345678, MoraSnapshotEvidence.Pair(Frame(1000), Frame(1300), 1400));
+        Assert.Null(MoraSnapshotEvidence.Pair(Frame(1000), Frame(1000), 1400));
+        Assert.Null(MoraSnapshotEvidence.Pair(Frame(1000), Frame(1300, "12345677"), 1400));
+        Assert.Null(MoraSnapshotEvidence.Pair(Frame(1000), Frame(1300), 3000));
+        Assert.Null(MoraSnapshotEvidence.Pair(Frame(1000), Frame(6500), 6600));
+    }
+    [Theory]
+    [InlineData("0", 0)]
+    [InlineData("12345678", 12345678)]
+    [InlineData("１２３４５６７８", 12345678)]
+    [InlineData("2147483647", 2147483647)]
+    public void CompleteNonnegativeIntegerParses(string raw, int expected) => Assert.Equal(expected, MoraSnapshotEvidence.ParseBalance(raw));
+    [Theory]
+    [InlineData("")]
+    [InlineData("12万")]
+    [InlineData("12,345,678")]
+    [InlineData("12345678/2000")]
+    [InlineData("余额12345678")]
+    [InlineData("123 45678")]
+    [InlineData("01")]
+    [InlineData("2147483648")]
+    public void UnknownOrAbbreviatedTextIsNeverZero(string raw) => Assert.Null(MoraSnapshotEvidence.ParseBalance(raw));
+    [Fact]
+    public void PrimogemWrongPageAndInsufficientCoinScoreNeverSupplyMora()
+    {
+        var f = Frame(1000);
+        foreach (var invalid in new[] {f with {IconName="原石"}, f with {IconScore=.74}, f with {IconScore=double.NaN},
+            f with {BackpackTabVerified=false}, f with {PromptVisible=true}, f with {HeaderRows=[new("武器", 143, 30, 80, 30)]},
+            f with {IconRegion=new(150,1000,37,37)}, f with {BalanceRows=[new("12345678",397,1005,140,24)]}})
+            Assert.Null(MoraSnapshotEvidence.Read(invalid));
+    }
+    [Fact]
+    public void OnlyObservedBottomMoraRegionsAndKnownRequestFieldsAreAccepted()
+    {
+        ReadMoraSnapshotTask.ParseRequest("{}").Validate();
+        Assert.Throws<ArgumentException>(() => new MoraSnapshotRequest {BalanceRegion=new(150,1000,140,40)}.Validate());
+        Assert.Throws<Newtonsoft.Json.JsonSerializationException>(() => ReadMoraSnapshotTask.ParseRequest("{\"x\":123}"));
+    }
+}
