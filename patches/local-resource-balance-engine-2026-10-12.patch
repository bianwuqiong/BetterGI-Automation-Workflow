+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class RecipeSlashPrivateImageTests(ITestOutputHelper output)
+{
+    [Theory]
+    [Trait("Fixture","PrivateRecipeCost")]
+    [InlineData(0)]
+    [InlineData(1)]
+    public void RetainedMicroRegionProvesSeparateInventoryAndFixedRecipeCost(int caseIndex)
+    {
+        var manifestPath=Environment.GetEnvironmentVariable("BGI_PRIVATE_RECIPE_FIXTURE_MANIFEST");
+        Assert.False(string.IsNullOrWhiteSpace(manifestPath),"An explicit ignored private fixture manifest is required; missing fixtures cannot pass.");
+        var manifest=Newtonsoft.Json.JsonConvert.DeserializeObject<PrivateManifest>(File.ReadAllText(manifestPath!));
+        Assert.NotNull(manifest);Assert.Equal(2,manifest.Cases.Length);
+        var fixture=manifest.Cases[caseIndex];
+        Assert.False(string.IsNullOrWhiteSpace(fixture.File));
+        Assert.True(fixture.ExpectedOriginalResin.HasValue && fixture.ExpectedOriginalResin is >=0 and <=200,
+            "A private expected inventory must be explicitly present; never default to zero.");
+        var file=Path.IsPathRooted(fixture.File)?fixture.File:Path.Combine(Path.GetDirectoryName(Path.GetFullPath(manifestPath!))!,fixture.File);
+        Assert.True(File.Exists(file));
+        using var image=Cv2.ImRead(file);
+        Assert.Equal(new Size(1538,895),image.Size());
+        using var nativeCrop=new Mat(image,new Rect(935,760,73,24));
+        using var ocr=new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),PaddleOcrService.PaddleOcrModelType.V6);
+        foreach(var width in new[]{1536,1920})
+        {
+            using var crop=new Mat();Cv2.Resize(nativeCrop,crop,new Size((int)Math.Round(73*width/1536d),(int)Math.Round(24*width/1536d)));
+            var reading=RecipeSlashCostEvidence.ReadCount(crop,ocr);
+            output.WriteLine("width={0}; {1}",width,Newtonsoft.Json.JsonConvert.SerializeObject(reading));
+            Assert.True(reading.Verified);Assert.Equal(fixture.ExpectedOriginalResin,reading.OriginalResin);Assert.Equal(60,reading.RecipeCost);
+            using var client=new Mat(image,new Rect(1,30,1536,864));using var full=new Mat();
+            Cv2.Resize(client,full,new Size(width,width*9/16));
+            using var capture=new ImageRegion(full.Clone(),0,0);
+            var production=GoToCraftingBenchTask.ReadProtectedRecipeCost(capture,ocr);
+            output.WriteLine("Full production reader width={0}; {1}",width,Newtonsoft.Json.JsonConvert.SerializeObject(production));
+            Assert.True(production.Verified);Assert.Equal(fixture.ExpectedOriginalResin,production.OriginalResin);Assert.Equal(60,production.RecipeCost);
+        }
+    }
+    private sealed class PrivateManifest {public PrivateCase[] Cases {get;set;}=[];}
+    private sealed class PrivateCase {public string File {get;set;}="";public int? ExpectedOriginalResin {get;set;}}
+}
