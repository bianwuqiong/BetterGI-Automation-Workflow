+    public void ExistingAscensionDefaultRemainsDistinctAndNullMaterialsFailCleanly()
+    {
+        new BackpackInventoryRequest {Materials=[new() {MaterialId="114001",MaterialName="高塔孤王的破瓦"}]}.Validate();
+        Assert.Throws<ArgumentException>(() => new BackpackInventoryRequest {
+            Materials=[new() {MaterialId="104013",MaterialName="精锻用魔矿"}]}.Validate());
+        Assert.Throws<ArgumentException>(() => new BackpackInventoryRequest {Category="weaponExperience",Materials=null!}.Validate());
+    }
+}
