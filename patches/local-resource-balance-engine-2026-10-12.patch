+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class MoraSnapshotPrivateImageTests(ITestOutputHelper output)
+{
+    [Theory]
+    [Trait("Fixture", "PrivateMora")]
+    [InlineData("valuable-mora-hover-1.png")]
+    [InlineData("valuable-mora-hover-2.png")]
+    public void RealLocalCoinMustBeClassifiedAsMoraByTheProductionModel(string file)
+    {
+        var directory=Environment.GetEnvironmentVariable("BETTERGI_PRIVATE_MORA_FIXTURE_DIR");
+        Assert.False(string.IsNullOrWhiteSpace(directory), "Provide retained private raw UI frames; missing images are not a pass.");
+        using var screenshot=Cv2.ImRead(Path.Combine(directory!,file));
+        Assert.Equal(new Size(1538,895),screenshot.Size());
+        using var client=new Mat(screenshot,new Rect(1,30,1536,864));
+        using var capture=new ImageRegion(client.Clone(),0,0);
+        using var recognizer=new ItemRecognizer();
+        var candidate=ReadMoraSnapshotTask.ReadCoinCandidate(capture,new MoraSnapshotRequest(),recognizer);
+        output.WriteLine("Actual Mora coin model name={0}; score={1:R}",candidate.Name,candidate.Score);
+        Assert.Equal("摩拉",candidate.Name);
+        Assert.True(candidate.Score>=.75,"The actual small currency icon must independently meet the identity threshold.");
+    }
+}
