+using System;
+using System.Collections.Concurrent;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.Core.Simulator.Extensions;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Element.Assets;
+using BetterGenshinImpact.GameTask.Model.Area;
+using BetterGenshinImpact.GameTask.Model.GameUI;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+/// <summary>Read the precious-items page's actual Mora coin and balance; no confirmation, spending or refill inputs.</summary>
+public sealed class ReadMoraSnapshotTask
+{
+    private static readonly JsonSerializerSettings JsonSettings = new() {
+        ContractResolver = new CamelCasePropertyNamesContractResolver(), MissingMemberHandling = MissingMemberHandling.Error };
+    public static MoraSnapshotRequest ParseRequest(string json)
+    {
+        var request = JsonConvert.DeserializeObject<MoraSnapshotRequest>(json, JsonSettings)
+            ?? throw new ArgumentException("Empty Mora snapshot request.");
+        request.Validate(); return request;
+    }
+    private static bool Page(ImageRegion image)
+    {
+        using var marker = image.Find(ElementRecognition.Get("BagPreciousItemChecked", image));
+        return marker.IsExist() && !Bv.IsInPromptDialog(image) && !Bv.IsInRevivePrompt(image);
+    }
+    public async Task<string> Start(MoraSnapshotRequest request, CancellationToken ct)
+    {
+        request.Validate(); bool opened = false, restored = false;
+        int? balance = null; MoraFrameEvidence? first = null, second = null;
+        string reason = "unverified";
+        var saved = new ConcurrentDictionary<string, ITaskTrigger>(GameTaskManager.TriggerDictionary ?? new());
+        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(20));
+        try
+        {
+            TaskTriggerDispatcher.Instance().ClearTriggers(); Simulation.ReleaseAllKey();
+            for (int i = 0; i < 2; i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                if (!SystemControl.IsGenshinImpactActiveByProcess() || !ReadBackpackInventoryTask.World(frame))
+                    throw new InvalidOperationException("Mora snapshot needs fresh outside-world frames.");
+                await Task.Delay(200, timeout.Token);
+            }
+            timeout.Token.ThrowIfCancellationRequested();
+            Simulation.SendInput.SimulateAction(GIActions.OpenInventory); opened = true;
+            await Task.Delay(800, timeout.Token);
+            bool selected = false;
+            for (int i = 0; i < 8; i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+                if (!SystemControl.IsGenshinImpactActiveByProcess()) throw new InvalidOperationException("Game focus changed.");
+                if (Bv.IsInPromptDialog(frame) || Bv.IsInRevivePrompt(frame)) throw new InvalidOperationException("Unknown inventory dialog.");
+                if (Page(frame)) { selected = true; break; }
+                using var tab = frame.Find(ElementRecognition.Get("BagPreciousItemUnchecked", frame));
+                if (tab.IsExist()) { timeout.Token.ThrowIfCancellationRequested(); tab.Click(); }
+                await Task.Delay(250, timeout.Token);
+            }
+            if (!selected) throw new InvalidOperationException("Precious-items page unverified.");
+            using var recognizer = new ItemRecognizer();
+            using (var frame = TaskControl.CaptureToRectArea(forceNew: true))
+                frame.MoveTo(frame.Width / 2, frame.Height - 40); // Removes cursor occlusion; no click.
+            await Task.Delay(200, timeout.Token);
+            for (int i = 0; i < 5; i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                second = ReadFrame(request, recognizer, timeout.Token);
+                balance = MoraSnapshotEvidence.Pair(first, second, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
+                if (balance.HasValue) { reason = "stable_precious_page_mora_model_and_integer"; break; }
+                first = second; await Task.Delay(250, timeout.Token);
+            }
+            if (!balance.HasValue) reason = "mora_icon_or_full_integer_pair_unverified";
+        }
+        catch (Exception ex)
+        {
+            balance = null; reason = ex is OperationCanceledException ? "observation_timeout_or_cancelled" : ex.Message;
+        }
+        finally
+        {
+            try { restored = await ReadBackpackInventoryTask.Restore(opened, "preciousItems"); }
+            catch { restored = false; }
+            Simulation.ReleaseAllKey(); TaskTriggerDispatcher.Instance().ClearTriggers();
+            GameTaskManager.TriggerDictionary = saved;
+            TaskTriggerDispatcher.Instance().SetTriggers(saved.Values.OrderByDescending(t => t.Priority).ToList());
+        }
+        ct.ThrowIfCancellationRequested();
+        if (!restored) { balance = null; reason += "; world_restore_unverified"; }
+        return JsonConvert.SerializeObject(new {
+            source = "precious_items_bottom_mora", readOnly = true, status = balance.HasValue ? "verified" : "unknown",
+            materialId = "202", materialName = "摩拉", balance, verified = balance.HasValue && restored,
+            observedAt = balance.HasValue && second is not null ? DateTimeOffset.FromUnixTimeMilliseconds(second.ObservedAt).ToString("O") : null,
+            mainUiRestored = restored, cleanupCompleted = restored, reason, first, second
+        }, JsonSettings);
+    }
+    internal static MoraFrameEvidence ReadFrame(MoraSnapshotRequest request, ItemRecognizer recognizer, CancellationToken ct)
+    {
+        using var frame = TaskControl.CaptureToRectArea(forceNew: true);
+        long at = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(); ct.ThrowIfCancellationRequested();
+        if (!SystemControl.IsGenshinImpactActiveByProcess()) throw new InvalidOperationException("Game focus changed.");
+        var iconRect = MoraSnapshotRequest.Scale(request.IconRegion, frame.Width);
+        var balanceRect = MoraSnapshotRequest.Scale(request.BalanceRegion, frame.Width);
+        var candidate = ReadCoinCandidate(frame, request, recognizer);
+        using var amount = frame.DeriveCrop(balanceRect);
+        var raw = OcrFactory.Paddle.OcrWithoutDetector(amount.SrcMat);
+        BackpackOcrRow[] Rows(Rect rect)
+        {
+            using var crop = frame.DeriveCrop(rect);
+            return OcrFactory.Paddle.OcrResult(crop.SrcMat).Regions.Select(r => {
+                var b = r.Rect.BoundingRect(); return new BackpackOcrRow(r.Text, b.X + rect.X, b.Y + rect.Y, b.Width, b.Height);
+            }).ToArray();
+        }
+        var headerRect = MoraSnapshotRequest.Scale(new(100, 0, 350, 100), frame.Width);
+        var header = Rows(headerRect); var numbers = Rows(balanceRect); ct.ThrowIfCancellationRequested();
+        return new(at, frame.Width, frame.Height, Page(frame), Bv.IsInPromptDialog(frame) || Bv.IsInRevivePrompt(frame),
+            header, candidate.Name, candidate.Score, BackpackRect.From(iconRect), BackpackRect.From(balanceRect), numbers, raw);
+    }
+    internal static ItemIconCandidate ReadCoinCandidate(ImageRegion frame, MoraSnapshotRequest request, ItemRecognizer recognizer)
+    {
+        using var coin = frame.DeriveCrop(MoraSnapshotRequest.Scale(request.IconRegion, frame.Width));
+        using var normalized = coin.SrcMat.Resize(new Size(125, 125));
+        return recognizer.Match(normalized);
+    }
+}
diff --git a/BetterGenshinImpact/GameTask/Common/Job/RecipeSlashCostEvidence.cs b/BetterGenshinImpact/GameTask/Common/Job/RecipeSlashCostEvidence.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/RecipeSlashCostEvidence.cs
@@ -0,0 +1,60 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Helpers;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+public sealed record RecipeSlashEvidence(bool Verified, Rect Bounds, double Correlation, int InkPixels);
+public sealed record RecipeCostReading(bool Verified, int? OriginalResin, int? RecipeCost,
+    string RawWhole, string RawNumerator, string RawDenominator, RecipeSlashEvidence Slash);
+
+/// <summary>Geometric slash proof plus separately cropped complete numerator and denominator, never digit replacement.</summary>
+public static class RecipeSlashCostEvidence
+{
+    public static RecipeSlashEvidence FindSlash(Mat count)
+    {
+        using var gray = count.Channels()==1 ? count.Clone() : count.CvtColor(ColorConversionCodes.BGR2GRAY);
+        using var ink = gray.Threshold(140,255,ThresholdTypes.BinaryInv);
+        using var labels=new Mat(); using var stats=new Mat(); using var centroids=new Mat();
+        int n=Cv2.ConnectedComponentsWithStats(ink,labels,stats,centroids);
+        var candidates=new List<RecipeSlashEvidence>();
+        for(int k=1;k<n;k++)
+        {
+            int x=stats.At<int>(k,0), y=stats.At<int>(k,1), w=stats.At<int>(k,2), h=stats.At<int>(k,3), area=stats.At<int>(k,4);
+            if(w<2 || h<6 || h/(double)w is <1.5 or >5 || area<6 || x<count.Width*.2 || x+w>count.Width*.85)continue;
+            var points=new List<Point>();
+            for(int yy=y;yy<y+h;yy++)for(int xx=x;xx<x+w;xx++)if(labels.At<int>(yy,xx)==k)points.Add(new(xx,yy));
+            double mx=points.Average(p=>p.X), my=points.Average(p=>p.Y);
+            double vx=0,vy=0,cov=0;
+            foreach(var p in points){vx+=(p.X-mx)*(p.X-mx);vy+=(p.Y-my)*(p.Y-my);cov+=(p.X-mx)*(p.Y-my);}
+            double correlation=vx*vy>0?cov/Math.Sqrt(vx*vy):0;
+            if(correlation<=-.75)candidates.Add(new(true,new(x,y,w,h),correlation,area));
+        }
+        return candidates.Count==1?candidates[0]:new(false,new(),0,0);
+    }
+    public static RecipeCostReading ReadCount(Mat count, IOcrService ocr)
+    {
+        var slash=FindSlash(count);
+        var whole=ocr.OcrWithoutDetector(count).Trim();
+        if(!slash.Verified)return new(false,null,null,whole,"","",slash);
+        var b=slash.Bounds;int pad=Math.Max(2,count.Width/30);
+        int y=Math.Max(0,b.Y-pad), bottom=Math.Min(count.Height,b.Bottom+pad);
+        int leftEnd=b.X-1, rightStart=b.Right+1;
+        if(leftEnd<8 || rightStart>=count.Width-8)return new(false,null,null,whole,"","",slash);
+        using var numerator=new Mat(count,new Rect(0,y,leftEnd,bottom-y));
+        using var denominator=new Mat(count,new Rect(rightStart,y,count.Width-rightStart,bottom-y));
+        using var largeNumerator=numerator.Resize(new Size(numerator.Width*4,numerator.Height*4),0,0,InterpolationFlags.Cubic);
+        using var largeDenominator=denominator.Resize(new Size(denominator.Width*4,denominator.Height*4),0,0,InterpolationFlags.Cubic);
+        var num=StringUtils.ConvertFullWidthNumToHalfWidth(ocr.OcrWithoutDetector(largeNumerator)).Trim();
+        var den=StringUtils.ConvertFullWidthNumToHalfWidth(ocr.OcrWithoutDetector(largeDenominator)).Trim();
+        var original=ParseNumerator(num);
+        bool verified=original.HasValue && den=="60";
+        return new(verified,verified?original:null,verified?60:null,whole,num,den,slash);
+    }
+    public static int? ParseNumerator(string raw) => Regex.IsMatch(raw,@"\A(?:0|[1-9][0-9]{0,2})\z") &&
+        int.TryParse(raw,out var value) && value<=200 ? value : null;
+}
