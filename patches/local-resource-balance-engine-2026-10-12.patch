+using BetterGenshinImpact.GameTask.Common.Job;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class RecipeSlashCostEvidenceTests
+{
+    [Fact]
+    public void SlantedSlashPixelsAreIndependentOfTheMisreadWholeText()
+    {
+        using var image=new Mat(25,75,MatType.CV_8UC3,Scalar.All(235));
+        Cv2.Line(image,new Point(33,19),new Point(39,6),Scalar.All(20),2);
+        var slash=RecipeSlashCostEvidence.FindSlash(image);
+        Assert.True(slash.Verified);Assert.True(slash.Correlation<-.75);
+    }
+    [Fact]
+    public void AVerticalOneBlankOrMultipleSlashDoesNotProveASeparator()
+    {
+        using var image=new Mat(25,75,MatType.CV_8UC3,Scalar.All(235));
+        Cv2.Line(image,new Point(35,19),new Point(35,6),Scalar.All(20),2);
+        Assert.False(RecipeSlashCostEvidence.FindSlash(image).Verified);
+        image.SetTo(Scalar.All(235));Assert.False(RecipeSlashCostEvidence.FindSlash(image).Verified);
+        Cv2.Line(image,new Point(30,19),new Point(36,6),Scalar.All(20),2);
+        Cv2.Line(image,new Point(47,19),new Point(53,6),Scalar.All(20),2);
+        Assert.False(RecipeSlashCostEvidence.FindSlash(image).Verified);
+    }
+    [Theory]
+    [InlineData("73",73)]
+    [InlineData("0",0)]
+    [InlineData("200",200)]
+    [InlineData("73160",null)]
+    [InlineData("201",null)]
+    [InlineData("7 3",null)]
+    public void NumeratorCropNeedsItsOwnCompleteCount(string text,int? expected) =>
+        Assert.Equal(expected,RecipeSlashCostEvidence.ParseNumerator(text));
+}
