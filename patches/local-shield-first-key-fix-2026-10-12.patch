+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/ProtectedShieldSwitchPolicyTests.cs
@@ -0,0 +1,49 @@
+using BetterGenshinImpact.GameTask.AutoFight.Model;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class ProtectedShieldSwitchPolicyTests
+{
+    [Fact] public void NoPreviousKeyAllowsTheFirstKnownOtherSlotRequest()
+    {
+        Assert.True(ProtectedShieldSwitchPolicy.ShouldRequestTarget(true,false,1,1,4,100,null));
+        Assert.False(MaterialSwitchTimingPolicy.ShouldRetryTarget(true,1,4,100,-1000));
+    }
+    [Fact] public void PendingTargetWaitsButPendingOtherRequestsTheTarget()
+    {
+        Assert.False(ProtectedShieldSwitchPolicy.ShouldRequestTarget(true,false,-2,4,4,100,null));
+        Assert.True(ProtectedShieldSwitchPolicy.ShouldRequestTarget(true,false,-2,1,4,100,null));
+        Assert.False(ProtectedShieldSwitchPolicy.ShouldRequestTarget(true,false,-2,-1,4,100,null));
+    }
+    [Theory]
+    [InlineData(false,false,1,1,4,100,null,false)]
+    [InlineData(true,true,1,1,4,100,null,false)]
+    [InlineData(true,false,4,4,4,100,null,false)]
+    [InlineData(true,false,1,1,0,100,null,false)]
+    [InlineData(true,false,1,1,5,100,null,false)]
+    [InlineData(true,false,1,1,4,5000,null,false)]
+    [InlineData(true,false,1,1,4,-1,null,false)]
+    [InlineData(true,false,1,1,4,1100,100L,true)]
+    [InlineData(true,false,1,1,4,1099,100L,false)]
+    [InlineData(true,false,1,1,4,1100,-1L,false)]
+    public void FocusSceneGeometryDeadlineAndOneSecondCadenceRemainRequired(bool ready,bool changed,int active,
+        int candidate,int target,long elapsed,long? prior,bool expected)=>
+        Assert.Equal(expected,ProtectedShieldSwitchPolicy.ShouldRequestTarget(ready,changed,active,candidate,target,elapsed,prior));
+    [Fact] public void OtherToTargetSequenceRequestsOnceAndRequiresTwoNewTargetObservations()
+    {
+        var context=new AvatarActiveCheckContext{StrictIdentity=true};int presses=0;long? last=null;
+        var active=context.ObserveStrictCandidate(1);Assert.Equal(-2,active);
+        Assert.True(ProtectedShieldSwitchPolicy.RequestIfDue(true,false,active,1,4,100,last,context,()=>presses++));last=100;
+        active=context.ObserveStrictCandidate(4);Assert.Equal(-2,active);
+        Assert.False(ProtectedShieldSwitchPolicy.RequestIfDue(true,false,active,4,4,1500,last,context,()=>presses++));
+        Assert.Equal(4,context.ObserveStrictCandidate(4));Assert.Equal(1,presses);
+    }
+    [Fact] public void RetryOfStillOtherSlotClearsPreRequestCandidateAgain()
+    {
+        var context=new AvatarActiveCheckContext{StrictIdentity=true};int presses=0;
+        context.ObserveStrictCandidate(1);Assert.Equal(1,context.ObserveStrictCandidate(1));
+        Assert.True(ProtectedShieldSwitchPolicy.RequestIfDue(true,false,1,1,4,1500,100,context,()=>presses++));
+        Assert.Equal(-2,context.ObserveStrictCandidate(4));Assert.Equal(4,context.ObserveStrictCandidate(4));
+        Assert.Equal(1,presses);
+    }
+}
