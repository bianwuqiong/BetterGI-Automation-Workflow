diff --git a/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldSwitchPolicy.cs b/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldSwitchPolicy.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/AutoFight/Model/ProtectedShieldSwitchPolicy.cs
@@ -0,0 +1,26 @@
+using System;
+
+namespace BetterGenshinImpact.GameTask.AutoFight.Model;
+
+/// <summary>Protected HUD already proved; no-key-yet is distinct from a prior key timestamp.</summary>
+public static class ProtectedShieldSwitchPolicy
+{
+    public static bool ShouldRequestTarget(bool ready,bool geometryChanged,int active,int strictCandidate,
+        int target,long elapsedMs,long? lastPressMs)
+    {
+        if(!ready || geometryChanged || target is <1 or >4 || active==target ||
+            !MaterialSwitchTimingPolicy.IdentityWindowOpen(elapsedMs))return false;
+        // Only an unconfirmed target candidate needs another frame before any new key.
+        // A unique first candidate of another slot does not prove the requested target.
+        if(active==-2 && (strictCandidate==target || strictCandidate is <1 or >4))return false;
+        return !lastPressMs.HasValue || lastPressMs.Value>=0 && elapsedMs-lastPressMs.Value>=1000;
+    }
+    public static bool RequestIfDue(bool ready,bool geometryChanged,int active,int strictCandidate,
+        int target,long elapsedMs,long? lastPressMs,AvatarActiveCheckContext context,Action press)
+    {
+        if(!context.StrictIdentity)throw new ArgumentException("Protected switch requires strict identity.");
+        if(!ShouldRequestTarget(ready,geometryChanged,active,strictCandidate,target,elapsedMs,lastPressMs))return false;
+        context.ResetStrictCandidate(); // A pre-key candidate can never satisfy post-key target verification.
+        press();return true;
+    }
+}
diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/ProtectedShieldSwitchPolicyTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/ProtectedShieldSwitchPolicyTests.cs
