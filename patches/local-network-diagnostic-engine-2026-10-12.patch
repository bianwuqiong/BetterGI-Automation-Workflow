+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/NetworkDisconnectPrivateImageTests.cs
@@ -0,0 +1,32 @@
+using BetterGenshinImpact.Core.Recognition.OCR.Paddle;
+using BetterGenshinImpact.Core.Recognition.ONNX;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+using Xunit.Abstractions;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class NetworkDisconnectPrivateImageTests(ITestOutputHelper output)
+{
+    [Fact]
+    [Trait("Fixture","PrivateNetworkDisconnect")]
+    public void ActualRetainedDisconnectModalUsesProductionReaderWithoutAnyInput()
+    {
+        var directory=Environment.GetEnvironmentVariable("BETTERGI_PRIVATE_NETWORK_FIXTURE_DIR");
+        Assert.False(string.IsNullOrWhiteSpace(directory),"Retained private frame is required; missing image is not a pass.");
+        using var screenshot=Cv2.ImRead(Path.Combine(directory!,"disconnect-during-shield-proof.png"));
+        Assert.Equal(new Size(1538,895),screenshot.Size());
+        using var client=new Mat(screenshot,new Rect(1,30,1536,864));
+        using var ocr=new PaddleOcrService(new BgiOnnxFactory(new FakeLogger<BgiOnnxFactory>()),PaddleOcrService.PaddleOcrModelType.V6);
+        foreach(var width in new[]{1536,1920})
+        {
+            using var scaled=new Mat();Cv2.Resize(client,scaled,new Size(width,width*9/16));
+            using var capture=new ImageRegion(scaled.Clone(),0,0);
+            var frame=ReadGameNetworkSnapshotTask.ReadFrame(capture,ocr,Bv.IsInPromptDialog(capture),1000);
+            output.WriteLine(Newtonsoft.Json.JsonConvert.SerializeObject(frame));
+            Assert.True(NetworkDisconnectEvidence.Positive(frame));
+        }
+    }
+}
