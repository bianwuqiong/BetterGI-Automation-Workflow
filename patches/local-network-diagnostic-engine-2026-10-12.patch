+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/NetworkDisconnectEvidenceTests.cs
@@ -0,0 +1,32 @@
+using BetterGenshinImpact.GameTask.Common.Job;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class NetworkDisconnectEvidenceTests
+{
+    private static NetworkDisconnectFrame Frame(long at) => new(at,1920,1080,true,"连接已断开","连接超时");
+    [Fact]
+    public void CompleteModalAndTwoIndependentFreshFramesClassifyOnlyTheDisconnect()
+    {
+        Assert.True(NetworkDisconnectEvidence.Pair(Frame(1000),Frame(1300),1400));
+        Assert.False(NetworkDisconnectEvidence.Pair(Frame(1000),Frame(1000),1400));
+        Assert.False(NetworkDisconnectEvidence.Pair(Frame(1000),Frame(1300),3000));
+        Assert.False(NetworkDisconnectEvidence.Pair(Frame(1000),Frame(6300),6400));
+        Assert.False(NetworkDisconnectEvidence.Pair(Frame(1000),null,1400));
+    }
+    [Theory]
+    [InlineData("连接成功","连接超时")]
+    [InlineData("是否退出秘境","连接超时")]
+    [InlineData("连接已断开","是否使用脆弱树脂")]
+    [InlineData("连接已断开","可能连接超时")]
+    [InlineData("连接已断开","连接超时确认")]
+    public void PartialOrForeignDialogDoesNotAuthorizeNetworkClassification(string title,string body) =>
+        Assert.False(NetworkDisconnectEvidence.Positive(Frame(1000) with {Header=title,Body=body}));
+    [Fact]
+    public void PromptMarkerAndAspectRatioRemainRequired()
+    {
+        Assert.False(NetworkDisconnectEvidence.Positive(Frame(1000) with {PromptDialog=false}));
+        Assert.False(NetworkDisconnectEvidence.Positive(Frame(1000) with {Width=1280,Height=800}));
+        Assert.True(NetworkDisconnectEvidence.Positive(Frame(1000) with {Header="连接已 断开",Body="连接 超时"}));
+    }
+}
