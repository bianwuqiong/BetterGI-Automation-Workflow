diff --git a/BetterGenshinImpact/GameTask/Common/Job/ReadGameNetworkSnapshotTask.cs b/BetterGenshinImpact/GameTask/Common/Job/ReadGameNetworkSnapshotTask.cs
new file mode 100644
--- /dev/null
+++ b/BetterGenshinImpact/GameTask/Common/Job/ReadGameNetworkSnapshotTask.cs
@@ -0,0 +1,75 @@
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.Common.Job;
+
+public sealed record NetworkDisconnectFrame(long ObservedAt, int Width, int Height, bool PromptDialog,
+    string Header, string Body);
+public sealed record GameNetworkSnapshot(string Status, bool ReadOnly, bool EvidenceVerified,
+    bool ConnectivityVerified, string? ObservedAt, NetworkDisconnectFrame? First, NetworkDisconnectFrame? Second,
+    string Reason);
+
+public static class NetworkDisconnectEvidence
+{
+    public static bool Positive(NetworkDisconnectFrame f) => f.Width>=800 && f.Width*9==f.Height*16 &&
+        f.PromptDialog && f.ObservedAt>=0 && BackpackInventoryEvidenceSafety.Normalize(f.Header)=="连接已断开" &&
+        BackpackInventoryEvidenceSafety.Normalize(f.Body)=="连接超时";
+    public static bool Pair(NetworkDisconnectFrame? first, NetworkDisconnectFrame? second, long now) =>
+        first is not null && second is not null && Positive(first) && Positive(second) &&
+        first.Width==second.Width && first.Height==second.Height && second.ObservedAt>first.ObservedAt &&
+        second.ObservedAt-first.ObservedAt<=5000 && now>=second.ObservedAt && now-second.ObservedAt<=1500;
+}
+
+/// <summary>Only observes the complete disconnect modal. Does not reconnect, confirm, move or consume.</summary>
+public sealed class ReadGameNetworkSnapshotTask
+{
+    public static string Serialize(GameNetworkSnapshot result) => JsonConvert.SerializeObject(result,
+        new JsonSerializerSettings {ContractResolver=new CamelCasePropertyNamesContractResolver()});
+    public async Task<GameNetworkSnapshot> Start(CancellationToken ct)
+    {
+        NetworkDisconnectFrame? first=null,second=null;
+        using var timeout=CancellationTokenSource.CreateLinkedTokenSource(ct);
+        timeout.CancelAfter(TimeSpan.FromSeconds(5));
+        try
+        {
+            for(int i=0;i<3;i++)
+            {
+                timeout.Token.ThrowIfCancellationRequested();
+                using var frame=TaskControl.CaptureToRectArea(forceNew:true);
+                if(!SystemControl.IsGenshinImpactActiveByProcess())return Result("unknown",false,"game_not_focused");
+                var hasDialog=Bv.IsInPromptDialog(frame);
+                second=ReadFrame(frame,OcrFactory.Paddle,hasDialog,DateTimeOffset.UtcNow.ToUnixTimeMilliseconds());
+                timeout.Token.ThrowIfCancellationRequested();
+                if(NetworkDisconnectEvidence.Pair(first,second,DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()))
+                    return Result("blocked_network",true,"complete_disconnect_and_timeout_modal_pair");
+                // No modal is an absence observation only, never proof of online connectivity.
+                if(i>0 && first?.PromptDialog==false && !hasDialog)
+                    return Result("not_observed",false,"disconnect_modal_not_observed_connectivity_unverified");
+                first=second; await Task.Delay(250,timeout.Token);
+            }
+            return Result("unknown",false,"modal_text_pair_unverified");
+        }
+        catch(OperationCanceledException) when(!ct.IsCancellationRequested) {return Result("unknown",false,"observation_timeout");}
+        catch(OperationCanceledException){throw;}
+        catch(Exception ex){return Result("unknown",false,"observation_failed:"+ex.GetType().Name);}
+        GameNetworkSnapshot Result(string status,bool verified,string reason) => new(status,true,verified,false,
+            verified && second is not null?DateTimeOffset.FromUnixTimeMilliseconds(second.ObservedAt).ToString("O"):null,
+            first,second,reason);
+    }
+    internal static NetworkDisconnectFrame ReadFrame(ImageRegion frame, IOcrService ocr, bool prompt, long at)
+    {
+        if(!prompt)return new(at,frame.Width,frame.Height,false,"","");
+        Rect Scaled(int x,int y,int w,int h)=>new((int)Math.Round(x*frame.Width/1920d),(int)Math.Round(y*frame.Width/1920d),
+            (int)Math.Round(w*frame.Width/1920d),(int)Math.Round(h*frame.Width/1920d));
+        using var header=frame.DeriveCrop(Scaled(740,260,450,80));
+        using var body=frame.DeriveCrop(Scaled(780,460,360,110));
+        return new(at,frame.Width,frame.Height,true,ocr.Ocr(header.SrcMat).Trim(),ocr.Ocr(body.SrcMat).Trim());
+    }
+}
