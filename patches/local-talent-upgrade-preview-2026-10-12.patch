+using System;
+using System.Linq;
+using System.Text;
+using System.Text.RegularExpressions;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+public sealed record UpgradePreviewRow(string Text,Rect Bounds);
+public sealed record UpgradePreviewRatio(long ObservedAt,string Raw,Rect Bounds,int? Owned,int? Required,bool Complete,
+    bool SlashPixelVerified=false,string NumeratorRaw="",string DenominatorRaw="")
+{
+    public int Width{get;init;}public int Height{get;init;}public string DetectorRaw{get;init;}="";
+    public UpgradePreviewRow[] OcrRows{get;init;}=[];
+    public Rect? SlashBounds{get;init;}public double SlashCorrelation{get;init;}public int SlashInkPixels{get;init;}
+    public Rect? NumeratorRegion{get;init;}public Rect? DenominatorRegion{get;init;}
+    public UpgradePreviewRow[] NumeratorRows{get;init;}=[];public UpgradePreviewRow[] DenominatorRows{get;init;}=[];
+    public int SplitOcrScale{get;init;}public string Prefix{get;init;}="";
+}
+public sealed record UpgradePreviewMaterial(string Name,double IconScore,Rect Card,UpgradePreviewRatio Quantity)
+{public Rect IconRegion{get;init;}}
+public sealed record UpgradePreviewDetail(long ObservedAt,bool Page,string Type,string Title,int? DisplayLevel,int? BaseLevel)
+{
+    public int Width{get;init;}public int Height{get;init;}public Rect TypeRegion{get;init;}public Rect TitleRegion{get;init;}
+    public UpgradePreviewRow[] TypeRows{get;init;}=[];public UpgradePreviewRow[] TitleRows{get;init;}=[];
+    public Rect LevelRegion{get;init;}public string LevelRaw{get;init;}="";public UpgradePreviewRow[] LevelRows{get;init;}=[];
+    public Rect ColorSampleRegion{get;init;}public Rect GlyphRegion{get;init;}public string GlyphColor{get;init;}="Unknown";
+    public int BrightPixels{get;init;}public int NeutralPixels{get;init;}public int CyanPixels{get;init;}public int DarkConflicts{get;init;}
+    public Rect BonusRegion{get;init;}public string BonusRaw{get;init;}="";public bool? HasFixedPlusThree{get;init;}
+}
+public sealed record UpgradePreviewFrame(long ObservedAt,bool Page,int? Current,int? Next,
+    UpgradePreviewMaterial[] Materials,UpgradePreviewRatio Mora,string CoinName,double CoinScore,UpgradePreviewRow[] Rows)
+{
+    public int Width{get;init;}public int Height{get;init;}public Rect MarkerRegion{get;init;}public Rect CoinRegion{get;init;}
+    public Rect CurrentLevelRegion{get;init;}public Rect NextLevelRegion{get;init;}
+    public UpgradePreviewRow[] CurrentLevelRows{get;init;}=[];public UpgradePreviewRow[] NextLevelRows{get;init;}=[];
+    public string CurrentLevelRaw{get;init;}="";public string NextLevelRaw{get;init;}="";
+}
