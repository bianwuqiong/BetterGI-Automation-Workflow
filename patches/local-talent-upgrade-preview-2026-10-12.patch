+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using BetterGenshinImpact.Core.Recognition;
+using BetterGenshinImpact.Core.Config;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.Core.Simulator;
+using BetterGenshinImpact.GameTask.Common.BgiVision;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using Microsoft.Extensions.Logging;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Serialization;
+using OpenCvSharp;
+using Vanara.PInvoke;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+/// <summary>Only navigation, read-only preview/card tooltips and recognized-page Escape. Never final confirmation.</summary>
+public sealed class InspectTalentUpgradeTask
+{
+    private readonly ILogger logger=App.GetLogger<InspectTalentUpgradeTask>();
+    private readonly List<object> frames=[];
+    private string official="";
+    private string type="";
+    private CancellationToken token;
+    private bool opened;
+    private UpgradePreviewDetail? selectedDetail;
+    private static long Now()=>DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+    private ImageRegion Capture()
+    {
+        token.ThrowIfCancellationRequested();var frame=Common.TaskControl.CaptureToRectArea(forceNew:true);
+        if(!SystemControl.IsGenshinImpactActiveByProcess()||Bv.IsInRevivePrompt(frame))
+        {frame.Dispose();throw new InvalidOperationException("game_focus_or_revive_blocked");}
+        return frame;
+    }
+    private static bool Overview(ImageRegion frame)
+    {using var found=frame.Find(CharacterDevelopmentAssets.Get(frame.Width,frame.Height).MenuRo);return found.IsExist();}
+    private static bool World(ImageRegion frame)=>ReadBackpackInventoryTask.World(frame)&&!Bv.IsInPromptDialog(frame)&&!Bv.IsInAnyClosableUi(frame);
+    private async Task Delay(int ms=250)=>await Task.Delay(ms,token);
+    private UpgradePreviewDetail Detail()
+    {using var frame=Capture();var read=TalentUpgradePreviewReader.Detail(frame,OcrFactory.Paddle,Now());frames.Add(read);return read;}
+    private async Task<(UpgradePreviewDetail First,UpgradePreviewDetail Second)> DetailPair()
+    {
+        var first=Detail();await Delay();var second=Detail();
+        if(!TalentUpgradePreviewEvidence.DetailPair(first,second,type,Now()))throw new InvalidOperationException("detail_identity_pair_unverified");
+        return(first,second);
+    }
+    private async Task<(UpgradePreviewFrame First,UpgradePreviewFrame Second)> PreviewPair(ItemRecognizer recognizer,int level)
+    {
+        UpgradePreviewFrame Read(){using var frame=Capture();var read=TalentUpgradePreviewReader.Preview(frame,OcrFactory.Paddle,recognizer,Now());frames.Add(read);return read;}
+        var first=Read();await Delay();var second=Read();
+        if(!TalentUpgradePreviewEvidence.PreviewPair(first,second,level,Now()))throw new InvalidOperationException("upgrade_preview_pair_unverified");
+        return(first,second);
+    }
+    private async Task ClickKnownText(string text,Rect reference)
+    {
+        token.ThrowIfCancellationRequested();using var frame=Capture();
+        if(text=="天赋")
+        {
+            if(!Overview(frame)||TalentUpgradePreviewEvidence.Normalize(CharacterSelectionHelper.ReadSelectedName(frame,frame.Width/1920d))!=official)
+                throw new InvalidOperationException("fresh_selected_character_before_navigation_unverified");
+        }
+        else if(text=="升级")
+        {
+            var detail=TalentUpgradePreviewReader.Detail(frame,OcrFactory.Paddle,Now());
+            if(selectedDetail is null||!detail.Page||detail.Type!=type||detail.Title!=selectedDetail.Title||detail.BaseLevel!=selectedDetail.BaseLevel)
+                throw new InvalidOperationException("fresh_talent_detail_before_preview_unverified");
+        }
+        else throw new InvalidOperationException("unsupported_read_only_navigation_label");
+        var roi=TalentUpgradePreviewReader.Scale(reference,frame.Width);
+        var matches=TalentUpgradePreviewReader.Rows(frame,reference,OcrFactory.Paddle)
+            .Where(r=>TalentUpgradePreviewEvidence.Normalize(r.Text)==text).ToArray();
+        if(matches.Length!=1 || matches[0].Bounds.Width<=0 || matches[0].Bounds.Height<=0 ||
+            matches[0].Bounds.X<roi.X || matches[0].Bounds.Right>roi.Right || matches[0].Bounds.Y<roi.Y || matches[0].Bounds.Bottom>roi.Bottom)
+            throw new InvalidOperationException("unique_navigation_label_unverified");
+        frame.ClickTo(matches[0].Bounds.X+matches[0].Bounds.Width/2,matches[0].Bounds.Y+matches[0].Bounds.Height/2);
+        await Delay(500);
+    }
+    private async Task OpenTalent()
+    {
+        await ClickKnownText("天赋",new(0,80,370,900));
+        Point[] Read(){using var frame=Capture();
+            if(!Overview(frame)||Bv.IsInPromptDialog(frame))throw new InvalidOperationException("talent_list_page_unverified");
+            var rows=TalentUpgradePreviewReader.Rows(frame,new(1536,0,384,900),OcrFactory.Paddle)
+                .Where(r=>CharacterDevelopmentStateMachineTask.TryParseTalentLevel(r.Text,out _))
+                .OrderBy(r=>r.Bounds.Y).ToArray();
+            return rows.Select(r=>new Point(r.Bounds.X+r.Bounds.Width/2,r.Bounds.Y+r.Bounds.Height/2)).ToArray();}
+        var first=Read();await Delay();var second=Read();
+        if(first.Length!=3||second.Length!=3||first.Zip(second).Any(p=>Math.Abs(p.First.Y-p.Second.Y)>6))
+            throw new InvalidOperationException("three_combat_talent_entries_pair_unverified");
+        int index=type switch{"普通攻击"=>0,"元素战技"=>1,_=>2};
+        using var frame=Capture();if(!Overview(frame)||Bv.IsInPromptDialog(frame))throw new InvalidOperationException("fresh_talent_list_before_click_unverified");
+        frame.ClickTo(second[index].X,second[index].Y);await Delay(500);
+    }
+    private async Task<UpgradePreviewTooltip[]> Tooltip(UpgradePreviewMaterial material)
+    {
+        using(var frame=Capture())
+        {
+            if(!TalentUpgradePreviewReader.PreviewPage(TalentUpgradePreviewReader.Rows(frame,new(420,235,1100,750),OcrFactory.Paddle)))
+                throw new InvalidOperationException("fresh_preview_before_tooltip_unverified");
+            // Card center is well above the final confirmation row. No confirm/key controller action exists here.
+            var card=material.Card;
+            if(card.Y<frame.Height*.5 || card.Bottom>frame.Height*.75 || card.X<frame.Width*.2 || card.Right>frame.Width*.8)
+                throw new InvalidOperationException("material_card_geometry_unverified");
+            frame.ClickTo(card.X+card.Width/2,card.Y+card.Height/3);
+        }
+        await Delay(400);
+        UpgradePreviewTooltip Read(){using var frame=Capture();var read=TalentUpgradePreviewReader.Tooltip(frame,OcrFactory.Paddle,Now(),material.Name);frames.Add(read);return read;}
+        var first=Read();await Delay();var second=Read();
+        if(!TalentUpgradePreviewEvidence.TooltipPair(first,second,material,Now()))throw new InvalidOperationException("named_material_tooltip_pair_unverified");
+        using(var frame=Capture())
+        {
+            var current=TalentUpgradePreviewReader.Tooltip(frame,OcrFactory.Paddle,Now(),material.Name);
+            if(!current.Page||current.Name!=material.Name)throw new InvalidOperationException("fresh_tooltip_before_cancel_unverified");
+            token.ThrowIfCancellationRequested();Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+        }
+        await Delay(400);
+        return[first,second];
+    }
+    private async Task<bool> Restore()
+    {
+        using var timeout=new CancellationTokenSource(TimeSpan.FromSeconds(10));long? previousWorldAt=null;
+        for(int i=0;i<12;i++)
+        {
+            using var frame=Common.TaskControl.CaptureToRectArea(forceNew:true);
+            var at=Now();var focused=SystemControl.IsGenshinImpactActiveByProcess();var world=focused&&World(frame);
+            frames.Add(new{phase="world_restore",observedAt=at,width=frame.Width,height=frame.Height,focused,worldVerified=world});
+            if(!focused)return false;
+            if(world)
+            {
+                if(previousWorldAt.HasValue&&TalentUpgradePreviewEvidence.Fresh(previousWorldAt.Value,at,at))return true;
+                previousWorldAt=at;
+            }
+            else
+            {
+                previousWorldAt=null;
+                if(!opened || Bv.IsInRevivePrompt(frame)||Bv.IsInDomain(frame))return false;
+                var rows=TalentUpgradePreviewReader.Rows(frame,new(420,235,1100,750),OcrFactory.Paddle);
+                var preview=TalentUpgradePreviewReader.PreviewPage(rows);
+                var detail=TalentUpgradePreviewReader.Detail(frame,OcrFactory.Paddle,Now()).Page;
+                var tooltip=TalentUpgradePreviewReader.Tooltip(frame,OcrFactory.Paddle,Now()).Page;
+                if(!Overview(frame)&&!preview&&!detail&&!tooltip)return false;
+                timeout.Token.ThrowIfCancellationRequested();Simulation.SendInput.Keyboard.KeyPress(User32.VK.VK_ESCAPE);
+            }
+            await Task.Delay(250,timeout.Token);
+        }
+        return false;
+    }
+    public async Task<string> Start(string characterName,string talentType,CancellationToken ct)
+    {
+        TalentUpgradePreviewEvidence.ValidateRequest(characterName,talentType);
+        var target=CharacterSelectionHelper.CreateTarget(characterName);
+        if(target.SkipDisplayNameConfirmation)throw new ArgumentException("Preview requires a complete stable official character display name.");
+        official=target.Name;type=talentType;
+        bool restored=false,verified=false;string reason="unverified";
+        UpgradePreviewDetail? detailReceipt=null;UpgradePreviewFrame? previewReceipt=null;
+        UpgradePreviewCharacter[] names=[];var tooltips=new List<UpgradePreviewTooltip[]>();
+        var saved=new ConcurrentDictionary<string,ITaskTrigger>(GameTaskManager.TriggerDictionary??new());
+        using var timeout=CancellationTokenSource.CreateLinkedTokenSource(ct);timeout.CancelAfter(TimeSpan.FromSeconds(150));token=timeout.Token;
+        try
+        {
+            TaskTriggerDispatcher.Instance().ClearTriggers();Simulation.ReleaseAllKey();
+            for(int i=0;i<2;i++){using var initial=Capture();if(!World(initial))throw new InvalidOperationException("fresh_world_pair_required");await Delay();}
+            opened=true;
+            await new CharacterDevelopmentStateMachineTask([official],CharacterDevelopmentCategory.Attribute|CharacterDevelopmentCategory.Weapon,true).Start(token);
+            var nameList=new List<UpgradePreviewCharacter>();
+            for(int i=0;i<3;i++)
+            {
+                using var frame=Capture();var read=new UpgradePreviewCharacter(Now(),Overview(frame),
+                    CharacterSelectionHelper.ReadSelectedName(frame,frame.Width/1920d)){
+                        Width=frame.Width,Height=frame.Height,NameRegion=TalentUpgradePreviewReader.Scale(new(1466,131,244,38),frame.Width),
+                        NameRows=TalentUpgradePreviewReader.Rows(frame,new(1466,131,244,38),OcrFactory.Paddle)};
+                nameList.Add(read);frames.Add(read);await Delay(200);
+            }
+            names=nameList.ToArray();if(!TalentUpgradePreviewEvidence.CharacterTriple(names,official,Now()))throw new InvalidOperationException("full_official_character_name_triple_unverified");
+            await OpenTalent();var detail=await DetailPair();detailReceipt=detail.Second;selectedDetail=detailReceipt;
+            await ClickKnownText("升级",new(0,975,560,100));
+            using var recognizer=new ItemRecognizer();var preview=await PreviewPair(recognizer,detailReceipt.BaseLevel!.Value);previewReceipt=preview.Second;
+            foreach(var material in previewReceipt.Materials)
+            {
+                var fresh=await PreviewPair(recognizer,detailReceipt.BaseLevel.Value);
+                if(!TalentUpgradePreviewEvidence.SameCosts(previewReceipt,fresh.Second))throw new InvalidOperationException("preview_costs_changed");
+                tooltips.Add(await Tooltip(fresh.Second.Materials.Single(m=>m.Name==material.Name)));
+            }
+            var final=await PreviewPair(recognizer,detailReceipt.BaseLevel.Value);
+            if(!TalentUpgradePreviewEvidence.SameCosts(previewReceipt,final.Second))throw new InvalidOperationException("final_preview_costs_changed");
+            previewReceipt=final.Second;verified=true;reason="verified_read_only_preview";
+        }
+        catch(Exception ex){reason=ex is OperationCanceledException?"observation_timeout_or_cancelled":ex.Message;verified=false;}
+        finally
+        {
+            try{restored=await Restore();}catch{restored=false;}
+            Simulation.ReleaseAllKey();TaskTriggerDispatcher.Instance().ClearTriggers();GameTaskManager.TriggerDictionary=saved;
+            TaskTriggerDispatcher.Instance().SetTriggers(saved.Values.OrderByDescending(t=>t.Priority).ToList());
+        }
+        ct.ThrowIfCancellationRequested();verified&=restored;
+        logger.LogInformation("只读天赋升级预览：verified={Verified} restored={Restored} confirmationSubmitted=False reason={Reason}",verified,restored,reason);
+        var reportFolder=Global.Absolute("log\\talent-upgrade-inspection");
+        var reportPath=System.IO.Path.Combine(reportFolder,DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmssfff")+"-"+Guid.NewGuid().ToString("N")[..8]+".json");
+        var payload=JsonConvert.SerializeObject(new{
+            schemaVersion=1,task="talent-upgrade-inspection",status=verified?"success":"unknown",readOnly=true,
+            rawReportPath=reportPath,
+            characterName=official,talentType=type,talentName=verified?detailReceipt?.Title:null,
+            currentBaseLevel=verified?previewReceipt?.Current:null,nextBaseLevel=verified?previewReceipt?.Next:null,
+            materials=verified?previewReceipt?.Materials.Select(m=>new{name=m.Name,owned=m.Quantity.Owned,required=m.Quantity.Required}).ToArray():null,
+            mora=verified?new{owned=previewReceipt?.Mora.Owned,required=previewReceipt?.Mora.Required}:null,
+            evidenceVerified=verified,mainUiRestored=restored,confirmationSubmitted=false,reason=restored?reason:"world_restore_unverified",
+            observedAt=verified&&previewReceipt is not null?DateTimeOffset.FromUnixTimeMilliseconds(previewReceipt.ObservedAt).ToString("O"):null,
+            evidence=new{characterIdentity=names,detailIdentityCarryover=detailReceipt,preview=previewReceipt,materialTooltips=tooltips,rawFrames=frames,
+                characterSelectionAfterIdentity=false,tooltipRequirementUsedAsUpgradeCost=false}
+        },new JsonSerializerSettings{ContractResolver=new CamelCasePropertyNamesContractResolver()});
+        try{System.IO.Directory.CreateDirectory(reportFolder);System.IO.File.WriteAllText(reportPath,payload);}
+        catch(Exception ex){logger.LogWarning("只读天赋预览私有报告写入失败：{Type}",ex.GetType().Name);}
+        return payload;
+    }
+}
