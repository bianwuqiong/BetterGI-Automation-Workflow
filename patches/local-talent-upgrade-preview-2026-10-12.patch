+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentUpgradePreviewEvidenceTests
+{
+    [Theory] [InlineData("12/3",12,3)] [InlineData("０/２",0,2)]
+    public void CompleteRatioSeparatesOwnedAndRequired(string raw,int owned,int required)
+    {var r=TalentUpgradePreviewEvidence.Ratio(raw);Assert.Equal(owned,r.Owned);Assert.Equal(required,r.Required);}
+    [Theory] [InlineData("123")] [InlineData("12l3")] [InlineData("1.2万/3")] [InlineData("12/03")] [InlineData("12//3")] [InlineData("-1/3")]
+    public void MissingSlashShortenedOrPartialNumbersAreUnknown(string raw)=>Assert.Null(TalentUpgradePreviewEvidence.Ratio(raw).Owned);
+    [Fact] public void QuoteGlyphNormalizationPreservesEveryNameCharacter()
+    {
+        Assert.Equal("「教材」的教导",TalentUpgradePreviewEvidence.CanonicalMaterialName("[教材」的教导"));
+        Assert.NotEqual("「教材」的教导",TalentUpgradePreviewEvidence.CanonicalMaterialName("[材」的教导"));
+        Assert.NotEqual("「教材」的教导",TalentUpgradePreviewEvidence.CanonicalMaterialName("教材的教导"));
+    }
+    [Fact] public void CharacterMustHaveThreeIndependentFullNamesOnOverview()
+    {
+        UpgradePreviewCharacter[] f=[new(100,true,"目标角色"),new(400,true,"目标角色"),new(700,true,"目标角色")];
+        Assert.True(TalentUpgradePreviewEvidence.CharacterTriple(f,"目标角色",700));
+        Assert.False(TalentUpgradePreviewEvidence.CharacterTriple([f[0],f[1],f[1]],"目标角色",700));
+        Assert.False(TalentUpgradePreviewEvidence.CharacterTriple([f[0],f[1],f[2] with{Name="目标"}],"目标角色",700));
+        Assert.False(TalentUpgradePreviewEvidence.CharacterTriple([f[0],f[1],f[2] with{Overview=false}],"目标角色",700));
+    }
+    private static UpgradePreviewFrame Frame(long at,int own=1234,int fee=120)=>new(at,true,1,2,
+        [new("材料甲",.9,new(800,650,116,146),new(at,"17/3",new(835,760,50,20),17,3,true)),
+         new("材料乙",.9,new(1000,650,116,146),new(at,"23/6",new(1035,760,50,20),23,6,true))],
+        new(at,$"{own}/{fee}",new(900,800,275,55),own,fee,true),"摩拉",.9,[]);
+    [Fact] public void PopupRequiresFullMarkersExactNextLevelNamedMaterialsCoinAndFreshPair()
+    {
+        var a=Frame(100);var b=Frame(500);
+        Assert.True(TalentUpgradePreviewEvidence.PreviewPair(a,b,1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,a,1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{Page=false},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{Next=3},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{CoinName="原石"},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{CoinScore=.74},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{CoinScore=double.PositiveInfinity},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{Materials=[b.Materials[0],b.Materials[0]]},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,b with{Mora=b.Mora with{Complete=false}},1,500));
+        Assert.False(TalentUpgradePreviewEvidence.PreviewPair(a,Frame(500,1235),1,500));
+    }
+    [Fact] public void TooltipAggregateRequirementNeverOverridesPopupUpgradeRequirement()
+    {
+        var item=Frame(100).Materials[0];
+        var a=new UpgradePreviewTooltip(500,true,"材料甲","角色天赋素材",new(500,"17/9",default,17,9,true));
+        var b=a with{ObservedAt=800,Quantity=a.Quantity with{ObservedAt=800}};
+        Assert.True(TalentUpgradePreviewEvidence.TooltipPair(a,b,item,800));Assert.Equal(3,item.Quantity.Required);
+        Assert.False(TalentUpgradePreviewEvidence.TooltipPair(a,b with{Name="材料"},item,800));
+        Assert.False(TalentUpgradePreviewEvidence.TooltipPair(a,b with{Quantity=b.Quantity with{Owned=18}},item,800));
+    }
+    [Theory] [InlineData(100,100,100,false)] [InlineData(100,6000,6000,false)] [InlineData(100,400,1901,false)]
+    [InlineData(100,400,399,false)] [InlineData(100,400,400,true)]
+    public void CaptureTimeAndLatestFreshnessAreMandatory(long first,long second,long now,bool expected)=>
+        Assert.Equal(expected,TalentUpgradePreviewEvidence.Fresh(first,second,now));
+    [Theory] [InlineData("元素战技")] [InlineData("元素爆发")] [InlineData("普通攻击")]
+    public void OnlyTheThreeCombatTalentTypesCanBeRequested(string type)=>TalentUpgradePreviewEvidence.ValidateRequest("目标角色",type);
+    [Theory] [InlineData("被动天赋")] [InlineData("确认升级")]
+    public void ArbitraryUpgradeActionsCannotBeRequested(string type)=>Assert.Throws<ArgumentException>(()=>TalentUpgradePreviewEvidence.ValidateRequest("目标角色",type));
+}
