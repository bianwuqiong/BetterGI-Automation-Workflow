+using System;
+using System.Linq;
+using System.Text.RegularExpressions;
+using BetterGenshinImpact.Core.Recognition.OCR;
+using BetterGenshinImpact.GameTask.Common.Job;
+using BetterGenshinImpact.GameTask.Model.Area;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+/// <summary>Shared production/offline parser of the observed talent detail, preview and material tooltip.</summary>
+internal static class TalentUpgradePreviewReader
+{
+    private static UpgradePreviewRow[] Project(OcrResultRegion[] rows,Rect box,int scale=1)=>rows.Select(r=>{
+        var b=r.Rect.BoundingRect();int left=box.X+(int)Math.Floor(b.Left/(double)scale),top=box.Y+(int)Math.Floor(b.Top/(double)scale);
+        return new UpgradePreviewRow(r.Text,new(left,top,box.X+(int)Math.Ceiling(b.Right/(double)scale)-left,box.Y+(int)Math.Ceiling(b.Bottom/(double)scale)-top));}).ToArray();
+    internal static Rect Scale(Rect r,int width)=>new((int)Math.Round(r.X*width/1920d),(int)Math.Round(r.Y*width/1920d),
+        (int)Math.Round(r.Width*width/1920d),(int)Math.Round(r.Height*width/1920d));
+    internal static UpgradePreviewRow[] Rows(ImageRegion frame,Rect reference,IOcrService ocr)
+    {
+        var rect=Scale(reference,frame.Width);using var crop=frame.DeriveCrop(rect);
+        return Project(ocr.OcrResult(crop.SrcMat).Regions,rect);
+    }
+    private static bool Full(UpgradePreviewRow row,Rect box,double s)=>row.Bounds.Width>0&&row.Bounds.Height>0&&
+        row.Bounds.Left-box.Left>=2*s&&box.Right-row.Bounds.Right>=2*s&&row.Bounds.Top>=box.Top&&row.Bounds.Bottom<=box.Bottom;
+    private static string OneName(ImageRegion frame,Rect reference,IOcrService ocr)
+    {
+        var box=Scale(reference,frame.Width);var rows=Rows(frame,reference,ocr);
+        return rows.Length==1&&Full(rows[0],box,frame.Width/1920d)?TalentUpgradePreviewEvidence.Normalize(rows[0].Text):"";
+    }
+    private static (string Name,UpgradePreviewRow[] Rows) EnlargedName(ImageRegion frame,Rect reference,IOcrService ocr)
+    {
+        using var crop=frame.DeriveCrop(Scale(reference,frame.Width));
+        using var gray=crop.SrcMat.CvtColor(ColorConversionCodes.BGR2GRAY);
+        using var foreground=gray.Threshold(210,255,ThresholdTypes.BinaryInv);
+        using var large=foreground.Resize(new Size(crop.Width*4,crop.Height*4),0,0,InterpolationFlags.Cubic);
+        var rows=ocr.OcrResult(large).Regions;
+        if(rows.Length!=1)return("",Project(rows,Scale(reference,frame.Width),4));
+        var b=rows[0].Rect.BoundingRect();double margin=2*frame.Width/1920d*4;
+        return(b.Left>=margin&&large.Width-b.Right>=margin&&b.Top>=0&&b.Bottom<=large.Height?
+            TalentUpgradePreviewEvidence.Normalize(rows[0].Text):"",Project(rows,Scale(reference,frame.Width),4));
+    }
+    internal static UpgradePreviewDetail Detail(ImageRegion frame,IOcrService ocr,long at)
+    {
+        // Separate preview-only crop; preserve the older general character-reader ROIs.
+        var marker=string.Concat(Rows(frame,new(100,219,125,33),ocr).Select(r=>r.Text));
+        if(!CharacterDevelopmentStateMachineTask.IsTalentDetailText(marker))return new(at,false,"","",null,null){Width=frame.Width,Height=frame.Height};
+        var typeRows=Rows(frame,new(242,13,98,36),ocr);
+        var type=CharacterDevelopmentStateMachineTask.NormalizeTalentType(string.Concat(typeRows.Select(r=>r.Text)));
+        var levelBox=Scale(new(240,160,100,52),frame.Width);
+        using var levelCrop=frame.DeriveCrop(levelBox);var levelOcr=ocr.OcrResult(levelCrop.SrcMat);
+        var parsed=CharacterDevelopmentStateMachineTask.TryParseTalentLevel(levelOcr.Text.Trim(),out var level);
+        int padding=Math.Max(4,(int)Math.Round(10*frame.Width/1920d));
+        var colorBox=new Rect(levelBox.X-padding,levelBox.Y-padding,levelBox.Width+2*padding,levelBox.Height+2*padding);
+        using var colorCrop=frame.DeriveCrop(colorBox);
+        var shifted=new OcrResult(levelOcr.Regions.Select(r=>new OcrResultRegion(new RotatedRect(
+            new Point2f(r.Rect.Center.X+padding,r.Rect.Center.Y+padding),r.Rect.Size,r.Rect.Angle),r.Text,r.Score)).ToArray());
+        var color=CharacterDevelopmentStateMachineTask.ReadTalentLevelGlyphColor(colorCrop.SrcMat,shifted,out var glyph,out var bright,out var neutral,out var cyan,out var dark);
+        var bonusText=string.Concat(Rows(frame,new(35,285,146,30),ocr).Select(r=>r.Text));
+        bool bonus=false;
+        var ok=type.Length>0&&parsed&&CharacterDevelopmentStateMachineTask.TryResolveTalentBonus(level,color,bonusText,out bonus);
+        var titleRows=ok?Rows(frame,new(20,120,540,52),ocr):[];
+        var titleBox=Scale(new(20,120,540,52),frame.Width);
+        var title=titleRows.Length==1&&Full(titleRows[0],titleBox,frame.Width/1920d)?TalentUpgradePreviewEvidence.Normalize(titleRows[0].Text):"";
+        int? basic=ok?level-(bonus?3:0):null;
+        return new(at,ok&&title.Length>0,type,title,ok?level:null,basic is >=1 and <=10?basic:null){
+            Width=frame.Width,Height=frame.Height,TypeRegion=Scale(new(242,13,98,36),frame.Width),TypeRows=typeRows,TitleRegion=titleBox,TitleRows=titleRows,
+            LevelRegion=levelBox,LevelRaw=levelOcr.Text,LevelRows=Project(levelOcr.Regions,levelBox),ColorSampleRegion=colorBox,
+            GlyphRegion=new(glyph.X+colorBox.X,glyph.Y+colorBox.Y,glyph.Width,glyph.Height),GlyphColor=color.ToString(),
+            BrightPixels=bright,NeutralPixels=neutral,CyanPixels=cyan,DarkConflicts=dark,BonusRegion=Scale(new(35,285,146,30),frame.Width),BonusRaw=bonusText,HasFixedPlusThree=ok?bonus:null};
+    }
+    internal static bool PreviewPage(UpgradePreviewRow[] rows)
+    {
+        var names=rows.Select(r=>TalentUpgradePreviewEvidence.Normalize(r.Text)).ToArray();
+        return new[]{"属性变更","所需材料","取消","确认"}.All(n=>names.Count(t=>t==n)==1);
+    }
+    internal static UpgradePreviewRatio ReadRatio(ImageRegion frame,Rect box,IOcrService ocr,long at,string prefix="")
+    {
+        using var crop=frame.DeriveCrop(box);
+        var rows=ocr.OcrResult(crop.SrcMat).Regions;
+        string raw=TalentUpgradePreviewEvidence.Normalize(ocr.OcrWithoutDetector(crop.SrcMat));
+        string detector=TalentUpgradePreviewEvidence.Normalize(string.Concat(rows.Select(r=>r.Text)));
+        if(prefix.Length>0)
+        {
+            raw=raw.StartsWith(prefix,StringComparison.Ordinal)?raw[prefix.Length..]:"";
+            detector=detector.StartsWith(prefix,StringComparison.Ordinal)?detector[prefix.Length..]:"";
+        }
+        var parsed=TalentUpgradePreviewEvidence.Ratio(raw);
+        bool full=rows.Length>0&&rows.All(r=>{
+            var b=r.Rect.BoundingRect();return b.Left>=2*frame.Width/1920d&&crop.Width-b.Right>=2*frame.Width/1920d&&
+                b.Top>=0&&b.Bottom<=crop.Height;
+        });
+        bool complete=full&&raw==detector&&parsed.Owned.HasValue&&parsed.Required.HasValue;
+        if(!complete&&prefix.Length==0&&box.Width<200*frame.Width/1920d)
+        {
+            // The card's actual slash may OCR as '1'. Never replace digits: prove the slash
+            // geometrically and OCR complete left/right integers independently instead.
+            var slash=RecipeSlashCostEvidence.FindSlash(crop.SrcMat);
+            if(slash.Verified&&slash.Bounds.X>8&&slash.Bounds.Right<crop.Width-8)
+            {
+                using var left=new Mat(crop.SrcMat,new Rect(0,0,slash.Bounds.X-1,crop.Height));
+                using var right=new Mat(crop.SrcMat,new Rect(slash.Bounds.Right+1,0,crop.Width-slash.Bounds.Right-1,crop.Height));
+                (string Raw,int? Value,bool Full,UpgradePreviewRow[] Rows) ReadInteger(Mat original,Rect absolute)
+                {
+                    using var large=original.Resize(new Size(original.Width*4,original.Height*4),0,0,InterpolationFlags.Cubic);
+                    var integerRows=ocr.OcrResult(large).Regions;
+                    var integerRaw=TalentUpgradePreviewEvidence.Normalize(ocr.OcrWithoutDetector(large));
+                    bool fullInteger=integerRows.Length==1&&integerRaw==TalentUpgradePreviewEvidence.Normalize(integerRows[0].Text);
+                    if(fullInteger){var b=integerRows[0].Rect.BoundingRect();fullInteger=b.Left>=2*frame.Width/1920d*4&&large.Width-b.Right>=2*frame.Width/1920d*4;}
+                    return(integerRaw,TalentUpgradePreviewEvidence.Integer(integerRaw),fullInteger,Project(integerRows,absolute,4));
+                }
+                var numeratorBox=new Rect(box.X,box.Y,left.Width,left.Height);
+                var denominatorBox=new Rect(box.X+slash.Bounds.Right+1,box.Y,right.Width,right.Height);
+                var numerator=ReadInteger(left,numeratorBox);var denominator=ReadInteger(right,denominatorBox);
+                if(numerator.Full&&denominator.Full&&numerator.Value.HasValue&&denominator.Value.HasValue)
+                    return new(at,raw,box,numerator.Value,denominator.Value,true,true,numerator.Raw,denominator.Raw){
+                        Width=frame.Width,Height=frame.Height,DetectorRaw=detector,OcrRows=Project(rows,box),Prefix=prefix,
+                        SlashBounds=new(slash.Bounds.X+box.X,slash.Bounds.Y+box.Y,slash.Bounds.Width,slash.Bounds.Height),SlashCorrelation=slash.Correlation,SlashInkPixels=slash.InkPixels,
+                        NumeratorRegion=numeratorBox,DenominatorRegion=denominatorBox,NumeratorRows=numerator.Rows,DenominatorRows=denominator.Rows,SplitOcrScale=4};
+            }
+        }
+        return new(at,raw,box,complete?parsed.Owned:null,complete?parsed.Required:null,complete){Width=frame.Width,Height=frame.Height,DetectorRaw=detector,OcrRows=Project(rows,box),Prefix=prefix};
+    }
+    private static (int? Value,string Raw,UpgradePreviewRow[] Rows) Level(ImageRegion frame,Rect reference,IOcrService ocr)
+    {
+        using var crop=frame.DeriveCrop(Scale(reference,frame.Width));
+        var raw=TalentUpgradePreviewEvidence.Normalize(ocr.OcrWithoutDetector(crop.SrcMat));
+        var rows=ocr.OcrResult(crop.SrcMat).Regions;
+        var detected=TalentUpgradePreviewEvidence.Normalize(string.Concat(rows.Select(r=>r.Text)));
+        var match=Regex.Match(raw,@"\A等级([1-9]|10)\z");
+        return(raw==detected&&match.Success?int.Parse(match.Groups[1].Value):null,raw,Project(rows,Scale(reference,frame.Width)));
+    }
+    private static (string Name,double Score) Icon(ImageRegion frame,Rect box,ItemRecognizer recognizer)
+    {
+        using var crop=frame.DeriveCrop(box);using var normalized=crop.SrcMat.Resize(new Size(125,125));
+        var candidate=recognizer.Match(normalized);return(candidate.Name,candidate.Score);
+    }
+    internal static UpgradePreviewFrame Preview(ImageRegion frame,IOcrService ocr,ItemRecognizer recognizer,long at)
+    {
+        var rows=Rows(frame,new(420,235,1100,750),ocr);bool page=PreviewPage(rows);
+        if(!page)return new(at,false,null,null,[],new(at,"",default,null,null,false),"",0,[]){Width=frame.Width,Height=frame.Height,MarkerRegion=Scale(new(420,235,1100,750),frame.Width)};
+        var countsBox=Scale(new(440,690,1040,100),frame.Width);
+        var countRows=Rows(frame,new(440,690,1040,100),ocr).Where(r=>Regex.IsMatch(TalentUpgradePreviewEvidence.Normalize(r.Text),@"\A[0-9/]{2,20}\z") && Full(r,countsBox,frame.Width/1920d))
+            .OrderBy(r=>r.Bounds.X).ToArray();
+        double s=frame.Width/1920d;
+        var materials=countRows.Select(row=>{
+            var box=new Rect(row.Bounds.X-(int)Math.Round(8*s),row.Bounds.Y-(int)Math.Round(5*s),
+                row.Bounds.Width+(int)Math.Round(16*s),row.Bounds.Height+(int)Math.Round(10*s));
+            var center=row.Bounds.X+row.Bounds.Width/2;
+            var card=new Rect(center-(int)Math.Round(58*s),row.Bounds.Bottom-(int)Math.Round(138*s),(int)Math.Round(116*s),(int)Math.Round(146*s));
+            var imageBox=new Rect(card.X,card.Y,card.Width,(int)Math.Round(112*s));
+            var icon=Icon(frame,imageBox,recognizer);
+            return new UpgradePreviewMaterial(icon.Name,icon.Score,card,ReadRatio(frame,box,ocr,at)){IconRegion=imageBox};
+        }).ToArray();
+        var coin=Icon(frame,Scale(new(853,799,37,37),frame.Width),recognizer);
+        var current=Level(frame,new(760,245,160,65),ocr);var next=Level(frame,new(1000,245,170,65),ocr);
+        return new(at,true,current.Value,next.Value,materials,
+            ReadRatio(frame,Scale(new(903,797,275,55),frame.Width),ocr,at),coin.Name,coin.Score,rows){
+                Width=frame.Width,Height=frame.Height,MarkerRegion=Scale(new(420,235,1100,750),frame.Width),CoinRegion=Scale(new(853,799,37,37),frame.Width),
+                CurrentLevelRegion=Scale(new(760,245,160,65),frame.Width),NextLevelRegion=Scale(new(1000,245,170,65),frame.Width),
+                CurrentLevelRows=current.Rows,NextLevelRows=next.Rows,CurrentLevelRaw=current.Raw,NextLevelRaw=next.Raw};
+    }
+    internal static UpgradePreviewTooltip Tooltip(ImageRegion frame,IOcrService ocr,long at,string? expectedMaterialName=null)
+    {
+        var rawName=OneName(frame,new(730,168,440,67),ocr);
+        var alternateRead=EnlargedName(frame,new(730,168,440,67),ocr);var alternate=alternateRead.Name;
+        var candidates=new[]{rawName,alternate}.Where(n=>n.Length>0).Select(TalentUpgradePreviewEvidence.CanonicalMaterialName).Distinct().ToArray();
+        // Expected name comes from the independently matched preview card (>=.75), not caller text.
+        // Accept a complete actual OCR candidate matching it; never replace a Chinese name character.
+        var name=expectedMaterialName is not null&&candidates.Contains(expectedMaterialName)?expectedMaterialName:
+            expectedMaterialName is null&&candidates.Length==1?candidates[0]:"";
+        var kind=OneName(frame,new(730,230,440,65),ocr);
+        var sources=Rows(frame,new(730,690,460,65),ocr);
+        var footerRows=Rows(frame,new(725,890,470,65),ocr);
+        var ratio=ReadRatio(frame,Scale(new(885,890,295,65),frame.Width),ocr,at,"培养需求");
+        var page=candidates.Length>0&&kind is "角色天赋素材" or "角色与武器培养素材" &&
+            sources.Any(r=>TalentUpgradePreviewEvidence.Normalize(r.Text)=="来源") &&
+            footerRows.Any(r=>TalentUpgradePreviewEvidence.Normalize(r.Text).StartsWith("培养需求",StringComparison.Ordinal));
+        return new(at,page,name,kind,ratio,rawName,alternate){Width=frame.Width,Height=frame.Height,NameRegion=Scale(new(730,168,440,67),frame.Width),
+            KindRegion=Scale(new(730,230,440,65),frame.Width),SourceRegion=Scale(new(730,690,460,65),frame.Width),
+            NameRows=Rows(frame,new(730,168,440,67),ocr),AlternateNameRows=alternateRead.Rows,AlternateNameScale=4,
+            KindRows=Rows(frame,new(730,230,440,65),ocr),SourceRows=sources,AlternateNamePreprocessing="gray_threshold_210_inverse_cubic_4x",
+            FooterLabelRegion=Scale(new(725,890,470,65),frame.Width),FooterLabelRows=footerRows};
+    }
+}
