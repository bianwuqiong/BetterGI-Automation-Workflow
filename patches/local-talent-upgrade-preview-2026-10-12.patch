+    public UpgradePreviewRow[] NameRows{get;init;}=[];public UpgradePreviewRow[] AlternateNameRows{get;init;}=[];
+    public int AlternateNameScale{get;init;}public UpgradePreviewRow[] KindRows{get;init;}=[];public UpgradePreviewRow[] SourceRows{get;init;}=[];
+    public string AlternateNamePreprocessing{get;init;}="";
+    public Rect FooterLabelRegion{get;init;}public UpgradePreviewRow[] FooterLabelRows{get;init;}=[];
+}
+public sealed record UpgradePreviewCharacter(long ObservedAt,bool Overview,string Name)
+{public int Width{get;init;}public int Height{get;init;}public Rect NameRegion{get;init;}public UpgradePreviewRow[] NameRows{get;init;}=[];}
+
+/// <summary>Complete UI values only. No budgets, confirmation input, or guessed inventory defaults.</summary>
+public static class TalentUpgradePreviewEvidence
+{
+    public static string Normalize(string text)=>string.Concat(text.Normalize(NormalizationForm.FormKC).Where(c=>!char.IsWhiteSpace(c)));
+    public static string CanonicalMaterialName(string raw)=>Normalize(raw).Replace('[','「').Replace(']','」');
+    public static void ValidateRequest(string name,string type)
+    {
+        if(string.IsNullOrWhiteSpace(name)||name!=name.Trim()||name.Length>80||name.Any(char.IsControl))
+            throw new ArgumentException("A bounded complete character name is required.");
+        if(type is not("普通攻击" or "元素战技" or "元素爆发"))throw new ArgumentException("Only combat talents are supported.");
+    }
+    public static int? Integer(string text)=>Regex.IsMatch(Normalize(text),@"\A(?:0|[1-9][0-9]{0,9})\z") &&
+        int.TryParse(Normalize(text),out var n)?n:null;
+    public static (int? Owned,int? Required) Ratio(string text)
+    {
+        var m=Regex.Match(Normalize(text),@"\A(0|[1-9][0-9]{0,9})/(0|[1-9][0-9]{0,9})\z");
+        return m.Success?(Integer(m.Groups[1].Value),Integer(m.Groups[2].Value)):(null,null);
+    }
+    public static bool Fresh(long first,long second,long now)=>first>=0 && second>first && second-first<=5000 &&
+        now>=second && now-second<=1500;
+    public static bool CharacterTriple(UpgradePreviewCharacter[] frames,string official,long now)=>frames.Length==3 &&
+        frames.All(f=>f.Overview&&Normalize(f.Name)==Normalize(official)) && Fresh(frames[0].ObservedAt,frames[1].ObservedAt,frames[1].ObservedAt) &&
+        Fresh(frames[1].ObservedAt,frames[2].ObservedAt,now) && frames[2].ObservedAt-frames[0].ObservedAt<=5000;
+    public static bool DetailPair(UpgradePreviewDetail a,UpgradePreviewDetail b,string type,long now)=>
+        a.Page&&b.Page&&a.Type==type&&b.Type==type&&a.Title.Length>0&&a.Title==b.Title&&
+        a.DisplayLevel==b.DisplayLevel&&a.BaseLevel is >=1 and <=9&&a.BaseLevel==b.BaseLevel&&Fresh(a.ObservedAt,b.ObservedAt,now);
+    public static bool QuantityPair(UpgradePreviewRatio a,UpgradePreviewRatio b,long now)=>a.Complete&&b.Complete&&
+        a.Owned is >=0&&a.Required is >0&&a.Owned==b.Owned&&a.Required==b.Required&&Fresh(a.ObservedAt,b.ObservedAt,now);
+    public static bool PreviewPair(UpgradePreviewFrame a,UpgradePreviewFrame b,int current,long now)=>
+        a.Page&&b.Page&&a.Current==current&&b.Current==current&&a.Next==current+1&&b.Next==current+1&&current is >=1 and <=9&&
+        Fresh(a.ObservedAt,b.ObservedAt,now)&&a.Materials.Length is >=1 and <=4&&a.Materials.Length==b.Materials.Length&&
+        a.Materials.Select(m=>m.Name).Distinct().Count()==a.Materials.Length &&
+        a.Materials.Zip(b.Materials).All(p=>p.First.Name.Length>0&&p.First.Name==p.Second.Name&&double.IsFinite(p.First.IconScore)&&double.IsFinite(p.Second.IconScore)&&p.First.IconScore>=.75&&p.Second.IconScore>=.75&&
+            QuantityPair(p.First.Quantity,p.Second.Quantity,now))&&a.CoinName=="摩拉"&&b.CoinName=="摩拉"&&double.IsFinite(a.CoinScore)&&double.IsFinite(b.CoinScore)&&a.CoinScore>=.75&&b.CoinScore>=.75&&
+        QuantityPair(a.Mora,b.Mora,now);
+    public static bool SameCosts(UpgradePreviewFrame a,UpgradePreviewFrame b)=>a.Current==b.Current&&a.Next==b.Next&&
+        a.Mora.Owned==b.Mora.Owned&&a.Mora.Required==b.Mora.Required&&a.Materials.Length==b.Materials.Length&&
+        a.Materials.Zip(b.Materials).All(p=>p.First.Name==p.Second.Name&&p.First.Quantity.Owned==p.Second.Quantity.Owned&&p.First.Quantity.Required==p.Second.Quantity.Required);
+    public static bool TooltipPair(UpgradePreviewTooltip a,UpgradePreviewTooltip b,UpgradePreviewMaterial item,long now)=>
+        a.Page&&b.Page&&a.Name==item.Name&&b.Name==item.Name&&a.Kind==b.Kind&&
+        a.Quantity.Complete&&b.Quantity.Complete&&a.Quantity.Owned==item.Quantity.Owned&&b.Quantity.Owned==item.Quantity.Owned&&
+        Fresh(a.ObservedAt,b.ObservedAt,now);
+    // Tooltip's aggregate cultivation denominator is intentionally not the next-upgrade requirement.
+}
