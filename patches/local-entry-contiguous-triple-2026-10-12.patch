+++ b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentEntryContiguousTripleTests.cs
@@ -0,0 +1,41 @@
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+using OpenCvSharp;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class TalentEntryContiguousTripleTests
+{
+    private const string Official="目标角色";
+    private static UpgradePreviewTalentEntries Frame(long at,int count=3,int shift=0)
+    {
+        var header="风元素/"+Official;var name=new UpgradePreviewCharacter(at,true,Official){Width=1920,Height=1080,
+            NameSource="talent_global_header",NameBoxMethod="whole_header_ocr_box_contains_name",HeaderRaw=header,HeaderElement="风",
+            NameRegion=TalentGlobalHeaderEvidence.ReferenceRegion,NameRows=[new(header,new(145,42,220,28))]};
+        var rows=Enumerable.Range(0,count).Select(i=>new UpgradePreviewRow("Lv.1",new(1640+shift,170+i*90,60,28))).ToArray();
+        return new(at,1920,1080,true,true,false,false,name,TalentEntryObservationEvidence.ReferenceRegion,rows,rows){
+            MenuRegion=TalentGlobalHeaderEvidence.TalentMenuReference,MenuRows=[new("天赋",new(155,415,80,30))]};
+    }
+    [Fact] public void RejectedThirdIsKeptAndOnlyTheNextContiguousTripleCanBeSelected()
+    {
+        var trials=new[]{Frame(100),Frame(400),Frame(700,2),Frame(1000),Frame(1300),Frame(1600)};
+        var accepted=new List<int>();
+        for(int i=2;i<trials.Length;i++)
+            if(TalentEntryObservationEvidence.ContiguousTriple(trials[i-2],trials[i-1],trials[i],Official,trials[i].ObservedAt))accepted.Add(i);
+        Assert.Equal(new[]{5},accepted);Assert.Equal(2,trials[2].Candidates.Length);
+        Assert.Equal("wrong_candidate_count",TalentEntryObservationEvidence.FrameFailure(trials[2],Official));
+    }
+    [Theory] [InlineData("prompt")] [InlineData("focus")] [InlineData("revive")] [InlineData("header")]
+    public void ThirdModalFocusOrCurrentHeaderFailureNeverPermitsClick(string fault)
+    {
+        var c=Frame(700);c=fault switch{"prompt"=>c with{PromptVisible=true},"focus"=>c with{Focused=false},
+            "revive"=>c with{ReviveVisible=true},_=>c with{Character=c.Character with{HeaderRaw="风元素/另一角色"}}};
+        Assert.False(TalentEntryObservationEvidence.ContiguousTriple(Frame(100),Frame(400),c,Official,700));
+    }
+    [Fact] public void ThirdIsStillBoundToCurrentPositionAndIndependentTime()
+    {
+        Assert.False(TalentEntryObservationEvidence.ContiguousTriple(Frame(100),Frame(400),Frame(700,shift:7),Official,700));
+        Assert.False(TalentEntryObservationEvidence.ContiguousTriple(Frame(100),Frame(400),Frame(400),Official,700));
+        Assert.False(TalentEntryObservationEvidence.ContiguousTriple(Frame(100),Frame(400),Frame(2000),Official,2000));
+        Assert.Equal(12000,TalentEntryObservationEvidence.ObservationLimitMs);Assert.Equal(300,TalentEntryObservationEvidence.ObservationIntervalMs);
+    }
+}
