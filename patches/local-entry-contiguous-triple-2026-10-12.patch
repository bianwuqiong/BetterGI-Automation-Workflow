diff --git a/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentEntryContiguousTripleTests.cs b/Test/BetterGenshinImpact.UnitTest/GameTaskTests/TalentEntryContiguousTripleTests.cs
