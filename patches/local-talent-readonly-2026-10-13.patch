+using System.Collections.Generic;
+using BetterGenshinImpact.GameTask.CharacterDevelopment;
+
+namespace BetterGenshinImpact.UnitTest.GameTaskTests;
+
+public class InspectionCleanupReadOrderTests
+{
+    [Fact] public void PreferredTooltipIsReadBeforeBroadPreviewAndAccountFreeMenuOcr()
+    {
+        var reads=new List<string>();
+        var scene=InspectTalentUpgradeTask.ReadCleanupScene("tooltip",layer=>{reads.Add(layer);return layer=="tooltip";});
+        Assert.Equal("tooltip",scene);
+        Assert.Equal(new[]{"overview","tooltip"},reads);
+    }
+    [Theory] [InlineData("tooltip","preview")] [InlineData("preview","detail")]
+    [InlineData("detail","tooltip")] [InlineData("overview","paimon_menu")]
+    public void FailedPreferredLayerAlwaysContinuesThroughFreshFallbackReads(string preferred,string actual)
+    {
+        var reads=new List<string>();
+        var scene=InspectTalentUpgradeTask.ReadCleanupScene(preferred,layer=>{reads.Add(layer);return layer==actual;});
+        Assert.Equal(actual,scene);
+        Assert.Contains(preferred,reads);
+        Assert.Equal(actual,reads[^1]);
+        Assert.Equal(reads.Count,new HashSet<string>(reads).Count);
+    }
+    [Fact] public void CachedLayerNameCannotProveAChangedOrUnknownScene()
+    {
+        var reads=new List<string>();
+        var scene=InspectTalentUpgradeTask.ReadCleanupScene("tooltip",layer=>{reads.Add(layer);return false;});
+        Assert.Equal("unknown",scene);
+        Assert.Equal(new[]{"overview","tooltip","preview","detail","paimon_menu"},reads);
+        var policy=new InspectionCleanupPolicy();
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe(scene,100,0,true,false));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe(scene,400,300,true,false));
+    }
+    [Fact] public void NewlyPredictedLayerStillRequiresTwoFreshObservationsBeforeEscape()
+    {
+        var preferred=InspectTalentUpgradeTask.CleanupSceneAfterEscape("tooltip");
+        Assert.Equal("preview",preferred);
+        var actual=InspectTalentUpgradeTask.ReadCleanupScene(preferred,layer=>layer=="preview");
+        var policy=new InspectionCleanupPolicy();
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe(actual,100,0,true,false));
+        Assert.Equal(InspectionCleanupAction.Escape,policy.Observe(actual,400,300,true,false));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe(actual,1600,1500,true,false));
+    }
+    [Fact] public void WorldRequiresTwoIndependentCapturesAfterLastCharacterEscape()
+    {
+        var policy=new InspectionCleanupPolicy();
+        policy.Observe("overview",100,0,true,false);
+        Assert.Equal(InspectionCleanupAction.Escape,policy.Observe("overview",400,300,true,false));
+        Assert.Equal("unknown",InspectTalentUpgradeTask.CleanupSceneAfterEscape("overview"));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("world",800,700,true,false));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("world",800,750,true,false));
+        Assert.Equal(InspectionCleanupAction.Restored,policy.Observe("world",1100,1000,true,false));
+    }
+    [Fact] public void UnknownBetweenWorldCapturesInvalidatesTheWorldPair()
+    {
+        var policy=new InspectionCleanupPolicy();
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("world",100,0,true,false));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("unknown",400,300,true,false));
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("world",700,600,true,false));
+        Assert.Equal(InspectionCleanupAction.Restored,policy.Observe("world",1000,900,true,false));
+    }
+    [Fact] public void OriginalTenSecondDeadlineRemainsHardForWorldAndRecognizedLayers()
+    {
+        var policy=new InspectionCleanupPolicy();
+        Assert.Equal(InspectionCleanupAction.Wait,policy.Observe("world",100,9900,true,false));
+        Assert.Equal(InspectionCleanupAction.Blocked,policy.Observe("world",400,10000,true,false));
+        Assert.Equal(InspectionCleanupAction.Blocked,policy.Observe("overview",500,10001,true,false));
+    }
+}
